@page "/models"
@inject AppLibraryState LibraryState
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["ModelsPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["ModelsEyebrow"]</p><h1>@Strings["ModelsHeading"]</h1><p class="muted">@Strings["ModelsDescription"]</p></div>
    @if (_activeConnections.Count > 0)
    {
        <a class="button" href="/models/new">@Strings["AddModel"]</a>
    }
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_activeConnections.Count == 0)
{
    <p class="empty">@Strings["AddConnectionFirst"] <a href="/connections/new">@Strings["AddConnection"]</a></p>
}
else
{
    <section class="panel">
        @if (_activeModels.Count == 0)
        {
            <p class="empty">@Strings["NoModels"]</p>
        }
        else
        {
            <ul class="metadata-list">
                @foreach (var model in _activeModels)
                {
                    <li>
                        <div>
                            <strong>@model.Label</strong>
                            <small>@Strings["ModelSummary", ConnectionLabel(model.ConnectionId), ModeLabel(model.Mode), model.ProviderModelId]</small>
                            @if (IsNotCurrentlyListed(model))
                            {
                                <span class="notice">@Strings["ModelNotCurrentlyListed"]</span>
                            }
                        </div>
                        <a class="ghost" href="@($"/models/{model.Id}")">@Strings["Edit"]</a>
                        @if (_recycleCandidate == model.Id)
                        {
                            <span role="group" aria-label="@Strings["ConfirmRecycleModel"]">
                                <span>@Strings["RecycleModelWarning"]</span>
                                <button class="danger" disabled="@_busy" @onclick="() => RecycleAsync(model.Id)">@Strings["Recycle"]</button>
                                <button class="secondary" disabled="@_busy" @onclick="() => _recycleCandidate = null">@Strings["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleCandidate = model.Id">@Strings["Recycle"]</button>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <button class="secondary" @onclick="() => _showRecycled = !_showRecycled">@(_showRecycled ? Strings["HideRecycledModels"] : Strings["ShowRecycledModels"])</button>
        @if (_showRecycled)
        {
            @if (_recycledModels.Count == 0)
            {
                <p class="empty">@Strings["NoRecycledModels"]</p>
            }
            else
            {
                <ul class="metadata-list">
                    @foreach (var model in _recycledModels)
                    {
                        <li>
                            <div><strong>@model.Label</strong><small>@ModeLabel(model.Mode)</small></div>
                            <button class="ghost" disabled="@_busy" @onclick="() => RestoreAsync(model.Id)">@Strings["Restore"]</button>
                            @if (_deleteCandidate == model.Id)
                            {
                                <span role="group" aria-label="@Strings["ConfirmPermanentlyDeleteModel"]">
                                    <span>@Strings["PermanentlyDeleteModelWarning"]</span>
                                    <button class="danger" disabled="@_busy" @onclick="() => PermanentlyDeleteAsync(model.Id)">@Strings["DeletePermanently"]</button>
                                    <button class="secondary" disabled="@_busy" @onclick="() => _deleteCandidate = null">@Strings["Cancel"]</button>
                                </span>
                            }
                            else
                            {
                                <button class="ghost danger" disabled="@_busy" @onclick="() => _deleteCandidate = model.Id">@Strings["DeletePermanently"]</button>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </section>
}

@code {
    private IReadOnlyList<Model> _activeModels = [];
    private IReadOnlyList<Model> _recycledModels = [];
    private IReadOnlyList<Connection> _activeConnections = [];
    private readonly Dictionary<string, ModelCatalogue> _catalogues = [];
    private bool _busy;
    private bool _showRecycled;
    private string? _message;
    private string? _recycleCandidate;
    private string? _deleteCandidate;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _activeModels = await workspace.GetActiveModelsAsync();
        _recycledModels = await workspace.GetRecycledModelsAsync();
        _activeConnections = await workspace.GetActiveConnectionsAsync();
        _catalogues.Clear();
        foreach (var connectionId in _activeModels.Select(model => model.ConnectionId).Distinct())
        {
            try
            {
                _catalogues[connectionId] = await workspace.GetModelCatalogueAsync(connectionId);
            }
            catch (SlopFactoryException)
            {
                // Connection no longer resolvable; leave uncached so IsNotCurrentlyListed stays silent.
            }
        }
    }

    private bool IsNotCurrentlyListed(Model model) =>
        _catalogues.TryGetValue(model.ConnectionId, out var catalogue)
        && catalogue.RetrievedAt is not null
        && !catalogue.Entries.Any(entry => string.Equals(entry.ProviderModelId, model.ProviderModelId, StringComparison.Ordinal));

    private string ConnectionLabel(string connectionId) => _activeConnections.FirstOrDefault(connection => connection.Id == connectionId)?.Label ?? Strings["Unavailable"];

    private string ModeLabel(GenerationMode mode) => mode switch
    {
        GenerationMode.Text => Strings["ModeText"],
        GenerationMode.Image => Strings["ModeImage"],
        _ => mode.ToString()
    };

    private async Task RecycleAsync(string modelId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.RecycleModelAsync(modelId);
            _recycleCandidate = null;
            _message = Strings["ModelRecycled"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task RestoreAsync(string modelId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.RestoreModelAsync(modelId);
            _message = Strings["ModelRestored"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task PermanentlyDeleteAsync(string modelId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.PermanentlyDeleteModelAsync(modelId);
            _deleteCandidate = null;
            _message = Strings["ModelPermanentlyDeleted"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }
}
