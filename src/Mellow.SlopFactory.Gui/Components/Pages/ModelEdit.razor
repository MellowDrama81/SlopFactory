@page "/models/new"
@page "/models/{Id}"
@inject AppLibraryState LibraryState
@inject ISecureCredentialStore Credentials
@inject IProviderAdapterResolver AdapterResolver
@inject NavigationManager Navigation
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@(IsNew ? Strings["AddModel"] : Strings["EditModel"])</PageTitle>

<header class="page-header">
    <h1>@(IsNew ? Strings["AddModel"] : Strings["EditModel"])</h1>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "error" : "")" role="@(_isError ? "alert" : "status")">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_activeConnections.Count == 0)
{
    <p class="empty">@Strings["AddConnectionFirst"] <a href="/connections/new">@Strings["AddConnection"]</a></p>
}
else
{
    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="stack-form">
        <label for="model-label">@Strings["Label"]</label>
        <InputText id="model-label" @bind-Value="_form.Label" maxlength="100" />

        <label for="model-connection">@Strings["Connection"]</label>
        <InputSelect id="model-connection" @bind-Value="_form.ConnectionId" @bind-Value:after="OnConnectionChangedAsync" disabled="@(!IsNew)">
            @foreach (var connection in _activeConnections)
            {
                <option value="@connection.Id">@connection.Label</option>
            }
        </InputSelect>

        @if (!IsNew && _existingNeedsReview)
        {
            <div class="notice error" role="alert">
                @Strings["ModelNeedsReview"]
                <button type="button" class="secondary" disabled="@_busy" @onclick="MarkReviewedAsync">@Strings["MarkAsReviewed"]</button>
            </div>
        }

        <label for="model-mode">@Strings["GenerationMode"]</label>
        <InputSelect id="model-mode" @bind-Value="_form.Mode" @bind-Value:after="OnModeChanged">
            <option value="@GenerationMode.Text">@Strings["ModeText"]</option>
            <option value="@GenerationMode.Image">@Strings["ModeImage"]</option>
            <option value="@GenerationMode.Audio">@Strings["ModeAudio"]</option>
            <option value="@GenerationMode.Video">@Strings["ModeVideo"]</option>
        </InputSelect>

        @if (!SelectedConnectionIsComfyUi)
        {
            <label for="model-provider-id">@Strings["ProviderModelId"]</label>
            <InputText id="model-provider-id" @bind-Value="_form.ProviderModelId" maxlength="100" />
            @if (_catalogue is not null)
            {
                <p class="muted">
                    @(_catalogue.RetrievedAt is { } retrievedAt ? Strings["ModelCatalogueLastRefreshed", retrievedAt.ToLocalTime().ToString("g")] : Strings["ModelCatalogueNeverRefreshed"])
                    @if (_catalogue.PossiblyStale)
                    {
                        <span class="notice error">@Strings["ModelCataloguePossiblyStale"]</span>
                    }
                    else if (_catalogue.RetrievedAt is { } lastRefreshed && DateTimeOffset.UtcNow - lastRefreshed > LibraryRules.ModelCatalogueStalenessPeriod)
                    {
                        <span class="notice">@Strings["ModelCatalogueStale"]</span>
                    }
                </p>
            }
            @if (SelectedConnectionSupportsModelDiscovery)
            {
                <button type="button" class="secondary" disabled="@_busy" @onclick="LoadModelsAsync">@(_loadingModels ? Strings["LoadingModels"] : Strings["LoadModels"])</button>
                @if (_discoveredModels is not null)
                {
                    @if (_discoveredModels.Count == 0)
                    {
                        <p class="muted">@Strings["NoModelsDiscovered"]</p>
                    }
                    else
                    {
                        <select aria-label="@Strings["DiscoveredModels"]" @onchange="ChooseDiscoveredModel">
                            <option value="">@Strings["SelectDiscoveredModel"]</option>
                            @foreach (var discovered in _discoveredModels)
                            {
                                <option value="@discovered.ProviderModelId">@(discovered.DisplayLabel ?? discovered.ProviderModelId)</option>
                            }
                        </select>
                    }
                }
            }
            else
            {
                <button type="button" class="secondary" disabled>@Strings["LoadModels"]</button>
                <p class="muted">@Strings["ModelDiscoveryNotAvailableForProvider"]</p>
            }
        }

        <label class="check"><InputCheckbox @bind-Value="_form.SupportsSystemInstructions" /> @Strings["SupportsSystemInstructions"]</label>

        @if (_form.Mode == GenerationMode.Text)
        {
            <label for="model-text-format">@Strings["TextResultFormat"]</label>
            <InputSelect id="model-text-format" @bind-Value="_form.TextFormat">
                <option value="@TextResultFormat.Markdown">@Strings["TextResultFormatMarkdown"]</option>
                <option value="@TextResultFormat.PlainText">@Strings["TextResultFormatPlainText"]</option>
            </InputSelect>
        }

        @if (SelectedConnectionIsComfyUi)
        {
            @if (_form.Mode == GenerationMode.Image)
            {
                <label for="model-comfy-builtin-workflow">@Strings["ComfyBuiltInWorkflowPicker"]</label>
                <select id="model-comfy-builtin-workflow" @onchange="ChooseBuiltInWorkflow">
                    <option value="">@Strings["ComfyBuiltInWorkflowPickerPlaceholder"]</option>
                    @foreach (var builtIn in ComfyBuiltInWorkflows.All)
                    {
                        <option value="@builtIn.Id">@builtIn.Name</option>
                    }
                </select>
                @if (_selectedBuiltInWorkflow is not null)
                {
                    <p class="muted">@_selectedBuiltInWorkflow.Description</p>
                    <p class="muted">@Strings["ComfyBuiltInWorkflowReferenceImageCount", _selectedBuiltInWorkflow.ReferenceImageCount]</p>
                    <p class="muted">@Strings["ComfyBuiltInWorkflowRequiredNodes", string.Join(", ", _selectedBuiltInWorkflow.Requirements.NodeTypes)]</p>
                    @if (_selectedBuiltInWorkflow.Requirements.ModelFiles.Count > 0)
                    {
                        <p class="muted">@Strings["ComfyBuiltInWorkflowRequiredModels", string.Join(", ", _selectedBuiltInWorkflow.Requirements.ModelFiles)]</p>
                    }
                    @if (_selectedBuiltInWorkflow.Tuning.Count > 0)
                    {
                        <p class="muted">@Strings["ComfyBuiltInWorkflowTuningDefaults"]</p>
                        <ul class="metadata-list">
                            @foreach (var parameter in _selectedBuiltInWorkflow.Tuning)
                            {
                                <li><strong>@parameter.Name: @parameter.DefaultValue.</strong> @parameter.Effect</li>
                            }
                        </ul>
                    }
                }
            }

            <label for="model-comfy-workflow">@Strings["ComfyWorkflowTemplate"]</label>
            <textarea id="model-comfy-workflow" rows="12" @bind="_form.ComfyWorkflowTemplate" placeholder="{...}"></textarea>
            <p class="muted">@Strings["ComfyWorkflowTemplateHelp"]</p>
        }

        @if (_pendingReviewConfirmation)
        {
            <div class="notice error" role="alert">
                <p>@Strings["ModelChangeAffectsSavedSettings", _affectedSavedSettings.Count]</p>
                @if (_affectedSavedSettings.Count > 0)
                {
                    <ul class="metadata-list">
                        @foreach (var savedSetting in _affectedSavedSettings)
                        {
                            <li>@savedSetting.Title</li>
                        }
                    </ul>
                }
                <div class="actions">
                    <button type="button" class="danger" disabled="@_busy" @onclick="ConfirmSaveAsync">@Strings["ConfirmModelChange"]</button>
                    <button type="button" class="secondary" disabled="@_busy" @onclick="() => _pendingReviewConfirmation = false">@Strings["Cancel"]</button>
                </div>
            </div>
        }
        else
        {
            <div class="actions">
                <button type="submit" disabled="@_busy">@Strings["Save"]</button>
                <a class="ghost" href="/models">@Strings["Cancel"]</a>
            </div>
        }
    </EditForm>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private bool IsNew => string.IsNullOrEmpty(Id);

    private const string ComfyUiPlaceholderProviderModelId = "workflow";

    private ModelForm _form = new();
    private IReadOnlyList<Connection> _activeConnections = [];
    private IReadOnlyList<ProviderModelInfo>? _discoveredModels;
    private ModelCatalogue? _catalogue;
    private bool _busy;
    private bool _loadingModels;
    private string? _message;
    private bool _isError;
    private string _originalProviderModelId = string.Empty;
    private GenerationMode _originalMode;
    private bool _existingNeedsReview;
    private bool _pendingReviewConfirmation;
    private IReadOnlyList<SavedGenerationSetting> _affectedSavedSettings = [];
    private ComfyBuiltInWorkflow? _selectedBuiltInWorkflow;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _activeConnections = await workspace.GetActiveConnectionsAsync();
        if (!IsNew)
        {
            try
            {
                var existing = await workspace.GetModelAsync(Id);
                _form.Label = existing.Label;
                _form.ConnectionId = existing.ConnectionId;
                _form.Mode = existing.Mode;
                _form.ProviderModelId = existing.ProviderModelId;
                _form.SupportsSystemInstructions = existing.SupportsSystemInstructions;
                _form.TextFormat = existing.TextFormat;
                _form.ComfyWorkflowTemplate = existing.ComfyWorkflowTemplate ?? string.Empty;
                _originalProviderModelId = existing.ProviderModelId;
                _originalMode = existing.Mode;
                _existingNeedsReview = existing.NeedsReview;
            }
            catch (SlopFactoryException exception)
            {
                _message = exception.Message;
                _isError = true;
            }
        }
        else if (_activeConnections.Count > 0)
        {
            _form.ConnectionId = _activeConnections[0].Id;
        }

        await LoadCatalogueAsync();
    }

    private async Task LoadCatalogueAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || string.IsNullOrEmpty(_form.ConnectionId)) return;
        try
        {
            _catalogue = await workspace.GetModelCatalogueAsync(_form.ConnectionId);
        }
        catch (SlopFactoryException)
        {
            _catalogue = null;
        }
    }

    /// <summary>Whether the currently selected connection's provider has any model-listing endpoint at
    /// all — see <see cref="LibraryRules.SupportsModelDiscovery"/>. Gates both the discovery button and
    /// the discovered-models dropdown so a provider with no such endpoint (1min.ai today) never lets the
    /// user trigger a call that is guaranteed to fail.</summary>
    private bool SelectedConnectionSupportsModelDiscovery =>
        _activeConnections.FirstOrDefault(candidate => candidate.Id == _form.ConnectionId) is { } connection
        && LibraryRules.SupportsModelDiscovery(connection.ProviderType);

    /// <summary>Gates the workflow-JSON textarea (see Comfy.md section 3.2) — only ComfyUi models
    /// carry a <see cref="Model.ComfyWorkflowTemplate"/>, and only such a connection's models require
    /// entering one to be usable at all.</summary>
    private bool SelectedConnectionIsComfyUi =>
        _activeConnections.FirstOrDefault(candidate => candidate.Id == _form.ConnectionId) is { ProviderType: ProviderType.ComfyUi };

    /// <summary>Clears the previously discovered list and reloads the catalogue for the newly selected
    /// connection — the old list/catalogue belonged to a different connection (and possibly a provider
    /// with no discovery support at all) and would otherwise linger stale on screen.</summary>
    private async Task OnConnectionChangedAsync()
    {
        _discoveredModels = null;
        await LoadCatalogueAsync();
    }

    /// <summary>Clears the previously discovered list when the mode changes — that list may have been
    /// filtered to a different <see cref="GenerationMode"/> (OpenRouter's confirmed
    /// <c>output_modalities</c> query parameter, see <see cref="LoadModelsAsync"/>), so it no longer
    /// reflects what the newly selected mode should offer.</summary>
    private void OnModeChanged()
    {
        _discoveredModels = null;
    }

    private async Task LoadModelsAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        var connection = _activeConnections.FirstOrDefault(candidate => candidate.Id == _form.ConnectionId);
        if (connection is null) return;
        _busy = true;
        _loadingModels = true;
        try
        {
            var adapter = AdapterResolver.Resolve(connection.ProviderType);
            var apiKey = connection is { HasCredential: true, CredentialRevisionId: { } revisionId } ? await Credentials.GetActiveAsync(workspace.Descriptor.LibraryId, connection.Id, revisionId) : null;
            var discovered = await adapter.ListModelsAsync(connection, apiKey, _form.Mode);
            _discoveredModels = discovered
                .OrderBy(model => model.DisplayLabel ?? model.ProviderModelId, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // The catalogue is one per-connection cache spanning every mode — Models.razor's stale-model
            // check depends on it listing every modality, not just whichever one is being added/edited
            // right now. Only OpenRouter's ListModelsAsync actually narrows by mode (see
            // OpenRouterProviderAdapter), so only it needs a second, unfiltered fetch to keep that
            // shared cache correct; every other provider already returned its full catalogue above.
            var catalogueSource = connection.ProviderType == ProviderType.OpenRouter
                ? await adapter.ListModelsAsync(connection, apiKey)
                : discovered;
            _catalogue = await workspace.RefreshModelCatalogueAsync(connection.Id, catalogueSource);
            if (_discoveredModels.Count == 0) _message = Strings["NoModelsDiscovered"];
        }
        catch (Exception exception) when (exception is HttpRequestException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
            _discoveredModels = null;
            try
            {
                _catalogue = await workspace.MarkModelCatalogueRefreshFailedAsync(connection.Id);
            }
            catch (SlopFactoryException)
            {
                // Connection may have been recycled between the failed refresh and this cleanup step; nothing further to record.
            }
        }
        finally
        {
            _busy = false;
            _loadingModels = false;
        }
    }

    private void ChooseDiscoveredModel(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString();
        if (!string.IsNullOrEmpty(selected)) _form.ProviderModelId = selected;
    }

    /// <summary>Populates the (still-editable) workflow textarea from the chosen built-in template —
    /// deliberately does not auto-save, mirroring <see cref="ChooseDiscoveredModel"/>'s
    /// pick-then-review pattern, since a built-in template may still need hand-editing (e.g. swapping
    /// a checkpoint name not installed on the user's own Comfy account).</summary>
    private void ChooseBuiltInWorkflow(ChangeEventArgs args)
    {
        var selectedId = args.Value?.ToString();
        _selectedBuiltInWorkflow = string.IsNullOrEmpty(selectedId) ? null : ComfyBuiltInWorkflows.All.FirstOrDefault(workflow => workflow.Id == selectedId);
        if (_selectedBuiltInWorkflow is not null) _form.ComfyWorkflowTemplate = _selectedBuiltInWorkflow.WorkflowTemplate;
    }

    private async Task SaveAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;

        if (!IsNew && (!string.Equals(_form.ProviderModelId, _originalProviderModelId, StringComparison.Ordinal) || _form.Mode != _originalMode))
        {
            var activeSavedSettings = await workspace.GetActiveSavedSettingsAsync();
            _affectedSavedSettings = activeSavedSettings.Where(savedSetting => savedSetting.ModelId == Id).ToArray();
            _pendingReviewConfirmation = true;
            return;
        }

        await SaveModelAsync();
    }

    private async Task ConfirmSaveAsync()
    {
        _pendingReviewConfirmation = false;
        await SaveModelAsync();
    }

    private async Task SaveModelAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _busy = true;
        try
        {
            var comfyWorkflowTemplate = SelectedConnectionIsComfyUi ? _form.ComfyWorkflowTemplate : null;
            // The Provider Model ID field is hidden for ComfyUi (see SelectedConnectionIsComfyUi's
            // remarks — ComfyUiProviderAdapter never reads Model.ProviderModelId at all), but the
            // domain layer still requires a non-empty value, so a new ComfyUi model gets a fixed
            // placeholder here rather than surfacing a meaningless field just to satisfy validation.
            var providerModelId = SelectedConnectionIsComfyUi && string.IsNullOrWhiteSpace(_form.ProviderModelId)
                ? ComfyUiPlaceholderProviderModelId
                : _form.ProviderModelId;
            if (IsNew)
            {
                await workspace.CreateModelAsync(_form.Label, _form.ConnectionId, providerModelId, _form.Mode, _form.SupportsSystemInstructions, _form.TextFormat, comfyWorkflowTemplate);
            }
            else
            {
                await workspace.UpdateModelAsync(Id, _form.Label, providerModelId, _form.Mode, _form.SupportsSystemInstructions, _form.TextFormat, comfyWorkflowTemplate);
            }

            Navigation.NavigateTo("/models");
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally { _busy = false; }
    }

    private async Task MarkReviewedAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _busy = true;
        try
        {
            await workspace.MarkModelReviewedAsync(Id);
            _existingNeedsReview = false;
            _message = Strings["ModelMarkedReviewed"];
            _isError = false;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally { _busy = false; }
    }

    private sealed class ModelForm
    {
        public string Label { get; set; } = string.Empty;
        public string ConnectionId { get; set; } = string.Empty;
        public GenerationMode Mode { get; set; } = GenerationMode.Text;
        public string ProviderModelId { get; set; } = string.Empty;
        public bool SupportsSystemInstructions { get; set; }
        public TextResultFormat TextFormat { get; set; } = TextResultFormat.Markdown;
        public string ComfyWorkflowTemplate { get; set; } = string.Empty;
    }
}
