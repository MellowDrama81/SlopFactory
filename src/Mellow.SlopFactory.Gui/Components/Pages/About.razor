@page "/about"
@inject IAppBuildInfo BuildInfo
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["NavAbout"] · SlopFactory</PageTitle>
<header class="page-header">
    <div>
        <p class="eyebrow">@Strings["NavAbout"]</p>
        <h1>@Strings["AboutHeading"]</h1>
        <p class="muted">@Strings["AboutBuildLine", BuildInfo.Channel, BuildInfo.DisplayVersion, BuildInfo.BuildNumber]</p>
    </div>
</header>
<section class="panel prose">
    <h2>@Strings["AboutIntro"]</h2>
    <p>@Strings["AboutDescription"]</p>
</section>
<section class="panel prose">
    <h2>@Strings["BuildInformation"]</h2>
    <p class="muted">@Strings["AboutApplicationId", BuildInfo.ApplicationId]</p>
    @if (BuildInfo.DownloadPageUrl is { Length: > 0 } url)
    {
        <p><a href="@url" target="_blank" rel="noopener noreferrer">@Strings["DownloadPageLink"]</a></p>
    }
</section>
