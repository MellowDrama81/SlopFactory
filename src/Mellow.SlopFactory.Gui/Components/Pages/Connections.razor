@page "/connections"
@inject AppLibraryState LibraryState
@inject IConnectionRateLimitTracker RateLimitTracker
@inject GenerationQueueService Queue
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["ConnectionsPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["ConnectionsEyebrow"]</p><h1>@Strings["ConnectionsHeading"]</h1><p class="muted">@Strings["ConnectionsDescription"]</p></div>
    <a class="button" href="/connections/new">@Strings["AddConnection"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else
{
    <section class="panel">
        @if (_activeConnections.Count == 0)
        {
            <p class="empty">@Strings["NoConnections"]</p>
        }
        else
        {
            <ul class="metadata-list">
                @foreach (var connection in _activeConnections)
                {
                    <li>
                        <div>
                            <strong>@connection.Label</strong>
                            <small>@Strings["ConnectionSummary", ProviderTypeLabel(connection.ProviderType), StatusLabel(connection)]</small>
                        </div>
                        <code>@connection.BaseUrl</code>
                        @if (IsInsecureHttpBaseUrl(connection))
                        {
                            <span class="notice error">@Strings["InsecureConnectionBadge"]</span>
                        }
                        @if (UnresolvedAsyncJobCount(connection.Id) is > 0 and var unresolvedCount)
                        {
                            <div class="notice" role="status">
                                @Strings["UnresolvedAsyncJobsNotice", unresolvedCount]
                                <button type="button" class="ghost" disabled="@_busy" @onclick="() => DiscardUnresolvedAsyncJobsAsync(connection.Id)">@Strings["DiscardUnresolvedAsyncJobs"]</button>
                            </div>
                        }
                        @if (RateLimitTracker.GetObservation(connection.Id) is { } observation && observation.RemainingRequests is not null && observation.LimitRequests is not null)
                        {
                            <small class="muted">@Strings["RateLimitObservedSummary", observation.RemainingRequests, observation.LimitRequests, observation.ObservedAt.ToLocalTime().ToString("t")]</small>
                        }
                        <a class="ghost" href="@($"/connections/{connection.Id}")">@Strings["Edit"]</a>
                        @if (_recycleCandidate == connection.Id)
                        {
                            <span role="dialog" aria-label="@Strings["ConfirmRecycleConnection"]">
                                <span>@Strings["RecycleConnectionWarning", DependentModelCount(connection.Id)]</span>
                                @if (Queue.IsConnectionActivelyInUse(connection.Id))
                                {
                                    <span class="notice error">@Strings["ConnectionActivelyInUse"]</span>
                                }
                                else
                                {
                                    @if (Queue.GetQueuedJobTitlesForConnection(connection.Id).Count is > 0 and var queuedJobCount)
                                    {
                                        <span class="notice">@Strings["RecycleConnectionQueuedJobsWarning", queuedJobCount]</span>
                                    }
                                    <button class="danger" disabled="@_busy" @onclick="() => RecycleAsync(connection.Id)">@Strings["Recycle"]</button>
                                }
                                <button class="secondary" disabled="@_busy" @onclick="() => _recycleCandidate = null">@Strings["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleCandidate = connection.Id">@Strings["Recycle"]</button>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <p class="muted">@Strings["RecycledItemsMovedToBin"] <a class="ghost" href="/recycle-bin">@Strings["NavRecycleBin"]</a></p>
}

@code {
    private IReadOnlyList<Connection> _activeConnections = [];
    private IReadOnlyList<Model> _activeModels = [];
    private ILookup<string, AsyncRemoteJobRecord> _unresolvedAsyncJobsByConnection = Array.Empty<AsyncRemoteJobRecord>().ToLookup(job => job.ConnectionId);
    private bool _busy;
    private string? _message;
    private string? _recycleCandidate;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _activeConnections = await workspace.GetActiveConnectionsAsync();
        _activeModels = await workspace.GetActiveModelsAsync();
        // Pending (Submitted/Processing/MonitoringPaused/CompletedAwaitingDownload) async jobs — e.g. a video generation
        // whose poll loop never finished because the app closed mid-poll — are otherwise only
        // visible through ConnectionEdit.razor's reconciliation gate, which a user only ever sees
        // if they happen to edit that connection's auth settings. Surfacing them here gives real
        // visibility and a cleanup path instead of a silently orphaned registry row.
        _unresolvedAsyncJobsByConnection = (await workspace.GetPendingAsyncRemoteJobsAsync()).ToLookup(job => job.ConnectionId);
    }

    private int UnresolvedAsyncJobCount(string connectionId) => _unresolvedAsyncJobsByConnection[connectionId].Count();

    private async Task DiscardUnresolvedAsyncJobsAsync(string connectionId)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _busy = true;
        try
        {
            foreach (var job in _unresolvedAsyncJobsByConnection[connectionId].ToArray())
            {
                await workspace.DeleteAsyncRemoteJobAsync(job.Id);
            }
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private int DependentModelCount(string connectionId) => _activeModels.Count(model => model.ConnectionId == connectionId);

    private static bool IsInsecureHttpBaseUrl(Connection connection) => connection.BaseUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase);

    private string ProviderTypeLabel(ProviderType providerType) => providerType switch
    {
        ProviderType.OpenAi => Strings["ProviderOpenAi"],
        ProviderType.GenericOpenAiCompatible => Strings["ProviderGenericOpenAiCompatible"],
        ProviderType.OpenRouter => Strings["ProviderOpenRouter"],
        ProviderType.DeepInfra => Strings["ProviderDeepInfra"],
        ProviderType.OneMinAi => Strings["ProviderOneMinAi"],
        _ => providerType.ToString()
    };

    private string StatusLabel(Connection connection) => connection.CredentialRequiresRepair
        ? Strings["ConnectionCredentialRequiresRepair"]
        : !connection.HasCredential
        ? Strings["ConnectionCredentialsRequired"]
        : connection.LastTestStatus switch
        {
            ConnectionTestStatus.Success => Strings["ConnectionVerified"],
            ConnectionTestStatus.Failed => Strings["ConnectionTestFailedStatus"],
            _ => Strings["ConnectionUnverified"]
        };

    private async Task RecycleAsync(string connectionId)
    {
        if (Queue.IsConnectionActivelyInUse(connectionId)) return;
        _busy = true;
        try
        {
            // plan.md:419 — recycling cancels every still-queued (never yet submitted) job on this
            // connection, having already shown their count in the cascade warning above.
            Queue.CancelQueuedJobsForConnection(connectionId);
            await LibraryState.Workspace!.RecycleConnectionAsync(connectionId);
            _recycleCandidate = null;
            _message = Strings["ConnectionRecycled"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }
}
