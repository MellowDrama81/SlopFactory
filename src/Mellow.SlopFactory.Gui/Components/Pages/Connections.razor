@page "/connections"
@inject AppLibraryState LibraryState
@inject ISecureCredentialStore Credentials
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["ConnectionsPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["ConnectionsEyebrow"]</p><h1>@Strings["ConnectionsHeading"]</h1><p class="muted">@Strings["ConnectionsDescription"]</p></div>
    <a class="button" href="/connections/new">@Strings["AddConnection"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else
{
    <section class="panel">
        @if (_activeConnections.Count == 0)
        {
            <p class="empty">@Strings["NoConnections"]</p>
        }
        else
        {
            <ul class="metadata-list">
                @foreach (var connection in _activeConnections)
                {
                    <li>
                        <div>
                            <strong>@connection.Label</strong>
                            <small>@Strings["ConnectionSummary", ProviderTypeLabel(connection.ProviderType), StatusLabel(connection)]</small>
                        </div>
                        <code>@connection.BaseUrl</code>
                        @if (IsInsecureHttpBaseUrl(connection))
                        {
                            <span class="notice error">@Strings["InsecureConnectionBadge"]</span>
                        }
                        <a class="ghost" href="@($"/connections/{connection.Id}")">@Strings["Edit"]</a>
                        @if (_recycleCandidate == connection.Id)
                        {
                            <span role="dialog" aria-label="@Strings["ConfirmRecycleConnection"]">
                                <span>@Strings["RecycleConnectionWarning", DependentModelCount(connection.Id)]</span>
                                <button class="danger" disabled="@_busy" @onclick="() => RecycleAsync(connection.Id)">@Strings["Recycle"]</button>
                                <button class="secondary" disabled="@_busy" @onclick="() => _recycleCandidate = null">@Strings["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleCandidate = connection.Id">@Strings["Recycle"]</button>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <button class="secondary" @onclick="() => _showRecycled = !_showRecycled">@(_showRecycled ? Strings["HideRecycledConnections"] : Strings["ShowRecycledConnections"])</button>
        @if (_showRecycled)
        {
            @if (_recycledConnections.Count == 0)
            {
                <p class="empty">@Strings["NoRecycledConnections"]</p>
            }
            else
            {
                <ul class="metadata-list">
                    @foreach (var connection in _recycledConnections)
                    {
                        <li>
                            <div><strong>@connection.Label</strong><small>@ProviderTypeLabel(connection.ProviderType)</small></div>
                            <button class="ghost" disabled="@_busy" @onclick="() => RestoreAsync(connection.Id)">@Strings["Restore"]</button>
                            @if (_deleteCandidate == connection.Id)
                            {
                                <span role="dialog" aria-label="@Strings["ConfirmPermanentlyDeleteConnection"]">
                                    <span>@Strings["PermanentlyDeleteConnectionWarning"]</span>
                                    <button class="danger" disabled="@_busy" @onclick="() => PermanentlyDeleteAsync(connection.Id)">@Strings["DeletePermanently"]</button>
                                    <button class="secondary" disabled="@_busy" @onclick="() => _deleteCandidate = null">@Strings["Cancel"]</button>
                                </span>
                            }
                            else
                            {
                                <button class="ghost danger" disabled="@_busy" @onclick="() => _deleteCandidate = connection.Id">@Strings["DeletePermanently"]</button>
                            }
                        </li>
                    }
                </ul>
            }
        }
    </section>
}

@code {
    private IReadOnlyList<Connection> _activeConnections = [];
    private IReadOnlyList<Connection> _recycledConnections = [];
    private IReadOnlyList<Model> _activeModels = [];
    private bool _busy;
    private bool _showRecycled;
    private string? _message;
    private string? _recycleCandidate;
    private string? _deleteCandidate;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _activeConnections = await workspace.GetActiveConnectionsAsync();
        _recycledConnections = await workspace.GetRecycledConnectionsAsync();
        _activeModels = await workspace.GetActiveModelsAsync();
    }

    private int DependentModelCount(string connectionId) => _activeModels.Count(model => model.ConnectionId == connectionId);

    private static bool IsInsecureHttpBaseUrl(Connection connection) => connection.BaseUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase);

    private string ProviderTypeLabel(ProviderType providerType) => providerType switch
    {
        ProviderType.OpenAi => Strings["ProviderOpenAi"],
        ProviderType.GenericOpenAiCompatible => Strings["ProviderGenericOpenAiCompatible"],
        _ => providerType.ToString()
    };

    private string StatusLabel(Connection connection) => !connection.HasCredential
        ? Strings["ConnectionCredentialsRequired"]
        : connection.LastTestStatus switch
        {
            ConnectionTestStatus.Success => Strings["ConnectionVerified"],
            ConnectionTestStatus.Failed => Strings["ConnectionTestFailedStatus"],
            _ => Strings["ConnectionUnverified"]
        };

    private async Task RecycleAsync(string connectionId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.RecycleConnectionAsync(connectionId);
            _recycleCandidate = null;
            _message = Strings["ConnectionRecycled"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task RestoreAsync(string connectionId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.RestoreConnectionAsync(connectionId);
            _message = Strings["ConnectionRestored"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task PermanentlyDeleteAsync(string connectionId)
    {
        _busy = true;
        try
        {
            var libraryId = LibraryState.Workspace!.Descriptor.LibraryId;
            await LibraryState.Workspace!.PermanentlyDeleteConnectionAsync(connectionId);
            await Credentials.RemoveAsync(libraryId, connectionId);
            _deleteCandidate = null;
            _message = Strings["ConnectionPermanentlyDeleted"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }
}
