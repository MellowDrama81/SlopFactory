@page "/saved-settings"
@inject AppLibraryState LibraryState
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["SavedSettingsPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["GenerateEyebrow"]</p><h1>@Strings["SavedSettingsHeading"]</h1><p class="muted">@Strings["SavedSettingsDescription"]</p></div>
    <a class="button" href="/generate">@Strings["NewGeneration"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else
{
    <section class="panel">
        @if (_activeSettings.Count == 0)
        {
            <p class="empty">@Strings["NoSavedSettings"]</p>
        }
        else
        {
            <ul class="metadata-list">
                @foreach (var setting in _activeSettings)
                {
                    <li>
                        <div>
                            <strong>@setting.Title</strong>
                            <small>@Strings["SavedSettingSummary", setting.ModelLabel, ModeLabel(setting.Mode)]</small>
                            @if (setting.NeedsReview)
                            {
                                <span class="notice error">@Strings["NeedsReview"]</span>
                            }
                        </div>
                        <p>@setting.Prompt</p>
                        <a class="ghost" href="@($"/generate/{setting.Id}")">@Strings["UseSettings"]</a>
                        @if (_recycleCandidate == setting.Id)
                        {
                            <span role="dialog" aria-label="@Strings["ConfirmRecycleSavedSettings"]">
                                <span>@Strings["RecycleSavedSettingsWarning"]</span>
                                <button class="danger" disabled="@_busy" @onclick="() => RecycleAsync(setting.Id)">@Strings["Recycle"]</button>
                                <button class="secondary" disabled="@_busy" @onclick="() => _recycleCandidate = null">@Strings["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleCandidate = setting.Id">@Strings["Recycle"]</button>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <p class="muted">@Strings["RecycledItemsMovedToBin"] <a class="ghost" href="/recycle-bin">@Strings["NavRecycleBin"]</a></p>
}

@code {
    private IReadOnlyList<SavedGenerationSetting> _activeSettings = [];
    private bool _busy;
    private string? _message;
    private string? _recycleCandidate;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _activeSettings = await workspace.GetActiveSavedSettingsAsync();
    }

    private string ModeLabel(GenerationMode mode) => mode switch
    {
        GenerationMode.Text => Strings["ModeText"],
        GenerationMode.Image => Strings["ModeImage"],
        GenerationMode.Audio => Strings["ModeAudio"],
        GenerationMode.Video => Strings["ModeVideo"],
        _ => mode.ToString()
    };

    private async Task RecycleAsync(string settingId)
    {
        _busy = true;
        try
        {
            await LibraryState.Workspace!.RecycleSavedSettingAsync(settingId);
            _recycleCandidate = null;
            _message = Strings["SavedSettingsRecycled"];
            await ReloadAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }
}
