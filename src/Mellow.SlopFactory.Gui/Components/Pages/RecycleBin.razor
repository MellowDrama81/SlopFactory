@page "/recycle-bin"
@inject AppLibraryState LibraryState
@inject ISecureCredentialStore Credentials
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["RecycleBinPageTitle"]</PageTitle>

<header class="page-header">
    <div>
        <p class="eyebrow">@Strings["Recovery"]</p>
        <h1>@Strings["RecycleBin"]</h1>
        <p class="muted">@Strings["RecycleBinDescription"]</p>
    </div>
    <button class="danger" disabled="@(_entries.Count == 0 || _isBusy)" @onclick="BeginEmpty">@Strings["EmptyRecycleBin"]</button>
</header>

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="notice" role="status">@_message</div> }
@if (_failures.Count > 0)
{
    <div class="notice error" role="alert">
        <strong>@Strings["ItemsCouldNotBeProcessed", _failures.Count]</strong>
        <ul>
            @foreach (var failure in _failures) { <li><strong>@failure.Name:</strong> @failure.Error</li> }
        </ul>
    </div>
}

@if (_pendingAction is not null)
{
    <section class="panel confirmation-panel" role="dialog" aria-labelledby="confirmation-title">
        <h2 id="confirmation-title">@ConfirmationTitle</h2>
        <p>@ConfirmationMessage</p>
        <p><strong>@Strings["AffectedContent"]</strong> @CascadeSummary(_pendingEntries)</p>
        <ul>
            @foreach (var entry in _pendingEntries.Take(6))
            {
                <li>@KindName(entry.Reference.Kind): <strong>@entry.Name</strong> — @EntryCascadeSummary(entry)</li>
            }
            @if (_pendingEntries.Count > 6) { <li>@Strings["AndMoreItems", _pendingEntries.Count - 6]</li> }
        </ul>
        @if (_pendingAction == RecycleBinAction.Restore)
        {
            <div class="restore-review">
                @foreach (var preview in _restorePreview.Items)
                {
                    <div class="restore-review-item">
                        <strong>@preview.Entry.Name</strong>
                        <ul>
                            @foreach (var effect in preview.Effects) { <li>@effect</li> }
                            @foreach (var blocker in preview.BlockingReasons) { <li class="error">@Strings["Blocked", blocker]</li> }
                        </ul>
                    </div>
                }
                @if (_restorePreview.BlockedCount > 0)
                {
                    <p class="error"><strong>@Strings["RestoreBlockedItems", _restorePreview.BlockedCount]</strong> @Strings["RestoreBlockedGuidance"]</p>
                }
            </div>
        }
        <div class="actions">
            <button class="@(_pendingAction == RecycleBinAction.Restore ? string.Empty : "danger")" disabled="@(_isBusy || (_pendingAction == RecycleBinAction.Restore && _restorePreview.RestorableCount == 0))" @onclick="ConfirmPendingActionAsync">@ConfirmationButtonLabel</button>
            <button class="secondary" disabled="@_isBusy" @onclick="CancelPendingAction">@Strings["Cancel"]</button>
        </div>
    </section>
}

<section class="panel recycle-controls" aria-label="@Strings["RecycleBinControls"]">
    <label>@Strings["Search"]
        <input type="search" placeholder="@Strings["NameOrOriginalLocation"]" @bind="_search" @bind:event="oninput" />
    </label>
    <label>@Strings["Category"]
        <select @bind="_category">
            <option value="all">@Strings["All"]</option>
            <option value="folder">@Strings["Folders"]</option>
            <option value="file">@Strings["Files"]</option>
            <option value="link">@Strings["FileLinks"]</option>
            <option value="connection">@Strings["NavConnections"]</option>
            <option value="model">@Strings["NavModels"]</option>
            <option value="savedsetting">@Strings["NavSavedSettings"]</option>
        </select>
    </label>
    <label>@Strings["Sort"]
        <select @bind="_sort">
            <option value="deleted-desc">@Strings["RecentlyDeleted"]</option>
            <option value="deleted-asc">@Strings["OldestDeleted"]</option>
            <option value="name-asc">@Strings["NameAscending"]</option>
            <option value="name-desc">@Strings["NameDescending"]</option>
            <option value="type">@Strings["EntityType"]</option>
        </select>
    </label>
</section>

<div class="selection-bar">
    <span>@Strings["ItemsShownSelected", VisibleEntries.Count, _selected.Count]</span>
    <div class="actions">
        <button class="secondary" disabled="@(VisibleEntries.Count == 0 || _isBusy)" @onclick="SelectVisible">@Strings["SelectAllShown"]</button>
        <button class="secondary" disabled="@(_selected.Count == 0 || _isBusy)" @onclick="ClearSelection">@Strings["ClearSelection"]</button>
        <button disabled="@(SelectedRestorableCount == 0 || _isBusy)" @onclick="BeginRestoreSelected">@Strings["RestoreSelected", SelectedRestorableCount]</button>
        <button class="danger" disabled="@(_selected.Count == 0 || _isBusy)" @onclick="BeginDeleteSelected">@Strings["DeleteSelectedPermanently", _selected.Count]</button>
    </div>
</div>

@if (_entries.Count == 0)
{
    <div class="empty-panel"><p>@Strings["RecycleBinEmpty"]</p></div>
}
else if (VisibleEntries.Count == 0)
{
    <div class="empty-panel"><p>@Strings["NoRecycleBinMatches"]</p></div>
}
else
{
    <div class="file-list">
        @foreach (var entry in VisibleEntries)
        {
            <article class="file-row recycle-entry">
                <label class="recycle-check">
                    <input type="checkbox" checked="@_selected.Contains(entry.Reference)" @onchange="eventArgs => ToggleSelection(entry.Reference, eventArgs)" />
                    <span class="visually-hidden">@Strings["SelectItem", KindName(entry.Reference.Kind), entry.Name]</span>
                </label>
                <div class="file-main">
                    <strong>@entry.Name</strong>
                    <span>@Strings["OriginallyIn", KindName(entry.Reference.Kind), entry.OriginalLocation]</span>
                    <span>@Strings["DeletedEntryStatus", entry.RecycledAt.ToLocalTime().ToString("g"), EntryCascadeSummary(entry), StateName(entry.State)]</span>
                    @if (entry.DeletionFailure is not null)
                    {
                        <span class="error">@Strings["LastDeletionAttemptFailed", entry.DeletionFailure.FailedAt.ToLocalTime().ToString("g"), entry.DeletionFailure.SanitizedError]</span>
                    }
                </div>
                <div class="actions">
                    @if (entry.State == LibraryRecordState.Recycled)
                    {
                        <button disabled="@_isBusy" @onclick="() => BeginRestore([entry.Reference])">@Strings["Restore"]</button>
                    }
                    <button class="danger" disabled="@_isBusy" @onclick="() => BeginDelete([entry.Reference])">@(entry.State == LibraryRecordState.PendingPermanentDeletion ? Strings["RetryPermanentDeletion"] : Strings["DeletePermanently"])</button>
                </div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<RecycleBinEntry> _entries = [];
    private readonly HashSet<RecycleBinItemReference> _selected = [];
    private IReadOnlyList<RecycleBinEntry> _pendingEntries = [];
    private IReadOnlyList<RecycleBinOperationItemResult> _failures = [];
    private RecycleBinRestorePreview _restorePreview = new([]);
    private RecycleBinAction? _pendingAction;
    private string _search = string.Empty;
    private string _category = "all";
    private string _sort = "deleted-desc";
    private string? _message;
    private bool _isBusy;

    private enum RecycleBinAction { Restore, Delete, Empty }

    private IReadOnlyList<RecycleBinEntry> VisibleEntries
    {
        get
        {
            IEnumerable<RecycleBinEntry> query = _entries;
            query = _category switch
            {
                "folder" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.Folder),
                "file" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.File),
                "link" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.FileLink),
                "connection" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.Connection),
                "model" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.Model),
                "savedsetting" => query.Where(entry => entry.Reference.Kind == RecycleBinItemKind.SavedSetting),
                _ => query
            };
            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(entry => entry.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || entry.OriginalLocation.Contains(_search, StringComparison.OrdinalIgnoreCase));
            }
            query = _sort switch
            {
                "deleted-asc" => query.OrderBy(entry => entry.RecycledAt),
                "name-asc" => query.OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase),
                "name-desc" => query.OrderByDescending(entry => entry.Name, StringComparer.OrdinalIgnoreCase),
                "type" => query.OrderBy(entry => entry.Reference.Kind).ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase),
                _ => query.OrderByDescending(entry => entry.RecycledAt)
            };
            return query.ToArray();
        }
    }

    private int SelectedRestorableCount => _entries.Count(entry => _selected.Contains(entry.Reference) && entry.State == LibraryRecordState.Recycled);
    private string ConfirmationTitle => _pendingAction switch { RecycleBinAction.Restore => Strings["RestoreSelectedItemsQuestion"], RecycleBinAction.Empty => Strings["EmptyRecycleBinQuestion"], _ => Strings["PermanentlyDeleteSelectedItemsQuestion"] };
    private string ConfirmationMessage => _pendingAction == RecycleBinAction.Restore
        ? Strings["RestoreReviewMessage"]
        : Strings["PermanentDeletionWarning"];
    private string ConfirmationButtonLabel => _pendingAction switch { RecycleBinAction.Restore => Strings["RestoreItemCount", _restorePreview.RestorableCount], RecycleBinAction.Empty => Strings["EmptyRecycleBin"], _ => Strings["DeletePermanently"] };

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (LibraryState.Workspace is null) return;
        _entries = await LibraryState.Workspace.GetRecycleBinEntriesAsync();
        _selected.IntersectWith(_entries.Select(entry => entry.Reference));
    }

    private void ToggleSelection(RecycleBinItemReference reference, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true) _selected.Add(reference); else _selected.Remove(reference);
    }

    private void SelectVisible() => _selected.UnionWith(VisibleEntries.Select(entry => entry.Reference));
    private void ClearSelection() => _selected.Clear();
    private Task BeginRestoreSelected() => BeginRestore(_selected);
    private void BeginDeleteSelected() => BeginDelete(_selected);
    private void BeginEmpty() => BeginAction(RecycleBinAction.Empty, _entries);

    private async Task BeginRestore(IEnumerable<RecycleBinItemReference> references)
    {
        var selected = references.ToHashSet();
        var entries = _entries.Where(entry => selected.Contains(entry.Reference) && entry.State == LibraryRecordState.Recycled).ToArray();
        if (entries.Length == 0 || LibraryState.Workspace is null) return;
        _isBusy = true;
        try
        {
            _restorePreview = await LibraryState.Workspace.GetRecycleBinRestorePreviewAsync(entries.Select(entry => entry.Reference).ToArray());
            BeginAction(RecycleBinAction.Restore, entries);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void BeginDelete(IEnumerable<RecycleBinItemReference> references)
    {
        var selected = references.ToHashSet();
        BeginAction(RecycleBinAction.Delete, _entries.Where(entry => selected.Contains(entry.Reference)));
    }

    private void BeginAction(RecycleBinAction action, IEnumerable<RecycleBinEntry> entries)
    {
        var snapshot = entries.ToArray();
        if (snapshot.Length == 0) return;
        _pendingAction = action;
        _pendingEntries = snapshot;
        _message = null;
        _failures = [];
    }

    private void CancelPendingAction()
    {
        _pendingAction = null;
        _pendingEntries = [];
        _restorePreview = new([]);
    }

    private async Task ConfirmPendingActionAsync()
    {
        if (_pendingAction is null || LibraryState.Workspace is null) return;
        _isBusy = true;
        try
        {
            var workspace = LibraryState.Workspace;
            var libraryId = workspace.Descriptor.LibraryId;
            var connectionLedgers = new Dictionary<string, CredentialLedgerConnectionSnapshot>(StringComparer.Ordinal);
            if (_pendingAction != RecycleBinAction.Restore)
            {
                var connectionIds = _pendingEntries.Where(entry => entry.Reference.Kind == RecycleBinItemKind.Connection)
                    .Select(entry => entry.Reference.Id).ToHashSet(StringComparer.Ordinal);
                if (connectionIds.Count > 0)
                {
                    foreach (var snapshot in await workspace.GetCredentialLedgerSnapshotAsync())
                    {
                        if (connectionIds.Contains(snapshot.ConnectionId)) connectionLedgers[snapshot.ConnectionId] = snapshot;
                    }
                }
            }

            var result = _pendingAction switch
            {
                RecycleBinAction.Restore => await workspace.RestoreRecycleBinItemsAsync(_restorePreview.Items.Where(item => item.CanRestore).Select(item => item.Entry.Reference).ToArray()),
                RecycleBinAction.Empty => await workspace.EmptyRecycleBinAsync(),
                _ => await workspace.PermanentlyDeleteRecycleBinItemsAsync(_pendingEntries.Select(entry => entry.Reference).ToArray())
            };

            foreach (var success in result.Items.Where(item => item.Succeeded && item.Reference.Kind == RecycleBinItemKind.Connection))
            {
                if (!connectionLedgers.TryGetValue(success.Reference.Id, out var ledger)) continue;
                try
                {
                    foreach (var revision in ledger.Revisions)
                    {
                        if (revision.Purpose == CredentialRevisionPurpose.Active) await Credentials.RemoveActiveAsync(libraryId, success.Reference.Id, revision.RevisionId);
                        else await Credentials.RemoveCandidateAsync(libraryId, success.Reference.Id, revision.RevisionId);
                    }
                    await Credentials.RemoveLegacyAsync(libraryId, success.Reference.Id);
                }
                catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
                {
                    // Best-effort: the connection's DB rows are already gone and cannot be rolled back
                    // here. A leftover secure-storage entry is harmless (never referenced again), and
                    // this is isolated per connection so one failure doesn't block cleanup for the rest
                    // of the batch (e.g. Empty Recycle Bin deleting several connections at once).
                }
            }

            foreach (var success in result.Items.Where(item => item.Succeeded)) _selected.Remove(success.Reference);
            _failures = result.Items.Where(item => !item.Succeeded).ToArray();
            _message = result.FailedCount == 0
                ? Strings["ItemsProcessedSuccessfully", result.SucceededCount]
                : Strings["ItemsProcessedWithFailures", result.SucceededCount, result.FailedCount];
        }
        finally
        {
            _isBusy = false;
            _pendingAction = null;
            _pendingEntries = [];
            _restorePreview = new([]);
            await ReloadAsync();
        }
    }

    private string KindName(RecycleBinItemKind kind) => kind switch
    {
        RecycleBinItemKind.Folder => Strings["Folder"],
        RecycleBinItemKind.File => Strings["File"],
        RecycleBinItemKind.FileLink => Strings["FileLink"],
        RecycleBinItemKind.Connection => Strings["Connection"],
        RecycleBinItemKind.Model => Strings["Model"],
        _ => Strings["SavedSetting"]
    };
    private string StateName(LibraryRecordState state) => state == LibraryRecordState.PendingPermanentDeletion ? Strings["PendingPermanentDeletion"] : Strings["Recycled"];
    private string EntryCascadeSummary(RecycleBinEntry entry) => entry.Reference.Kind switch
    {
        RecycleBinItemKind.Connection => Strings["CascadeSummaryConnection", entry.OwnedModelCount, entry.OwnedSavedSettingCount],
        RecycleBinItemKind.Model => Strings["CascadeSummaryModel", entry.OwnedSavedSettingCount],
        RecycleBinItemKind.SavedSetting => Strings["NoDependents"],
        _ => Strings["CascadeSummary", entry.OwnedFolderCount, entry.OwnedFileCount, entry.OwnedLinkCount]
    };
    private string CascadeSummary(IEnumerable<RecycleBinEntry> entries)
    {
        var snapshot = entries.ToArray();
        var segments = new List<string>();
        var folders = snapshot.Sum(entry => entry.OwnedFolderCount);
        var files = snapshot.Sum(entry => entry.OwnedFileCount);
        var links = snapshot.Sum(entry => entry.OwnedLinkCount);
        if (folders > 0 || files > 0 || links > 0) segments.Add(Strings["CascadeSummary", folders, files, links]);
        var models = snapshot.Sum(entry => entry.OwnedModelCount);
        var savedSettings = snapshot.Sum(entry => entry.OwnedSavedSettingCount);
        if (models > 0 || savedSettings > 0) segments.Add(Strings["CascadeSummaryConnection", models, savedSettings]);
        return segments.Count == 0 ? Strings["CascadeSummary", 0, 0, 0] : string.Join(' ', segments);
    }
}
