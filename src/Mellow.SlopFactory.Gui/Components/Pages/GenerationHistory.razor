@page "/generation-history"
@inject AppLibraryState LibraryState
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["GenerationHistoryPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["GenerateEyebrow"]</p><h1>@Strings["GenerationHistoryHeading"]</h1><p class="muted">@Strings["GenerationHistoryDescription"]</p></div>
</header>

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_records.Count == 0)
{
    <p class="empty">@Strings["NoGenerationHistory"]</p>
}
else
{
    <section class="panel">
        <div class="inline-form">
            <label for="history-status-filter">@Strings["FilterByStatus"]
                <select id="history-status-filter" @bind="_statusFilter">
                    <option value="">@Strings["All"]</option>
                    <option value="@GenerationStatus.Completed">@Strings["GenerationCompleted"]</option>
                    <option value="@GenerationStatus.Failed">@Strings["GenerationFailed"]</option>
                    <option value="@GenerationStatus.PartiallyCompleted">@Strings["GenerationPartiallyCompleted"]</option>
                </select>
            </label>
            <label for="history-mode-filter">@Strings["FilterByMode"]
                <select id="history-mode-filter" @bind="_modeFilter">
                    <option value="">@Strings["All"]</option>
                    <option value="@GenerationMode.Text">@Strings["ModeText"]</option>
                    <option value="@GenerationMode.Image">@Strings["ModeImage"]</option>
                </select>
            </label>
            <label for="history-model-filter">@Strings["FilterByModel"]
                <select id="history-model-filter" @bind="_modelFilter">
                    <option value="">@Strings["All"]</option>
                    @foreach (var modelLabel in _knownModelLabels)
                    {
                        <option value="@modelLabel">@modelLabel</option>
                    }
                </select>
            </label>
            <label for="history-provider-filter">@Strings["FilterByProvider"]
                <select id="history-provider-filter" @bind="_providerFilter">
                    <option value="">@Strings["All"]</option>
                    <option value="@ProviderType.OpenAi">@Strings["ProviderOpenAi"]</option>
                    <option value="@ProviderType.GenericOpenAiCompatible">@Strings["ProviderGenericOpenAiCompatible"]</option>
                    <option value="@ProviderType.OpenRouter">@Strings["ProviderOpenRouter"]</option>
                    <option value="@ProviderType.DeepInfra">@Strings["ProviderDeepInfra"]</option>
                </select>
            </label>
            <label for="history-date-from-filter">@Strings["FilterByDateFrom"]
                <input id="history-date-from-filter" type="date" @bind="_dateFromFilter" />
            </label>
            <label for="history-date-to-filter">@Strings["FilterByDateTo"]
                <input id="history-date-to-filter" type="date" @bind="_dateToFilter" />
            </label>
            <button type="button" class="secondary" @onclick="ClearFilters">@Strings["ClearSearchAndFilters"]</button>
        </div>
    </section>

    @if (FilteredRecords.Count == 0)
    {
        <p class="empty">@Strings["NoFilteredGenerationHistory"]</p>
    }
    else
    {
        <ul class="metadata-list">
            @foreach (var record in FilteredRecords)
            {
                <li>
                    <div>
                        <strong>@record.ModelLabel</strong>
                        <small>@Strings["GenerationRecordSummary", StatusLabel(record.Status), record.CreatedAt.ToLocalTime().ToString("g"), record.ResultFileIds.Count]</small>
                    </div>
                    <p>@record.Prompt</p>
                    <div class="actions">
                        <a class="button" href="@($"/generation-history/{record.Id}")">@Strings["ViewDetails"]</a>
                        <a class="ghost" href="@($"/generate/history/{record.Id}")">@Strings["UseAgain"]</a>
                        @if (_recycleCandidate == record.Id)
                        {
                            <span role="dialog" aria-label="@Strings["ConfirmRecycleGenerationRecord"]">
                                <span>@Strings["RecycleGenerationRecordWarning"]</span>
                                <button class="danger" disabled="@_busy" @onclick="() => RecycleAsync(record.Id)">@Strings["Recycle"]</button>
                                <button class="secondary" disabled="@_busy" @onclick="() => _recycleCandidate = null">@Strings["Cancel"]</button>
                            </span>
                        }
                        else
                        {
                            <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleCandidate = record.Id">@Strings["Recycle"]</button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    <p class="muted">@Strings["RecycledItemsMovedToBin"] <a class="ghost" href="/recycle-bin">@Strings["NavRecycleBin"]</a></p>
}

@if (LibraryState.Workspace is not null && _improvementRecords.Count > 0)
{
    <section class="panel">
        <h2>@Strings["PromptImprovementHistoryHeading"]</h2>
        <p class="muted">@Strings["PromptImprovementHistoryDescription"]</p>
        <ul class="metadata-list">
            @foreach (var record in _improvementRecords)
            {
                <li>
                    <div>
                        <strong>@record.ModelLabel</strong>
                        <small>@Strings["GenerationRecordSummary", StatusLabel(record.Status), record.CreatedAt.ToLocalTime().ToString("g"), record.Candidates.Count]</small>
                    </div>
                    <p>@record.RawPrompt</p>
                    @if (!string.IsNullOrEmpty(record.Guidance))
                    {
                        <p class="muted">@Strings["ImprovementGuidance"]: @record.Guidance</p>
                    }
                    @if (record.ErrorMessage is not null)
                    {
                        <p class="error">@record.ErrorMessage</p>
                    }
                    @if (record.PromptTokens is not null || record.CompletionTokens is not null)
                    {
                        <p class="muted">@Strings["TokenUsage", record.PromptTokens?.ToString() ?? Strings["Unknown"], record.CompletionTokens?.ToString() ?? Strings["Unknown"]]</p>
                    }
                    @if (record.Candidates.Count > 0)
                    {
                        <details>
                            <summary>@Strings["ShowImprovementCandidates", record.Candidates.Count]</summary>
                            <ul class="metadata-list">
                                @foreach (var candidate in record.Candidates)
                                {
                                    <li>@candidate</li>
                                }
                            </ul>
                        </details>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    private IReadOnlyList<GenerationRecord> _records = [];
    private IReadOnlyList<PromptImprovementRecord> _improvementRecords = [];
    private string _statusFilter = string.Empty;
    private string _modeFilter = string.Empty;
    private string _modelFilter = string.Empty;
    private string _providerFilter = string.Empty;
    private DateOnly? _dateFromFilter;
    private DateOnly? _dateToFilter;
    private string? _recycleCandidate;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _records = await workspace.GetGenerationHistoryAsync();
        _improvementRecords = await workspace.GetPromptImprovementHistoryAsync();
    }

    private async Task RecycleAsync(string generationId)
    {
        if (LibraryState.Workspace is null) return;
        _busy = true;
        try
        {
            await LibraryState.Workspace.RecycleGenerationRecordAsync(generationId);
            _recycleCandidate = null;
            _records = await LibraryState.Workspace.GetGenerationHistoryAsync();
        }
        finally { _busy = false; }
    }

    private IReadOnlyList<string> _knownModelLabels => _records.Select(record => record.ModelLabel).Distinct(StringComparer.Ordinal).OrderBy(label => label, StringComparer.Ordinal).ToArray();

    private IReadOnlyList<GenerationRecord> FilteredRecords => _records
        .Where(record => string.IsNullOrEmpty(_statusFilter) || record.Status.ToString() == _statusFilter)
        .Where(record => string.IsNullOrEmpty(_modeFilter) || record.Mode.ToString() == _modeFilter)
        .Where(record => string.IsNullOrEmpty(_modelFilter) || string.Equals(record.ModelLabel, _modelFilter, StringComparison.Ordinal))
        .Where(record => string.IsNullOrEmpty(_providerFilter) || record.ProviderType.ToString() == _providerFilter)
        .Where(record => _dateFromFilter is not { } from || DateOnly.FromDateTime(record.CreatedAt.ToLocalTime().DateTime) >= from)
        .Where(record => _dateToFilter is not { } to || DateOnly.FromDateTime(record.CreatedAt.ToLocalTime().DateTime) <= to)
        .ToArray();

    private void ClearFilters()
    {
        _statusFilter = string.Empty;
        _modeFilter = string.Empty;
        _modelFilter = string.Empty;
        _providerFilter = string.Empty;
        _dateFromFilter = null;
        _dateToFilter = null;
    }

    private string StatusLabel(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => Strings["GenerationCompleted"],
        GenerationStatus.Failed => Strings["GenerationFailed"],
        GenerationStatus.PartiallyCompleted => Strings["GenerationPartiallyCompleted"],
        _ => status.ToString()
    };
}
