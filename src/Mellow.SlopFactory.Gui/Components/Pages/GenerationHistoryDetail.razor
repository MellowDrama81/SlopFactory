@page "/generation-history/{Id}"
@implements IDisposable
@inject AppLibraryState LibraryState
@inject GenerationNotificationCoordinator NotificationCoordinator
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["GenerationHistoryDetailPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["GenerateEyebrow"]</p><h1>@Strings["GenerationHistoryDetailHeading"]</h1></div>
    <a class="button" href="/generation-history">@Strings["BackToGenerationHistory"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice error" role="alert">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_record is not null)
{
    <section class="panel">
        <div>
            <strong>@_record.ModelLabel</strong>
            <small>@Strings["GenerationRecordSummary", StatusLabel(_record.Status), _record.CreatedAt.ToLocalTime().ToString("g"), _record.ResultFileIds.Count]</small>
        </div>
        <p>@_record.Prompt</p>
        @if (!string.IsNullOrEmpty(_record.SystemInstructions))
        {
            <details>
                <summary>@Strings["ShowSystemInstructions"]</summary>
                <p>@_record.SystemInstructions</p>
            </details>
        }
        @if (_record.Status == GenerationStatus.PartiallyCompleted)
        {
            <p class="muted">@Strings["GenerationPartiallyCompletedDetail", _record.ResultFileIds.Count, _record.ResultCount]</p>
        }
        @if (_record.ErrorMessage is not null)
        {
            <p class="error">@_record.ErrorMessage</p>
        }
        @if (_record.PromptTokens is not null || _record.CompletionTokens is not null)
        {
            <p class="muted">@Strings["TokenUsage", _record.PromptTokens?.ToString() ?? Strings["Unknown"], _record.CompletionTokens?.ToString() ?? Strings["Unknown"]]</p>
        }
        @if (_record.PromptImprovementRecordId is not null)
        {
            <p class="muted">@Strings["PromptImprovementUsed"]</p>
        }
        @if (_record.SourceFileId is null && _record.SourceFileTombstone is { } sourceTombstone)
        {
            <p class="muted">@Strings["SourceFilePermanentlyDeleted", sourceTombstone.DisplayName, sourceTombstone.MediaType]</p>
        }
        <div class="actions">
            <a class="button" href="@($"/generate/history/{_record.Id}")">@Strings["UseAgain"]</a>
            @if (_record.SourceFileId is not null)
            {
                <a class="ghost" href="@($"/file/{_record.SourceFileId}")">@Strings["SourceImageUsed"]</a>
            }
            @if (_record.State == LibraryRecordState.Active)
            {
                @if (_recycleConfirm)
                {
                    <span role="dialog" aria-label="@Strings["ConfirmRecycleGenerationRecord"]">
                        <span>@Strings["RecycleGenerationRecordWarning"]</span>
                        <button class="danger" disabled="@_busy" @onclick="RecycleAsync">@Strings["Recycle"]</button>
                        <button class="secondary" disabled="@_busy" @onclick="() => _recycleConfirm = false">@Strings["Cancel"]</button>
                    </span>
                }
                else
                {
                    <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleConfirm = true">@Strings["Recycle"]</button>
                }
            }
        </div>
        @if (_record.ResultFileIds.Count > 0 || _record.TombstonedResults.Count > 0)
        {
            <ul class="metadata-list">
                @foreach (var fileId in _record.ResultFileIds)
                {
                    <li><a href="@($"/file/{fileId}")">@Strings["OpenGeneratedFile"]</a></li>
                }
                @foreach (var tombstone in _record.TombstonedResults)
                {
                    <li>@Strings["ResultFilePermanentlyDeleted", tombstone.DisplayName, tombstone.MediaType]</li>
                }
            </ul>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private GenerationRecord? _record;
    private string? _message;
    private bool _recycleConfirm;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        NotificationCoordinator.VisibleGenerationRecordId = Id;
        await LibraryState.InitializeAsync();
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        try
        {
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
    }

    public void Dispose() => NotificationCoordinator.VisibleGenerationRecordId = null;

    private async Task RecycleAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _busy = true;
        try
        {
            await workspace.RecycleGenerationRecordAsync(Id);
            _recycleConfirm = false;
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private string StatusLabel(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => Strings["GenerationCompleted"],
        GenerationStatus.Failed => Strings["GenerationFailed"],
        GenerationStatus.PartiallyCompleted => Strings["GenerationPartiallyCompleted"],
        _ => status.ToString()
    };
}
