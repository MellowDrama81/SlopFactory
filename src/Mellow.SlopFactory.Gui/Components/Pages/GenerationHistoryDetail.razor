@page "/generation-history/{Id}"
@implements IDisposable
@inject AppLibraryState LibraryState
@inject GenerationNotificationCoordinator NotificationCoordinator
@inject GenerationQueueService Queue
@inject NavigationManager Navigation
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["GenerationHistoryDetailPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["GenerateEyebrow"]</p><h1>@Strings["GenerationHistoryDetailHeading"]</h1></div>
    <a class="button" href="/generation-history">@Strings["BackToGenerationHistory"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice error" role="alert">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_record is not null)
{
    <section class="panel">
        <div>
            <strong>@_record.ModelLabel</strong>
            <small>@Strings["GenerationRecordSummary", StatusLabel(_record.Status), _record.CreatedAt.ToLocalTime().ToString("g"), _record.ResultFileIds.Count]</small>
        </div>
        <p>@_record.Prompt</p>
        @if (!string.IsNullOrEmpty(_record.SystemInstructions))
        {
            <details>
                <summary>@Strings["ShowSystemInstructions"]</summary>
                <p>@_record.SystemInstructions</p>
            </details>
        }
        @if (_record.Status == GenerationStatus.PartiallyCompleted)
        {
            <p class="muted">@Strings["GenerationPartiallyCompletedDetail", _record.ResultFileIds.Count, _record.ResultCount]</p>
        }
        @if (_record.Results.Any(entry => entry.Status is GenerationResultStatus.Failed or GenerationResultStatus.PendingReview))
        {
            <details open>
                <summary>@Strings["PerResultStatusHeading"]</summary>
                <ul class="metadata-list">
                    @foreach (var entry in _record.Results.OrderBy(candidate => candidate.Position))
                    {
                        <li>
                            @Strings["ResultPositionLabel", entry.Position + 1]: @(entry.Status switch { GenerationResultStatus.Committed => Strings["ResultCommitted"], GenerationResultStatus.PendingReview => Strings["ResultPendingReview"], _ => Strings["ResultFailed"] })
                            @if (entry.ErrorMessage is not null)
                            {
                                <span class="muted"> — @entry.ErrorMessage</span>
                            }
                            @if (entry.Status == GenerationResultStatus.PendingReview && _record.State == LibraryRecordState.Active)
                            {
                                <div class="actions">
                                    <button type="button" class="secondary" disabled="@_busy" @onclick="() => RetainUnverifiedResultAsync(entry.Position)">@Strings["RetainAsUnverifiedBinary"]</button>
                                    <button type="button" class="ghost danger" disabled="@_busy" @onclick="() => DiscardUnverifiedResultAsync(entry.Position)">@Strings["DiscardUnverifiedResult"]</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
        @if (_record.SafetyBlockedCount > 0)
        {
            <p class="muted">@Strings["SafetyBlockedResultsDetail", _record.SafetyBlockedCount]</p>
        }
        @if (_record.ErrorMessage is not null)
        {
            <p class="error">@_record.ErrorMessage</p>
        }
        @if (_record.PromptTokens is not null || _record.CompletionTokens is not null)
        {
            <p class="muted">@Strings["TokenUsage", _record.PromptTokens?.ToString() ?? Strings["Unknown"], _record.CompletionTokens?.ToString() ?? Strings["Unknown"]]</p>
        }
        @if (_record.ActualCost is not null)
        {
            <p class="muted">@Strings["ActualCost", _record.ActualCost.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture), _record.ActualCostCurrency ?? Strings["Unknown"]]</p>
        }
        @if (_record.PromptImprovementRecordId is not null)
        {
            <p class="muted">@Strings["PromptImprovementUsed"]</p>
        }
        @{ var sourceSlots = SourceSlots(); }
        @if (sourceSlots.Count > 0)
        {
            <ul class="metadata-list">
                @foreach (var slot in sourceSlots)
                {
                    @if (slot.FileId is not null)
                    {
                        <li><a href="@($"/file/{slot.FileId}")">@Strings["SourceImageSlotUsed", slot.Position]</a></li>
                    }
                    else if (slot.Tombstone is { } tombstone)
                    {
                        <li>@Strings["SourceFilePermanentlyDeletedSlot", slot.Position, tombstone.DisplayName, tombstone.MediaType]</li>
                    }
                }
            </ul>
        }
        <div class="actions">
            <a class="button" href="@($"/generate/history/{_record.Id}")">@Strings["UseAgain"]</a>
            @if (_record.State == LibraryRecordState.Active && _record.Results.Any(entry => entry.Status == GenerationResultStatus.Failed))
            {
                <button type="button" class="secondary" disabled="@_busy" @onclick="RetryFailedResultsOnlyAsync">@Strings["RetryFailedResultsOnly", _record.Results.Count(entry => entry.Status == GenerationResultStatus.Failed)]</button>
            }
            @if (_record.State == LibraryRecordState.Active)
            {
                @if (_recycleConfirm)
                {
                    <span role="dialog" aria-label="@Strings["ConfirmRecycleGenerationRecord"]">
                        <span>@Strings["RecycleGenerationRecordWarning"]</span>
                        <button class="danger" disabled="@_busy" @onclick="RecycleAsync">@Strings["Recycle"]</button>
                        <button class="secondary" disabled="@_busy" @onclick="() => _recycleConfirm = false">@Strings["Cancel"]</button>
                    </span>
                }
                else
                {
                    <button class="ghost danger" disabled="@_busy" @onclick="() => _recycleConfirm = true">@Strings["Recycle"]</button>
                }
            }
        </div>
        @if (_record.ResultFileIds.Count > 0 || _record.TombstonedResults.Count > 0)
        {
            <ul class="metadata-list">
                @foreach (var fileId in _record.ResultFileIds)
                {
                    <li><a href="@($"/file/{fileId}")">@Strings["OpenGeneratedFile"]</a></li>
                }
                @foreach (var tombstone in _record.TombstonedResults)
                {
                    <li>@Strings["ResultFilePermanentlyDeleted", tombstone.DisplayName, tombstone.MediaType]</li>
                }
            </ul>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private GenerationRecord? _record;
    private string? _message;
    private bool _recycleConfirm;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        NotificationCoordinator.VisibleGenerationRecordId = Id;
        await LibraryState.InitializeAsync();
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        try
        {
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
    }

    public void Dispose() => NotificationCoordinator.VisibleGenerationRecordId = null;

    private async Task RecycleAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        _busy = true;
        try
        {
            await workspace.RecycleGenerationRecordAsync(Id);
            _recycleConfirm = false;
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Submits a new, independent run covering only the positions that failed or were never
    /// attempted — the original request's immutable snapshot is never edited in place, matching
    /// plan.md's rule that a submitted request can only be replaced by a new run with its own
    /// history ID. Uses a synthetic draft ID scoped to this record rather than a real
    /// <c>GenerationDraft</c>, since a history record does not know which draft originally
    /// submitted it (or whether that draft still exists) and this retry never needs one.
    /// </summary>
    private async Task RetryFailedResultsOnlyAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _record is null || _record.ModelId is null) return;
        _busy = true;
        try
        {
            var failedCount = _record.Results.Count(entry => entry.Status == GenerationResultStatus.Failed);
            if (failedCount == 0) return;

            var models = await workspace.GetActiveModelsAsync();
            var model = models.FirstOrDefault(candidate => candidate.Id == _record.ModelId);
            if (model is null)
            {
                _message = Strings["RetryModelUnavailable"];
                return;
            }
            var connections = await workspace.GetActiveConnectionsAsync();
            var connection = connections.FirstOrDefault(candidate => candidate.Id == model.ConnectionId);
            if (connection is null)
            {
                _message = Strings["RetryConnectionUnavailable"];
                return;
            }

            var snapshot = new GenerationJobSnapshot(
                DraftId: $"retry-{_record.Id}",
                SubmittedTabTitle: Strings["RetryTabTitle", model.Label].Value,
                Mode: model.Mode,
                ModelId: model.Id,
                Prompt: _record.Prompt,
                SystemInstructions: _record.SystemInstructions,
                SourceFileId: _record.SourceFileId,
                ResultCount: failedCount,
                DestinationFolderId: _record.DestinationFolderId,
                AcceptedImprovementRecordId: null,
                Settings: _record.Settings,
                SecondarySourceFileId: _record.SecondarySourceFileId,
                TertiarySourceFileId: _record.TertiarySourceFileId);
            Queue.Enqueue(snapshot, connection.Id);
            Navigation.NavigateTo("/queue");
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task RetainUnverifiedResultAsync(int position)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _record is null) return;
        _busy = true;
        try
        {
            await workspace.RetainUnverifiedResultAsync(_record.Id, position);
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task DiscardUnverifiedResultAsync(int position)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _record is null) return;
        _busy = true;
        try
        {
            await workspace.DiscardUnverifiedResultAsync(_record.Id, position);
            _record = await workspace.GetGenerationRecordAsync(Id);
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private string StatusLabel(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => Strings["GenerationCompleted"],
        GenerationStatus.Failed => Strings["GenerationFailed"],
        GenerationStatus.PartiallyCompleted => Strings["GenerationPartiallyCompleted"],
        GenerationStatus.Cancelled => Strings["GenerationCancelled"],
        GenerationStatus.CancelledWithResults => Strings["GenerationCancelledWithResults"],
        _ => status.ToString()
    };

    private sealed record SourceSlotView(int Position, string? FileId, FileIdentitySnapshot? Tombstone);

    private IReadOnlyList<SourceSlotView> SourceSlots()
    {
        if (_record is null) return [];
        SourceSlotView[] slots =
        [
            new(1, _record.SourceFileId, _record.SourceFileId is null ? _record.SourceFileTombstone : null),
            new(2, _record.SecondarySourceFileId, _record.SecondarySourceFileId is null ? _record.SecondarySourceFileTombstone : null),
            new(3, _record.TertiarySourceFileId, _record.TertiarySourceFileId is null ? _record.TertiarySourceFileTombstone : null)
        ];
        return slots.Where(slot => slot.FileId is not null || slot.Tombstone is not null).ToList();
    }
}
