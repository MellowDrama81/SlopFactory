@page "/library-settings"
@implements IDisposable
@inject AppLibraryState LibraryState
@inject ILibraryLocationService Locations
@inject PreviewCacheService PreviewCache
@inject IRecentLibraryService RecentLibraries
@inject IThemePreferenceService Theme
@inject GenerationQueueService Queue
@inject GenerationNotificationCoordinator NotificationCoordinator
@inject IntegrityScanRecommendationService ScanRecommendation
@inject IPlatformFileActionService PlatformFiles
@inject IRecoveryStagingService RecoveryStaging
@inject IDiagnosticsLogger Diagnostics
@inject IWindowsExitCoordinator ExitCoordinator
@inject IStringLocalizer<UiStrings> Strings
@using Mellow.SlopFactory.Application
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["LibrarySettingsPageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["LocalStorage"]</p><h1>@Strings["LibrarySettingsHeading"]</h1><p class="muted">@Strings["LibrarySettingsDescription"]</p></div>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

<section class="panel">
    <h2>@Strings["Appearance"]</h2>
    <label for="theme-preference">@Strings["Theme"]</label>
    <select id="theme-preference" value="@Theme.Preference" @onchange="ChangeTheme">
        <option value="@ThemePreference.System">@Strings["FollowSystem"]</option>
        <option value="@ThemePreference.Light">@Strings["Light"]</option>
        <option value="@ThemePreference.Dark">@Strings["Dark"]</option>
    </select>
</section>

<section class="panel">
    <h2>@Strings["GenerationQueueSettingsHeading"]</h2>
    <p class="muted">@Strings["DeviceWideSubmissionCapHelp"]</p>
    <EditForm Model="_queueCapForm" OnValidSubmit="SaveDeviceCap" class="inline-form">
        <label for="device-cap">@Strings["DeviceWideSubmissionCap"]</label>
        <InputNumber id="device-cap" @bind-Value="_queueCapForm.Value" min="@GenerationQueueService.MinDeviceCap" max="@GenerationQueueService.MaxDeviceCap" />
        <button type="submit">@Strings["SaveDeviceCap"]</button>
    </EditForm>
    <p class="muted">@Strings["MeteredNetworkPolicyHelp"]</p>
    <label for="metered-network-policy">@Strings["MeteredNetworkPolicy"]</label>
    <select id="metered-network-policy" value="@Queue.MeteredNetworkPolicy" @onchange="ChangeMeteredNetworkPolicy">
        <option value="@MeteredNetworkTransferPolicy.Allow">@Strings["MeteredNetworkAllow"]</option>
        <option value="@MeteredNetworkTransferPolicy.Ask">@Strings["MeteredNetworkAsk"]</option>
        <option value="@MeteredNetworkTransferPolicy.WifiOnly">@Strings["MeteredNetworkWifiOnly"]</option>
    </select>
</section>

<section class="panel">
    <h2>@Strings["GenerationNotificationsHeading"]</h2>
    <p class="muted">@Strings["GenerationNotificationsHelp"]</p>
    <label><input type="checkbox" checked="@NotificationCoordinator.Enabled" @onchange="ToggleNotificationsAsync" /> @Strings["EnableGenerationNotifications"]</label>
</section>

<section class="panel">
    <h2>@Strings["ActiveLibrary"]</h2>
    <dl>
        <dt>@Strings["Name"]</dt><dd>@(LibraryState.Workspace?.Descriptor.DisplayName ?? Strings["Unavailable"])</dd>
        <dt>@Strings["Location"]</dt><dd class="mono">@(LibraryState.ActivePath ?? Strings["NoLocationOpen"])</dd>
    </dl>
    @if (LibraryState.Workspace is null && LibraryState.ActivePath is not null) { <button class="secondary" disabled="@_busy" @onclick="RetryActiveLibraryAsync">@Strings["RetryRememberedLibrary"]</button> }

    @if (LibraryState.Workspace is not null)
    {
        <EditForm Model="_nameForm" OnValidSubmit="RenameAsync" class="inline-form">
            <label for="library-name">@Strings["LibraryName"]</label>
            <InputText id="library-name" @bind-Value="_nameForm.Name" maxlength="255" />
            <button type="submit" disabled="@(_busy || _scanning)">@Strings["RenameLibrary"]</button>
        </EditForm>
        @if (OperatingSystem.IsWindows())
        {
            @if (!_confirmOpenLocation)
            {
                <button class="secondary" disabled="@(_busy || _scanning)" @onclick="() => _confirmOpenLocation = true">@Strings["OpenLibraryLocation"]</button>
            }
            else
            {
                <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmOpenLibraryLocation"]">
                    <span>@Strings["ManagedDirectoryWarning"]</span>
                    <button class="secondary" @onclick="OpenLibraryLocationAsync">@Strings["OpenLocation"]</button>
                    <button class="secondary" @onclick="() => _confirmOpenLocation = false">Cancel</button>
                </div>
            }
        }
    }

    <EditForm Model="_form" OnValidSubmit="SwitchAsync" class="stack-form">
        @if (OperatingSystem.IsAndroid())
        {
            <label for="library-location">@Strings["AppSpecificStorageLocation"]</label>
            <InputSelect id="library-location" @bind-Value="_form.Path">
                @foreach (var location in _availableLocations)
                {
                    <option value="@location.Path">@location.Label</option>
                }
            </InputSelect>
        }
        else
        {
            <label for="library-location">@Strings["AbsoluteLocalDirectory"]</label>
            <InputText id="library-location" @bind-Value="_form.Path" />
        }
        <p class="muted">@Strings["LibraryLocationGuidance"]</p>
        <button type="submit" disabled="@(_busy || _scanning)">@(_busy ? Strings["SwitchingLibrary"] : Strings["OpenThisLibrary"])</button>
    </EditForm>
    @if (_adoptCandidatePath is not null)
    {
        <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmAdoptCopiedLibrary"]">
            <span>@Strings["AdoptCopiedLibraryWarning"]</span>
            <button class="danger" disabled="@_busy" @onclick="ConfirmAdoptionAsync">@Strings["AdoptCopiedLibrary"]</button>
            <button class="secondary" disabled="@_busy" @onclick="() => _adoptCandidatePath = null">Cancel</button>
        </div>
    }
    @if (_cloudSyncCandidatePath is not null)
    {
        <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmCloudLibraryLocation"]">
            <span>@Strings["CloudLibraryWarning"]</span>
            <button class="danger" disabled="@_busy" @onclick="ConfirmCloudLocationAsync">@Strings["UseThisLocation"]</button>
            <button class="secondary" disabled="@_busy" @onclick="() => _cloudSyncCandidatePath = null">Cancel</button>
        </div>
    }
</section>

@if (OperatingSystem.IsAndroid())
{
    <section class="panel">
        <h2>@Strings["AndroidStorage"]</h2><p>@Strings["AndroidStorageRetention"]</p><p class="muted">@Strings["AndroidStoragePermissions"]</p><button class="secondary" @onclick="PlatformFiles.OpenApplicationSettings">@Strings["OpenSystemSettings"]</button>
    </section>
}

<section class="panel">
    <h2>@Strings["RecentLibraries"]</h2><p class="muted">@Strings["RecentLibrariesGuidance"]</p>
    @if (_recentLibraries.Count == 0)
    {
        <p class="empty">@Strings["NoRememberedLibraries"]</p>
    }
    else
    {
        <ul class="metadata-list">
            @foreach (var library in _recentLibraries)
            {
                var active = IsActive(library);
                var available = IsAvailable(library);
                <li>
                    <div>
                        <strong>@library.DisplayName @(active ? Strings["ActiveSuffix"] : string.Empty)</strong><small>@Strings["RecentLibraryStatus", available ? Strings["Available"] : library.State == RememberedLibraryState.Corrupt ? Strings["CorruptLibraryStatus", library.FailureStage ?? string.Empty, library.DiagnosticId ?? string.Empty] : Strings["Unavailable"], library.LastOpenedAt.ToLocalTime().ToString("g")]</small>
                    </div>
                    <code>@library.Path</code>
                    <button class="ghost" disabled="@(active || !available || _busy || _scanning)" @onclick="() => OpenRecentAsync(library)">@Strings["Open"]</button>
                    @if (!available) { <button class="ghost" disabled="@(_busy || _scanning)" @onclick="() => RelinkRecentAsync(library)">@Strings["RelinkUsingLocation"]</button> }
                    @if (OperatingSystem.IsWindows() && library.State == RememberedLibraryState.Corrupt && Directory.Exists(library.Path)) { <button class="ghost" @onclick="() => OpenRememberedLocationAsync(library.Path)">@Strings["OpenLocation"]</button> }
                    <button class="ghost danger" disabled="@(active || HasActiveWork(library) || HasDirtyDrafts(library) || HasStagedResults(library) || _busy || _scanning)" @onclick="() => _forgetCandidate = library">@Strings["Forget"]</button>
                    @if (!active && HasActiveWork(library))
                    {
                        <small class="muted">@Strings["LibraryHasActiveWorkNotice"]</small>
                    }
                    @if (!active && !HasActiveWork(library) && (HasDirtyDrafts(library) || HasStagedResults(library)))
                    {
                        <small class="muted">@Strings["LibraryHasRecoveryDataNotice"]</small>
                        <button class="ghost danger" disabled="@_busy" @onclick="() => _forceForgetCandidate = library">@Strings["DeleteRecoveryDataAndForget"]</button>
                    }
                </li>
            }
        </ul>
    }
    <button class="secondary" disabled="@(_rebuildingPreviews || LibraryState.Workspace is null)" @onclick="RebuildPreviewsAsync">@(_rebuildingPreviews ? Strings["RebuildingPreviews"] : Strings["RebuildLibraryPreviews"])</button>
    @if (_previewRebuildProgress is not null) { <p class="muted" role="status">@Strings["RebuildPreviewProgress", _previewRebuildProgress.DisplayName, _previewRebuildProgress.ProcessedItems, _previewRebuildProgress.TotalItems]</p> }
    @if (_forgetCandidate is not null)
    {
        <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmForgetLibrary"]"><span>@Strings["ForgetLibraryWarning", _forgetCandidate.DisplayName]</span><button class="danger" @onclick="ForgetRecentAsync">@Strings["ForgetLibrary"]</button>
            <button class="secondary" @onclick="() => _forgetCandidate = null">@Strings["Cancel"]</button>
        </div>
    }
    @if (_forceForgetCandidate is not null)
    {
        <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmDeleteRecoveryDataAndForget"]"><span>@Strings["DeleteRecoveryDataAndForgetWarning", _forceForgetCandidate.DisplayName]</span><button class="danger" @onclick="ForceForgetRecentAsync">@Strings["DeleteRecoveryDataAndForget"]</button>
            <button class="secondary" @onclick="() => _forceForgetCandidate = null">@Strings["Cancel"]</button>
        </div>
    }
</section>

<section class="panel">
    <h2>@Strings["PreviewCache"]</h2><p class="muted">@Strings["PreviewCacheGuidance"]</p>
    @if (_cacheStatus is not null)
    {
        <p>@Strings["CacheUsage", FormatBytes(_cacheStatus.UseBytes), FormatBytes(_cacheStatus.LimitBytes)]</p>
    }
    <EditForm Model="_cacheForm" OnValidSubmit="SaveCacheLimitAsync" class="inline-form">
        <label for="cache-limit">@Strings["CacheLimitMib"]</label>
        <InputNumber id="cache-limit" @bind-Value="_cacheForm.LimitMiB" min="64" max="8192" />
        <button type="submit">@Strings["SaveCacheLimit"]</button>
    </EditForm>
    @if (!_confirmClearCache)
    {
        <button class="secondary" @onclick="() => _confirmClearCache = true">@Strings["ClearPreviewCache"]</button>
    }
    else
    {
        <div class="inline-form" role="dialog" aria-label="@Strings["ConfirmClearPreviewCache"]"><span>@Strings["ClearPreviewCacheWarning"]</span><button class="danger" @onclick="ClearCacheAsync">@Strings["ClearPreviews"]</button>
            <button class="secondary" @onclick="() => _confirmClearCache = false">@Strings["Cancel"]</button>
        </div>
    }
</section>

<section class="panel integrity-panel">
    <h2>@Strings["LibraryIntegrity"]</h2><p class="muted">@Strings["IntegrityGuidance"]</p>
    <div class="actions">
        <button disabled="@(_scanning || LibraryState.Workspace is null)" @onclick="StartIntegrityScanAsync">@(_scanning ? Strings["Scanning"] : Strings["StartIntegrityScan"])</button>
        @if (_scanning) { <button class="secondary" @onclick="CancelIntegrityScan">@Strings["CancelScan"]</button> }
    </div>
    @if (_scanProgress is not null)
    {
        <!-- Not an aria-live region: this text changes per scanned file, which would otherwise
             re-announce on every single one across a large library. The scan's
             completion is already announced separately once _scanReport is set (role="status"
             region below). -->
        <div class="scan-progress" aria-live="off">
            <progress max="@Math.Max(_scanProgress.TotalItems, 1)" value="@_scanProgress.ProcessedItems"></progress>
            <span>@Strings["IntegrityProgress", _scanProgress.Stage, _scanProgress.ProcessedItems, _scanProgress.TotalItems]</span>
        </div>
    }
    @if (_scanReport is not null)
    {
        <div class="integrity-summary">
            <h3>@IntegrityHeading</h3>
            <p>@Strings["ScanTimes", _scanReport.StartedAt.ToLocalTime().ToString("g"), _scanReport.FinishedAt.ToLocalTime().ToString("g")]</p>
            @if (_scanReport.WasCancelled) { <p class="error">@Strings["ScanPartialResult"]</p> }
            <p class="muted">@Strings["IntegrityJsonScope"]</p>
            <button class="secondary" disabled="@_exportingScan" @onclick="ExportIntegrityReportAsync">@(_exportingScan ? Strings["PreparingExport"] : Strings["ExportFindingsJson"])</button>
            @if (_scanReport.Findings.Count > 0)
            {
                <ul class="integrity-findings">
                    @foreach (var finding in _scanReport.Findings)
                    {
                        <li>
                            <strong>@IssueName(finding.Kind)</strong>
                            <span>@finding.Summary</span>
                            @if (finding.RecordId is not null) { <span class="mono">@Strings["RecordIdentifier", finding.RecordId]</span> }
                            @if (finding.ExpectedByteSize is not null || finding.ActualByteSize is not null)
                            {
                                <span>@Strings["ExpectedFoundBytes", finding.ExpectedByteSize?.ToString() ?? Strings["Unknown"], finding.ActualByteSize?.ToString() ?? Strings["Unknown"]]</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>

<section class="panel">
    <h2>@Strings["Diagnostics"]</h2>
    <p class="muted">@Strings["DiagnosticsGuidance"]</p>
    @if (Diagnostics.VerboseEnabled)
    {
        <p class="notice">@Strings["VerboseDiagnosticsActiveUntil", Diagnostics.VerboseExpiresAt!.Value.ToLocalTime().ToString("t")]</p>
        <button class="secondary" @onclick="Diagnostics.DisableVerbose">@Strings["DisableVerboseDiagnostics"]</button>
    }
    else
    {
        <button class="secondary" @onclick="Diagnostics.EnableVerbose">@Strings["EnableVerboseDiagnosticsFor1Hour"]</button>
    }
    <a class="ghost" href="/diagnostics">@Strings["NavDiagnostics"]</a>
    @if (OperatingSystem.IsWindows())
    {
        <label class="check">
            <input type="checkbox" checked="@ExitCoordinator.RememberedKeepRunning" @onchange="eventArgs => ExitCoordinator.SetRememberedKeepRunning(eventArgs.Value is true)" />
            @Strings["KeepRunningSetting"]
        </label>
    }
</section>

@code {
    private void ChangeTheme(ChangeEventArgs args) => Theme.SetPreference(Enum.Parse<ThemePreference>(args.Value?.ToString() ?? nameof(ThemePreference.System)));
    private QueueCapForm _queueCapForm = new();
    private void SaveDeviceCap()
    {
        Queue.SetDeviceCap(_queueCapForm.Value);
        _queueCapForm.Value = Queue.DeviceCap;
        _message = Strings["DeviceCapSaved"];
    }
    private void ChangeMeteredNetworkPolicy(ChangeEventArgs args) => Queue.SetMeteredNetworkPolicy(Enum.Parse<MeteredNetworkTransferPolicy>(args.Value?.ToString() ?? nameof(MeteredNetworkTransferPolicy.Allow)));
    private async Task ToggleNotificationsAsync(ChangeEventArgs args)
    {
        var enable = args.Value is bool value && value;
        var granted = await NotificationCoordinator.SetEnabledAsync(enable);
        _message = Strings[granted ? (enable ? "GenerationNotificationsEnabled" : "GenerationNotificationsDisabled") : "NotificationPermissionDenied"];
    }
    private IReadOnlyList<AppLibraryLocation> _availableLocations = [];
    private LocationForm _form = new();
    private NameForm _nameForm = new();
    private bool _busy;
    private bool _scanning;
    private string? _message;
    private CancellationTokenSource? _scanCancellation;
    private LibraryIntegrityScanProgress? _scanProgress;
    private LibraryIntegrityReport? _scanReport;
    private bool _exportingScan;
    private PreviewCacheStatus? _cacheStatus;
    private CacheForm _cacheForm = new();
    private bool _confirmClearCache;
    private bool _rebuildingPreviews;
    private PreviewRebuildProgress? _previewRebuildProgress;
    private IReadOnlyList<RecentLibrary> _recentLibraries = [];
    private RecentLibrary? _forgetCandidate;
    private RecentLibrary? _forceForgetCandidate;
    private string? _adoptCandidatePath;
    private string? _cloudSyncCandidatePath;
    private bool _confirmOpenLocation;

    private string IntegrityHeading => _scanReport switch
    {
        { WasCancelled: true } => Strings["PartialScanHeading", _scanReport.Findings.Count],
        { IsComplete: true, Findings.Count: 0 } => Strings["ScanCompleteNoFindings"],
        { IsComplete: true } => Strings["ScanCompleteFindings", _scanReport.Findings.Count],
        _ => Strings["ScanIncompleteFindings", _scanReport?.Findings.Count ?? 0]
    };

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        _availableLocations = Locations.GetAvailableLocations();
        _form.Path = LibraryState.ActivePath ?? _availableLocations.FirstOrDefault()?.Path ?? Locations.DefaultPath;
        _nameForm.Name = LibraryState.Workspace?.Descriptor.DisplayName ?? string.Empty;
        _queueCapForm.Value = Queue.DeviceCap;
        ReloadRecentLibraries();
        await ReloadCacheStatusAsync();
    }

    private async Task SwitchAsync()
    {
        if (IsLikelyCloudSynchronizedPath(_form.Path) && !SamePath(_form.Path, _cloudSyncCandidatePath))
        {
            _cloudSyncCandidatePath = _form.Path;
            _message = Strings["CloudWarningReview"];
            return;
        }
        _busy = true;
        try
        {
            await LibraryState.SwitchAsync(_form.Path);
            _nameForm.Name = LibraryState.Workspace!.Descriptor.DisplayName;
            _message = Strings["OpenedLibrary", LibraryState.Workspace!.Descriptor.DisplayName];
            ReloadRecentLibraries();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _adoptCandidatePath = File.Exists(Path.Combine(_form.Path, "slopfactory-library.json")) ? _form.Path : null;
        }
        finally { _busy = false; }
    }

    private async Task RetryActiveLibraryAsync()
    {
        _busy = true;
        try { await LibraryState.RetryAsync(); ReloadRecentLibraries(); _message = LibraryState.Workspace is null ? LibraryState.Error : Strings["OpenedLibrary", LibraryState.Workspace.Descriptor.DisplayName]; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException) { _message = exception.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmCloudLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_cloudSyncCandidatePath)) return;
        _form.Path = _cloudSyncCandidatePath;
        await SwitchAsync();
        _cloudSyncCandidatePath = null;
    }

    private async Task ConfirmAdoptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_adoptCandidatePath)) return;
        _busy = true;
        try
        {
            await LibraryState.AdoptCopyAsync(_adoptCandidatePath);
            _form.Path = LibraryState.ActivePath ?? _adoptCandidatePath;
            _nameForm.Name = LibraryState.Workspace?.Descriptor.DisplayName ?? string.Empty;
            _message = Strings["CopiedLibraryAdopted"];
            _adoptCandidatePath = null;
            ReloadRecentLibraries();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task RelinkRecentAsync(RecentLibrary library)
    {
        _busy = true;
        try { await LibraryState.RelinkAsync(library.LibraryId, _form.Path); ReloadRecentLibraries(); _message = Strings["RelinkedLibrary", library.DisplayName]; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException) { _message = exception.Message; }
        finally { _busy = false; }
    }

    private async Task RenameAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RenameLibraryAsync(_nameForm.Name);
            _nameForm.Name = LibraryState.Workspace.Descriptor.DisplayName;
            RecentLibraries.RecordOpened(LibraryState.Workspace.Descriptor);
            ReloadRecentLibraries();
            _message = Strings["LibraryRenamed"];
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private Task OpenLibraryLocationAsync()
    {
        if (!OperatingSystem.IsWindows() || string.IsNullOrWhiteSpace(LibraryState.ActivePath)) return Task.CompletedTask;
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = LibraryState.ActivePath,
                UseShellExecute = true
            });
            _confirmOpenLocation = false;
        }
        catch (Exception exception) when (exception is System.ComponentModel.Win32Exception or InvalidOperationException or UnauthorizedAccessException)
        {
            _message = exception.Message;
        }
        return Task.CompletedTask;
    }

    private Task OpenRememberedLocationAsync(string path)
    {
        if (!OperatingSystem.IsWindows()) return Task.CompletedTask;
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo { FileName = path, UseShellExecute = true }); }
        catch (Exception exception) when (exception is System.ComponentModel.Win32Exception or InvalidOperationException or UnauthorizedAccessException) { _message = exception.Message; }
        return Task.CompletedTask;
    }

    private async Task StartIntegrityScanAsync()
    {
        if (LibraryState.Workspace is null) return;
        ScanRecommendation.Clear();
        _scanCancellation?.Dispose();
        _scanCancellation = new CancellationTokenSource();
        _scanReport = null;
        _scanProgress = new LibraryIntegrityScanProgress(0, 1, Strings["StartingScan"]);
        _scanning = true;
        _message = null;
        var progress = new Progress<LibraryIntegrityScanProgress>(value =>
        {
            _scanProgress = value;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            _scanReport = await LibraryState.Workspace.RunIntegrityScanAsync(progress, _scanCancellation.Token);
            _message = _scanReport.WasCancelled ? Strings["ScanCancelled"] : Strings["ScanFinished"];
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally
        {
            _scanning = false;
        }
    }

    private void CancelIntegrityScan() => _scanCancellation?.Cancel();

    private async Task ExportIntegrityReportAsync()
    {
        if (_scanReport is null) return;
        _exportingScan = true;
        try
        {
            var fileName = $"slopfactory-integrity-{_scanReport.StartedAt:yyyyMMdd-HHmmss}.json";
            var path = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllTextAsync(path, IntegrityReportExporter.SerializeDefault(_scanReport));
            await Share.Default.RequestAsync(new ShareFileRequest(Strings["ExportIntegrityFindingsTitle"], new ShareFile(path, "application/json")));
            _message = Strings["IntegrityReportReady"];
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _exportingScan = false; }
    }

    private void ReloadRecentLibraries() => _recentLibraries = RecentLibraries.GetAll();

    private bool IsActive(RecentLibrary library) => LibraryState.Workspace is not null
        && string.Equals(library.LibraryId, LibraryState.Workspace.Descriptor.LibraryId, StringComparison.Ordinal)
        && SamePath(library.Path, LibraryState.ActivePath);

    private static bool IsAvailable(RecentLibrary library) => Directory.Exists(library.Path) && File.Exists(Path.Combine(library.Path, "slopfactory-library.json")) &&
        (!OperatingSystem.IsWindows() || library.VolumeIdentity is null || string.Equals(library.VolumeIdentity, LibraryVolumeIdentity.ForPath(library.Path), StringComparison.Ordinal));

    private static bool SamePath(string left, string? right) => right is not null && string.Equals(Path.TrimEndingDirectorySeparator(Path.GetFullPath(left)), Path.TrimEndingDirectorySeparator(Path.GetFullPath(right)), OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);

    private static bool IsLikelyCloudSynchronizedPath(string path)
    {
        if (!OperatingSystem.IsWindows() || string.IsNullOrWhiteSpace(path)) return false;
        try
        {
            var fullPath = Path.GetFullPath(path);
            var knownRoots = new[]
            {
                Environment.GetEnvironmentVariable("OneDrive"),
                Environment.GetEnvironmentVariable("OneDriveConsumer"),
                Environment.GetEnvironmentVariable("OneDriveCommercial"),
                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Dropbox"),
                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Google Drive")
            };
            return knownRoots.Where(root => !string.IsNullOrWhiteSpace(root)).Any(root =>
            {
                var relative = Path.GetRelativePath(Path.GetFullPath(root!), fullPath);
                return relative == "." || (!Path.IsPathRooted(relative) && !relative.StartsWith($"..{Path.DirectorySeparatorChar}", StringComparison.Ordinal));
            });
        }
        catch (Exception exception) when (exception is ArgumentException or NotSupportedException) { return false; }
    }

    private async Task OpenRecentAsync(RecentLibrary library)
    {
        _form.Path = library.Path;
        await SwitchAsync();
    }

    /// <summary>A library with active queued/running/monitoring work cannot be
    /// forgotten, whether it is the currently active library or one kept open in the background.</summary>
    private bool HasActiveWork(RecentLibrary library) => LibraryState.HasActiveWorkFor(library.LibraryId);

    /// <summary>Blocks ordinary Forget Library while unreconciled emergency draft
    /// markers exist for this library, since they may be the only record that unsaved work exists.</summary>
    private bool HasDirtyDrafts(RecentLibrary library) => LibraryState.GetDirtyDraftCount(library.LibraryId) > 0;

    /// <summary>Blocks ordinary Forget Library while completed provider results remain
    /// staged for recovery for this library.</summary>
    private bool HasStagedResults(RecentLibrary library) => RecoveryStaging.GetAll().Any(entry => entry.LibraryId == library.LibraryId);

    private async Task ForgetRecentAsync()
    {
        if (_forgetCandidate is null || IsActive(_forgetCandidate) || HasActiveWork(_forgetCandidate) || HasDirtyDrafts(_forgetCandidate) || HasStagedResults(_forgetCandidate)) return;
        RecentLibraries.Forget(_forgetCandidate.LibraryId, _forgetCandidate.Path);
        await PreviewCache.ForgetLibraryAsync(_forgetCandidate.LibraryId);
        _message = Strings["ForgotLibrary", _forgetCandidate.DisplayName];
        _forgetCandidate = null;
        ReloadRecentLibraries();
        await ReloadCacheStatusAsync();
    }

    /// <summary>**Delete Recovery Drafts and Forget** / **Discard Staged Results and Forget**
    /// combined: explicitly clears whichever device-local recovery data
    /// blocks the ordinary Forget above, then completes the normal forget workflow. Never touches the
    /// library's own database — dirty-draft markers and staged results are both device-local-only
    /// state, not library content, and do not enter the library recycle bin
    /// (there is nothing library-side to recycle).</summary>
    private async Task ForceForgetRecentAsync()
    {
        if (_forceForgetCandidate is null || IsActive(_forceForgetCandidate) || HasActiveWork(_forceForgetCandidate)) return;
        var libraryId = _forceForgetCandidate.LibraryId;
        LibraryState.DeleteDirtyDraftsFor(libraryId);
        foreach (var entry in RecoveryStaging.GetAll().Where(entry => entry.LibraryId == libraryId).ToArray())
        {
            await RecoveryStaging.DiscardAsync(entry.Id);
        }
        RecentLibraries.Forget(libraryId, _forceForgetCandidate.Path);
        await PreviewCache.ForgetLibraryAsync(libraryId);
        _message = Strings["ForgotLibrary", _forceForgetCandidate.DisplayName];
        _forceForgetCandidate = null;
        ReloadRecentLibraries();
        await ReloadCacheStatusAsync();
    }

    private async Task ReloadCacheStatusAsync()
    {
        _cacheStatus = await PreviewCache.GetStatusAsync();
        _cacheForm.LimitMiB = Math.Max(64, _cacheStatus.LimitBytes / 1_048_576);
    }

    private async Task SaveCacheLimitAsync()
    {
        await PreviewCache.SetLimitAsync(_cacheForm.LimitMiB * 1_048_576);
        await ReloadCacheStatusAsync();
        _message = Strings["CacheLimitSaved"];
    }

    private async Task ClearCacheAsync()
    {
        await PreviewCache.ClearAsync();
        _confirmClearCache = false;
        await ReloadCacheStatusAsync();
        _message = Strings["CacheCleared"];
    }

    private async Task RebuildPreviewsAsync()
    {
        if (LibraryState.Workspace is null) return;
        _rebuildingPreviews = true;
        _previewRebuildProgress = null;
        try
        {
            var progress = new Progress<PreviewRebuildProgress>(value =>
            {
                _previewRebuildProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await PreviewCache.RebuildLibraryAsync(LibraryState.Workspace, progress);
            _message = Strings["PreviewsRebuilt", result.RebuiltFiles, result.EligibleFiles, result.UnavailableFiles];
            await ReloadCacheStatusAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _previewRebuildProgress = null; _rebuildingPreviews = false; }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824d:0.##} GiB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576d:0.##} MiB";
        if (bytes >= 1_024) return $"{bytes / 1_024d:0.##} KiB";
        return $"{bytes} B";
    }

    private string IssueName(LibraryIntegrityIssueKind kind) => kind switch
    {
        LibraryIntegrityIssueKind.ManifestInvalid => Strings["IssueManifestInvalid"], LibraryIntegrityIssueKind.DatabaseInvalid => Strings["IssueDatabaseInvalid"], LibraryIntegrityIssueKind.RequiredDirectoryMissing => Strings["IssueRequiredDirectoryMissing"], LibraryIntegrityIssueKind.ManagedFileMissing => Strings["IssueManagedFileMissing"], LibraryIntegrityIssueKind.ManagedFileSizeMismatch => Strings["IssueFileSizeMismatch"], LibraryIntegrityIssueKind.ManagedFileHashMismatch => Strings["IssueContentHashMismatch"], LibraryIntegrityIssueKind.UnsafeManagedEntry => Strings["IssueUnsafeManagedEntry"], LibraryIntegrityIssueKind.OrphanManagedFile => Strings["IssueOrphanManagedFile"], _ => Strings["IssueManagedFileInaccessible"]
    };

    public void Dispose()
    {
        _scanCancellation?.Cancel();
        _scanCancellation?.Dispose();
    }

    private sealed class LocationForm { public string Path { get; set; } = string.Empty; }
    private sealed class NameForm { public string Name { get; set; } = string.Empty; }
    private sealed class CacheForm { public long LimitMiB { get; set; } }
    private sealed class QueueCapForm { public int Value { get; set; } }
}
