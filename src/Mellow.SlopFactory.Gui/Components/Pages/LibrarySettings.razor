@page "/library-settings"
@implements IDisposable
@inject AppLibraryState LibraryState
@inject ILibraryLocationService Locations
@inject PreviewCacheService PreviewCache
@inject IRecentLibraryService RecentLibraries
@using Mellow.SlopFactory.Application

<PageTitle>Library settings · SlopFactory</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">Local storage</p><h1>Library settings</h1><p class="muted">Open or create an independent local library.</p></div>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice" role="status">@_message</div>
}

<section class="panel">
    <h2>Active library</h2>
    <dl>
        <dt>Name</dt><dd>@(LibraryState.Workspace?.Descriptor.DisplayName ?? "Unavailable")</dd>
        <dt>Location</dt><dd class="mono">@(LibraryState.ActivePath ?? "No location is open")</dd>
    </dl>

    @if (LibraryState.Workspace is not null)
    {
        <EditForm Model="_nameForm" OnValidSubmit="RenameAsync" class="inline-form">
            <label for="library-name">Library name</label>
            <InputText id="library-name" @bind-Value="_nameForm.Name" maxlength="255" />
            <button type="submit" disabled="@(_busy || _scanning)">Rename library</button>
        </EditForm>
#if WINDOWS
        @if (!_confirmOpenLocation)
        {
            <button class="secondary" disabled="@(_busy || _scanning)" @onclick="() => _confirmOpenLocation = true">Open library location</button>
        }
        else
        {
            <div class="inline-form" role="group" aria-label="Confirm opening library location">
                <span>This is an application-managed directory. Internal filenames may not match display names, and editing or moving entries outside SlopFactory is unsupported.</span>
                <button class="secondary" @onclick="OpenLibraryLocationAsync">Open location</button>
                <button class="secondary" @onclick="() => _confirmOpenLocation = false">Cancel</button>
            </div>
        }
#endif
    }

    <EditForm Model="_form" OnValidSubmit="SwitchAsync" class="stack-form">
#if ANDROID
        <label for="library-location">App-specific storage location</label>
        <InputSelect id="library-location" @bind-Value="_form.Path">
            @foreach (var location in _availableLocations)
            {
                <option value="@location.Path">@location.Label</option>
            }
        </InputSelect>
#else
        <label for="library-location">Absolute local directory</label>
        <InputText id="library-location" @bind-Value="_form.Path" />
#endif
        <p class="muted">An empty location becomes a new library. A valid existing SlopFactory library is opened. A non-empty unrelated directory is rejected. Existing data is never moved or copied.</p>
        <button type="submit" disabled="@(_busy || _scanning)">@(_busy ? "Switching…" : "Open this library")</button>
    </EditForm>
    @if (_adoptCandidatePath is not null)
    {
        <div class="inline-form" role="group" aria-label="Confirm adopting copied library">
            <span>The selected location could be a copy of another available library. Adopting it assigns a new permanent ID, keeps its files and records, and makes it independent from the original.</span>
            <button class="danger" disabled="@_busy" @onclick="ConfirmAdoptionAsync">Adopt copied library</button>
            <button class="secondary" disabled="@_busy" @onclick="() => _adoptCandidatePath = null">Cancel</button>
        </div>
    }
    @if (_cloudSyncCandidatePath is not null)
    {
        <div class="inline-form" role="group" aria-label="Confirm cloud-synchronised library location">
            <span>This location appears to be cloud-synchronised. Concurrent sync activity can corrupt or duplicate a local library. Continue only if you understand that SlopFactory does not provide synchronisation.</span>
            <button class="danger" disabled="@_busy" @onclick="ConfirmCloudLocationAsync">Use this location</button>
            <button class="secondary" disabled="@_busy" @onclick="() => _cloudSyncCandidatePath = null">Cancel</button>
        </div>
    }
</section>

<section class="panel">
    <h2>Recent libraries</h2>
    <p class="muted">Libraries are independent. Opening another location never moves or copies data.</p>
    @if (_recentLibraries.Count == 0)
    {
        <p class="empty">No remembered libraries.</p>
    }
    else
    {
        <ul class="metadata-list">
            @foreach (var library in _recentLibraries)
            {
                var active = IsActive(library);
                var available = IsAvailable(library);
                <li>
                    <div>
                        <strong>@library.DisplayName @(active ? "(active)" : string.Empty)</strong>
                        <small>@(available ? "Available" : "Unavailable") Â· Last opened @library.LastOpenedAt.ToLocalTime().ToString("g")</small>
                    </div>
                    <code>@library.Path</code>
                    <button class="ghost" disabled="@(active || !available || _busy || _scanning)" @onclick="() => OpenRecentAsync(library)">Open</button>
                    <button class="ghost danger" disabled="@(active || _busy || _scanning)" @onclick="() => _forgetCandidate = library">Forget</button>
                </li>
            }
        </ul>
    }
    <button class="secondary" disabled="@(_rebuildingPreviews || LibraryState.Workspace is null)" @onclick="RebuildPreviewsAsync">@(_rebuildingPreviews ? "Rebuilding previews…" : "Rebuild library previews")</button>
    @if (_previewRebuildProgress is not null) { <p class="muted" role="status">Rebuilding @_previewRebuildProgress.DisplayName: @_previewRebuildProgress.ProcessedItems of @_previewRebuildProgress.TotalItems.</p> }
    @if (_forgetCandidate is not null)
    {
        <div class="inline-form" role="group" aria-label="Confirm forgetting library">
            <span>Forget @_forgetCandidate.DisplayName on this device? Its library data and future credentials remain untouched; regenerable previews for it will be removed.</span>
            <button class="danger" @onclick="ForgetRecentAsync">Forget library</button>
            <button class="secondary" @onclick="() => _forgetCandidate = null">Cancel</button>
        </div>
    }
</section>

<section class="panel">
    <h2>Preview cache</h2>
    <p class="muted">Regenerable thumbnails are stored in device-local application cache, separately from every library. Cache limits never restrict or delete original files.</p>
    @if (_cacheStatus is not null)
    {
        <p>Using <strong>@FormatBytes(_cacheStatus.UseBytes)</strong> of <strong>@FormatBytes(_cacheStatus.LimitBytes)</strong>.</p>
    }
    <EditForm Model="_cacheForm" OnValidSubmit="SaveCacheLimitAsync" class="inline-form">
        <label for="cache-limit">Cache limit (MiB)</label>
        <InputNumber id="cache-limit" @bind-Value="_cacheForm.LimitMiB" min="64" max="8192" />
        <button type="submit">Save cache limit</button>
    </EditForm>
    @if (!_confirmClearCache)
    {
        <button class="secondary" @onclick="() => _confirmClearCache = true">Clear preview cache</button>
    }
    else
    {
        <div class="inline-form" role="group" aria-label="Confirm clearing preview cache">
            <span>Clear all device-local previews? Original library files are unaffected.</span>
            <button class="danger" @onclick="ClearCacheAsync">Clear previews</button>
            <button class="secondary" @onclick="() => _confirmClearCache = false">Cancel</button>
        </div>
    }
</section>

<section class="panel integrity-panel">
    <h2>Library integrity</h2>
    <p class="muted">An explicit full scan validates the manifest and database, then reads and hashes every active and recycled managed file. It never repairs, deletes, adopts, or rewrites anything.</p>
    <div class="actions">
        <button disabled="@(_scanning || LibraryState.Workspace is null)" @onclick="StartIntegrityScanAsync">@(_scanning ? "Scanning…" : "Start full integrity scan")</button>
        @if (_scanning) { <button class="secondary" @onclick="CancelIntegrityScan">Cancel scan</button> }
    </div>
    @if (_scanProgress is not null)
    {
        <div class="scan-progress" role="status" aria-live="polite">
            <progress max="@Math.Max(_scanProgress.TotalItems, 1)" value="@_scanProgress.ProcessedItems"></progress>
            <span>@_scanProgress.Stage · @_scanProgress.ProcessedItems of @_scanProgress.TotalItems items</span>
        </div>
    }
    @if (_scanReport is not null)
    {
        <div class="integrity-summary">
            <h3>@IntegrityHeading</h3>
            <p>Started @_scanReport.StartedAt.ToLocalTime().ToString("g"); finished @_scanReport.FinishedAt.ToLocalTime().ToString("g").</p>
            @if (_scanReport.WasCancelled) { <p class="error">This is an incomplete partial result because the scan was cancelled.</p> }
            <p class="muted">JSON export includes: library ID, schema version, scan times/status, finding category, opaque record ID, byte counts, and summary. It excludes names, paths, hashes, metadata, prompts, credentials, and file bytes.</p>
            <button class="secondary" disabled="@_exportingScan" @onclick="ExportIntegrityReportAsync">@(_exportingScan ? "Preparing export…" : "Export findings as JSON")</button>
            @if (_scanReport.Findings.Count > 0)
            {
                <ul class="integrity-findings">
                    @foreach (var finding in _scanReport.Findings)
                    {
                        <li>
                            <strong>@IssueName(finding.Kind)</strong>
                            <span>@finding.Summary</span>
                            @if (finding.RecordId is not null) { <span class="mono">Record @finding.RecordId</span> }
                            @if (finding.ExpectedByteSize is not null || finding.ActualByteSize is not null)
                            {
                                <span>Expected @(finding.ExpectedByteSize?.ToString() ?? "unknown") bytes; found @(finding.ActualByteSize?.ToString() ?? "unknown") bytes.</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<AppLibraryLocation> _availableLocations = [];
    private LocationForm _form = new();
    private NameForm _nameForm = new();
    private bool _busy;
    private bool _scanning;
    private string? _message;
    private CancellationTokenSource? _scanCancellation;
    private LibraryIntegrityScanProgress? _scanProgress;
    private LibraryIntegrityReport? _scanReport;
    private bool _exportingScan;
    private PreviewCacheStatus? _cacheStatus;
    private CacheForm _cacheForm = new();
    private bool _confirmClearCache;
    private bool _rebuildingPreviews;
    private PreviewRebuildProgress? _previewRebuildProgress;
    private IReadOnlyList<RecentLibrary> _recentLibraries = [];
    private RecentLibrary? _forgetCandidate;
    private string? _adoptCandidatePath;
    private string? _cloudSyncCandidatePath;
#if WINDOWS
    private bool _confirmOpenLocation;
#endif

    private string IntegrityHeading => _scanReport switch
    {
        { WasCancelled: true } => $"Partial scan: {_scanReport.Findings.Count} finding(s)",
        { IsComplete: true, Findings.Count: 0 } => "Integrity scan completed with no findings",
        { IsComplete: true } => $"Integrity scan completed with {_scanReport.Findings.Count} finding(s)",
        _ => $"Integrity scan incomplete with {_scanReport?.Findings.Count ?? 0} finding(s)"
    };

    protected override async Task OnInitializedAsync()
    {
        await LibraryState.InitializeAsync();
        _availableLocations = Locations.GetAvailableLocations();
        _form.Path = LibraryState.ActivePath ?? _availableLocations.FirstOrDefault()?.Path ?? Locations.DefaultPath;
        _nameForm.Name = LibraryState.Workspace?.Descriptor.DisplayName ?? string.Empty;
        ReloadRecentLibraries();
        await ReloadCacheStatusAsync();
    }

    private async Task SwitchAsync()
    {
        if (IsLikelyCloudSynchronizedPath(_form.Path) && !SamePath(_form.Path, _cloudSyncCandidatePath))
        {
            _cloudSyncCandidatePath = _form.Path;
            _message = "This location appears to be cloud-synchronised. Review the warning before continuing.";
            return;
        }
        _busy = true;
        try
        {
            await LibraryState.SwitchAsync(_form.Path);
            _nameForm.Name = LibraryState.Workspace!.Descriptor.DisplayName;
            _message = $"Opened {LibraryState.Workspace!.Descriptor.DisplayName}.";
            ReloadRecentLibraries();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _adoptCandidatePath = File.Exists(Path.Combine(_form.Path, "slopfactory-library.json")) ? _form.Path : null;
        }
        finally { _busy = false; }
    }

    private async Task ConfirmCloudLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_cloudSyncCandidatePath)) return;
        _form.Path = _cloudSyncCandidatePath;
        await SwitchAsync();
        _cloudSyncCandidatePath = null;
    }

    private async Task ConfirmAdoptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_adoptCandidatePath)) return;
        _busy = true;
        try
        {
            await LibraryState.AdoptCopyAsync(_adoptCandidatePath);
            _form.Path = LibraryState.ActivePath ?? _adoptCandidatePath;
            _nameForm.Name = LibraryState.Workspace?.Descriptor.DisplayName ?? string.Empty;
            _message = "The copied library was adopted as an independent library. Existing media and local records were preserved.";
            _adoptCandidatePath = null;
            ReloadRecentLibraries();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _busy = false; }
    }

    private async Task RenameAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RenameLibraryAsync(_nameForm.Name);
            _nameForm.Name = LibraryState.Workspace.Descriptor.DisplayName;
            RecentLibraries.RecordOpened(LibraryState.Workspace.Descriptor);
            ReloadRecentLibraries();
            _message = "Library renamed.";
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

#if WINDOWS
    private Task OpenLibraryLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(LibraryState.ActivePath)) return Task.CompletedTask;
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = LibraryState.ActivePath,
                UseShellExecute = true
            });
            _confirmOpenLocation = false;
        }
        catch (Exception exception) when (exception is System.ComponentModel.Win32Exception or InvalidOperationException or UnauthorizedAccessException)
        {
            _message = exception.Message;
        }
        return Task.CompletedTask;
    }
#endif

    private async Task StartIntegrityScanAsync()
    {
        if (LibraryState.Workspace is null) return;
        _scanCancellation?.Dispose();
        _scanCancellation = new CancellationTokenSource();
        _scanReport = null;
        _scanProgress = new LibraryIntegrityScanProgress(0, 1, "Starting scan");
        _scanning = true;
        _message = null;
        var progress = new Progress<LibraryIntegrityScanProgress>(value =>
        {
            _scanProgress = value;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            _scanReport = await LibraryState.Workspace.RunIntegrityScanAsync(progress, _scanCancellation.Token);
            _message = _scanReport.WasCancelled ? "Integrity scan cancelled; partial findings are shown below." : "Integrity scan finished.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally
        {
            _scanning = false;
        }
    }

    private void CancelIntegrityScan() => _scanCancellation?.Cancel();

    private async Task ExportIntegrityReportAsync()
    {
        if (_scanReport is null) return;
        _exportingScan = true;
        try
        {
            var fileName = $"slopfactory-integrity-{_scanReport.StartedAt:yyyyMMdd-HHmmss}.json";
            var path = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllTextAsync(path, IntegrityReportExporter.SerializeDefault(_scanReport));
            await Share.Default.RequestAsync(new ShareFileRequest("Export integrity findings", new ShareFile(path, "application/json")));
            _message = "The JSON integrity report is ready to save or share. It contains only the default diagnostic fields.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _exportingScan = false; }
    }

    private void ReloadRecentLibraries() => _recentLibraries = RecentLibraries.GetAll();

    private bool IsActive(RecentLibrary library) => LibraryState.Workspace is not null
        && string.Equals(library.LibraryId, LibraryState.Workspace.Descriptor.LibraryId, StringComparison.Ordinal)
        && SamePath(library.Path, LibraryState.ActivePath);

    private static bool IsAvailable(RecentLibrary library) => Directory.Exists(library.Path) && File.Exists(Path.Combine(library.Path, "slopfactory-library.json"));

    private static bool SamePath(string left, string? right) => right is not null && string.Equals(Path.TrimEndingDirectorySeparator(Path.GetFullPath(left)), Path.TrimEndingDirectorySeparator(Path.GetFullPath(right)), OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);

    private static bool IsLikelyCloudSynchronizedPath(string path)
    {
        if (!OperatingSystem.IsWindows() || string.IsNullOrWhiteSpace(path)) return false;
        try
        {
            var fullPath = Path.GetFullPath(path);
            var knownRoots = new[]
            {
                Environment.GetEnvironmentVariable("OneDrive"),
                Environment.GetEnvironmentVariable("OneDriveConsumer"),
                Environment.GetEnvironmentVariable("OneDriveCommercial"),
                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Dropbox"),
                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Google Drive")
            };
            return knownRoots.Where(root => !string.IsNullOrWhiteSpace(root)).Any(root =>
            {
                var relative = Path.GetRelativePath(Path.GetFullPath(root!), fullPath);
                return relative == "." || (!Path.IsPathRooted(relative) && !relative.StartsWith($"..{Path.DirectorySeparatorChar}", StringComparison.Ordinal));
            });
        }
        catch (Exception exception) when (exception is ArgumentException or NotSupportedException) { return false; }
    }

    private async Task OpenRecentAsync(RecentLibrary library)
    {
        _form.Path = library.Path;
        await SwitchAsync();
    }

    private async Task ForgetRecentAsync()
    {
        if (_forgetCandidate is null || IsActive(_forgetCandidate)) return;
        RecentLibraries.Forget(_forgetCandidate.LibraryId, _forgetCandidate.Path);
        await PreviewCache.ForgetLibraryAsync(_forgetCandidate.LibraryId);
        _message = $"Forgot {_forgetCandidate.DisplayName} on this device. Its library data was not changed.";
        _forgetCandidate = null;
        ReloadRecentLibraries();
        await ReloadCacheStatusAsync();
    }

    private async Task ReloadCacheStatusAsync()
    {
        _cacheStatus = await PreviewCache.GetStatusAsync();
        _cacheForm.LimitMiB = Math.Max(64, _cacheStatus.LimitBytes / 1_048_576);
    }

    private async Task SaveCacheLimitAsync()
    {
        await PreviewCache.SetLimitAsync(_cacheForm.LimitMiB * 1_048_576);
        await ReloadCacheStatusAsync();
        _message = "Preview cache limit saved. Older previews were removed if needed.";
    }

    private async Task ClearCacheAsync()
    {
        await PreviewCache.ClearAsync();
        _confirmClearCache = false;
        await ReloadCacheStatusAsync();
        _message = "Preview cache cleared. Original files were not changed.";
    }

    private async Task RebuildPreviewsAsync()
    {
        if (LibraryState.Workspace is null) return;
        _rebuildingPreviews = true;
        _previewRebuildProgress = null;
        try
        {
            var progress = new Progress<PreviewRebuildProgress>(value =>
            {
                _previewRebuildProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await PreviewCache.RebuildLibraryAsync(LibraryState.Workspace, progress);
            _message = $"Rebuilt {result.RebuiltFiles} of {result.EligibleFiles} eligible previews; {result.UnavailableFiles} could not be generated. Original files were not changed.";
            await ReloadCacheStatusAsync();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
        }
        finally { _previewRebuildProgress = null; _rebuildingPreviews = false; }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824d:0.##} GiB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576d:0.##} MiB";
        if (bytes >= 1_024) return $"{bytes / 1_024d:0.##} KiB";
        return $"{bytes} B";
    }

    private static string IssueName(LibraryIntegrityIssueKind kind) => kind switch
    {
        LibraryIntegrityIssueKind.ManifestInvalid => "Manifest invalid",
        LibraryIntegrityIssueKind.DatabaseInvalid => "Database invalid",
        LibraryIntegrityIssueKind.RequiredDirectoryMissing => "Required directory missing",
        LibraryIntegrityIssueKind.ManagedFileMissing => "Managed file missing",
        LibraryIntegrityIssueKind.ManagedFileSizeMismatch => "File size mismatch",
        LibraryIntegrityIssueKind.ManagedFileHashMismatch => "Content hash mismatch",
        LibraryIntegrityIssueKind.UnsafeManagedEntry => "Unsafe managed entry",
        LibraryIntegrityIssueKind.OrphanManagedFile => "Orphan managed file",
        _ => "Managed file inaccessible"
    };

    public void Dispose()
    {
        _scanCancellation?.Cancel();
        _scanCancellation?.Dispose();
    }

    private sealed class LocationForm { public string Path { get; set; } = string.Empty; }
    private sealed class NameForm { public string Name { get; set; } = string.Empty; }
    private sealed class CacheForm { public long LimitMiB { get; set; } }
}
