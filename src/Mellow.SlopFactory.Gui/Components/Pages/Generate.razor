    protected override async Task OnInitializedAsync()
    {
        Queue.Changed += OnQueueChanged;
        LibraryState.Closing += OnLibraryClosingAsync;
        await LibraryState.InitializeAsync();
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        await RefreshActiveModelsAsync(workspace);
        _activeConnections = await workspace.GetActiveConnectionsAsync();
        _activeFolders = await workspace.GetActiveFoldersAsync();
        var activeFiles = await workspace.GetActiveFilesAsync();
        _activeImageFiles = activeFiles.Where(file => file.MediaType is "image/png" or "image/jpeg" or "image/webp" or "image/gif").ToArray();

        _drafts = await workspace.GetDraftsAsync();
        if (_drafts.Count == 0)
        {
            _drafts = [await workspace.CreateDraftAsync()];
        }

        await LoadDraftIntoFormAsync(_drafts.OrderBy(draft => draft.TabOrder).First().Id);
    }

    private async Task RefreshActiveModelsAsync(ILibraryWorkspace workspace)
    {
        var activeModels = await workspace.GetActiveModelsAsync();
        _hasNeedsReviewModels = activeModels.Any(model => model.NeedsReview);
        _models = activeModels.Where(model => !model.NeedsReview).ToArray();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ConsumeRouteDraftAsync();
    }

    private void OnQueueChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private Task OnLibraryClosingAsync() => FlushPendingAutosaveAsync();

    public async ValueTask DisposeAsync()
    {
        Queue.Changed -= OnQueueChanged;
        LibraryState.Closing -= OnLibraryClosingAsync;
        await FlushPendingAutosaveAsync();
    }

    private async Task ConsumeRouteDraftAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;

        if (!string.IsNullOrEmpty(SettingsId) && !string.Equals(_consumedSettingsId, SettingsId, StringComparison.Ordinal))
        {
            _consumedSettingsId = SettingsId;
            try
            {
                var saved = await workspace.GetSavedSettingAsync(SettingsId);
                await FlushPendingAutosaveAsync();
                var model = saved.ModelId is not null ? _models.FirstOrDefault(candidate => candidate.Id == saved.ModelId) : null;
                var modelId = model?.Id ?? (_models.Count > 0 ? _models[0].Id : null);
                var sourceFileId = saved.SourceFileId is not null && _activeImageFiles.Any(file => file.Id == saved.SourceFileId) ? saved.SourceFileId : null;
                var secondarySourceFileId = saved.SecondarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == saved.SecondarySourceFileId) ? saved.SecondarySourceFileId : null;
                var tertiarySourceFileId = saved.TertiarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == saved.TertiarySourceFileId) ? saved.TertiarySourceFileId : null;
                var draft = await workspace.CreateDraftAsync();
                draft = await workspace.ReplaceDraftStateAsync(draft.Id, saved.Title, modelId, saved.Prompt, saved.SystemInstructions, sourceFileId, saved.ResultCount, saved.DestinationFolderId, null, null, saved.Settings, secondarySourceFileId, tertiarySourceFileId);
                _drafts = [.. _drafts, draft];
                await LoadDraftIntoFormAsync(draft.Id);
                _loadedSettingsId = saved.Id;
                _loadedTitle = saved.Title;
                _loadedRevision = saved.Revision;
                _settingsTitle = saved.Title;
                if (model is null && saved.ModelId is not null && _models.Count > 0)
                {
                    _message = Strings["SavedSettingsModelUnavailable", saved.ModelLabel];
                }
            }
            catch (SlopFactoryException exception)
            {
                _message = exception.Message;
                _isError = true;
            }
        }
        else if (!string.IsNullOrEmpty(HistoryId) && !string.Equals(_consumedHistoryId, HistoryId, StringComparison.Ordinal))
        {
            _consumedHistoryId = HistoryId;
            try
            {
                var history = await workspace.GetGenerationRecordAsync(HistoryId);
                await FlushPendingAutosaveAsync();
                var model = history.ModelId is not null ? _models.FirstOrDefault(candidate => candidate.Id == history.ModelId) : null;
                var modelId = model?.Id ?? (_models.Count > 0 ? _models[0].Id : null);
                var sourceFileId = history.SourceFileId is not null && _activeImageFiles.Any(file => file.Id == history.SourceFileId) ? history.SourceFileId : null;
                var secondarySourceFileId = history.SecondarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == history.SecondarySourceFileId) ? history.SecondarySourceFileId : null;
                var tertiarySourceFileId = history.TertiarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == history.TertiarySourceFileId) ? history.TertiarySourceFileId : null;
                var draft = await workspace.CreateDraftAsync();
                draft = await workspace.ReplaceDraftStateAsync(draft.Id, null, modelId, history.Prompt, history.SystemInstructions, sourceFileId, history.ResultCount, history.DestinationFolderId, null, null, history.Settings, secondarySourceFileId, tertiarySourceFileId);
                _drafts = [.. _drafts, draft];
                await LoadDraftIntoFormAsync(draft.Id);
                if (model is null && history.ModelId is not null && _models.Count > 0)
                {
                    _message = Strings["SavedSettingsModelUnavailable", history.ModelLabel];
                }
            }
            catch (SlopFactoryException exception)
            {
                _message = exception.Message;
                _isError = true;
            }
        }
    }

    private async Task LoadDraftIntoFormAsync(string draftId)
    {
        var draft = _drafts.FirstOrDefault(candidate => candidate.Id == draftId);
        if (draft is null) return;
        _activeDraftId = draftId;
        _recycledModel = null;
        var model = draft.ModelId is not null ? _models.FirstOrDefault(candidate => candidate.Id == draft.ModelId) : null;
        string resolvedModelId;
        string? unavailableMessage = null;

        if (model is not null || draft.ModelId is null)
        {
            resolvedModelId = model?.Id ?? (_models.Count > 0 ? _models[0].Id : string.Empty);
        }
        else
        {
            resolvedModelId = _models.Count > 0 ? _models[0].Id : string.Empty;
            var workspace = LibraryState.Workspace;
            Model? current = null;
            if (workspace is not null)
            {
                try
                {
                    current = await workspace.GetModelAsync(draft.ModelId);
                }
                catch (RecordNotFoundException)
                {
                    current = null;
                }
            }

            if (current is null)
            {
                resolvedModelId = string.Empty;
                unavailableMessage = Strings["DraftModelDeleted"];
            }
            else if (current.State == LibraryRecordState.Recycled)
            {
                _recycledModel = current;
                unavailableMessage = Strings["DraftModelRecycled", current.Label];
            }
            else
            {
                unavailableMessage = Strings["DraftModelUnavailable"];
            }
        }

        _form = new GenerateForm
        {
            ModelId = resolvedModelId,
            Prompt = draft.Prompt,
            SystemInstructions = draft.SystemInstructions ?? string.Empty,
            SourceFileId = draft.SourceFileId is not null && _activeImageFiles.Any(file => file.Id == draft.SourceFileId) ? draft.SourceFileId : string.Empty,
            SecondarySourceFileId = draft.SecondarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == draft.SecondarySourceFileId) ? draft.SecondarySourceFileId : string.Empty,
            TertiarySourceFileId = draft.TertiarySourceFileId is not null && _activeImageFiles.Any(file => file.Id == draft.TertiarySourceFileId) ? draft.TertiarySourceFileId : string.Empty,
            ResultCount = draft.ResultCount,
            DestinationFolderId = draft.DestinationFolderId,
            Temperature = draft.Settings.Temperature,
            TopP = draft.Settings.TopP,
            MaxTokens = draft.Settings.MaxTokens,
            FrequencyPenalty = draft.Settings.FrequencyPenalty,
            PresencePenalty = draft.Settings.PresencePenalty,
            AdvancedJson = draft.Settings.AdvancedJson ?? string.Empty
        };
        _improvementModelId = draft.ImprovementModelId is not null && _models.Any(candidate => candidate.Id == draft.ImprovementModelId) ? draft.ImprovementModelId : string.Empty;
        _improvementGuidance = draft.ImprovementGuidance ?? string.Empty;
        _improvementCandidates = null;
        _lastImprovementRecordId = null;
        _acceptedImprovementRecordId = null;
        _tabTitleInput = draft.CustomTitle ?? string.Empty;
        _loadedSettingsId = null;
        _loadedTitle = null;
        _loadedRevision = 0;
        _settingsTitle = string.Empty;
        _settingsConflict = null;
        _settingsRecycledConflict = null;
        _saveStatus = SaveStatus.Idle;
        _saveError = null;
        _message = unavailableMessage;
        _isError = false;
    }

    private async Task RestoreDraftModelAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _recycledModel is null) return;
        _busy = true;
        try
        {
            await workspace.RestoreModelAsync(_recycledModel.Id);
            await RefreshActiveModelsAsync(workspace);
            _form.ModelId = _recycledModel.Id;
            _recycledModel = null;
            _message = null;
            _isError = false;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally { _busy = false; }
    }

    private async Task SwitchToDraftAsync(string draftId)
    {
        if (draftId == _activeDraftId) return;
        _closingDraftId = null;
        await FlushPendingAutosaveAsync();
        await LoadDraftIntoFormAsync(draftId);
    }

    private async Task AddDraftAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        await FlushPendingAutosaveAsync();
        var draft = await workspace.CreateDraftAsync();
        _drafts = [.. _drafts, draft];
        await LoadDraftIntoFormAsync(draft.Id);
    }

    private Task DuplicateActiveDraftAsync() => _activeDraftId is null ? Task.CompletedTask : DuplicateDraftAsync(_activeDraftId);

    private async Task DuplicateDraftAsync(string draftId)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        if (draftId == _activeDraftId) await FlushPendingAutosaveAsync();
        var duplicate = await workspace.DuplicateDraftAsync(draftId);
        _drafts = [.. _drafts, duplicate];
        _switcherOpen = false;
        await LoadDraftIntoFormAsync(duplicate.Id);
    }

    private async Task SelectFromSwitcherAsync(string draftId)
    {
        await SwitchToDraftAsync(draftId);
        _switcherOpen = false;
    }

    private void BeginSwitcherRename(GenerationDraft draft)
    {
        _switcherRenamingDraftId = draft.Id;
        _switcherRenameTitle = draft.CustomTitle ?? string.Empty;
    }

    private async Task CommitSwitcherRenameAsync(string draftId)
    {
        var workspace = LibraryState.Workspace;
        var draft = _drafts.FirstOrDefault(candidate => candidate.Id == draftId);
        if (workspace is null || draft is null || string.IsNullOrWhiteSpace(_switcherRenameTitle)) return;
        var updated = await workspace.ReplaceDraftStateAsync(draftId, _switcherRenameTitle, draft.ModelId, draft.Prompt, draft.SystemInstructions, draft.SourceFileId, draft.ResultCount, draft.DestinationFolderId, draft.ImprovementModelId, draft.ImprovementGuidance, draft.Settings, draft.SecondarySourceFileId, draft.TertiarySourceFileId);
        _drafts = _drafts.Select(candidate => candidate.Id == draftId ? updated : candidate).ToArray();
        if (draftId == _activeDraftId) _tabTitleInput = updated.CustomTitle ?? string.Empty;
        _switcherRenamingDraftId = null;
    }

    private int ActiveDraftPosition => _drafts.OrderBy(draft => draft.TabOrder).ToList().FindIndex(draft => draft.Id == _activeDraftId) + 1;

    private List<GenerationDraft> FilteredSwitcherDrafts() =>
        _drafts.OrderBy(draft => draft.TabOrder)
            .Where(draft => string.IsNullOrWhiteSpace(_switcherFilter) || DraftDisplayTitle(draft).Contains(_switcherFilter, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private string? DraftRunStatusLabel(string draftId)
    {
        var activeJobIds = Queue.GetActiveJobIdsForDraft(draftId);
        if (activeJobIds.Count == 0) return null;
        if (activeJobIds.Count > 1) return Strings["ActiveRunsCount", activeJobIds.Count].Value;
        var status = Queue.GetJobStatus(activeJobIds[0]);
        if (status is null) return null;
        return status.Phase switch
        {
            GenerationJobPhase.Queued => Strings["QueuePosition", status.QueuePosition ?? 0].Value,
            GenerationJobPhase.Running => Strings["Generating"].Value,
            GenerationJobPhase.Monitoring => Strings["MonitoringAsyncJob"].Value,
            GenerationJobPhase.DependencyRecycled => Strings["DependencyRecycledNotice"].Value,
            _ => null
        };
    }

    private bool IsFirstDraft(GenerationDraft draft) => _drafts.OrderBy(candidate => candidate.TabOrder).First().Id == draft.Id;
    private bool IsLastDraft(GenerationDraft draft) => _drafts.OrderBy(candidate => candidate.TabOrder).Last().Id == draft.Id;

    private async Task MoveDraftAsync(string draftId, int direction)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        var ordered = _drafts.OrderBy(candidate => candidate.TabOrder).Select(candidate => candidate.Id).ToList();
        var index = ordered.IndexOf(draftId);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= ordered.Count) return;
        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        _drafts = await workspace.ReorderDraftsAsync(ordered);
    }

    private void BeginCloseDraft(string draftId)
    {
        _closingDraftId = draftId;
        _closeSaveIntentActive = false;
        _closeSaveTitle = string.Empty;
        _closeError = null;
    }

    private void BeginSaveAndCloseDraft()
    {
        _closeSaveIntentActive = true;
        _closeSaveTitle = string.Empty;
        _closeError = null;
    }

    private async Task SaveAsSettingsAndCloseDraftAsync(string draftId)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || string.IsNullOrWhiteSpace(_closeSaveTitle)) return;
        var draft = _drafts.FirstOrDefault(candidate => candidate.Id == draftId);
        if (draft is null) return;
        try
        {
            await workspace.CreateSavedSettingAsync(_closeSaveTitle, draft.ModelId, draft.Prompt, draft.ResultCount, draft.DestinationFolderId, draft.SystemInstructions, draft.SourceFileId, draft.Settings, draft.SecondarySourceFileId, draft.TertiarySourceFileId);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _closeError = exception.Message;
            return;
        }

        _closeSaveIntentActive = false;
        await ConfirmCloseDraftAsync(draftId);
        _message = Strings["SavedSettingsSaved"];
        _isError = false;
    }

    private async Task ConfirmCloseDraftAsync(string draftId)
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null) return;
        if (draftId == _activeDraftId)
        {
            _autosaveCts?.Cancel();
            _autosaveCts = null;
        }
        await workspace.DeleteDraftAsync(draftId);
        _drafts = _drafts.Where(draft => draft.Id != draftId).ToArray();
        _closingDraftId = null;
        if (_drafts.Count == 0)
        {
            var fresh = await workspace.CreateDraftAsync();
            _drafts = [fresh];
            await LoadDraftIntoFormAsync(fresh.Id);
        }
        else if (_activeDraftId == draftId)
        {
            await LoadDraftIntoFormAsync(_drafts.OrderBy(draft => draft.TabOrder).First().Id);
        }
    }

    private string DraftDisplayTitle(GenerationDraft? draft)
    {
        if (draft is null) return string.Empty;
        if (!string.IsNullOrEmpty(draft.CustomTitle)) return draft.CustomTitle;
        var untitledOrdered = _drafts.Where(candidate => string.IsNullOrEmpty(candidate.CustomTitle)).OrderBy(candidate => candidate.TabOrder).ToList();
        var index = untitledOrdered.FindIndex(candidate => candidate.Id == draft.Id) + 1;
        return Strings["UntitledDraftTitle", index];
    }

    private void ScheduleAutosave()
    {
        if (_activeDraftId is not null) LibraryState.MarkDraftDirty(_activeDraftId);
        _autosaveCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autosaveCts = cts;
        _saveStatus = SaveStatus.Saving;
        _ = AutosaveAfterDelayAsync(cts.Token);
    }

    private async Task AutosaveAfterDelayAsync(CancellationToken token)
    {
        try { await Task.Delay(TimeSpan.FromMilliseconds(800), token); }
        catch (TaskCanceledException) { return; }
        if (token.IsCancellationRequested) return;
        await PersistCurrentDraftAsync();
        if (!token.IsCancellationRequested) StateHasChanged();
    }

    private async Task FlushPendingAutosaveAsync()
    {
        _autosaveCts?.Cancel();
        _autosaveCts = null;
        if (_activeDraftId is not null) await PersistCurrentDraftAsync();
    }

    private async Task PersistCurrentDraftAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _activeDraftId is null) return;
        var draftId = _activeDraftId;
        var editToken = LibraryState.MarkDraftDirty(draftId);
        try
        {
            _saveStatus = SaveStatus.Saving;
            var systemInstructions = SelectedModel?.SupportsSystemInstructions == true && !string.IsNullOrWhiteSpace(_form.SystemInstructions) ? _form.SystemInstructions : null;
            var sourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.SourceFileId) ? _form.SourceFileId : null;
            var secondarySourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.SecondarySourceFileId) ? _form.SecondarySourceFileId : null;
            var tertiarySourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.TertiarySourceFileId) ? _form.TertiarySourceFileId : null;
            var improvementModelId = string.IsNullOrEmpty(_improvementModelId) ? null : _improvementModelId;
            var improvementGuidance = string.IsNullOrWhiteSpace(_improvementGuidance) ? null : _improvementGuidance;
            var updated = await workspace.ReplaceDraftStateAsync(draftId, _tabTitleInput, string.IsNullOrEmpty(_form.ModelId) ? null : _form.ModelId, _form.Prompt, systemInstructions, sourceFileId, _form.ResultCount, _form.DestinationFolderId, improvementModelId, improvementGuidance, CurrentGenerationSettings(), secondarySourceFileId, tertiarySourceFileId);
            _drafts = _drafts.Select(existing => existing.Id == updated.Id ? updated : existing).ToArray();
            _saveError = null;
            _saveStatus = SaveStatus.Saved;
            LibraryState.ClearDirtyDraft(draftId, editToken);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _saveError = exception.Message;
            _saveStatus = SaveStatus.NotSaved;
        }
    }

    private async Task RetrySaveAsync() => await PersistCurrentDraftAsync();

    private async Task ResetTabTitleAsync()
    {
        _autosaveCts?.Cancel();
        _autosaveCts = null;
        _tabTitleInput = string.Empty;
        await PersistCurrentDraftAsync();
    }

