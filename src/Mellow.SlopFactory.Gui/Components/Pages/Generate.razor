    private bool HasDuplicateSourceSelection
    {
        get
        {
            string?[] ids = [string.IsNullOrEmpty(_form.SourceFileId) ? null : _form.SourceFileId, string.IsNullOrEmpty(_form.SecondarySourceFileId) ? null : _form.SecondarySourceFileId, string.IsNullOrEmpty(_form.TertiarySourceFileId) ? null : _form.TertiarySourceFileId];
            for (var i = 0; i < ids.Length; i++)
            {
                if (ids[i] is null) continue;
                for (var j = i + 1; j < ids.Length; j++)
                {
                    if (ids[i] == ids[j]) return true;
                }
            }
            return false;
        }
    }

