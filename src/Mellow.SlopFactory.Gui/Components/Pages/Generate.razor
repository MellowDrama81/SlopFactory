    private void ApplySavedSettingsResult(SavedGenerationSetting saved)
    {
        _loadedSettingsId = saved.Id;
        _loadedTitle = saved.Title;
        _loadedRevision = saved.Revision;
        _message = Strings["SavedSettingsSaved"];
        _isError = false;
    }

    private void GenerateAsync()
    {
        _busy = true;
        try
        {
            var workspace = LibraryState.Workspace;
            if (workspace is null || _activeDraftId is null) return;
            var model = _models.FirstOrDefault(candidate => candidate.Id == _form.ModelId);
            if (model is null) return;
            var connection = _activeConnections.FirstOrDefault(candidate => candidate.Id == model.ConnectionId);
            if (connection is null)
            {
                _message = Strings["ConnectionUnavailableForModel"];
                _isError = true;
                return;
            }
            if (CredentialBlocked(connection))
            {
                _message = connection.CredentialRequiresRepair ? Strings["CredentialRequiresRepairBanner"] : Strings["GenerationBlockedCredentialsRequired"];
                _isError = true;
                return;
            }

            if (HasDuplicateSourceSelection) return;

            var systemInstructions = model.SupportsSystemInstructions && !string.IsNullOrWhiteSpace(_form.SystemInstructions) ? _form.SystemInstructions : null;
            var sourceFileId = string.IsNullOrEmpty(_form.SourceFileId) ? null : _form.SourceFileId;
            var secondarySourceFileId = string.IsNullOrEmpty(_form.SecondarySourceFileId) ? null : _form.SecondarySourceFileId;
            var tertiarySourceFileId = string.IsNullOrEmpty(_form.TertiarySourceFileId) ? null : _form.TertiarySourceFileId;
            GenerationSettings settings;
            try { settings = LibraryRules.ValidateGenerationSettings(CurrentGenerationSettings()); }
            catch (LibraryValidationException exception)
            {
                _message = exception.Message;
                _isError = true;
                return;
            }
            var snapshot = new GenerationJobSnapshot(_activeDraftId, DraftDisplayTitle(ActiveDraft), model.Mode, model.Id, _form.Prompt, systemInstructions, sourceFileId, _form.ResultCount, _form.DestinationFolderId, _acceptedImprovementRecordId, settings, secondarySourceFileId, tertiarySourceFileId);
            Queue.Enqueue(snapshot, model.ConnectionId);
            _message = null;
            _isError = false;
        }
        finally { _busy = false; }
    }

    private async Task ImprovePromptAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || string.IsNullOrEmpty(_improvementModelId) || string.IsNullOrWhiteSpace(_form.Prompt)) return;
        var improvementModel = _models.FirstOrDefault(candidate => candidate.Id == _improvementModelId);
        if (improvementModel is null) return;
        var connection = _activeConnections.FirstOrDefault(candidate => candidate.Id == improvementModel.ConnectionId);
        if (connection is null)
        {
            _message = Strings["ConnectionUnavailableForModel"];
            _isError = true;
            return;
        }
        if (CredentialBlocked(connection))
        {
            _message = connection.CredentialRequiresRepair ? Strings["CredentialRequiresRepairBanner"] : Strings["GenerationBlockedCredentialsRequired"];
            _isError = true;
            return;
        }

        _improving = true;
        _improvementCandidates = null;
        _acceptedImprovementRecordId = null;
        var guidance = string.IsNullOrWhiteSpace(_improvementGuidance) ? null : _improvementGuidance;
        IReadOnlyList<string>? candidates = null;
        string? attemptError = null;
        int? promptTokens = null;
        int? completionTokens = null;
        try
        {
            var adapter = AdapterResolver.Resolve(connection.ProviderType);
            var apiKey = connection is { HasCredential: true, CredentialRevisionId: { } revisionId } ? await Credentials.GetActiveAsync(workspace.Descriptor.LibraryId, connection.Id, revisionId) : null;
            var outputModeLabel = SelectedModelMode switch
            {
                GenerationMode.Image => "image",
                GenerationMode.Audio => "audio",
                GenerationMode.Video => "video",
                _ => "text"
            };
            var template = string.Format(PromptImprovementTemplate, outputModeLabel);
            if (guidance is not null)
            {
                template = $"{template} Additional guidance from the user: {guidance}";
            }

            var result = await adapter.GenerateTextAsync(connection, improvementModel, apiKey, _form.Prompt, 1, template);
            candidates = result.Texts;
            promptTokens = result.PromptTokens;
            completionTokens = result.CompletionTokens;
            _improvementCandidates = candidates;
            _message = null;
        }
        catch (Exception exception) when (exception is ProviderAdapterException or HttpRequestException)
        {
            attemptError = exception.Message;
            _message = exception.Message;
            _isError = true;
        }
        finally
        {
            try
            {
                var record = await workspace.RecordPromptImprovementAttemptAsync(improvementModel.Id, _form.Prompt, guidance, PromptImprovementTemplateVersion, candidates, attemptError, promptTokens, completionTokens);
                _lastImprovementRecordId = record.Id;
            }
            catch (SlopFactoryException)
            {
                _lastImprovementRecordId = null;
            }
            _improving = false;
        }
    }

    private void UseImprovedPrompt(string candidate)
    {
        _form.Prompt = candidate;
        _acceptedImprovementRecordId = _lastImprovementRecordId;
        _improvementCandidates = null;
        ScheduleAutosave();
    }

