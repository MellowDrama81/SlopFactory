    private string FolderPath(string folderId)
    {
        var names = new Stack<string>();
        var current = _activeFolders.FirstOrDefault(folder => folder.Id == folderId);
        while (current is not null)
        {
            names.Push(current.Name);
            current = current.ParentId is { } parentId ? _activeFolders.FirstOrDefault(folder => folder.Id == parentId) : null;
        }
        return names.Count == 0 ? Strings["UnknownFolder"] : string.Join(" / ", names);
    }

    private string ResolveSourceFileName(string? fileId) =>
        fileId is null ? Strings["ReviewChangesNoValue"] : _activeImageFiles.FirstOrDefault(file => file.Id == fileId)?.DisplayName ?? Strings["UnknownFile"];

    private string ResolveSettingValue(double? value) => value?.ToString() ?? Strings["UseProviderDefault"];
    private string ResolveSettingValue(int? value) => value?.ToString() ?? Strings["UseProviderDefault"];

    private IReadOnlyList<(string Field, string Mine, string Theirs)> BuildConflictDiffRows()
    {
        if (_settingsConflict is not { } conflict) return [];
        var (systemInstructions, sourceFileId, secondarySourceFileId, tertiarySourceFileId) = CurrentSavedSettingFields();
        var settings = CurrentGenerationSettings();
        var rows = new List<(string Field, string Mine, string Theirs)>
        {
            (Strings["ReviewChangesModelField"], SelectedModel?.Label ?? Strings["Unavailable"], conflict.ModelLabel),
            (Strings["ReviewChangesPromptField"], _form.Prompt, conflict.Prompt),
            (Strings["ReviewChangesSystemInstructionsField"], systemInstructions ?? Strings["ReviewChangesNoValue"], conflict.SystemInstructions ?? Strings["ReviewChangesNoValue"]),
            (Strings["ReviewChangesSourceFileField"], ResolveSourceFileName(sourceFileId), ResolveSourceFileName(conflict.SourceFileId)),
            (Strings["ReviewChangesSecondarySourceFileField"], ResolveSourceFileName(secondarySourceFileId), ResolveSourceFileName(conflict.SecondarySourceFileId)),
            (Strings["ReviewChangesTertiarySourceFileField"], ResolveSourceFileName(tertiarySourceFileId), ResolveSourceFileName(conflict.TertiarySourceFileId)),
            (Strings["ReviewChangesDestinationField"], FolderPath(_form.DestinationFolderId), FolderPath(conflict.DestinationFolderId)),
            (Strings["ReviewChangesResultCountField"], _form.ResultCount.ToString(), conflict.ResultCount.ToString()),
            (Strings["ReviewChangesTemperatureField"], ResolveSettingValue(settings.Temperature), ResolveSettingValue(conflict.Settings.Temperature)),
            (Strings["ReviewChangesTopPField"], ResolveSettingValue(settings.TopP), ResolveSettingValue(conflict.Settings.TopP)),
            (Strings["ReviewChangesMaxTokensField"], ResolveSettingValue(settings.MaxTokens), ResolveSettingValue(conflict.Settings.MaxTokens)),
            (Strings["ReviewChangesFrequencyPenaltyField"], ResolveSettingValue(settings.FrequencyPenalty), ResolveSettingValue(conflict.Settings.FrequencyPenalty)),
            (Strings["ReviewChangesPresencePenaltyField"], ResolveSettingValue(settings.PresencePenalty), ResolveSettingValue(conflict.Settings.PresencePenalty))
        };
        if (!string.Equals(settings.AdvancedJson, conflict.Settings.AdvancedJson, StringComparison.Ordinal))
        {
            rows.Add((Strings["ReviewChangesAdvancedGenerationSettingsField"], Strings["AdvancedGenerationSettingsConfigured"], Strings["AdvancedGenerationSettingsChanged"]));
        }
        return rows.Where(row => !string.Equals(row.Mine, row.Theirs, StringComparison.Ordinal)).ToList();
    }

    private async Task SaveInPlaceAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _loadedSettingsId is null || string.IsNullOrWhiteSpace(_settingsTitle)) return;
        _busy = true;
        try
        {
            SavedGenerationSetting? current;
            try
            {
                current = await workspace.GetSavedSettingAsync(_loadedSettingsId);
            }
            catch (RecordNotFoundException)
            {
                current = null;
            }

            if (current is null)
            {
                _loadedSettingsId = null;
                _loadedTitle = null;
                _loadedRevision = 0;
                _message = Strings["SavedSettingsSourceDeleted"];
                _isError = true;
                return;
            }
            if (current.State != LibraryRecordState.Active)
            {
                _settingsRecycledConflict = current;
                return;
            }

            var (systemInstructions, sourceFileId, secondarySourceFileId, tertiarySourceFileId) = CurrentSavedSettingFields();
            var saved = await workspace.UpdateSavedSettingAsync(_loadedSettingsId, _loadedRevision, _settingsTitle, _form.ModelId, _form.Prompt, _form.ResultCount, _form.DestinationFolderId, systemInstructions, sourceFileId, CurrentGenerationSettings(), secondarySourceFileId, tertiarySourceFileId);
            ApplySavedSettingsResult(saved);
        }
        catch (SavedSettingRevisionConflictException exception)
        {
            _settingsConflict = exception.Current;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally { _busy = false; }
    }

    private async Task RestoreAndUpdateSavedSettingAsync()
    {
        var workspace = LibraryState.Workspace;
        if (workspace is null || _settingsRecycledConflict is null || _loadedSettingsId is null) return;
        _busy = true;
        try
        {
            await workspace.RestoreSavedSettingAsync(_loadedSettingsId);
            var (systemInstructions, sourceFileId, secondarySourceFileId, tertiarySourceFileId) = CurrentSavedSettingFields();
            var saved = await workspace.UpdateSavedSettingAsync(_loadedSettingsId, _settingsRecycledConflict.Revision, _settingsTitle, _form.ModelId, _form.Prompt, _form.ResultCount, _form.DestinationFolderId, systemInstructions, sourceFileId, CurrentGenerationSettings(), secondarySourceFileId, tertiarySourceFileId);
            ApplySavedSettingsResult(saved);
            _settingsRecycledConflict = null;
        }
        catch (SavedSettingRevisionConflictException exception)
        {
            _settingsConflict = exception.Current;
            _settingsRecycledConflict = null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally { _busy = false; }
    }

