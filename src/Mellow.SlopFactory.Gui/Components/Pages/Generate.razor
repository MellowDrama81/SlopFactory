    private (string? SystemInstructions, string? SourceFileId, string? SecondarySourceFileId, string? TertiarySourceFileId) CurrentSavedSettingFields()
    {
        var systemInstructions = SelectedModel?.SupportsSystemInstructions == true && !string.IsNullOrWhiteSpace(_form.SystemInstructions) ? _form.SystemInstructions : null;
        var sourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.SourceFileId) ? _form.SourceFileId : null;
        var secondarySourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.SecondarySourceFileId) ? _form.SecondarySourceFileId : null;
        var tertiarySourceFileId = SelectedModelMode == GenerationMode.Text && !string.IsNullOrEmpty(_form.TertiarySourceFileId) ? _form.TertiarySourceFileId : null;
        return (systemInstructions, sourceFileId, secondarySourceFileId, tertiarySourceFileId);
    }

    private GenerationSettings CurrentGenerationSettings() => SelectedModelMode == GenerationMode.Text
        ? new GenerationSettings(_form.Temperature, _form.TopP, _form.MaxTokens, _form.FrequencyPenalty, _form.PresencePenalty, _form.AdvancedJson)
        : GenerationSettings.Empty;

