@page "/generate"
@page "/generate/{SettingsId}"
@page "/generate/history/{HistoryId}"
@implements IAsyncDisposable
@inject AppLibraryState LibraryState
@inject GenerationQueueService Queue
@inject ISecureCredentialStore Credentials
@inject IProviderAdapterResolver AdapterResolver
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources
@using Mellow.SlopFactory.Infrastructure.Providers
@using Microsoft.AspNetCore.Components.Web.Virtualization

<PageTitle>@Strings["GeneratePageTitle"]</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">@Strings["GenerateEyebrow"]</p><h1>@Strings["GenerateHeading"]</h1><p class="muted">@Strings["GenerateDescription"]</p></div>
    <a class="button" href="/saved-settings">@Strings["SavedSettingsHeading"]</a>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "error" : "")" role="@(_isError ? "alert" : "status")">@_message</div>
}

@if (LibraryState.Workspace is null)
{
    <p class="empty">@Strings["NoLocationOpen"]</p>
}
else if (_models.Count == 0 && _hasNeedsReviewModels)
{
    <p class="empty">@Strings["AllModelsNeedReview"] <a href="/models">@Strings["ModelsHeading"]</a></p>
}
else if (_models.Count == 0)
{
    <p class="empty">@Strings["AddModelFirst"] <a href="/models/new">@Strings["AddModel"]</a></p>
}
else
{
    @if (OperatingSystem.IsAndroid())
    {
        <button type="button" class="tab-switcher-compact" @onclick="() => _switcherOpen = true">
            @Strings["TabSwitcherCompactLabel", DraftDisplayTitle(ActiveDraft), ActiveDraftPosition, _drafts.Count]
        </button>
    }
    else
    {
        <div class="tab-strip">
            @foreach (var draft in _drafts.OrderBy(candidate => candidate.TabOrder))
            {
                <div class="tab @(draft.Id == _activeDraftId ? "active" : "")">
                    @if (_closingDraftId == draft.Id && _closeSaveIntentActive)
                    {
                        <span class="tab-close-confirm" role="dialog" aria-label="@Strings["CloseTab"]">
                            <input maxlength="100" placeholder="@Strings["SettingsTitle"]" @bind="_closeSaveTitle" />
                            @if (_closeError is not null)
                            {
                                <span class="error">@_closeError</span>
                            }
                            <button type="button" class="secondary" disabled="@string.IsNullOrWhiteSpace(_closeSaveTitle)" @onclick="() => SaveAsSettingsAndCloseDraftAsync(draft.Id)">@Strings["SaveAndCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="() => _closeSaveIntentActive = false">@Strings["BackToCloseOptions"]</button>
                        </span>
                    }
                    else if (_closingDraftId == draft.Id)
                    {
                        <span class="tab-close-confirm" role="dialog" aria-label="@Strings["CloseTab"]">
                            @Strings["CloseTabConfirmMessage"]
                            <button type="button" class="danger" @onclick="() => ConfirmCloseDraftAsync(draft.Id)">@Strings["ConfirmCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="BeginSaveAndCloseDraft">@Strings["SaveSettingsAndCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="() => _closingDraftId = null">@Strings["CancelCloseTab"]</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="tab-move" title="@Strings["MoveTabLeft"]" aria-label="@Strings["MoveTabLeft"]" disabled="@IsFirstDraft(draft)" @onclick="() => MoveDraftAsync(draft.Id, -1)">‹</button>
                        <button type="button" class="tab-select" @onclick="() => SwitchToDraftAsync(draft.Id)">@DraftDisplayTitle(draft)</button>
                        <button type="button" class="tab-move" title="@Strings["MoveTabRight"]" aria-label="@Strings["MoveTabRight"]" disabled="@IsLastDraft(draft)" @onclick="() => MoveDraftAsync(draft.Id, 1)">›</button>
                        <button type="button" class="tab-close" title="@Strings["CloseTab"]" aria-label="@Strings["CloseTab"]" disabled="@(Queue.GetActiveJobIdsForDraft(draft.Id).Count > 0)" @onclick="() => BeginCloseDraft(draft.Id)">×</button>
                    }
                </div>
            }
            <button type="button" class="tab-add" title="@Strings["AddDraftTab"]" aria-label="@Strings["AddDraftTab"]" @onclick="AddDraftAsync">+</button>
        </div>
        <button type="button" class="secondary" @onclick="() => _switcherOpen = true">@Strings["ManageTabs"]</button>
    }

    @if (_switcherOpen)
    {
        <div class="tab-switcher" role="dialog" aria-label="@Strings["ManageTabs"]">
            <div class="inline-form">
                <input type="search" aria-label="@Strings["SearchTabs"]" placeholder="@Strings["SearchTabs"]" @bind="_switcherFilter" @bind:event="oninput" />
                <button type="button" class="secondary" @onclick="AddDraftAsync">@Strings["AddDraftTab"]</button>
                <button type="button" class="secondary" @onclick="() => _switcherOpen = false">@Strings["CloseTabSwitcher"]</button>
            </div>
            <ul>
            <Virtualize Items="FilteredSwitcherDrafts()" Context="draft">
                <li class="@(draft.Id == _activeDraftId ? "active" : "")">
                    @if (_switcherRenamingDraftId == draft.Id)
                    {
                        <input maxlength="100" @bind="_switcherRenameTitle" />
                        <button type="button" class="secondary" disabled="@string.IsNullOrWhiteSpace(_switcherRenameTitle)" @onclick="() => CommitSwitcherRenameAsync(draft.Id)">@Strings["Save"]</button>
                        <button type="button" class="secondary" @onclick="() => _switcherRenamingDraftId = null">@Strings["Cancel"]</button>
                    }
                    else if (_closingDraftId == draft.Id && _closeSaveIntentActive)
                    {
                        <span class="tab-close-confirm" role="dialog" aria-label="@Strings["CloseTab"]">
                            <input maxlength="100" placeholder="@Strings["SettingsTitle"]" @bind="_closeSaveTitle" />
                            @if (_closeError is not null)
                            {
                                <span class="error">@_closeError</span>
                            }
                            <button type="button" class="secondary" disabled="@string.IsNullOrWhiteSpace(_closeSaveTitle)" @onclick="() => SaveAsSettingsAndCloseDraftAsync(draft.Id)">@Strings["SaveAndCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="() => _closeSaveIntentActive = false">@Strings["BackToCloseOptions"]</button>
                        </span>
                    }
                    else if (_closingDraftId == draft.Id)
                    {
                        <span class="tab-close-confirm" role="dialog" aria-label="@Strings["CloseTab"]">
                            @Strings["CloseTabConfirmMessage"]
                            <button type="button" class="danger" @onclick="() => ConfirmCloseDraftAsync(draft.Id)">@Strings["ConfirmCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="BeginSaveAndCloseDraft">@Strings["SaveSettingsAndCloseTab"]</button>
                            <button type="button" class="secondary" @onclick="() => _closingDraftId = null">@Strings["CancelCloseTab"]</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="tab-move" title="@Strings["MoveTabLeft"]" aria-label="@Strings["MoveTabLeft"]" disabled="@IsFirstDraft(draft)" @onclick="() => MoveDraftAsync(draft.Id, -1)">‹</button>
                        <button type="button" class="tab-select" @onclick="() => SelectFromSwitcherAsync(draft.Id)">
                            @DraftDisplayTitle(draft)
                            @{ var status = DraftRunStatusLabel(draft.Id); }
                            @if (status is not null)
                            {
                                <span class="tab-status">@status</span>
                            }
                        </button>
                        <button type="button" class="tab-move" title="@Strings["MoveTabRight"]" aria-label="@Strings["MoveTabRight"]" disabled="@IsLastDraft(draft)" @onclick="() => MoveDraftAsync(draft.Id, 1)">›</button>
                        <button type="button" class="secondary" @onclick="() => BeginSwitcherRename(draft)">@Strings["RenameTabAction"]</button>
                        <button type="button" class="secondary" @onclick="() => DuplicateDraftAsync(draft.Id)">@Strings["DuplicateTab"]</button>
                        <button type="button" class="tab-close" title="@Strings["CloseTab"]" aria-label="@Strings["CloseTab"]" disabled="@(Queue.GetActiveJobIdsForDraft(draft.Id).Count > 0)" @onclick="() => BeginCloseDraft(draft.Id)">×</button>
                    }
                </li>
            </Virtualize>
            </ul>
        </div>
    }

    <div class="inline-form">
        <label for="tab-title">@Strings["TabTitle"]</label>
        <input id="tab-title" maxlength="100" placeholder="@DraftDisplayTitle(ActiveDraft)" @bind="_tabTitleInput" @bind:after="ScheduleAutosave" disabled="@FormDisabled" />
        @if (!string.IsNullOrEmpty(ActiveDraft?.CustomTitle))
        {
            <button type="button" class="secondary" @onclick="ResetTabTitleAsync">@Strings["ResetTabTitle"]</button>
        }
        <button type="button" class="secondary" @onclick="DuplicateActiveDraftAsync">@Strings["DuplicateTab"]</button>
    </div>

    @if (_saveStatus != SaveStatus.Idle)
    {
        <p class="muted save-status">
            @(_saveStatus switch
            {
                SaveStatus.Saving => Strings["DraftSaving"],
                SaveStatus.Saved => Strings["DraftSaved"],
                SaveStatus.NotSaved => Strings["DraftNotSaved"],
                _ => string.Empty
            })
            @if (_saveStatus == SaveStatus.NotSaved)
            {
                <button type="button" class="secondary" @onclick="RetrySaveAsync">@Strings["RetrySaveAction"]</button>
            }
        </p>
    }

    <EditForm Model="_form" OnValidSubmit="GenerateAsync" class="stack-form">
        <label for="generate-model">@Strings["Model"]</label>
        <InputSelect id="generate-model" @bind-Value="_form.ModelId" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled">
            @if (string.IsNullOrEmpty(_form.ModelId))
            {
                <option value="">@Strings["ChooseReplacementModel"]</option>
            }
            @foreach (var model in _models)
            {
                <option value="@model.Id">@model.Label (@ModeLabel(model.Mode))</option>
            }
        </InputSelect>

        @if (_recycledModel is not null)
        {
            <div class="notice error" role="alert">
                @Strings["DraftModelRecycled", _recycledModel.Label]
                <button type="button" class="secondary" disabled="@_busy" @onclick="RestoreDraftModelAsync">@Strings["RestoreModelAction"]</button>
            </div>
        }

        @if (SelectedConnection is not null && CredentialBlocked(SelectedConnection))
        {
            <div class="notice error" role="alert">@(SelectedConnection.CredentialRequiresRepair ? Strings["CredentialRequiresRepairBanner"] : Strings["GenerationBlockedCredentialsRequired"]) <a href="@($"/connections/{SelectedConnection.Id}")">@Strings["AddApiKey"]</a></div>
        }
        else if (SelectedConnection is not null && SelectedConnection.IsUnverified)
        {
            <div class="notice" role="status">@Strings["ConnectionUnverifiedWarning"]</div>
        }

        @if (SelectedModelMode == GenerationMode.Text)
        {
            @if (SelectedModel?.SupportsSystemInstructions == true)
            {
                <label for="generate-system-instructions">@Strings["SystemInstructions"]</label>
                <textarea id="generate-system-instructions" rows="3" maxlength="1048576" @bind="_form.SystemInstructions" @bind:event="oninput" @bind:after="ScheduleAutosave" disabled="@FormDisabled"></textarea>
            }
            else
            {
                <p class="muted">@Strings["ModelDoesNotSupportSystemInstructions"]</p>
            }

            <label for="generate-source-image">@Strings["SourceImageSlot1"]</label>
            <InputSelect id="generate-source-image" @bind-Value="_form.SourceFileId" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled">
                <option value="">@Strings["NoSourceImage"]</option>
                @foreach (var file in _activeImageFiles)
                {
                    <option value="@file.Id">@file.DisplayName</option>
                }
            </InputSelect>

            <label for="generate-source-image-2">@Strings["SourceImageSlot2"]</label>
            <InputSelect id="generate-source-image-2" @bind-Value="_form.SecondarySourceFileId" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled">
                <option value="">@Strings["NoSourceImage"]</option>
                @foreach (var file in _activeImageFiles)
                {
                    <option value="@file.Id">@file.DisplayName</option>
                }
            </InputSelect>

            <label for="generate-source-image-3">@Strings["SourceImageSlot3"]</label>
            <InputSelect id="generate-source-image-3" @bind-Value="_form.TertiarySourceFileId" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled">
                <option value="">@Strings["NoSourceImage"]</option>
                @foreach (var file in _activeImageFiles)
                {
                    <option value="@file.Id">@file.DisplayName</option>
                }
            </InputSelect>

            @if (HasDuplicateSourceSelection)
            {
                <p class="notice error" role="alert">@Strings["DuplicateSourceSelectionError"]</p>
            }

            <details>
                <summary>@Strings["GenerationSettingsHeading"]</summary>
                <label for="generate-temperature">@Strings["Temperature"]</label>
                <InputNumber id="generate-temperature" @bind-Value="_form.Temperature" @bind-Value:after="ScheduleAutosave" step="0.1" disabled="@FormDisabled" />
                <p class="muted">@Strings["TemperatureHelp", LibraryRules.MinTemperature, LibraryRules.MaxTemperature]</p>

                <label for="generate-top-p">@Strings["TopP"]</label>
                <InputNumber id="generate-top-p" @bind-Value="_form.TopP" @bind-Value:after="ScheduleAutosave" step="0.1" disabled="@FormDisabled" />
                <p class="muted">@Strings["TopPHelp", LibraryRules.MinTopP, LibraryRules.MaxTopP]</p>

                <label for="generate-max-tokens">@Strings["MaxTokens"]</label>
                <InputNumber id="generate-max-tokens" @bind-Value="_form.MaxTokens" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled" />
                <p class="muted">@Strings["MaxTokensHelp", LibraryRules.MinMaxTokens]</p>

                <label for="generate-frequency-penalty">@Strings["FrequencyPenalty"]</label>
                <InputNumber id="generate-frequency-penalty" @bind-Value="_form.FrequencyPenalty" @bind-Value:after="ScheduleAutosave" step="0.1" disabled="@FormDisabled" />
                <p class="muted">@Strings["FrequencyPenaltyHelp", LibraryRules.MinFrequencyPenalty, LibraryRules.MaxFrequencyPenalty]</p>

                <label for="generate-presence-penalty">@Strings["PresencePenalty"]</label>
                <InputNumber id="generate-presence-penalty" @bind-Value="_form.PresencePenalty" @bind-Value:after="ScheduleAutosave" step="0.1" disabled="@FormDisabled" />
                <p class="muted">@Strings["PresencePenaltyHelp", LibraryRules.MinPresencePenalty, LibraryRules.MaxPresencePenalty]</p>

                <label for="generate-advanced-settings">@Strings["AdvancedGenerationSettings"]</label>
                <textarea id="generate-advanced-settings" rows="5" maxlength="65536" @bind="_form.AdvancedJson" @bind:event="oninput" @bind:after="ScheduleAutosave" disabled="@FormDisabled"></textarea>
                <p class="muted">@Strings["AdvancedGenerationSettingsHelp", LibraryRules.MaximumAdvancedGenerationSettingsJsonBytes]</p>
                @if (AdvancedSettingsPreview is { } preview)
                {
                    <p class="muted">@Strings["AdvancedGenerationSettingsPreview"]</p>
                    <pre class="metadata-list">@preview</pre>
                }
            </details>
        }

        <label for="generate-prompt">@Strings["Prompt"]</label>
        <textarea id="generate-prompt" rows="8" maxlength="1048576" @bind="_form.Prompt" @bind:event="oninput" @bind:after="ScheduleAutosave" disabled="@FormDisabled"></textarea>
        @if (SelectedModelMode == GenerationMode.Text)
        {
            <p class="muted">@Strings["EstimatedTokenCount", EstimatedTokenCount]</p>
        }

        <label for="generate-count">@Strings["ResultCount"]</label>
        <InputNumber id="generate-count" @bind-Value="_form.ResultCount" @bind-Value:after="ScheduleAutosave" min="1" max="4" disabled="@FormDisabled" />

        <label for="generate-folder">@Strings["DestinationFolder"]</label>
        <InputSelect id="generate-folder" @bind-Value="_form.DestinationFolderId" @bind-Value:after="ScheduleAutosave" disabled="@FormDisabled">
            @foreach (var folder in _activeFolders)
            {
                <option value="@folder.Id">@FolderPath(folder.Id)</option>
            }
        </InputSelect>

        <p class="muted">@Strings["CostUnknownNotice"]</p>

        <div class="actions">
            <button type="submit" disabled="@(FormDisabled || string.IsNullOrEmpty(_form.ModelId) || (SelectedConnection is not null && CredentialBlocked(SelectedConnection)) || HasDuplicateSourceSelection)">
                @Strings["Generate"]
            </button>
        </div>
    </EditForm>

    @if (_models.Any(candidate => candidate.Mode == GenerationMode.Text))
    {
        <section class="panel">
            <h2>@Strings["PromptImprovementHeading"]</h2>
            <p class="muted">@Strings["PromptImprovementDescription"]</p>
            <label for="improvement-model">@Strings["ImprovementModel"]</label>
            <select id="improvement-model" @bind="_improvementModelId" @bind:after="ScheduleAutosave" disabled="@(FormDisabled || _improving)">
                <option value="">@Strings["NoImprovementModel"]</option>
                @foreach (var textModel in _models.Where(candidate => candidate.Mode == GenerationMode.Text))
                {
                    <option value="@textModel.Id">@textModel.Label</option>
                }
            </select>

            <label for="improvement-guidance">@Strings["ImprovementGuidance"]</label>
            <textarea id="improvement-guidance" rows="2" maxlength="1048576" @bind="_improvementGuidance" @bind:after="ScheduleAutosave" disabled="@(FormDisabled || _improving)"></textarea>

            <p class="muted">@Strings["CostUnknownNotice"]</p>

            <div class="actions">
                <button type="button" class="secondary" disabled="@(FormDisabled || _improving || string.IsNullOrEmpty(_improvementModelId) || string.IsNullOrWhiteSpace(_form.Prompt))" @onclick="ImprovePromptAsync">@(_improving ? Strings["ImprovingPrompt"] : Strings["ImprovePromptAction"])</button>
            </div>

            @if (_improvementCandidates is not null)
            {
                @if (_improvementCandidates.Count == 0)
                {
                    <p class="empty">@Strings["NoImprovementCandidates"]</p>
                }
                else
                {
                    <ul class="metadata-list">
                        @foreach (var candidate in _improvementCandidates)
                        {
                            <li>
                                <p>@candidate</p>
                                <button type="button" class="secondary" @onclick="() => UseImprovedPrompt(candidate)">@Strings["UseThisCandidate"]</button>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }

    <section class="panel">
        <h2>@Strings["SaveSettingsHeading"]</h2>
        <p class="muted">@Strings["SaveSettingsDescription"]</p>
        @if (_settingsConflict is not null)
        {
            <div class="notice error" role="dialog" aria-label="@Strings["SavedSettingsConflictTitle"]">
                <p>@Strings["SavedSettingsConflictMessage"]</p>
                <details>
                    <summary>@Strings["ReviewChangesSummary"]</summary>
                    @{ var diffRows = BuildConflictDiffRows(); }
                    @if (diffRows.Count == 0)
                    {
                        <p class="muted">@Strings["ReviewChangesNoDifferences"]</p>
                    }
                    else
                    {
                        <dl>
                            @foreach (var row in diffRows)
                            {
                                <dt>@row.Field</dt>
                                <dd>@Strings["ReviewChangesYourVersionColumn"]: @row.Mine</dd>
                                <dd>@Strings["ReviewChangesSavedVersionColumn"]: @row.Theirs</dd>
                            }
                        </dl>
                    }
                </details>
                <div class="actions">
                    <button type="button" class="danger" disabled="@_busy" @onclick="OverwriteConflictedSettingsAsync">@Strings["OverwriteSavedSettings"]</button>
                    <button type="button" class="secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_settingsTitle))" @onclick="SaveAsNewAsync">@Strings["SaveSettingsAsAction"]</button>
                    <button type="button" class="secondary" disabled="@_busy" @onclick="CancelSettingsConflict">@Strings["Cancel"]</button>
                </div>
            </div>
        }
        else if (_settingsRecycledConflict is not null)
        {
            <div class="notice error" role="dialog" aria-label="@Strings["SavedSettingsRecycledTitle"]">
                <p>@Strings["SavedSettingsRecycledMessage"]</p>
                <div class="actions">
                    <button type="button" class="danger" disabled="@_busy" @onclick="RestoreAndUpdateSavedSettingAsync">@Strings["RestoreAndSaveSettings"]</button>
                    <button type="button" class="secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_settingsTitle))" @onclick="SaveAsNewAsync">@Strings["SaveSettingsAsAction"]</button>
                    <button type="button" class="secondary" disabled="@_busy" @onclick="() => _settingsRecycledConflict = null">@Strings["Cancel"]</button>
                </div>
            </div>
        }
        else
        {
            <div class="inline-form">
                <label for="settings-title">@Strings["SettingsTitle"]</label>
                <input id="settings-title" maxlength="100" @bind="_settingsTitle" disabled="@FormDisabled" />
                <button type="button" class="secondary" disabled="@(FormDisabled || _loadedSettingsId is null || string.IsNullOrWhiteSpace(_settingsTitle))" @onclick="SaveInPlaceAsync">@Strings["SaveSettingsAction"]</button>
                <button type="button" class="secondary" disabled="@(FormDisabled || string.IsNullOrWhiteSpace(_settingsTitle))" @onclick="SaveAsNewAsync">@Strings["SaveSettingsAsAction"]</button>
            </div>
        }
    </section>

    @if (ActiveJobIds.Count > 0 || RecentOutcomes.Count > 0)
    {
        <h2>@Strings["RunsHeading"]</h2>

        @foreach (var jobId in ActiveJobIds)
        {
            var runStatus = Queue.GetJobStatus(jobId);
            @if (runStatus is not null)
            {
                <section class="panel run-card" @key="jobId">
                    <p role="status">
                        @(runStatus.Phase switch
                        {
                            GenerationJobPhase.Queued => Strings["QueuePosition", runStatus.QueuePosition ?? 0],
                            GenerationJobPhase.Running => Strings["Generating"],
                            GenerationJobPhase.Monitoring => Strings["MonitoringAsyncJob"],
                            GenerationJobPhase.DependencyRecycled => Strings["DependencyRecycledNotice"],
                            _ => Strings["Generate"]
                        })
                    </p>
                    @if (runStatus.Phase == GenerationJobPhase.Queued && Queue.IsJobAwaitingRateLimitReset(jobId))
                    {
                        <p class="notice" role="status">@Strings["RateLimitAwaitingReset"]</p>
                    }
                    <button type="button" class="secondary" @onclick="() => Queue.Cancel(jobId)">@Strings["CancelGeneration"]</button>
                </section>
            }
        }

        @foreach (var outcome in RecentOutcomes)
        {
            <section class="panel run-card" @key="outcome.JobId" role="status">
                @if (outcome.CancelledBeforeSubmission)
                {
                    <p class="muted">@Strings["GenerationCancelledBeforeSubmission"]</p>
                }
                else if (outcome.StagedForRecovery)
                {
                    <p class="notice">@Strings["ResultStagedForRecoveryNotice"]</p>
                    <a class="ghost" href="/recovery-staging">@Strings["NavRecoveryStaging"]</a>
                }
                else if (outcome.Record is null && outcome.LocalErrorMessage is null)
                {
                    <p class="muted">@Strings["GenerationCancelledByUser"]</p>
                }
                else if (outcome.LocalErrorMessage is not null)
                {
                    <p class="error">@outcome.LocalErrorMessage</p>
                }
                else if (outcome.Record is { } record)
                {
                    <h2>@GenerationStatusLabel(record.Status)</h2>
                    @if (record.Status == GenerationStatus.PartiallyCompleted)
                    {
                        <p class="muted">@Strings["GenerationPartiallyCompletedDetail", record.ResultFileIds.Count, record.ResultCount]</p>
                    }
                    @if (record.SafetyBlockedCount > 0)
                    {
                        <p class="muted">@Strings["SafetyBlockedResultsDetail", record.SafetyBlockedCount]</p>
                    }
                    @if (record.ErrorMessage is not null)
                    {
                        <p class="error">@record.ErrorMessage</p>
                    }
                    @if (record.PromptTokens is not null || record.CompletionTokens is not null)
                    {
                        <p class="muted">@Strings["TokenUsage", record.PromptTokens?.ToString() ?? Strings["Unknown"], record.CompletionTokens?.ToString() ?? Strings["Unknown"]]</p>
                    }
                    @if (record.SourceFileId is not null)
                    {
                        <p class="muted">@Strings["SourceImageSlotUsed", 1] <a href="@($"/file/{record.SourceFileId}")">@Strings["OpenGeneratedFile"]</a></p>
                    }
                    @if (record.SecondarySourceFileId is not null)
                    {
                        <p class="muted">@Strings["SourceImageSlotUsed", 2] <a href="@($"/file/{record.SecondarySourceFileId}")">@Strings["OpenGeneratedFile"]</a></p>
                    }
                    @if (record.TertiarySourceFileId is not null)
                    {
                        <p class="muted">@Strings["SourceImageSlotUsed", 3] <a href="@($"/file/{record.TertiarySourceFileId}")">@Strings["OpenGeneratedFile"]</a></p>
                    }
                    @if (record.ResultFileIds.Count > 0)
                    {
                        <ul class="metadata-list">
                            @foreach (var fileId in record.ResultFileIds)
                            {
                                <li><a href="@($"/file/{fileId}")">@Strings["OpenGeneratedFile"]</a></li>
                            }
                        </ul>
                    }
                }
            </section>
        }
    }
}

@code {
    [Parameter] public string SettingsId { get; set; } = string.Empty;
    [Parameter] public string HistoryId { get; set; } = string.Empty;

    private enum SaveStatus { Idle, Saving, Saved, NotSaved }

    private GenerateForm _form = new();
    private IReadOnlyList<Model> _models = [];
    private IReadOnlyList<Connection> _activeConnections = [];
    private IReadOnlyList<FolderRecord> _activeFolders = [];
    private IReadOnlyList<FileRecord> _activeImageFiles = [];
    private IReadOnlyList<GenerationDraft> _drafts = [];
    private string? _activeDraftId;
    private string _tabTitleInput = string.Empty;
    private string? _closingDraftId;
    private bool _closeSaveIntentActive;
    private string _closeSaveTitle = string.Empty;
    private string? _closeError;
    private bool _switcherOpen;
    private string _switcherFilter = string.Empty;
