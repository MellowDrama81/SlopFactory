@page "/file/{Id}"
@inject AppLibraryState LibraryState
@inject NavigationManager Navigation
@inject ManagedMediaResourceService MediaResources
@inject PreviewCacheService PreviewCache
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<PageTitle>File details · SlopFactory</PageTitle>

@if (_file is null)
{
    <section class="center-state"><h1>Loading file</h1></section>
}
else
{
    <header class="page-header">
        <div><p class="eyebrow">File details</p><h1>@_file.DisplayName</h1><p class="muted">@_file.MediaType · @_file.ByteSize bytes</p></div>
        <button class="secondary" @onclick="Back">Back to library</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice" role="status">@_message</div>
    }

    <section class="panel content-health-panel" aria-labelledby="content-health-title">
        <div class="section-heading"><h2 id="content-health-title">Managed content</h2><button class="secondary" disabled="@_verifyingContent" @onclick="VerifyContentAsync">@(_verifyingContent ? "Verifying…" : "Verify now")</button></div>
        <p><strong>@ContentStateLabel(_file.ContentState)</strong> · Built-in viewing rechecks the managed bytes before use.</p>
        @if (_file.ContentState == FileContentState.Missing)
        {
            <p class="error">The managed file is missing. The file record, user metadata, and links remain preserved.</p>
        }
        else if (_file.ContentState == FileContentState.Changed)
        {
            <p class="error">The bytes differ from the recorded content and have not been accepted as a replacement. Normal viewing is blocked.</p>
            @if (_contentHealth?.ObservedContentHash is not null)
            {
                <dl><dt>Recorded</dt><dd class="mono">@_file.ContentHash · @_file.ByteSize bytes · @_file.MediaType</dd><dt>Observed</dt><dd class="mono">@_contentHealth.ObservedContentHash · @_contentHealth.ObservedByteSize bytes · @_contentHealth.ObservedMediaType</dd></dl>
            }
            <button class="secondary" disabled="@_inspectingChangedContent" @onclick="InspectChangedContentAsync">@(_inspectingChangedContent ? "Inspecting…" : "Inspect changed bytes")</button>
            @if (_changedInspection is not null)
            {
                <div class="notice" role="status">
                    <p><strong>Changed-byte inspection</strong> does not accept or alter the file.</p>
                    <dl><dt>Actual bytes</dt><dd class="mono">@_changedInspection.ActualContentHash · @_changedInspection.ActualByteSize bytes · @_changedInspection.ActualMediaType</dd></dl>
                    @if (_changedText is not null) { <pre class="text-viewer">@_changedText.Content</pre><p class="muted">@(_changedText.IsTruncated ? "Only the first 1,048,576 characters are shown." : "Read-only text inspection.")</p> }
                </div>
            }
        }
        else if (_file.ContentState == FileContentState.Replaced && _contentProvenance is not null)
        {
            <p>The current bytes were accepted as a permanent replacement. The recorded original identity remains available for comparison.</p>
            <dl>
                <dt>Recorded original</dt><dd class="mono">@_contentProvenance.OriginalContentHash · @_contentProvenance.OriginalByteSize bytes · @_contentProvenance.OriginalMediaType</dd>
                <dt>Current replacement</dt><dd class="mono">@_file.ContentHash · @_file.ByteSize bytes · @_file.MediaType</dd>
                @if (_contentProvenance.ReplacedAt is not null) { <dt>Replaced</dt><dd>@_contentProvenance.ReplacedAt.Value.ToLocalTime().ToString("g")</dd> }
            </dl>
        }
        @if (_file.ContentState is FileContentState.Missing or FileContentState.Changed)
        {
            <div class="actions">
                <button disabled="@_replacingContent" @onclick="ChooseReplacementAsync">Choose replacement file</button>
                @if (_file.ContentState == FileContentState.Changed) { <button class="secondary" disabled="@_replacingContent" @onclick="ReviewCurrentBytesAsync">Accept current bytes as replacement</button> }
            </div>
        }
        @if (_replacementReview is not null)
        {
            <div class="notice replacement-review" role="status">
                <h3>Review managed-content replacement</h3>
                <dl>
                    <dt>Recorded original</dt><dd class="mono">@_replacementReview.OriginalContentHash · @_replacementReview.OriginalByteSize bytes · @_replacementReview.OriginalMediaType</dd>
                    <dt>Candidate</dt><dd class="mono">@_replacementReview.CandidateContentHash · @_replacementReview.CandidateByteSize bytes · @_replacementReview.CandidateMediaType</dd>
                </dl>
                @if (_replacementReview.RestoresOriginal)
                {
                    <p>The candidate exactly restores the recorded original bytes. Original provenance and user metadata will remain unchanged.</p>
                }
                else
                {
                    <p class="error">This permanently accepts different bytes without retaining a hidden previous version. The stable file ID, folder, links, and original provenance remain; current content metadata changes.</p>
                    <p>@_replacementReview.OrdinaryMetadataCount ordinary and @_replacementReview.SensitiveMetadataCount sensitive user-metadata entrie(s) are attached. Sensitive keys and values remain concealed.</p>
                    <label class="check"><input type="checkbox" @bind="_clearMetadataAfterReplacement" /> Clear all user metadata after replacement</label>
                }
                <div class="actions">
                    <button class="@(_replacementReview.RestoresOriginal ? string.Empty : "danger")" disabled="@_replacingContent" @onclick="CommitReplacementAsync">@(_replacementReview.RestoresOriginal ? "Restore original content" : "Confirm permanent replacement")</button>
                    <button class="secondary" disabled="@_replacingContent" @onclick="CancelReplacementReview">Cancel</button>
                </div>
            </div>
        }
    </section>

    <section class="detail-grid">
        @if (_mediaSource is not null || _mediaError is not null || _mediaPreparing)
        {
            <article class="panel media-panel">
                <h2>@(_file.MediaType.StartsWith("video/", StringComparison.Ordinal) ? "Video viewer" : "Audio player")</h2>
                @if (_mediaPreparing)
                {
                    <p class="muted" role="status">Verifying managed media before playback...</p>
                }
                else if (_mediaError is not null)
                {
                    <p class="error">@_mediaError</p>
                }
                else if (_file.MediaType.StartsWith("video/", StringComparison.Ordinal))
                {
                    <video @ref="_mediaElement" src="@_mediaSource!.Uri" controls preload="metadata" class="media-viewer">
                        This platform cannot play the video format.
                    </video>
                }
                else
                {
                    <audio @ref="_mediaElement" src="@_mediaSource!.Uri" controls preload="metadata" class="media-viewer">
                        This platform cannot play the audio format.
                    </audio>
                }
                @if (_mediaSource is not null)
                {
                    <div class="media-tools">
                        <label for="playback-rate">Playback speed</label>
                        <select id="playback-rate" value="@_playbackRate" @onchange="ChangePlaybackRateAsync">
                            <option value="0.5">0.5x</option>
                            <option value="0.75">0.75x</option>
                            <option value="1">Normal</option>
                            <option value="1.25">1.25x</option>
                            <option value="1.5">1.5x</option>
                            <option value="2">2x</option>
                        </select>
                        <span class="muted">Use the built-in controls for seeking, volume, mute, captions when available, and video full screen.</span>
                    </div>
                }
            </article>
        }
        @if (_imageDataUri is not null || _imageError is not null)
        {
            <article class="panel image-panel">
                <h2>Image viewer</h2>
                @if (_imageError is not null)
                {
                    <p class="error">@_imageError</p>
                }
                else
                {
                    <div class="image-tools" aria-label="Image view controls">
                        @if (_file.MediaType == "image/gif")
                        {
                            <button class="ghost" @onclick="ToggleAnimatedImage">@(_animatedImagePlaying ? "Pause animation" : "Play animation")</button>
                        }
                        <button class="ghost" @onclick="FitImage">Fit</button>
                        <button class="ghost" @onclick="ActualImageSize">Actual size</button>
                        <label>Zoom <input type="range" min="25" max="400" step="25" @bind="_imageZoom" @bind:event="oninput" /> @_imageZoom%</label>
                        <button class="ghost" @onclick="RotateImage">Rotate 90°</button>
                    </div>
                    <div class="image-viewport">
                        @if (_file.MediaType != "image/gif" || _animatedImagePlaying || _animatedImagePosterUri is not null)
                        {
                            <img src="@(_file.MediaType == "image/gif" && !_animatedImagePlaying ? _animatedImagePosterUri : _imageDataUri)" alt="Preview of @_file.DisplayName" class="@(_fitImage ? "fit-image" : "actual-image")" style="transform: rotate(@(_imageRotation)deg) scale(@(_imageZoom / 100d));" />
                        }
                        else
                        {
                            <p class="muted">Animation paused. Choose Play animation to decode it.</p>
                        }
                    </div>
                    <p class="muted">Viewing controls do not modify the managed image.</p>
                }
            </article>
        }

        @if (_textContent is not null || _textError is not null)
        {
            <article class="panel text-panel">
                <h2>Text viewer</h2>
                @if (_textError is not null)
                {
                    <p class="error">@_textError</p>
                }
                else
                {
                    <p class="muted">Read-only · @_textContent!.EncodingName@(_textContent.IsTruncated ? " · Showing the first 1,048,576 characters" : string.Empty)</p>
                    <div class="text-tools">
                        @if (_file.MediaType == "text/markdown")
                        {
                            <div class="view-toggle" aria-label="Markdown view">
                                <button class="@(!_showRenderedMarkdown ? string.Empty : "secondary")" aria-pressed="@(!_showRenderedMarkdown)" @onclick="ShowPlainText">Plain text</button>
                                <button class="@(_showRenderedMarkdown ? string.Empty : "secondary")" aria-pressed="@_showRenderedMarkdown" @onclick="ShowRenderedMarkdownAsync" disabled="@_textContent.IsTruncated">Rendered Markdown</button>
                            </div>
                        }
                        <EditForm Model="_textSearchForm" OnValidSubmit="SearchTextAsync" class="text-search-form">
                            <label for="text-search">Find in file</label>
                            <InputText id="text-search" @bind-Value="_textSearchForm.SearchText" maxlength="256" />
                            <label class="check"><InputCheckbox @bind-Value="_textSearchForm.MatchCase" /> Match case</label>
                            <button type="submit" disabled="@_searchingText">@(_searchingText ? "Searching…" : "Find")</button>
                            @if (_textSearchResult is not null) { <button type="button" class="secondary" @onclick="ClearTextSearch">Clear</button> }
                        </EditForm>
                    </div>

                    @if (_showRenderedMarkdown)
                    {
                        @if (_markdownError is not null)
                        {
                            <p class="error">@_markdownError</p>
                        }
                        else if (_markdownContent is null)
                        {
                            <p class="muted" aria-live="polite">Rendering Markdown…</p>
                        }
                        else
                        {
                            <div class="rendered-markdown">@((MarkupString)_markdownContent.Html)</div>
                            @if (_markdownContent.ExternalLinks.Count > 0)
                            {
                                <section class="markdown-links" aria-labelledby="markdown-links-title">
                                    <h3 id="markdown-links-title">External links</h3>
                                    <p class="muted">Markdown links are inert in the rendered document. Review the destination before opening one in another application.</p>
                                    <ul>
                                        @foreach (var link in _markdownContent.ExternalLinks)
                                        {
                                            <li><span>@link.Label</span><code>@link.Destination</code><button class="ghost" @onclick="() => ReviewExternalLink(link)">Review link</button></li>
                                        }
                                    </ul>
                                </section>
                            }
                        }
                    }
                    else
                    {
                        <pre class="text-viewer">@_textContent.Content</pre>
                    }

                    @if (_textSearchResult is not null)
                    {
                        <section class="text-search-results" aria-live="polite" aria-labelledby="text-search-results-title">
                            <h3 id="text-search-results-title">Search results</h3>
                            @if (_textSearchResult.TotalMatches == 0)
                            {
                                <p>No matches found in the complete file.</p>
                            }
                            else
                            {
                                var selected = _textSearchResult.Matches[_selectedSearchIndex];
                                <div class="selection-bar">
                                    <span>Match @(_selectedSearchIndex + 1) of @_textSearchResult.TotalMatches@(_textSearchResult.ResultsTruncated ? " · First 200 available for navigation" : string.Empty)</span>
                                    <div class="actions"><button class="secondary" @onclick="PreviousTextMatch">Previous</button><button class="secondary" @onclick="NextTextMatch">Next</button></div>
                                </div>
                                <p class="muted">Character offset @selected.CharacterOffset@(_textContent.IsTruncated && selected.CharacterOffset >= _textContent.Content.Length ? " · Beyond the displayed plain-text prefix" : string.Empty)</p>
                                <pre class="text-search-snippet">@selected.Snippet[..selected.MatchStart]<mark>@selected.Snippet.Substring(selected.MatchStart, selected.MatchLength)</mark>@selected.Snippet[(selected.MatchStart + selected.MatchLength)..]</pre>
                            }
                        </section>
                    }

                    @if (_pendingExternalLink is not null)
                    {
                        <section class="panel external-link-review" role="dialog" aria-labelledby="external-link-review-title">
                            <h3 id="external-link-review-title">Open external link?</h3>
                            <p>Another application will receive this destination:</p>
                            <code>@_pendingExternalLink.Destination</code>
                            <div class="actions"><button @onclick="OpenReviewedExternalLinkAsync">Open externally</button><button class="secondary" @onclick="CancelExternalLink">Cancel</button></div>
                        </section>
                    }
                    @if (!_showTextEditor)
                    {
                        <button @onclick="BeginTextEdit" disabled="@_textContent.IsTruncated">Edit as Copy</button>
                        @if (_textContent.IsTruncated) { <p class="muted">This file is too large to open in the built-in editor.</p> }
                    }
                    else
                    {
                        <EditForm Model="_textCopyForm" OnValidSubmit="SaveTextCopyAsync" class="stack-form text-editor">
                            <label for="edited-content">Edited content</label>
                            <InputTextArea id="edited-content" @bind-Value="_textCopyForm.Content" />
                            <label for="edited-name">New file name</label>
                            <InputText id="edited-name" @bind-Value="_textCopyForm.DisplayName" maxlength="255" />
                            <label for="edited-folder">Destination folder</label>
                            <InputSelect id="edited-folder" @bind-Value="_textCopyForm.DestinationFolderId">
                                @foreach (var folder in _availableFolders) { <option value="@folder.Id">@folder.Name</option> }
                            </InputSelect>
                            <label for="edited-format">Format</label>
                            <InputSelect id="edited-format" @bind-Value="_textCopyForm.Format">
                                <option value="@TextCopyFormat.PreserveSourceFormat">Preserve source format</option>
                                <option value="@TextCopyFormat.PlainText">Plain text</option>
                                <option value="@TextCopyFormat.Markdown">Markdown</option>
                            </InputSelect>
                            <label class="check"><InputCheckbox @bind-Value="_textCopyForm.CopyUserMetadata" /> Copy user metadata</label>
                            @if (_textCopyForm.CopyUserMetadata && SensitiveMetadataCount > 0)
                            {
                                <label class="check"><InputCheckbox @bind-Value="_textCopyForm.IncludeSensitiveMetadata" /> Include @SensitiveMetadataCount sensitive metadata entr@(SensitiveMetadataCount == 1 ? "y" : "ies")</label>
                            }
                            <div class="actions"><button type="submit">Save edited copy</button><button type="button" class="secondary" @onclick="CancelTextEdit">Cancel</button></div>
                        </EditForm>
                    }
                }
            </article>
        }

        <article class="panel">
            <h2>System information</h2>
            <dl>
                <dt>Content hash</dt><dd class="mono">SHA-256 @_file.ContentHash</dd>
                <dt>Original filename</dt><dd>@_file.OriginalFileName</dd>
                <dt>Imported</dt><dd>@_file.ImportedAt.ToLocalTime().ToString("g")</dd>
                <dt>Library modified</dt><dd>@_file.ModifiedAt.ToLocalTime().ToString("g")</dd>
                @if (_file.SourceLastModified is not null) { <dt>Source last modified</dt><dd>@_file.SourceLastModified.Value.ToLocalTime().ToString("g")</dd> }
                <dt>Origin</dt><dd>@_file.Origin</dd>
                <dt>State</dt><dd>@_file.State</dd>
                <dt>Content state</dt><dd>@ContentStateLabel(_file.ContentState)</dd>
                @if (_contentProvenance?.ReplacedAt is not null) { <dt>Content replaced</dt><dd>@_contentProvenance.ReplacedAt.Value.ToLocalTime().ToString("g")</dd> }
            </dl>
        </article>

        <article class="panel">
            <h2>User metadata</h2>
            @if (_metadata.Count == 0)
            {
                <p class="empty">No user metadata.</p>
            }
            else
            {
                <ul class="metadata-list">
                    @foreach (var item in _metadata)
                    {
                        <li>
                            <div><strong>@item.Key</strong><small>@item.Kind @(item.IsSensitive ? "· Sensitive" : string.Empty)</small></div>
                            <code>@(item.IsSensitive && !_revealed.Contains(item.Id) ? "••••••" : item.SerializedValue)</code>
                            @if (item.IsSensitive)
                            {
                                <button class="ghost" @onclick="() => ToggleReveal(item.Id)">@(_revealed.Contains(item.Id) ? "Conceal" : "Reveal for session")</button>
                            }
                            <button class="ghost" @onclick="() => BeginRename(item)">Rename key</button>
                            <button class="danger ghost" @onclick="() => RemoveMetadataAsync(item.Key)">Remove</button>
                            @if (_renamingMetadataId == item.Id)
                            {
                                <div class="inline-form">
                                    <label for="rename-key-@item.Id">New key</label>
                                    <input id="rename-key-@item.Id" @bind="_renameKey" maxlength="100" />
                                    <button @onclick="() => RenameMetadataAsync(item.Key)">Save key</button>
                                    <button class="secondary" @onclick="CancelRename">Cancel</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            <EditForm Model="_metadataForm" OnValidSubmit="SaveMetadataAsync" class="stack-form">
                <label for="metadata-key">Key</label>
                <InputText id="metadata-key" @bind-Value="_metadataForm.Key" maxlength="100" />
                <label for="metadata-kind">Type</label>
                <InputSelect id="metadata-kind" @bind-Value="_metadataForm.Kind">
                    @foreach (var kind in Enum.GetValues<MetadataValueKind>()) { <option value="@kind">@kind</option> }
                </InputSelect>
                <label for="metadata-value">Value</label>
                <InputTextArea id="metadata-value" @bind-Value="_metadataForm.Value" />
                <label class="check"><InputCheckbox @bind-Value="_metadataForm.IsSensitive" /> Sensitive</label>
                <button type="submit">Add or update metadata</button>
            </EditForm>
        </article>

        <article class="panel">
            <h2>Links</h2>
            @if (_links.Count == 0) { <p class="empty">No file links.</p> }
            else
            {
                <ul class="metadata-list">
                    @foreach (var link in _links)
                    {
                        <li>
                            <div><strong>@link.Label</strong><small>@FileName(link.SourceFileId) → @FileName(link.TargetFileId) · @link.State</small></div>
                            @if (link.State == LibraryRecordState.Active)
                            {
                                <button class="ghost" @onclick="() => BeginLinkRename(link)">Relabel</button>
                                <button class="ghost" @onclick="() => ReverseLinkAsync(link.Id)">Reverse direction</button>
                                <button class="danger ghost" @onclick="() => RecycleLinkAsync(link.Id)">Recycle link</button>
                            }
                            @if (_renamingLinkId == link.Id)
                            {
                                <div class="inline-form">
                                    <label for="link-rename-@link.Id">New label</label>
                                    <input id="link-rename-@link.Id" @bind="_renamedLinkLabel" maxlength="200" />
                                    <button @onclick="() => RelabelLinkAsync(link.Id)">Save label</button>
                                    <button class="secondary" @onclick="CancelLinkRename">Cancel</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            @if (_availableFiles.Count == 0)
            {
                <p class="empty">Import another file before creating a link.</p>
            }
            else
            {
                <EditForm Model="_linkForm" OnValidSubmit="CreateLinkAsync" class="stack-form">
                    <label for="link-target">Target file</label>
                    <InputSelect id="link-target" @bind-Value="_linkForm.TargetFileId">
                        <option value="">Select a file</option>
                        @foreach (var target in _availableFiles) { <option value="@target.Id">@target.DisplayName</option> }
                    </InputSelect>
                    <label for="link-label">Label</label>
                    <InputText id="link-label" @bind-Value="_linkForm.Label" maxlength="200" />
                    <button type="submit">Create directed link</button>
                </EditForm>
            }
        </article>
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private FileRecord? _file;
    private IReadOnlyList<MetadataEntry> _metadata = [];
    private IReadOnlyList<FileLink> _links = [];
    private IReadOnlyList<FileRecord> _availableFiles = [];
    private IReadOnlyList<FolderRecord> _availableFolders = [];
    private TextFileContent? _textContent;
    private string? _textError;
    private RenderedMarkdownContent? _markdownContent;
    private string? _markdownError;
    private bool _showRenderedMarkdown;
    private TextSearchResult? _textSearchResult;
    private int _selectedSearchIndex;
    private bool _searchingText;
    private TextSearchForm _textSearchForm = new();
    private MarkdownExternalLink? _pendingExternalLink;
    private string? _imageDataUri;
    private string? _imageError;
    private ManagedMediaSource? _mediaSource;
    private string? _mediaError;
    private bool _mediaPreparing;
    private ElementReference _mediaElement;
    private bool _registerMediaElement;
    private double _playbackRate = 1;
    private int _imageZoom = 100;
    private int _imageRotation;
    private bool _fitImage = true;
    private string? _animatedImagePosterUri;
    private bool _animatedImagePlaying;
    private readonly HashSet<string> _revealed = new(StringComparer.Ordinal);
    private MetadataForm _metadataForm = new();
    private LinkForm _linkForm = new();
    private string? _message;
    private FileContentHealth? _contentHealth;
    private FileContentProvenance? _contentProvenance;
    private bool _verifyingContent;
    private ChangedContentInspection? _changedInspection;
    private TextFileContent? _changedText;
    private bool _inspectingChangedContent;
    private ManagedContentReplacementReview? _replacementReview;
    private string? _replacementSourcePath;
    private bool _clearMetadataAfterReplacement;
    private bool _replacingContent;
    private string? _renamingMetadataId;
    private string _renameKey = string.Empty;
    private string? _renamingLinkId;
    private string _renamedLinkLabel = string.Empty;
    private bool _showTextEditor;
    private TextCopyForm _textCopyForm = new();
    private int SensitiveMetadataCount => _metadata.Count(item => item.IsSensitive);

    protected override async Task OnParametersSetAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_registerMediaElement && _mediaSource is not null)
        {
            _registerMediaElement = false;
            await JavaScript.InvokeVoidAsync("slopFactoryMedia.register", _mediaElement);
        }
    }

    private async Task ReloadAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            _contentHealth = await LibraryState.Workspace.RevalidateFileContentAsync(Id);
            _file = _contentHealth.File;
            _changedInspection = null;
            _changedText = null;
            _contentProvenance = await LibraryState.Workspace.GetFileContentProvenanceAsync(Id);
            await StopMediaAsync();
            _mediaError = null;
            _mediaPreparing = false;
            _playbackRate = 1;
            if (CanUseContent(_file) && IsPlayableMediaType(_file.MediaType))
            {
                _mediaPreparing = true;
                try
                {
                    _mediaSource = await MediaResources.CreateAsync(Id);
                    _registerMediaElement = true;
                }
                catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException)
                {
                    _mediaError = exception.Message;
                }
                finally { _mediaPreparing = false; }
            }
            _imageDataUri = null;
            _imageError = null;
            _imageZoom = 100;
            _imageRotation = 0;
            _fitImage = true;
            _animatedImagePosterUri = null;
            _animatedImagePlaying = false;
            if (CanUseContent(_file) && IsImageMediaType(_file.MediaType))
            {
                try
                {
                    var image = await LibraryState.Workspace.ReadImageFileAsync(Id);
                    _imageDataUri = $"data:{image.MediaType};base64,{Convert.ToBase64String(image.Bytes)}";
                    if (_file.MediaType == "image/gif")
                    {
                        var poster = await PreviewCache.GetImageThumbnailAsync(LibraryState.Workspace, _file);
                        _animatedImagePosterUri = poster.DataUri;
                    }
                }
                catch (SlopFactoryException exception) { _imageError = exception.Message; }
            }
            _textContent = null;
            _textError = null;
            _markdownContent = null;
            _markdownError = null;
            _showRenderedMarkdown = false;
            ClearTextSearch();
            _pendingExternalLink = null;
            if (CanUseContent(_file) && IsTextMediaType(_file.MediaType))
            {
                try { _textContent = await LibraryState.Workspace.ReadTextFileAsync(Id); }
                catch (SlopFactoryException exception) { _textError = exception.Message; }
            }
            _metadata = await LibraryState.Workspace.GetMetadataAsync(Id);
            _links = await LibraryState.Workspace.GetLinksAsync(Id);
            _availableFiles = (await LibraryState.Workspace.GetActiveFilesAsync()).Where(file => file.Id != Id).ToArray();
            _availableFolders = await LibraryState.Workspace.GetActiveFoldersAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task VerifyContentAsync()
    {
        _verifyingContent = true;
        try { await ReloadAsync(); _message = $"Content verification complete: {ContentStateLabel(_file?.ContentState ?? FileContentState.Missing)}."; }
        finally { _verifyingContent = false; }
    }

    private async Task InspectChangedContentAsync()
    {
        if (LibraryState.Workspace is null) return;
        _inspectingChangedContent = true;
        try
        {
            _changedInspection = await LibraryState.Workspace.InspectChangedContentAsync(Id);
            _changedText = _changedInspection.ActualMediaType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) || _changedInspection.ActualMediaType is "application/json" or "application/xml"
                ? await LibraryState.Workspace.ReadChangedTextFileAsync(Id)
                : null;
            _message = null;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
        finally { _inspectingChangedContent = false; }
    }

    private static bool CanUseContent(FileRecord file) => file.ContentState is FileContentState.Healthy or FileContentState.Replaced;
    private static string ContentStateLabel(FileContentState state) => state switch
    {
        FileContentState.Missing => "Missing",
        FileContentState.Changed => "Content changed",
        FileContentState.Replaced => "Content replaced",
        _ => "Healthy"
    };

    private async Task ChooseReplacementAsync()
    {
        var selected = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = "Choose replacement content" });
        if (selected is null) return;
        await ReviewReplacementAsync(selected.FullPath);
    }

    private Task ReviewCurrentBytesAsync() => ReviewReplacementAsync(null);

    private async Task ReviewReplacementAsync(string? sourcePath)
    {
        if (LibraryState.Workspace is null) return;
        _replacingContent = true;
        try
        {
            _replacementReview = await LibraryState.Workspace.ReviewManagedContentReplacementAsync(Id, sourcePath);
            _replacementSourcePath = sourcePath;
            _clearMetadataAfterReplacement = false;
            _message = null;
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
        finally { _replacingContent = false; }
    }

    private async Task CommitReplacementAsync()
    {
        if (LibraryState.Workspace is null || _replacementReview is null) return;
        _replacingContent = true;
        try
        {
            var restoresOriginal = _replacementReview.RestoresOriginal;
            await LibraryState.Workspace.CommitManagedContentReplacementAsync(_replacementReview, _replacementSourcePath, !restoresOriginal, !restoresOriginal && _clearMetadataAfterReplacement);
            CancelReplacementReview();
            await ReloadAsync();
            _message = restoresOriginal ? "The recorded original content was restored." : "The replacement content was accepted permanently.";
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
        finally { _replacingContent = false; }
    }

    private void CancelReplacementReview()
    {
        _replacementReview = null;
        _replacementSourcePath = null;
        _clearMetadataAfterReplacement = false;
    }

    private async Task SaveMetadataAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.SetMetadataAsync(Id, _metadataForm.Key, _metadataForm.Kind, _metadataForm.Value, _metadataForm.IsSensitive);
            _metadataForm = new();
            _message = "Metadata saved.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task RemoveMetadataAsync(string key)
    {
        if (LibraryState.Workspace is null) return;
        await LibraryState.Workspace.RemoveMetadataAsync(Id, key);
        await ReloadAsync();
    }

    private void BeginRename(MetadataEntry entry)
    {
        _renamingMetadataId = entry.Id;
        _renameKey = entry.Key;
    }

    private void CancelRename()
    {
        _renamingMetadataId = null;
        _renameKey = string.Empty;
    }

    private async Task RenameMetadataAsync(string currentKey)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RenameMetadataAsync(Id, currentKey, _renameKey);
            CancelRename();
            _message = "Metadata key renamed.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task CreateLinkAsync()
    {
        if (LibraryState.Workspace is null || string.IsNullOrWhiteSpace(_linkForm.TargetFileId)) return;
        try
        {
            await LibraryState.Workspace.CreateLinkAsync(Id, _linkForm.TargetFileId, _linkForm.Label);
            _linkForm = new();
            _message = "Link created.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private void BeginLinkRename(FileLink link)
    {
        _renamingLinkId = link.Id;
        _renamedLinkLabel = link.Label;
    }

    private void CancelLinkRename()
    {
        _renamingLinkId = null;
        _renamedLinkLabel = string.Empty;
    }

    private async Task RelabelLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RelabelLinkAsync(linkId, _renamedLinkLabel);
            CancelLinkRename();
            _message = "Link relabelled.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task ReverseLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.ReverseLinkAsync(linkId);
            _message = "Link direction reversed.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task RecycleLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RecycleLinkAsync(linkId);
            _message = "Link moved to the recycle bin.";
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private void BeginTextEdit()
    {
        if (_file is null || _textContent is null || _textContent.IsTruncated) return;
        var extension = Path.GetExtension(_file.DisplayName);
        var stem = Path.GetFileNameWithoutExtension(_file.DisplayName);
        _textCopyForm = new TextCopyForm
        {
            Content = _textContent.Content,
            DisplayName = $"{stem} edited{extension}",
            DestinationFolderId = _file.FolderId,
            Format = TextCopyFormat.PreserveSourceFormat
        };
        _showTextEditor = true;
    }

    private void CancelTextEdit()
    {
        _showTextEditor = false;
        _textCopyForm = new();
    }

    private void ShowPlainText()
    {
        _showRenderedMarkdown = false;
        _pendingExternalLink = null;
    }

    private async Task ShowRenderedMarkdownAsync()
    {
        if (LibraryState.Workspace is null || _textContent?.IsTruncated != false) return;
        _showRenderedMarkdown = true;
        _pendingExternalLink = null;
        if (_markdownContent is not null || _markdownError is not null) return;
        try { _markdownContent = await LibraryState.Workspace.RenderMarkdownFileAsync(Id); }
        catch (SlopFactoryException exception)
        {
            _markdownError = exception.Message;
            _showRenderedMarkdown = false;
            _message = $"{exception.Message} Plain text is shown instead.";
        }
    }

    private async Task SearchTextAsync()
    {
        if (LibraryState.Workspace is null) return;
        _searchingText = true;
        try
        {
            _textSearchResult = await LibraryState.Workspace.SearchTextFileAsync(Id, _textSearchForm.SearchText, _textSearchForm.MatchCase);
            _selectedSearchIndex = 0;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
        finally { _searchingText = false; }
    }

    private void ClearTextSearch()
    {
        _textSearchResult = null;
        _selectedSearchIndex = 0;
    }

    private void PreviousTextMatch()
    {
        if (_textSearchResult?.Matches.Count > 0) _selectedSearchIndex = (_selectedSearchIndex + _textSearchResult.Matches.Count - 1) % _textSearchResult.Matches.Count;
    }

    private void NextTextMatch()
    {
        if (_textSearchResult?.Matches.Count > 0) _selectedSearchIndex = (_selectedSearchIndex + 1) % _textSearchResult.Matches.Count;
    }

    private void ReviewExternalLink(MarkdownExternalLink link) => _pendingExternalLink = link;
    private void CancelExternalLink() => _pendingExternalLink = null;

    private async Task OpenReviewedExternalLinkAsync()
    {
        if (_pendingExternalLink is null) return;
        try
        {
            await Browser.Default.OpenAsync(new Uri(_pendingExternalLink.Destination), BrowserLaunchMode.SystemPreferred);
            _pendingExternalLink = null;
        }
        catch (Exception exception) when (exception is UriFormatException or InvalidOperationException or NotSupportedException or ArgumentException)
        {
            _message = $"The external destination could not be opened: {exception.Message}";
        }
    }

    private async Task SaveTextCopyAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            var copy = await LibraryState.Workspace.CreateEditedTextCopyAsync(
                Id,
                _textCopyForm.DestinationFolderId,
                _textCopyForm.DisplayName,
                _textCopyForm.Content,
                _textCopyForm.Format,
                _textCopyForm.CopyUserMetadata,
                _textCopyForm.CopyUserMetadata && _textCopyForm.IncludeSensitiveMetadata);
            Navigation.NavigateTo($"/file/{copy.Id}");
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
    }

    private void ToggleReveal(string id) { if (!_revealed.Add(id)) _revealed.Remove(id); }
    private void FitImage() { _fitImage = true; _imageZoom = 100; }
    private void ActualImageSize() { _fitImage = false; _imageZoom = 100; }
    private void RotateImage() => _imageRotation = (_imageRotation + 90) % 360;
    private void ToggleAnimatedImage() => _animatedImagePlaying = !_animatedImagePlaying;
    private async Task ChangePlaybackRateAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rate)) return;
        _playbackRate = rate;
        await JavaScript.InvokeVoidAsync("slopFactoryMedia.setRate", _mediaElement, rate);
    }
    private async Task StopMediaAsync()
    {
        if (_mediaSource is null) return;
        try { await JavaScript.InvokeVoidAsync("slopFactoryMedia.stop", _mediaElement); }
        catch (JSDisconnectedException) { }
        MediaResources.Revoke(_mediaSource.Token);
        _mediaSource = null;
        _registerMediaElement = false;
    }
    public async ValueTask DisposeAsync() => await StopMediaAsync();
    private void Back() => Navigation.NavigateTo("/");
    private static bool IsTextMediaType(string mediaType) => mediaType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) || mediaType is "application/json" or "application/xml";
    private static bool IsImageMediaType(string mediaType) => mediaType is "image/png" or "image/jpeg" or "image/webp" or "image/gif" or "image/svg+xml";
    private static bool IsPlayableMediaType(string mediaType) => mediaType is "audio/mpeg" or "audio/wav" or "audio/aac" or "audio/mp4" or "audio/flac" or "audio/ogg" or "video/mp4";
    private string FileName(string fileId) => fileId == _file?.Id ? _file.DisplayName : _availableFiles.FirstOrDefault(file => file.Id == fileId)?.DisplayName ?? $"Unavailable file {fileId[..Math.Min(8, fileId.Length)]}";

    private sealed class MetadataForm
    {
        public string Key { get; set; } = string.Empty;
        public MetadataValueKind Kind { get; set; } = MetadataValueKind.Text;
        public string Value { get; set; } = string.Empty;
        public bool IsSensitive { get; set; }
    }

    private sealed class LinkForm
    {
        public string TargetFileId { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }

    private sealed class TextCopyForm
    {
        public string Content { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string DestinationFolderId { get; set; } = string.Empty;
        public TextCopyFormat Format { get; set; }
        public bool CopyUserMetadata { get; set; }
        public bool IncludeSensitiveMetadata { get; set; }
    }

    private sealed class TextSearchForm
    {
        public string SearchText { get; set; } = string.Empty;
        public bool MatchCase { get; set; }
    }
}
