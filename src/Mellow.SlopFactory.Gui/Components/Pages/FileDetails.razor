@page "/file/{Id}"
@inject AppLibraryState LibraryState
@inject NavigationManager Navigation
@inject ManagedMediaResourceService MediaResources
@inject PreviewCacheService PreviewCache
@inject IJSRuntime JavaScript
@inject ISensitiveMetadataDisclosureService SensitiveDisclosure
@inject ISensitiveRevealSessionService SensitiveReveals
@inject IPlatformFileActionService PlatformFiles
@inject IntegrityScanRecommendationService ScanRecommendation
@inject GenerationQueueService Queue
@implements IAsyncDisposable
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources

<PageTitle>@Strings["FileDetailsPageTitle"]</PageTitle>

@if (_file is null)
{
    <section class="center-state">
        <h1>@Strings["LoadingFile"]</h1>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="notice error" role="alert">@_message</div>
        }
    </section>
}
else
{
    <header class="page-header">
        <div><p class="eyebrow">@Strings["FileDetails"]</p><h1>@_file.DisplayName</h1><p class="muted">@Strings["FileDetailsMeta", _file.MediaType, _file.ByteSize]</p></div>
        <div class="actions">
            @if (ContentActionPolicy.CanUseManagedContent(_file))
            {
                <button class="secondary" disabled="@_fileActionBusy" @onclick="ExportAsync">@Strings["Export"]</button>
                @if (ContentActionPolicy.GetExternalOpenSafety(_file) is not (ExternalOpenSafety.BlockedActiveContent or ExternalOpenSafety.BlockedUnverifiedContent)) { <button class="secondary" disabled="@_fileActionBusy" @onclick="ReviewExternalOpenAsync">@Strings["OpenInAnotherApp"]</button> }
                <details>
                    <summary>@Strings["ExportSidecarOptionsHeading"]</summary>
                    <label class="check"><input type="checkbox" @bind="_sidecarForm.WriteSidecar" />@Strings["WriteSidecar"]</label>
                    @if (_sidecarForm.WriteSidecar)
                    {
                        <label class="check"><input type="checkbox" @bind="_sidecarForm.IncludePrompt" />@Strings["SidecarIncludePrompt"]</label>
                        <label class="check"><input type="checkbox" @bind="_sidecarForm.IncludeFilenames" />@Strings["SidecarIncludeFilenames"]</label>
                        <label class="check"><input type="checkbox" @bind="_sidecarForm.IncludeInternalIdentifiers" />@Strings["SidecarIncludeInternalIdentifiers"]</label>
                        <label class="check"><input type="checkbox" @bind="_sidecarForm.IncludeUsageAndCost" />@Strings["SidecarIncludeUsageAndCost"]</label>
                        <label class="check"><input type="checkbox" @bind="_sidecarForm.IncludeAdvancedSettings" />@Strings["SidecarIncludeAdvancedSettings"]</label>
                        <label class="check" title="@Strings["SidecarSafetyMetadataUnavailableHelp"]"><input type="checkbox" disabled />@Strings["SidecarIncludeSafetyMetadata"]</label>
                        <button type="button" class="secondary" disabled="@_sidecarPreviewBusy" @onclick="PreviewSidecarAsync">@Strings["SidecarPreviewAction"]</button>
                        @if (_sidecarPreview is not null)
                        {
                            <p class="muted">@Strings["SidecarPreviewHeading"]</p>
                            <pre class="metadata-list">@_sidecarPreview</pre>
                        }
                    }
                </details>
            }
            @if (_file.ContentState == FileContentState.Changed) { <button class="secondary" disabled="@_fileActionBusy" @onclick="ExportChangedBytesAsync">@Strings["ExportChangedBytes"]</button> }
            <button class="secondary" @onclick="Back">@Strings["BackToLibrary"]</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice" role="status">@_message</div>
    }
    @if (_confirmExternalOpen)
    {
        <section class="notice" role="dialog" aria-labelledby="external-open-warning-title">
            <h2 id="external-open-warning-title">@Strings["OpenTemporaryCopy"]</h2>
            <p>@Strings["ExternalOpenWarning"]</p>
            <button @onclick="OpenExternallyAsync">@Strings["Continue"]</button><button class="secondary" @onclick="() => _confirmExternalOpen = false">@Strings["Cancel"]</button>
        </section>
    }

    @if (HasDisplayExtensionMismatch(_file))
    {
        <div class="notice error" role="status">@Strings["ExtensionMismatch", Path.GetExtension(_file.DisplayName), _file.MediaType]</div>
    }

    <section class="panel content-health-panel" aria-labelledby="content-health-title">
        <div class="section-heading"><h2 id="content-health-title">@Strings["ManagedContent"]</h2><button class="secondary" disabled="@_verifyingContent" @onclick="VerifyContentAsync">@(_verifyingContent ? Strings["Verifying"] : Strings["VerifyNow"])</button></div>
        <p>@Strings["BuiltInViewingVerifiesContent", ContentStateLabel(_file.ContentState)]</p>
        @if (_file.ContentState == FileContentState.Missing)
        {
            <p class="error">@Strings["ManagedFileMissing"]</p>
        }
        else if (_file.ContentState == FileContentState.Changed)
        {
            <p class="error">@Strings["ContentChanged"]</p>
            @if (_contentHealth?.ObservedContentHash is not null)
            {
                <dl><dt>@Strings["Recorded"]</dt><dd class="mono">@Strings["ContentIdentity", _file.ContentHash, _file.ByteSize, _file.MediaType]</dd><dt>@Strings["Observed"]</dt><dd class="mono">@Strings["ContentIdentity", _contentHealth.ObservedContentHash ?? string.Empty, _contentHealth.ObservedByteSize ?? 0, _contentHealth.ObservedMediaType ?? string.Empty]</dd></dl>
            }
            <button class="secondary" disabled="@_inspectingChangedContent" @onclick="InspectChangedContentAsync">@(_inspectingChangedContent ? Strings["InspectingChangedBytes"] : Strings["InspectChangedBytes"])</button>
            @if (_changedInspection is not null)
            {
                <div class="notice" role="status">
                    <p>@Strings["ChangedByteInspectionDescription", Strings["ChangedByteInspection"]]</p>
                    <dl><dt>@Strings["ActualBytes"]</dt><dd class="mono">@Strings["ContentIdentity", _changedInspection.ActualContentHash, _changedInspection.ActualByteSize, _changedInspection.ActualMediaType]</dd></dl>
                    @if (_changedText is not null) { <pre class="text-viewer">@_changedText.Content</pre><p class="muted">@(_changedText.IsTruncated ? Strings["ChangedTextTruncated"] : Strings["ReadOnlyTextInspection"])</p> }
                </div>
            }
        }
        else if (_file.ContentState == FileContentState.Replaced && _contentProvenance is not null)
        {
            <p>@Strings["ReplacementAcceptedDescription"]</p>
            <dl>
                <dt>@Strings["RecordedOriginal"]</dt><dd class="mono">@Strings["ContentIdentity", _contentProvenance.OriginalContentHash, _contentProvenance.OriginalByteSize, _contentProvenance.OriginalMediaType]</dd>
                <dt>@Strings["CurrentReplacement"]</dt><dd class="mono">@Strings["ContentIdentity", _file.ContentHash, _file.ByteSize, _file.MediaType]</dd>
                @if (_contentProvenance.ReplacedAt is not null) { <dt>@Strings["Replaced"]</dt><dd>@_contentProvenance.ReplacedAt.Value.ToLocalTime().ToString("g")</dd> }
            </dl>
        }
        @if (_file.ContentState is FileContentState.Missing or FileContentState.Changed)
        {
            <div class="actions">
                <button disabled="@_replacingContent" @onclick="ChooseReplacementAsync">@Strings["ChooseReplacementFile"]</button>
                @if (_file.ContentState == FileContentState.Changed) { <button class="secondary" disabled="@_replacingContent" @onclick="ReviewCurrentBytesAsync">@Strings["AcceptCurrentBytes"]</button> }
            </div>
        }
        @if (_replacementReview is not null)
        {
            <div class="notice replacement-review" role="status">
                <h3>@Strings["ReviewManagedReplacement"]</h3>
                <dl>
                    <dt>@Strings["RecordedOriginal"]</dt><dd class="mono">@Strings["ContentIdentity", _replacementReview.OriginalContentHash, _replacementReview.OriginalByteSize, _replacementReview.OriginalMediaType]</dd>
                    <dt>@Strings["Candidate"]</dt><dd class="mono">@Strings["ContentIdentity", _replacementReview.CandidateContentHash, _replacementReview.CandidateByteSize, _replacementReview.CandidateMediaType]</dd>
                </dl>
                @if (_replacementReview.RestoresOriginal)
                {
                    <p>@Strings["CandidateRestoresOriginal"]</p>
                }
                else
                {
                    <p class="error">@Strings["PermanentReplacementWarning"]</p>
                    <p>@Strings["ReplacementMetadataSummary", _replacementReview.OrdinaryMetadataCount, _replacementReview.SensitiveMetadataCount]</p>
                    <label class="check"><input type="checkbox" @bind="_clearMetadataAfterReplacement" /> @Strings["ClearMetadataAfterReplacement"]</label>
                }
                <div class="actions">
                    <button class="@(_replacementReview.RestoresOriginal ? string.Empty : "danger")" disabled="@_replacingContent" @onclick="CommitReplacementAsync">@(_replacementReview.RestoresOriginal ? Strings["RestoreOriginalContent"] : Strings["ConfirmPermanentReplacement"])</button>
                    <button class="secondary" disabled="@_replacingContent" @onclick="CancelReplacementReview">@Strings["Cancel"]</button>
                </div>
            </div>
        }
    </section>

    <section class="detail-grid">
        @if (CanUseContent(_file) && PreviewKind == BuiltInPreviewKind.Unsupported)
        {
            <article class="panel">
                <h2>@Strings["PreviewUnavailable"]</h2>
                <p>@Strings["UnsupportedViewer", _file.MediaType]</p>
                <p class="muted">@Strings["SafeSystemInformation"]</p>
            </article>
        }
        @if (_mediaSource is not null || _mediaError is not null || _mediaPreparing)
        {
            <article class="panel media-panel">
                <h2>@(_file.MediaType.StartsWith("video/", StringComparison.Ordinal) ? Strings["VideoViewer"] : Strings["AudioPlayer"])</h2>
                @if (_mediaPreparing)
                {
                    <p class="muted" role="status">@Strings["VerifyingMedia"]</p>
                }
                else if (_mediaError is not null)
                {
                    <p class="error">@_mediaError</p>
                }
                else if (_file.MediaType.StartsWith("video/", StringComparison.Ordinal))
                {
                    <video @ref="_mediaElement" src="@_mediaSource!.Uri" controls preload="metadata" class="media-viewer">
                        @Strings["VideoFormatUnsupported"]
                    </video>
                }
                else
                {
                    <audio @ref="_mediaElement" src="@_mediaSource!.Uri" controls preload="metadata" class="media-viewer">
                        @Strings["AudioFormatUnsupported"]
                    </audio>
                }
                @if (_mediaSource is not null)
                {
                    <div class="media-tools">
                        <label for="playback-rate">@Strings["PlaybackSpeed"]</label>
                        <select id="playback-rate" value="@_playbackRate" @onchange="ChangePlaybackRateAsync">
                            <option value="0.5">@Strings["PlaybackRateHalf"]</option>
                            <option value="0.75">@Strings["PlaybackRateThreeQuarters"]</option>
                            <option value="1">@Strings["Normal"]</option>
                            <option value="1.25">@Strings["PlaybackRateOneAndQuarter"]</option>
                            <option value="1.5">@Strings["PlaybackRateOneAndHalf"]</option>
                            <option value="2">@Strings["PlaybackRateDouble"]</option>
                        </select>
                        <span class="muted">@Strings["MediaControlsGuidance"]</span>
                    </div>
                }
            </article>
        }
        @if (_imageDataUri is not null || _imageError is not null)
        {
            <article class="panel image-panel">
                <h2>@Strings["ImageViewer"]</h2>
                @if (_imageError is not null)
                {
                    <p class="error">@_imageError</p>
                }
                else
                {
                    <div class="image-tools" aria-label="@Strings["ImageViewControls"]">
                        @if (_file.MediaType == "image/gif")
                        {
                            <button class="ghost" @onclick="ToggleAnimatedImage">@(_animatedImagePlaying ? Strings["PauseAnimation"] : Strings["PlayAnimation"])</button>
                        }
                        <button class="ghost" @onclick="FitImage">@Strings["Fit"]</button>
                        <button class="ghost" @onclick="ActualImageSize">@Strings["ActualSize"]</button>
                        <label>@Strings["Zoom"] <input type="range" min="25" max="400" step="25" @bind="_imageZoom" @bind:event="oninput" /> @_imageZoom%</label>
                        <button class="ghost" @onclick="RotateImage">@Strings["RotateImage"]</button>
                    </div>
                    <div class="image-viewport">
                        @if (_file.MediaType != "image/gif" || _animatedImagePlaying || _animatedImagePosterUri is not null)
                        {
                            <img src="@(_file.MediaType == "image/gif" && !_animatedImagePlaying ? _animatedImagePosterUri : _imageDataUri)" alt="@Strings["ImagePreviewAlt", _file.DisplayName]" class="@(_fitImage ? "fit-image" : "actual-image")" style="transform: @ImageTransform;" />
                        }
                        else
                        {
                            <p class="muted">@Strings["AnimationPaused"]</p>
                        }
                    </div>
                    <p class="muted">@Strings["ViewingDoesNotModify"]</p>
                }
            </article>
        }

        @if (_textContent is not null || _textError is not null)
        {
            <article class="panel text-panel">
                <h2>@Strings["TextViewer"]</h2>
                @if (_textError is not null)
                {
                    <p class="error">@_textError</p>
                }
                else
                {
                    <p class="muted">@Strings["ReadOnlyTextSummary", _textContent!.EncodingName, _textContent.IsTruncated ? Strings["TextContentTruncatedSuffix"] : string.Empty]</p>
                    <div class="text-tools">
                        @if (_file.MediaType == "text/markdown")
                        {
                            <div class="view-toggle" aria-label="@Strings["MarkdownView"]">
                                <button class="@(!_showRenderedMarkdown ? string.Empty : "secondary")" aria-pressed="@(!_showRenderedMarkdown)" @onclick="ShowPlainText">@Strings["PlainText"]</button>
                                <button class="@(_showRenderedMarkdown ? string.Empty : "secondary")" aria-pressed="@_showRenderedMarkdown" @onclick="ShowRenderedMarkdownAsync" disabled="@_textContent.IsTruncated">@Strings["RenderedMarkdown"]</button>
                            </div>
                        }
                        <EditForm Model="_textSearchForm" OnValidSubmit="SearchTextAsync" class="text-search-form">
                            <label for="text-search">@Strings["FindInFile"]</label>
                            <InputText id="text-search" @bind-Value="_textSearchForm.SearchText" maxlength="256" />
                            <label class="check"><InputCheckbox @bind-Value="_textSearchForm.MatchCase" /> @Strings["MatchCase"]</label>
                            <button type="submit" disabled="@_searchingText">@(_searchingText ? Strings["Searching"] : Strings["Find"])</button>
                            @if (_textSearchResult is not null) { <button type="button" class="secondary" @onclick="ClearTextSearch">@Strings["Clear"]</button> }
                        </EditForm>
                    </div>

                    @if (_showRenderedMarkdown)
                    {
                        @if (_markdownError is not null)
                        {
                            <p class="error">@_markdownError</p>
                        }
                        else if (_markdownContent is null)
                        {
                            <p class="muted" aria-live="polite">@Strings["RenderingMarkdown"]</p>
                        }
                        else
                        {
                            <div class="rendered-markdown">@((MarkupString)_markdownContent.Html)</div>
                            @if (_markdownContent.ExternalLinks.Count > 0)
                            {
                                <section class="markdown-links" aria-labelledby="markdown-links-title">
                                    <h3 id="markdown-links-title">@Strings["ExternalLinks"]</h3>
                                    <p class="muted">@Strings["MarkdownLinksInert"]</p>
                                    <ul>
                                        @foreach (var link in _markdownContent.ExternalLinks)
                                        {
                                            <li><span>@link.Label</span><code>@link.Destination</code><button class="ghost" @onclick="() => ReviewExternalLink(link)">@Strings["ReviewLink"]</button></li>
                                        }
                                    </ul>
                                </section>
                            }
                        }
                    }
                    else
                    {
                        <pre class="text-viewer">@_textContent.Content</pre>
                    }

                    @if (_textSearchResult is not null)
                    {
                        <section class="text-search-results" aria-live="polite" aria-labelledby="text-search-results-title">
                            <h3 id="text-search-results-title">@Strings["SearchResults"]</h3>
                            @if (_textSearchResult.TotalMatches == 0)
                            {
                                <p>@Strings["NoMatchesFound"]</p>
                            }
                            else
                            {
                                var selected = _textSearchResult.Matches[_selectedSearchIndex];
                                <div class="selection-bar">
                                    <span>@Strings["TextSearchMatchSummary", _selectedSearchIndex + 1, _textSearchResult.TotalMatches, _textSearchResult.ResultsTruncated ? Strings["FirstNavigationMatches"] : string.Empty]</span>
                                    <div class="actions"><button class="secondary" @onclick="PreviousTextMatch">@Strings["Previous"]</button><button class="secondary" @onclick="NextTextMatch">@Strings["Next"]</button></div>
                                </div>
                                <p class="muted">@Strings["CharacterOffset", selected.CharacterOffset, _textContent.IsTruncated && selected.CharacterOffset >= _textContent.Content.Length ? Strings["BeyondDisplayedTextPrefix"] : string.Empty]</p>
                                <pre class="text-search-snippet">@selected.Snippet[..selected.MatchStart]<mark>@selected.Snippet.Substring(selected.MatchStart, selected.MatchLength)</mark>@selected.Snippet[(selected.MatchStart + selected.MatchLength)..]</pre>
                            }
                        </section>
                    }

                    @if (_pendingExternalLink is not null)
                    {
                        <section class="panel external-link-review" role="dialog" aria-labelledby="external-link-review-title">
                            <h3 id="external-link-review-title">@Strings["OpenExternalLink"]</h3>
                            <p>@Strings["ExternalLinkDestinationNotice"]</p>
                            <code>@_pendingExternalLink.Destination</code>
                            <div class="actions"><button @onclick="OpenReviewedExternalLinkAsync">@Strings["OpenExternally"]</button><button class="secondary" @onclick="CancelExternalLink">@Strings["Cancel"]</button></div>
                        </section>
                    }
                    @if (!_showTextEditor)
                    {
                        <button @onclick="BeginTextEdit" disabled="@_textContent.IsTruncated">@Strings["EditAsCopy"]</button>
                        @if (_textContent.IsTruncated) { <p class="muted">@Strings["TextTooLargeForEditor"]</p> }
                    }
                    else
                    {
                        <EditForm Model="_textCopyForm" OnValidSubmit="SaveTextCopyAsync" class="stack-form text-editor">
                            <label for="edited-content">@Strings["EditedContent"]</label>
                            <InputTextArea id="edited-content" @bind-Value="_textCopyForm.Content" />
                            <label for="edited-name">@Strings["NewFileName"]</label>
                            <InputText id="edited-name" @bind-Value="_textCopyForm.DisplayName" maxlength="255" />
                            <label for="edited-folder">@Strings["BulkDestinationFolder"]</label>
                            <InputSelect id="edited-folder" @bind-Value="_textCopyForm.DestinationFolderId">
                                @foreach (var folder in _availableFolders) { <option value="@folder.Id">@folder.Name</option> }
                            </InputSelect>
                            <label for="edited-format">@Strings["Format"]</label>
                            <InputSelect id="edited-format" @bind-Value="_textCopyForm.Format">
                                <option value="@TextCopyFormat.PreserveSourceFormat">@Strings["PreserveSourceFormat"]</option>
                                <option value="@TextCopyFormat.PlainText">@Strings["PlainTextFormat"]</option>
                                <option value="@TextCopyFormat.Markdown">@Strings["Markdown"]</option>
                            </InputSelect>
                            <label class="check"><InputCheckbox @bind-Value="_textCopyForm.CopyUserMetadata" /> @Strings["CopyUserMetadata"]</label>
                            @if (_textCopyForm.CopyUserMetadata && SensitiveMetadataCount > 0)
                            {
                                <label class="check"><InputCheckbox @bind-Value="_textCopyForm.IncludeSensitiveMetadata" /> @Strings["IncludeSensitiveMetadataCount", SensitiveMetadataCount]</label>
                            }
                            <div class="actions"><button type="submit">@Strings["SaveEditedCopy"]</button><button type="button" class="secondary" @onclick="CancelTextEdit">@Strings["Cancel"]</button></div>
                        </EditForm>
                    }
                }
            </article>
        }

        <article class="panel">
            <div class="section-heading"><h2>@Strings["SystemInformation"]</h2>@if (_technicalMetadataLoading) { <button class="secondary" @onclick="CancelTechnicalMetadata">@Strings["CancelTechnicalMetadata"]</button> }</div>
            @if (_technicalMetadataLoading) { <p role="status">@Strings["ReadingTechnicalMetadata"]</p> }
            <dl>
                <dt>@Strings["ContentHash"]</dt><dd class="mono">@Strings["ContentHashSummary", _file.ContentHash]</dd>
                <dt>@Strings["OriginalFilename"]</dt><dd>@_file.OriginalFileName</dd>
                <dt>@Strings["Imported"]</dt><dd>@_file.ImportedAt.ToLocalTime().ToString("g")</dd>
                <dt>@Strings["LibraryModified"]</dt><dd>@_file.ModifiedAt.ToLocalTime().ToString("g")</dd>
                @if (_file.SourceLastModified is not null) { <dt>@Strings["SourceLastModified"]</dt><dd>@_file.SourceLastModified.Value.ToLocalTime().ToString("g")</dd> }
                <dt>@Strings["Origin"]</dt><dd>@FormatOrigin(_file.Origin)</dd>
                <dt>@Strings["State"]</dt><dd>@FormatRecordState(_file.State)</dd>
                <dt>@Strings["ContentState"]</dt><dd>@ContentStateLabel(_file.ContentState)</dd>
                @foreach (var property in _systemMetadata?.Properties.Where(property => property.Key is not ("mediaType" or "byteSize" or "contentState") && property.Value is not null) ?? []) { <dt>@property.DisplayName</dt><dd>@property.Value</dd> }
                @if (_imageTechnicalProperties?.Width is not null && _imageTechnicalProperties.Height is not null) { <dt>@Strings["ImageDimensions"]</dt><dd>@Strings["ImageDimensionsValue", _imageTechnicalProperties.Width, _imageTechnicalProperties.Height]</dd> }
                @if (_contentProvenance?.ReplacedAt is not null) { <dt>@Strings["ContentReplaced"]</dt><dd>@_contentProvenance.ReplacedAt.Value.ToLocalTime().ToString("g")</dd> }
                @if (_derivationProvenance?.SourceFileId is not null) { <dt>@Strings["DerivedFrom"]</dt><dd class="mono">@_derivationProvenance.SourceFileId</dd> }
                @if (_derivationProvenance?.DeletedSource is { } deletedSource) { <dt>@Strings["DeletedSource"]</dt><dd>@Strings["DeletedSourceSummary", deletedSource.DisplayName, deletedSource.MediaType, deletedSource.ContentHash]</dd> }
            </dl>
        </article>

        @if (_derivationChain.Count > 1)
        {
            <article class="panel">
                <h2>@Strings["ProvenanceChain"]</h2>
                <ol>
                    @foreach (var entry in _derivationChain)
                    {
                        <li><span>@entry.File.DisplayName</span> <small class="muted">@Strings["ProvenanceChainEntry", entry.File.Id, FormatRecordState(entry.File.State), entry.DerivedBy is null ? string.Empty : Strings["DerivedBySuffix", entry.DerivedBy]]</small></li>
                    }
                </ol>
                <p class="muted">@Strings["ProvenanceChainDescription"]</p>
            </article>
        }

        <article class="panel">
            <h2>@Strings["Tags"]</h2>
            @if (_fileTags.Count == 0)
            {
                <p class="empty">@Strings["NoTags"]</p>
            }
            else
            {
                <ul class="tag-list">
                    @foreach (var tag in _fileTags)
                    {
                        <li class="tag-chip @(tag.IsInheritable ? "inheritable" : "")">
                            @tag.Name
                            <button type="button" class="ghost tag-inherit-toggle" aria-pressed="@tag.IsInheritable" title="@Strings["TagInheritableHelp"]" @onclick="() => ToggleTagInheritableAsync(tag)">@(tag.IsInheritable ? Strings["TagInheritableOn"] : Strings["TagInheritableOff"])</button>
                            <button class="ghost" aria-label="@Strings["RemoveTagAria", tag.Name]" @onclick="() => RemoveTagAsync(tag)">&times;</button>
                        </li>
                    }
                </ul>
            }
            <div class="inline-form">
                <label for="new-tag-name">@Strings["AddTag"]</label>
                <input id="new-tag-name" list="known-tags" maxlength="60" @bind="_newTagName" @bind:event="oninput" @onkeydown="@(async e => { if (e.Key == "Enter") await AddTagAsync(); })" />
                <datalist id="known-tags">
                    @foreach (var tag in _allTags) { <option value="@tag.Name" /> }
                </datalist>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(_newTagName)" @onclick="AddTagAsync">@Strings["AddTag"]</button>
            </div>
        </article>

        <article class="panel">
            <h2>@Strings["UserMetadata"]</h2>
            @if (_metadata.Count == 0)
            {
                <p class="empty">@Strings["NoUserMetadata"]</p>
            }
            else
            {
                <ul class="metadata-list">
                    @foreach (var item in _metadata)
                    {
                        <li>
                            <div><strong>@item.Key</strong><small>@Strings["MetadataItemSummary", FormatMetadataKind(item.Kind), item.IsSensitive ? Strings["SensitiveMetadataSuffix"] : string.Empty]</small></div>
                            @if (item.IsSensitive && !SensitiveReveals.IsRevealed(item.Id))
                            {
                                <span class="concealed-value" aria-hidden="true">@Strings["Concealed"]</span><span class="sr-only">@Strings["ConcealedSensitiveMetadataSummary", item.Key, FormatMetadataKind(item.Kind)]</span>
                            }
                            else
                            {
                                <div><code>@item.SerializedValue</code>@if (item.Kind == MetadataValueKind.DateTime) { <small>@Strings["MetadataLocalTime", FormatMetadataLocalTime(item.SerializedValue)]</small> }</div>
                            }
                            @if (item.IsSensitive)
                            {
                                <button class="ghost" aria-label="@(SensitiveReveals.IsRevealed(item.Id) ? Strings["ConcealMetadataAria", item.Key] : Strings["RevealMetadataAria", item.Key])" @onclick="() => ToggleReveal(item.Id)">@(SensitiveReveals.IsRevealed(item.Id) ? Strings["Conceal"] : Strings["RevealForSession"])</button>
                                @if (SensitiveReveals.IsRevealed(item.Id)) { <button class="ghost" @onclick="() => CopySensitiveMetadataAsync(item.SerializedValue)">@Strings["CopyValue"]</button> }
                            }
                            <button class="ghost" @onclick="() => BeginRename(item)">@Strings["RenameKey"]</button>
                            <button class="danger ghost" @onclick="() => RemoveMetadataAsync(item.Key)">@Strings["Remove"]</button>
                            @if (_renamingMetadataId == item.Id)
                            {
                                <div class="inline-form">
                                    <label for="rename-key-@item.Id">@Strings["NewKey"]</label>
                                    <input id="rename-key-@item.Id" @bind="_renameKey" maxlength="100" />
                                    <button @onclick="() => RenameMetadataAsync(item.Key)">@Strings["SaveKey"]</button>
                                    <button class="secondary" @onclick="CancelRename">@Strings["Cancel"]</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            <EditForm Model="_metadataForm" OnValidSubmit="ReviewMetadataAsync" class="stack-form">
                <label for="metadata-key">@Strings["Key"]</label>
                <InputText id="metadata-key" @bind-Value="_metadataForm.Key" maxlength="100" />
                <label for="metadata-kind">@Strings["Type"]</label>
                <InputSelect id="metadata-kind" @bind-Value="_metadataForm.Kind">
                    @foreach (var kind in Enum.GetValues<MetadataValueKind>()) { <option value="@kind">@FormatMetadataKind(kind)</option> }
                </InputSelect>
                <label for="metadata-value">@Strings["Value"]</label>
                @if (_metadataForm.IsSensitive)
                {
                    <input id="metadata-value" type="password" autocomplete="new-password" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="@Strings["SensitiveMetadataValue"]" @bind="_metadataForm.Value" />
                }
                else
                {
                    <InputTextArea id="metadata-value" @bind-Value="_metadataForm.Value" />
                }
                <label class="check"><InputCheckbox @bind-Value="_metadataForm.IsSensitive" /> @Strings["Sensitive"]</label>
                <button type="submit">@Strings["AddOrUpdateMetadata"]</button>
            </EditForm>
            @if (_confirmSensitiveMetadata)
            {
                <div class="notice" role="status"><p>@Strings["SensitiveMetadataSaveDisclosure"]</p><button @onclick="ConfirmSensitiveMetadataAsync">@Strings["UnderstandSaveSensitiveMetadata"]</button><button class="secondary" @onclick="() => _confirmSensitiveMetadata = false">@Strings["Cancel"]</button></div>
            }
        </article>

        <article class="panel">
            <h2>@Strings["Links"]</h2>
            @if (_links.Count == 0) { <p class="empty">@Strings["NoFileLinks"]</p> }
            else
            {
                <ul class="metadata-list">
                    @foreach (var link in _links)
                    {
                        <li>
                            <div><strong>@link.Label</strong><small>@Strings["LinkSummary", FileName(link.SourceFileId), FileName(link.TargetFileId), FormatRecordState(link.State)]</small></div>
                            @if (link.State == LibraryRecordState.Active)
                            {
                                <button class="ghost" @onclick="() => BeginLinkRename(link)">@Strings["Relabel"]</button>
                                <button class="ghost" @onclick="() => ReverseLinkAsync(link.Id)">@Strings["ReverseDirection"]</button>
                                <button class="danger ghost" @onclick="() => RecycleLinkAsync(link.Id)">@Strings["RecycleLink"]</button>
                            }
                            @if (_renamingLinkId == link.Id)
                            {
                                <div class="inline-form">
                                    <label for="link-rename-@link.Id">@Strings["NewLabel"]</label>
                                    <input id="link-rename-@link.Id" @bind="_renamedLinkLabel" maxlength="200" />
                                    <button @onclick="() => RelabelLinkAsync(link.Id)">@Strings["SaveLabel"]</button>
                                    <button class="secondary" @onclick="CancelLinkRename">@Strings["Cancel"]</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            @if (_availableFiles.Count == 0)
            {
                <p class="empty">@Strings["ImportAnotherFileForLink"]</p>
            }
            else
            {
                <EditForm Model="_linkForm" OnValidSubmit="CreateLinkAsync" class="stack-form">
                    <label for="link-target">@Strings["TargetFile"]</label>
                    <InputSelect id="link-target" @bind-Value="_linkForm.TargetFileId">
                        <option value="">@Strings["SelectAFile"]</option>
                        @foreach (var target in _availableFiles) { <option value="@target.Id">@target.DisplayName</option> }
                    </InputSelect>
                    <label for="link-label">@Strings["Label"]</label>
                    <InputText id="link-label" @bind-Value="_linkForm.Label" maxlength="200" />
                    <button type="submit">@Strings["CreateDirectedLink"]</button>
                </EditForm>
            }
        </article>
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private FileRecord? _file;
    private IReadOnlyList<MetadataEntry> _metadata = [];
    private IReadOnlyList<Tag> _fileTags = [];
    private IReadOnlyList<Tag> _allTags = [];
    private string _newTagName = string.Empty;
    private IReadOnlyList<FileLink> _links = [];
    private IReadOnlyList<FileRecord> _availableFiles = [];
    private IReadOnlyList<FolderRecord> _availableFolders = [];
    private TextFileContent? _textContent;
    private string? _textError;
    private RenderedMarkdownContent? _markdownContent;
    private string? _markdownError;
    private bool _showRenderedMarkdown;
    private TextSearchResult? _textSearchResult;
    private int _selectedSearchIndex;
    private bool _searchingText;
    private TextSearchForm _textSearchForm = new();
    private MarkdownExternalLink? _pendingExternalLink;
    private string? _imageDataUri;
    private string? _imageError;
    private ImageTechnicalProperties? _imageTechnicalProperties;
    private FileSystemMetadata? _systemMetadata;
    private CancellationTokenSource? _technicalMetadataCancellation;
    private bool _technicalMetadataLoading;
    private ManagedMediaSource? _mediaSource;
    private string? _mediaError;
    private bool _mediaPreparing;
    private ElementReference _mediaElement;
    private bool _registerMediaElement;
    private double _playbackRate = 1;
    private int _imageZoom = 100;
    private int _imageRotation;
    private bool _fitImage = true;
    private string? _animatedImagePosterUri;
    private bool _animatedImagePlaying;
    private MetadataForm _metadataForm = new();
    private bool _confirmSensitiveMetadata;
    private LinkForm _linkForm = new();
    private string? _message;
    private FileContentHealth? _contentHealth;
    private FileContentProvenance? _contentProvenance;
    private FileDerivationProvenance? _derivationProvenance;
    private IReadOnlyList<FileDerivationChainEntry> _derivationChain = [];
    private bool _verifyingContent;
    private ChangedContentInspection? _changedInspection;
    private TextFileContent? _changedText;
    private bool _inspectingChangedContent;
    private ManagedContentReplacementReview? _replacementReview;
    private string? _replacementSourcePath;
    private bool _clearMetadataAfterReplacement;
    private bool _replacingContent;
    private bool _fileActionBusy;
    private bool _confirmExternalOpen;
    private string? _renamingMetadataId;
    private string _renameKey = string.Empty;
    private string? _renamingLinkId;
    private string _renamedLinkLabel = string.Empty;
    private bool _showTextEditor;
    private TextCopyForm _textCopyForm = new();
    private int SensitiveMetadataCount => _metadata.Count(item => item.IsSensitive);
    private BuiltInPreviewKind PreviewKind => _file is null ? BuiltInPreviewKind.Unsupported : BuiltInPreviewCapabilities.ForMediaType(_file.MediaType);
    private int ImageOrientationRotation => _imageTechnicalProperties?.Orientation switch
    {
        3 or 4 => 180,
        5 or 6 => 90,
        7 or 8 => 270,
        _ => 0
    };
    private int ImageOrientationScaleX => _imageTechnicalProperties?.Orientation is 2 or 4 or 5 or 7 ? -1 : 1;
    private string ImageTransform => $"rotate({_imageRotation + ImageOrientationRotation}deg) scaleX({ImageOrientationScaleX}) scale({_imageZoom / 100d})";

    protected override void OnInitialized() => LibraryState.Changed += OnLibraryStateChanged;

    protected override async Task OnParametersSetAsync()
    {
        await LibraryState.InitializeAsync();
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_registerMediaElement && _mediaSource is not null)
        {
            _registerMediaElement = false;
            await JavaScript.InvokeVoidAsync("slopFactoryMedia.register", _mediaElement);
        }
    }

    private async Task ReloadAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            _contentHealth = await LibraryState.Workspace.RevalidateFileContentAsync(Id);
            _file = _contentHealth.File;
            _changedInspection = null;
            _changedText = null;
            _contentProvenance = await LibraryState.Workspace.GetFileContentProvenanceAsync(Id);
            _derivationProvenance = await LibraryState.Workspace.GetFileDerivationProvenanceAsync(Id);
            _derivationChain = await LibraryState.Workspace.GetFileDerivationChainAsync(Id);
            _technicalMetadataCancellation?.Cancel();
            _technicalMetadataCancellation?.Dispose();
            _technicalMetadataCancellation = new CancellationTokenSource();
            _technicalMetadataLoading = true;
            _systemMetadata = null;
            _ = LoadTechnicalMetadataAsync(LibraryState.Workspace, _technicalMetadataCancellation.Token);
            await StopMediaAsync();
            _mediaError = null;
            _mediaPreparing = false;
            _playbackRate = 1;
            if (CanUseContent(_file) && PreviewKind == BuiltInPreviewKind.Media)
            {
                _mediaPreparing = true;
                try
                {
                    _mediaSource = await MediaResources.CreateAsync(Id);
                    _registerMediaElement = true;
                }
                catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException)
                {
                    _mediaError = exception.Message;
                }
                finally { _mediaPreparing = false; }
            }
            _imageDataUri = null;
            _imageError = null;
            _imageTechnicalProperties = null;
            _imageZoom = 100;
            _imageRotation = 0;
            _fitImage = true;
            _animatedImagePosterUri = null;
            _animatedImagePlaying = false;
            if (CanUseContent(_file) && PreviewKind == BuiltInPreviewKind.Image)
            {
                try
                {
                    _imageTechnicalProperties = await LibraryState.Workspace.GetImageTechnicalPropertiesAsync(Id);
                    var image = await LibraryState.Workspace.ReadImageFileAsync(Id);
                    _imageDataUri = $"data:{image.MediaType};base64,{Convert.ToBase64String(image.Bytes)}";
                    if (_file.MediaType == "image/gif")
                    {
                        var poster = await PreviewCache.GetImageThumbnailAsync(LibraryState.Workspace, _file);
                        _animatedImagePosterUri = poster.DataUri;
                    }
                }
                catch (SlopFactoryException exception) { _imageError = exception.Message; }
            }
            _textContent = null;
            _textError = null;
            _markdownContent = null;
            _markdownError = null;
            _showRenderedMarkdown = false;
            ClearTextSearch();
            _pendingExternalLink = null;
            if (CanUseContent(_file) && PreviewKind == BuiltInPreviewKind.Text)
            {
                try { _textContent = await LibraryState.Workspace.ReadTextFileAsync(Id); }
                catch (SlopFactoryException exception) { _textError = exception.Message; }
            }
            _metadata = await LibraryState.Workspace.GetMetadataAsync(Id);
            _fileTags = await LibraryState.Workspace.GetTagsForFileAsync(Id);
            _allTags = await LibraryState.Workspace.GetAllTagsAsync();
            _links = await LibraryState.Workspace.GetLinksAsync(Id);
            _availableFiles = (await LibraryState.Workspace.GetActiveFilesAsync()).Where(file => file.Id != Id).ToArray();
            _availableFolders = await LibraryState.Workspace.GetActiveFoldersAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
        catch (Exception exception) { _message = $"{exception.GetType().Name}: {exception.Message}"; }
    }

    private async Task VerifyContentAsync()
    {
        _verifyingContent = true;
        try { await ReloadAsync(); _message = Strings["ContentVerificationComplete", ContentStateLabel(_file?.ContentState ?? FileContentState.Missing)]; }
        finally { _verifyingContent = false; }
    }

    private async Task InspectChangedContentAsync()
    {
        if (LibraryState.Workspace is null) return;
        _inspectingChangedContent = true;
        try
        {
            _changedInspection = await LibraryState.Workspace.InspectChangedContentAsync(Id);
            _changedText = _changedInspection.ActualMediaType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) || _changedInspection.ActualMediaType is "application/json" or "application/xml"
                ? await LibraryState.Workspace.ReadChangedTextFileAsync(Id)
                : null;
            _message = null;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
        finally { _inspectingChangedContent = false; }
    }

    private static bool CanUseContent(FileRecord file) => file.ContentState is FileContentState.Healthy or FileContentState.Replaced;
    private static bool HasDisplayExtensionMismatch(FileRecord file)
    {
        var displayExtension = Path.GetExtension(file.DisplayName);
        var expectedExtensions = file.MediaType switch
        {
            "image/png" => new[] { ".png" },
            "image/jpeg" => new[] { ".jpg", ".jpeg" },
            "image/webp" => new[] { ".webp" },
            "image/gif" => new[] { ".gif" },
            "image/svg+xml" => new[] { ".svg" },
            "application/pdf" => new[] { ".pdf" },
            "text/plain" => new[] { ".txt" },
            "text/markdown" => new[] { ".md", ".markdown" },
            "application/json" => new[] { ".json" },
            "application/xml" => new[] { ".xml" },
            "text/csv" => new[] { ".csv" },
            "audio/mpeg" => new[] { ".mp3" },
            "audio/wav" => new[] { ".wav" },
            "audio/flac" => new[] { ".flac" },
            "audio/ogg" => new[] { ".ogg", ".opus" },
            "audio/aac" => new[] { ".aac" },
            "audio/mp4" => new[] { ".m4a" },
            "video/mp4" => new[] { ".mp4" },
            _ => []
        };
        return expectedExtensions.Length > 0 && !expectedExtensions.Contains(displayExtension, StringComparer.OrdinalIgnoreCase);
    }
    private string FormatMetadataLocalTime(string serializedValue) => DateTimeOffset.TryParse(serializedValue, out var value)
        ? value.ToLocalTime().ToString("g")
        : Strings["Unavailable"];

    private string FormatMetadataKind(MetadataValueKind kind) => kind switch
    {
        MetadataValueKind.Text => Strings["MetadataKindText"],
        MetadataValueKind.Number => Strings["MetadataKindNumber"],
        MetadataValueKind.Boolean => Strings["MetadataKindBoolean"],
        MetadataValueKind.Date => Strings["MetadataKindDate"],
        MetadataValueKind.DateTime => Strings["MetadataKindDateTime"],
        _ => Strings["MetadataKindJson"]
    };

    private string FormatOrigin(FileOrigin origin) => origin switch
    {
        FileOrigin.Imported => Strings["OriginImported"],
        FileOrigin.Generated => Strings["OriginGenerated"],
        FileOrigin.UserCopy => Strings["OriginUserCopy"],
        FileOrigin.EditedCopy => Strings["OriginEditedCopy"],
        FileOrigin.UnverifiedProviderOutput => Strings["OriginUnverifiedProviderOutput"],
        _ => Strings["OriginRecoveredProviderOutput"]
    };

    private string FormatRecordState(LibraryRecordState state) => state switch
    {
        LibraryRecordState.Active => Strings["RecordStateActive"],
        LibraryRecordState.Recycled => Strings["RecordStateRecycled"],
        LibraryRecordState.PendingPermanentDeletion => Strings["RecordStatePendingPermanentDeletion"],
        LibraryRecordState.Missing => Strings["RecordStateMissing"],
        LibraryRecordState.ContentChanged => Strings["RecordStateContentChanged"],
        _ => Strings["RecordStateContentReplaced"]
    };
    private string ContentStateLabel(FileContentState state) => state switch
    {
        FileContentState.Missing => Strings["ContentStateMissing"],
        FileContentState.Changed => Strings["ContentStateContentChanged"],
        FileContentState.Replaced => Strings["ContentStateContentReplaced"],
        _ => Strings["ContentStateHealthy"]
    };

    private async Task ChooseReplacementAsync()
    {
        var selected = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = Strings["ChooseReplacementContentPickerTitle"] });
        if (selected is null) return;
        await ReviewReplacementAsync(selected.FullPath);
    }

    private Task ReviewCurrentBytesAsync() => ReviewReplacementAsync(null);

    private async Task ReviewReplacementAsync(string? sourcePath)
    {
        if (LibraryState.Workspace is null) return;
        _replacingContent = true;
        try
        {
            _replacementReview = await LibraryState.Workspace.ReviewManagedContentReplacementAsync(Id, sourcePath);
            _replacementSourcePath = sourcePath;
            _clearMetadataAfterReplacement = false;
            _message = null;
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
        finally { _replacingContent = false; }
    }

    private async Task CommitReplacementAsync()
    {
        if (LibraryState.Workspace is null || _replacementReview is null) return;
        // A file actively pinned by a queued/running generation using it as a source
        // input cannot be replaced or accepted until the pin releases or the work is cancelled.
        if (Queue.IsFileActivelyInUse(Id))
        {
            _message = Strings["FileActivelyInUse"];
            return;
        }
        _replacingContent = true;
        try
        {
            var restoresOriginal = _replacementReview.RestoresOriginal;
            await LibraryState.Workspace.CommitManagedContentReplacementAsync(_replacementReview, _replacementSourcePath, !restoresOriginal, !restoresOriginal && _clearMetadataAfterReplacement);
            CancelReplacementReview();
            await ReloadAsync();
            _message = restoresOriginal ? Strings["RecordedOriginalRestored"] : Strings["ReplacementContentAccepted"];
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
        finally { _replacingContent = false; }
    }

    private void CancelReplacementReview()
    {
        _replacementReview = null;
        _replacementSourcePath = null;
        _clearMetadataAfterReplacement = false;
    }

    private Task ReviewMetadataAsync()
    {
        if (_metadataForm.IsSensitive && !SensitiveDisclosure.IsAcknowledged)
        {
            _confirmSensitiveMetadata = true;
            return Task.CompletedTask;
        }
        return SaveMetadataAsync();
    }

    private async Task ConfirmSensitiveMetadataAsync()
    {
        SensitiveDisclosure.Acknowledge();
        _confirmSensitiveMetadata = false;
        await SaveMetadataAsync();
    }

    private async Task SaveMetadataAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.SetMetadataAsync(Id, _metadataForm.Key, _metadataForm.Kind, _metadataForm.Value, _metadataForm.IsSensitive);
            _metadataForm = new();
            _message = Strings["MetadataSaved"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task RemoveMetadataAsync(string key)
    {
        if (LibraryState.Workspace is null) return;
        await LibraryState.Workspace.RemoveMetadataAsync(Id, key);
        await ReloadAsync();
    }

    private async Task AddTagAsync()
    {
        if (LibraryState.Workspace is null || string.IsNullOrWhiteSpace(_newTagName)) return;
        try
        {
            var names = _fileTags.Select(tag => tag.Name).Append(_newTagName).ToArray();
            await LibraryState.Workspace.SetTagsForFileAsync(Id, names);
            _newTagName = string.Empty;
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task RemoveTagAsync(Tag tag)
    {
        if (LibraryState.Workspace is null) return;
        var names = _fileTags.Where(existing => existing.Id != tag.Id).Select(existing => existing.Name).ToArray();
        await LibraryState.Workspace.SetTagsForFileAsync(Id, names);
        await ReloadAsync();
    }

    /// <summary>Inheritable is a property of the tag itself, not of this file's assignment of it — so
    /// this flips it for every file carrying the tag, not just <see cref="_file"/>.</summary>
    private async Task ToggleTagInheritableAsync(Tag tag)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.SetTagInheritableAsync(tag.Id, !tag.IsInheritable);
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private void BeginRename(MetadataEntry entry)
    {
        _renamingMetadataId = entry.Id;
        _renameKey = entry.Key;
    }

    private void CancelRename()
    {
        _renamingMetadataId = null;
        _renameKey = string.Empty;
    }

    private async Task RenameMetadataAsync(string currentKey)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RenameMetadataAsync(Id, currentKey, _renameKey);
            CancelRename();
            _message = Strings["MetadataKeyRenamed"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task CreateLinkAsync()
    {
        if (LibraryState.Workspace is null || string.IsNullOrWhiteSpace(_linkForm.TargetFileId)) return;
        try
        {
            await LibraryState.Workspace.CreateLinkAsync(Id, _linkForm.TargetFileId, _linkForm.Label);
            _linkForm = new();
            _message = Strings["LinkCreated"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private void BeginLinkRename(FileLink link)
    {
        _renamingLinkId = link.Id;
        _renamedLinkLabel = link.Label;
    }

    private void CancelLinkRename()
    {
        _renamingLinkId = null;
        _renamedLinkLabel = string.Empty;
    }

    private async Task RelabelLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RelabelLinkAsync(linkId, _renamedLinkLabel);
            CancelLinkRename();
            _message = Strings["LinkRelabelled"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task ReverseLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.ReverseLinkAsync(linkId);
            _message = Strings["LinkDirectionReversed"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private async Task RecycleLinkAsync(string linkId)
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            await LibraryState.Workspace.RecycleLinkAsync(linkId);
            _message = Strings["LinkRecycled"];
            await ReloadAsync();
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
    }

    private void BeginTextEdit()
    {
        if (_file is null || _textContent is null || _textContent.IsTruncated) return;
        var extension = Path.GetExtension(_file.DisplayName);
        var stem = Path.GetFileNameWithoutExtension(_file.DisplayName);
        _textCopyForm = new TextCopyForm
        {
            Content = _textContent.Content,
            DisplayName = Strings["DefaultEditedCopyName", stem, extension],
            DestinationFolderId = _file.FolderId,
            Format = TextCopyFormat.PreserveSourceFormat
        };
        _showTextEditor = true;
    }

    private void CancelTextEdit()
    {
        _showTextEditor = false;
        _textCopyForm = new();
    }

    private void ShowPlainText()
    {
        _showRenderedMarkdown = false;
        _pendingExternalLink = null;
    }

    private async Task ShowRenderedMarkdownAsync()
    {
        if (LibraryState.Workspace is null || _textContent?.IsTruncated != false) return;
        _showRenderedMarkdown = true;
        _pendingExternalLink = null;
        if (_markdownContent is not null || _markdownError is not null) return;
        try { _markdownContent = await LibraryState.Workspace.RenderMarkdownFileAsync(Id); }
        catch (SlopFactoryException exception)
        {
            _markdownError = exception.Message;
            _showRenderedMarkdown = false;
            _message = Strings["PlainTextShownInstead", exception.Message];
        }
    }

    private sealed class SidecarOptionsForm
    {
        public bool WriteSidecar { get; set; }
        public bool IncludePrompt { get; set; }
        public bool IncludeFilenames { get; set; }
        public bool IncludeInternalIdentifiers { get; set; }
        public bool IncludeUsageAndCost { get; set; }
        public bool IncludeAdvancedSettings { get; set; }

        // Opt-ins this app has no supporting data for yet — present so the user can see
        // they're deliberately unavailable rather than silently absent, never selectable.
        public ExportSidecarOptions ToOptions() => new(WriteSidecar, IncludePrompt, IncludeSensitiveMetadata: false, IncludeFilenames, IncludeInternalIdentifiers, IncludeUsageAndCost, IncludeAdvancedSettings, IncludeSafetyMetadata: false);
    }

    private readonly SidecarOptionsForm _sidecarForm = new();
    private string? _sidecarPreview;
    private bool _sidecarPreviewBusy;

    /// <summary>Disclosure preview — shows the exact JSON a real export with the
    /// currently checked options would write, without exporting anything, so the user can see what
    /// they're about to disclose before committing to it.</summary>
    private async Task PreviewSidecarAsync()
    {
        if (_file is null || LibraryState.Workspace is null) return;
        _sidecarPreviewBusy = true;
        try
        {
            _sidecarPreview = await LibraryState.Workspace.BuildSidecarPreviewAsync(_file.Id, _sidecarForm.ToOptions());
        }
        catch (SlopFactoryException exception)
        {
            _message = exception.Message;
        }
        finally
        {
            _sidecarPreviewBusy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_file is null || LibraryState.Workspace is null) return;
        _fileActionBusy = true;
        try
        {
            var (result, sidecar) = await PlatformFiles.ExportAsync(LibraryState.Workspace, _file, changedBytes: false, _sidecarForm.ToOptions());
            // A destination read-back mismatch recommends an integrity scan rather
            // than silently retrying or claiming the failure means the source library file is
            // corrupt (nothing about this failure touches its ContentState at all).
            if (result.Outcome == FileExportOutcome.VerificationFailed) ScanRecommendation.Recommend(IntegrityScanRecommendationReason.StorageInconsistency);
            var mediaMessage = result.Outcome switch { FileExportOutcome.Exported => Strings["ExportCompleted"], FileExportOutcome.Cancelled => Strings["ExportCancelled"], _ => result.Error ?? Strings["ExportFailed"] };
            _message = sidecar is null
                ? mediaMessage
                : $"{mediaMessage} {(sidecar.Outcome == FileExportOutcome.Exported ? Strings["SidecarExportCompleted"] : Strings["SidecarExportFailed", sidecar.Error ?? string.Empty])}";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or SlopFactoryException) { _message = exception.Message; }
        finally { _fileActionBusy = false; }
    }

    private async Task LoadTechnicalMetadataAsync(ILibraryWorkspace workspace, CancellationToken cancellationToken)
    {
        try { _systemMetadata = await workspace.GetSystemMetadataAsync(Id, cancellationToken); }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = Strings["TechnicalMetadataUnavailable", exception.Message]; }
        finally { _technicalMetadataLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private void CancelTechnicalMetadata() => _technicalMetadataCancellation?.Cancel();

    private async Task ExportChangedBytesAsync()
    {
        if (_file is null || LibraryState.Workspace is null) return;
        _fileActionBusy = true;
        try
        {
            var (result, _) = await PlatformFiles.ExportAsync(LibraryState.Workspace, _file, changedBytes: true);
            if (result.Outcome == FileExportOutcome.VerificationFailed) ScanRecommendation.Recommend(IntegrityScanRecommendationReason.StorageInconsistency);
            _message = result.Outcome switch { FileExportOutcome.Exported => Strings["ChangedBytesExported"], FileExportOutcome.Cancelled => Strings["ChangedBytesExportCancelled"], _ => result.Error ?? Strings["ChangedBytesExportFailed"] };
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or SlopFactoryException) { _message = exception.Message; }
        finally { _fileActionBusy = false; }
    }

    private Task ReviewExternalOpenAsync()
    {
        if (_file is null) return Task.CompletedTask;
        if (ContentActionPolicy.GetExternalOpenSafety(_file) == ExternalOpenSafety.Allowed) return OpenExternallyAsync();
        _confirmExternalOpen = true;
        return Task.CompletedTask;
    }

    private async Task OpenExternallyAsync()
    {
        if (_file is null || LibraryState.Workspace is null) return;
        _fileActionBusy = true;
        try { await PlatformFiles.OpenExternallyAsync(LibraryState.Workspace, _file); _confirmExternalOpen = false; _message = Strings["ExternalOpenComplete"]; }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException or SlopFactoryException) { _message = exception.Message; }
        finally { _fileActionBusy = false; }
    }

    private async Task SearchTextAsync()
    {
        if (LibraryState.Workspace is null) return;
        _searchingText = true;
        try
        {
            _textSearchResult = await LibraryState.Workspace.SearchTextFileAsync(Id, _textSearchForm.SearchText, _textSearchForm.MatchCase);
            _selectedSearchIndex = 0;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; }
        finally { _searchingText = false; }
    }

    private void ClearTextSearch()
    {
        _textSearchResult = null;
        _selectedSearchIndex = 0;
    }

    private void PreviousTextMatch()
    {
        if (_textSearchResult?.Matches.Count > 0) _selectedSearchIndex = (_selectedSearchIndex + _textSearchResult.Matches.Count - 1) % _textSearchResult.Matches.Count;
    }

    private void NextTextMatch()
    {
        if (_textSearchResult?.Matches.Count > 0) _selectedSearchIndex = (_selectedSearchIndex + 1) % _textSearchResult.Matches.Count;
    }

    private void ReviewExternalLink(MarkdownExternalLink link) => _pendingExternalLink = link;
    private void CancelExternalLink() => _pendingExternalLink = null;

    private async Task OpenReviewedExternalLinkAsync()
    {
        if (_pendingExternalLink is null) return;
        try
        {
            await Browser.Default.OpenAsync(new Uri(_pendingExternalLink.Destination), BrowserLaunchMode.SystemPreferred);
            _pendingExternalLink = null;
        }
        catch (Exception exception) when (exception is UriFormatException or InvalidOperationException or NotSupportedException or ArgumentException)
        {
            _message = Strings["ExternalDestinationCouldNotOpen", exception.Message];
        }
    }

    private async Task SaveTextCopyAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            var copy = await LibraryState.Workspace.CreateEditedTextCopyAsync(
                Id,
                _textCopyForm.DestinationFolderId,
                _textCopyForm.DisplayName,
                _textCopyForm.Content,
                _textCopyForm.Format,
                _textCopyForm.CopyUserMetadata,
                _textCopyForm.CopyUserMetadata && _textCopyForm.IncludeSensitiveMetadata);
            Navigation.NavigateTo($"/file/{copy.Id}");
        }
        catch (Exception exception) when (exception is SlopFactoryException or IOException or UnauthorizedAccessException) { _message = exception.Message; }
    }

    private void ToggleReveal(string id) => SensitiveReveals.Toggle(id);

    private async Task CopySensitiveMetadataAsync(string value)
    {
        await Clipboard.Default.SetTextAsync(value);
        _message = Strings["SensitiveValueCopied"];
    }

    private void OnLibraryStateChanged(object? sender, EventArgs args) => _ = InvokeAsync(() =>
    {
        SensitiveReveals.Clear();
        StateHasChanged();
    });
    private void FitImage() { _fitImage = true; _imageZoom = 100; }
    private void ActualImageSize() { _fitImage = false; _imageZoom = 100; }
    private void RotateImage() => _imageRotation = (_imageRotation + 90) % 360;
    private void ToggleAnimatedImage() => _animatedImagePlaying = !_animatedImagePlaying;
    private async Task ChangePlaybackRateAsync(ChangeEventArgs args)
    {
        if (!double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rate)) return;
        _playbackRate = rate;
        await JavaScript.InvokeVoidAsync("slopFactoryMedia.setRate", _mediaElement, rate);
    }
    private async Task StopMediaAsync()
    {
        if (_mediaSource is null) return;
        try { await JavaScript.InvokeVoidAsync("slopFactoryMedia.stop", _mediaElement); }
        catch (JSDisconnectedException) { }
        MediaResources.Revoke(_mediaSource.Token);
        _mediaSource = null;
        _registerMediaElement = false;
    }
    public async ValueTask DisposeAsync()
    {
        LibraryState.Changed -= OnLibraryStateChanged;
        _technicalMetadataCancellation?.Cancel();
        _technicalMetadataCancellation?.Dispose();
        await StopMediaAsync();
    }
    private void Back() => Navigation.NavigateTo("/");
    private string FileName(string fileId) => fileId == _file?.Id ? _file.DisplayName : _availableFiles.FirstOrDefault(file => file.Id == fileId)?.DisplayName ?? Strings["UnavailableFileIdentifier", fileId[..Math.Min(8, fileId.Length)]];

    private sealed class MetadataForm
    {
        public string Key { get; set; } = string.Empty;
        public MetadataValueKind Kind { get; set; } = MetadataValueKind.Text;
        public string Value { get; set; } = string.Empty;
        public bool IsSensitive { get; set; }
    }

    private sealed class LinkForm
    {
        public string TargetFileId { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }

    private sealed class TextCopyForm
    {
        public string Content { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string DestinationFolderId { get; set; } = string.Empty;
        public TextCopyFormat Format { get; set; }
        public bool CopyUserMetadata { get; set; }
        public bool IncludeSensitiveMetadata { get; set; }
    }

    private sealed class TextSearchForm
    {
        public string SearchText { get; set; } = string.Empty;
        public bool MatchCase { get; set; }
    }
}
