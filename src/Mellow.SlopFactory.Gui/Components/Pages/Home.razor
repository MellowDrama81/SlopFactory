    private async Task BeginBulkMetadataAsync()
    {
        if (LibraryState.Workspace is null) return;
        _bulkAction = BulkAction.Metadata;
        _bulkMetadataPreview = null;
        var selectedMetadata = new List<IReadOnlyList<MetadataEntry>>(_selectedFileIds.Count);
        foreach (var fileId in _selectedFileIds) selectedMetadata.Add(await LibraryState.Workspace.GetMetadataAsync(fileId));
        if (selectedMetadata.Count == 0) { _commonMetadata = []; return; }
        _commonMetadata = selectedMetadata[0]
            .Where(entry => selectedMetadata.All(items => items.Any(candidate => LibraryRules.ComparisonKey(candidate.Key) == LibraryRules.ComparisonKey(entry.Key))))
            .Select(entry => SummarizeCommonMetadata(entry.Key, selectedMetadata))
            .OrderBy(item => item.Key, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
    }

    private static CommonMetadataSummary SummarizeCommonMetadata(string key, IReadOnlyList<IReadOnlyList<MetadataEntry>> selectedMetadata)
    {
        var entries = selectedMetadata.Select(items => items.Single(item => LibraryRules.ComparisonKey(item.Key) == LibraryRules.ComparisonKey(key))).ToArray();
        var kinds = entries.Select(item => item.Kind).Distinct().ToArray();
        var mixedSensitivity = entries.Select(item => item.IsSensitive).Distinct().Count() > 1;
        var typeLabel = kinds.Length == 1 ? kinds[0].ToString() : "Mixed Types";
        string valueLabel;
        if (entries.Any(item => item.IsSensitive)) valueLabel = mixedSensitivity ? "Mixed sensitivity; values concealed" : "Sensitive values concealed";
        else if (kinds.Length > 1) valueLabel = "Mixed values";
        else if (entries.Select(item => item.SerializedValue).Distinct(StringComparer.Ordinal).Count() > 1) valueLabel = "Mixed values";
        else valueLabel = $"Same value: {TruncateMetadataValue(entries[0].SerializedValue)}";
        return new CommonMetadataSummary(entries[0].Key, typeLabel, valueLabel);
    }

    private async Task ReviewBulkMetadataSetAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            var key = LibraryRules.NormalizeMetadataKey(_bulkMetadata.Key);
            _ = LibraryRules.ValidateMetadataValue(_bulkMetadata.Kind, _bulkMetadata.Value);
            var entries = await GetSelectedMetadataKeyAsync(key);
            _bulkMetadataPreview = new BulkMetadataPreview(false, entries.Count, entries.Count(item => item.IsSensitive),
                $"Set '{key}' as {_bulkMetadata.Kind} on {_selectedFileIds.Count} file(s), replacing {entries.Count} existing entr{(entries.Count == 1 ? "y" : "ies")}.");
            _message = null;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; _bulkMetadataPreview = null; }
    }

    private async Task ReviewBulkMetadataRemovalAsync()
    {
        if (LibraryState.Workspace is null) return;
        try
        {
            var key = LibraryRules.NormalizeMetadataKey(_bulkMetadata.Key);
            var entries = await GetSelectedMetadataKeyAsync(key);
            _bulkMetadataPreview = new BulkMetadataPreview(true, entries.Count, entries.Count(item => item.IsSensitive),
                $"Remove '{key}' from {entries.Count} of the {_selectedFileIds.Count} selected file(s). Files without that key remain unchanged.");
            _message = null;
        }
        catch (SlopFactoryException exception) { _message = exception.Message; _bulkMetadataPreview = null; }
    }

    private async Task<IReadOnlyList<MetadataEntry>> GetSelectedMetadataKeyAsync(string key)
    {
        if (LibraryState.Workspace is null) return [];
        var entries = new List<MetadataEntry>();
        foreach (var fileId in _selectedFileIds)
        {
            var match = (await LibraryState.Workspace.GetMetadataAsync(fileId)).FirstOrDefault(item => LibraryRules.ComparisonKey(item.Key) == LibraryRules.ComparisonKey(key));
            if (match is not null) entries.Add(match);
        }
        return entries;
    }

