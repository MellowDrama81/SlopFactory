        _browser.ImportedFrom = null;
        _browser.ImportedThrough = null;
        _browser.MetadataFilterEnabled = false;
        _browser.MetadataKey = string.Empty;
        _browser.MetadataKind = MetadataValueKind.Text;
        _browser.MetadataOperator = MetadataFilterOperator.Equals;
        _browser.MetadataComparisonValue = string.Empty;
        _browser.Offset = 0;
