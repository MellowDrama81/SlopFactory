@page "/"
@implements IDisposable
@inject AppLibraryState LibraryState
@inject NavigationManager Navigation
@inject PreviewCacheService PreviewCache
@inject IncomingImportService IncomingImports
@inject IRecentLibraryService RecentLibraries

<PageTitle>Library · SlopFactory</PageTitle>

@if (!LibraryState.IsInitialized)
{
    <section class="center-state" aria-live="polite"><h1>Opening your library</h1><p>Validating local storage…</p></section>
}
else if (LibraryState.Workspace is null)
{
    <section class="center-state error" role="alert"><h1>Library unavailable</h1><p>@LibraryState.Error</p></section>
}
else if (_contents is null)
{
    <section class="center-state" aria-live="polite"><h1>Loading library</h1></section>
}
else
{
    <header class="page-header">
        <div>
            <p class="eyebrow">Local library</p>
            <h1>@LibraryState.Workspace.Descriptor.DisplayName</h1>
            <p class="muted">@_contents.Folder.Name · @_contents.Folders.Count folder(s) · @_contents.Files.Count file(s)</p>
        </div>
        <div class="actions">
            <button class="secondary" @onclick="ToggleFolderForm">New folder</button>
            <button @onclick="ChooseImportFilesAsync" disabled="@_busy">Import files</button>
        </div>
    </header>

    @if (_showFolderForm)
    {
        <EditForm Model="_newFolder" OnValidSubmit="CreateFolderAsync" class="inline-form">
            <label for="folder-name">Folder name</label>
            <InputText id="folder-name" @bind-Value="_newFolder.Name" maxlength="255" />
            <button type="submit">Create</button>
            <button type="button" class="secondary" @onclick="ToggleFolderForm">Cancel</button>
        </EditForm>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="notice" role="status">@_message</div>
    }

    @if (_pendingImports.Count > 0)
    {
        <section class="panel import-review" aria-labelledby="import-review-title">
            <h2 id="import-review-title">Review import</h2>
            <label for="import-library">Target library</label>
            <select id="import-library" value="@_importForm.TargetLibraryPath" @onchange="ChangeImportTargetAsync" disabled="@_busy">
                @foreach (var library in AvailableImportLibraries()) { <option value="@library.Path">@library.DisplayName Â· @library.Path</option> }
            </select>
            <label for="import-folder">Destination folder</label>
            <InputSelect id="import-folder" @bind-Value="_importForm.DestinationFolderId" disabled="@_busy">
                @foreach (var folder in _activeFolders) { <option value="@folder.Id">@FolderPath(folder.Id)</option> }
            </InputSelect>
            <label class="check"><InputCheckbox @bind-Value="_importForm.ImportDuplicates" disabled="@_busy" /> Import byte-identical files as separate records instead of skipping them</label>
            <ul class="metadata-list">
                @foreach (var candidate in _pendingImports)
                {
                    <li>
                        <div><strong>@candidate.DisplayName</strong><small>@(candidate.ByteSize is null ? "Size unavailable until import" : FormatBytes(candidate.ByteSize.Value))@(!string.IsNullOrWhiteSpace(candidate.RelativeFolder) ? $" · {candidate.RelativeFolder}" : string.Empty)</small></div>
                        <button class="ghost danger" disabled="@_busy" @onclick="() => RemovePendingImport(candidate.Path)">Remove</button>
                    </li>
                }
            </ul>
            @if (_importProgress is not null)
            {
                <div class="scan-progress" role="status" aria-live="polite">
                    <progress max="@Math.Max(_importProgress.TotalBytes, 1)" value="@_importProgress.BytesProcessed"></progress>
                    <span>@_importProgress.Stage: @_importProgress.DisplayName Â· item @_importProgress.ItemIndex of @_importProgress.TotalItems</span>
                </div>
            }
            <div class="actions">
                <button disabled="@_busy" @onclick="ConfirmImportAsync">@(_busy ? "Importing..." : $"Import {_pendingImports.Count} file(s)")</button>
                @if (_busy) { <button class="secondary" @onclick="CancelImport">Cancel remaining import</button> }
                else { <button class="secondary" @onclick="CancelImportReview">Cancel</button> }
            </div>
        </section>
    }

    @if (_incomingFailures.Count > 0)
    {
        <section class="panel" aria-labelledby="incoming-failures-title">
            <div class="section-heading"><h2 id="incoming-failures-title">Incoming items not added to review</h2><button class="ghost" @onclick="() => _incomingFailures = []">Dismiss</button></div>
            <ul class="metadata-list">
                @foreach (var failure in _incomingFailures) { <li><div><strong>@failure.DisplayName</strong><small>@failure.Message</small></div></li> }
            </ul>
        </section>
    }

    @if (_lastImportResults.Count > 0)
    {
        <section class="panel import-results" aria-labelledby="import-results-title">
            <div class="section-heading"><h2 id="import-results-title">Import results</h2><button class="ghost" @onclick="() => _lastImportResults = []">Dismiss</button></div>
            <ul class="metadata-list">
                @foreach (var result in _lastImportResults)
                {
                    <li>
                        <div><strong>@result.Candidate.DisplayName</strong><small>@ImportOutcomeLabel(result.Outcome)@(!string.IsNullOrWhiteSpace(result.Error) ? $" Â· {result.Error}" : string.Empty)</small></div>
                        @if (result.Outcome == ImportOutcome.DuplicateSkipped)
                        {
                            @foreach (var match in result.Matches.Take(3)) { <button class="ghost" @onclick="() => OpenFile(match.Id)">Open existing @match.DisplayName</button> }
                        }
                        else if (result.File is not null)
                        {
                            <button class="ghost" @onclick="() => OpenFile(result.File.Id)">Open imported file</button>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (_editingFileId is not null || _editingFolderId is not null)
    {
        <EditForm Model="_itemForm" OnValidSubmit="SaveItemAsync" class="inline-form">
            <label for="item-name">Display name</label>
            <InputText id="item-name" @bind-Value="_itemForm.Name" maxlength="255" />
            <label for="item-folder">Location</label>
            <InputSelect id="item-folder" @bind-Value="_itemForm.DestinationFolderId">
                @foreach (var destination in AvailableDestinations())
                {
                    <option value="@destination.Id">@destination.Name</option>
                }
            </InputSelect>
            <button type="submit">Save changes</button>
            <button type="button" class="secondary" @onclick="CancelItemEdit">Cancel</button>
        </EditForm>
    }

    @if (_duplicatingFileId is not null)
    {
        <EditForm Model="_duplicateForm" OnValidSubmit="DuplicateFileAsync" class="inline-form">
            <label for="duplicate-name">Copy name</label>
            <InputText id="duplicate-name" @bind-Value="_duplicateForm.Name" maxlength="255" />
            <label for="duplicate-folder">Destination</label>
            <InputSelect id="duplicate-folder" @bind-Value="_duplicateForm.DestinationFolderId">
                @foreach (var destination in _activeFolders)
                {
                    <option value="@destination.Id">@destination.Name</option>
                }
            </InputSelect>
            <button type="submit">Create copy</button>
            <button type="button" class="secondary" @onclick="CancelDuplicate">Cancel</button>
        </EditForm>
    }

    <nav class="breadcrumbs" aria-label="Folder path">
        @foreach (var folder in Breadcrumbs())
        {
            <button class="text-button" @onclick="() => OpenFolderAsync(folder.Id)" disabled="@(folder.Id == _contents.Folder.Id)">@folder.Name</button>
            @if (folder.Id != _contents.Folder.Id) { <span aria-hidden="true">/</span> }
        }
    </nav>

    <section aria-labelledby="folders-title">
        <h2 id="folders-title">Folders</h2>
        @if (_contents.Folders.Count == 0)
        {
            <p class="empty">No folders here.</p>
        }
        else
        {
            <div class="grid">
                @foreach (var folder in _contents.Folders)
                {
                    <article class="card folder-card">
                        <button class="card-link" @onclick="() => OpenFolderAsync(folder.Id)"><span aria-hidden="true">▰</span><strong>@folder.Name</strong></button>
                        @if (folder.Id != LibraryState.Workspace.Descriptor.GeneratedFolderId)
                        {
                            <button class="ghost" @onclick="() => BeginFolderEdit(folder)">Manage</button>
                            <button class="danger ghost" @onclick="() => RecycleFolderAsync(folder.Id)">Recycle</button>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section aria-labelledby="files-title">
        <div class="section-heading">
            <h2 id="files-title">Files</h2>
            <div class="view-toggle" aria-label="File view">
                <button class="@(_browser.ViewMode == LibraryBrowserViewMode.List ? string.Empty : "secondary")" aria-pressed="@(_browser.ViewMode == LibraryBrowserViewMode.List)" @onclick="() => SetViewMode(LibraryBrowserViewMode.List)">List</button>
                <button class="@(_browser.ViewMode == LibraryBrowserViewMode.Grid ? string.Empty : "secondary")" aria-pressed="@(_browser.ViewMode == LibraryBrowserViewMode.Grid)" @onclick="() => SetViewMode(LibraryBrowserViewMode.Grid)">Grid</button>
            </div>
        </div>

        <EditForm Model="_browser" OnValidSubmit="ApplyBrowserAsync" class="browser-controls">
            <label class="browser-search" for="library-search">Search names and user metadata
                <input id="library-search" type="search" maxlength="256" @bind="_browser.SearchText" placeholder="Search library files" />
            </label>
            <label for="browse-scope">Scope
                <InputSelect id="browse-scope" @bind-Value="_browser.Scope">
                    <option value="@LibraryBrowseScope.CurrentFolder">Current folder</option>
                    <option value="@LibraryBrowseScope.EntireLibrary">Entire library</option>
                </InputSelect>
            </label>
            <label for="media-filter">Media
                <InputSelect id="media-filter" @bind-Value="_browser.MediaKind">
                    @foreach (var kind in Enum.GetValues<LibraryMediaKind>()) { <option value="@kind">@kind</option> }
                </InputSelect>
            </label>
            <label for="origin-filter">Origin
                <InputSelect id="origin-filter" @bind-Value="_browser.Origin">
                    <option value="">Any</option>
                    @foreach (var origin in Enum.GetValues<FileOrigin>()) { <option value="@origin">@FormatOrigin(origin)</option> }
                </InputSelect>
            </label>
            <label for="imported-from">Imported from
                <InputDate id="imported-from" @bind-Value="_browser.ImportedFrom" />
            </label>
            <label for="imported-through">Imported through
                <InputDate id="imported-through" @bind-Value="_browser.ImportedThrough" />
            </label>
            <label for="file-sort">Sort
                <InputSelect id="file-sort" @bind-Value="_browser.Sort">
                    <option value="@LibraryFileSort.Name">Name</option>
                    <option value="@LibraryFileSort.ImportedNewest">Imported (newest)</option>
                    <option value="@LibraryFileSort.ModifiedNewest">Modified (newest)</option>
                    <option value="@LibraryFileSort.SizeLargest">Size (largest)</option>
                    <option value="@LibraryFileSort.MediaType">Media type</option>
                </InputSelect>
            </label>
            <label class="check metadata-filter-toggle"><InputCheckbox id="metadata-filter-enabled" @bind-Value="_browser.MetadataFilterEnabled" /> Filter by typed metadata</label>
            @if (_browser.MetadataFilterEnabled)
            {
                <label for="metadata-filter-key">Metadata key
                    <InputText id="metadata-filter-key" maxlength="100" @bind-Value="_browser.MetadataKey" />
                </label>
                <label for="metadata-filter-kind">Metadata type
                    <select id="metadata-filter-kind" value="@_browser.MetadataKind" @onchange="ChangeMetadataFilterKind">
                        @foreach (var kind in Enum.GetValues<MetadataValueKind>()) { <option value="@kind">@kind</option> }
                    </select>
                </label>
                <label for="metadata-filter-operator">Operator
                    <InputSelect id="metadata-filter-operator" @bind-Value="_browser.MetadataOperator">
                        @foreach (var item in MetadataOperators(_browser.MetadataKind)) { <option value="@item.Operator">@item.Label</option> }
                    </InputSelect>
                </label>
                @if (MetadataFilterNeedsValue)
                {
                    <label for="metadata-filter-value">Comparison value
                        <input id="metadata-filter-value" type="password" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" @bind="_browser.MetadataComparisonValue" />
                    </label>
                }
            }
            <div class="actions browser-actions">
                <button type="submit" disabled="@_loadingBrowse">Apply</button>
                <button type="button" class="secondary" @onclick="ClearBrowserAsync" disabled="@_loadingBrowse">Clear search and filters</button>
            </div>
        </EditForm>

        @if (_browseResult is null)
        {
            <p class="muted" aria-live="polite">Loading files…</p>
        }
        else if (_browseResult.TotalCount == 0)
        {
            <div class="empty-panel">
                <p>@(HasBrowserCriteria ? "No files match the current search and filters." : "There are no files in this folder.")</p>
                @if (HasBrowserCriteria) { <button class="secondary" @onclick="ClearBrowserAsync">Clear search and filters</button> }
                else { <button @onclick="ChooseImportFilesAsync">Import files</button> }
            </div>
        }
        else
        {
            <p class="muted browser-summary" role="status">Showing @(_browseResult.Offset + 1)–@(_browseResult.Offset + _browseResult.Items.Count) of @_browseResult.TotalCount active file(s)@(_browser.Scope == LibraryBrowseScope.EntireLibrary ? " across the library" : " in this folder").@(_browser.MetadataFilterEnabled ? $" Among files passing the other filters, {_browseResult.MetadataMissingCount} lack the selected key and {_browseResult.MetadataIncompatibleTypeCount} use an incompatible type." : string.Empty)</p>
            <div class="selection-bar" aria-label="File selection actions">
                <div class="actions">
                    <button class="secondary" @onclick="SelectCurrentPage">Select this page</button>
                    @if (_selectedFileIds.Count > 0) { <button class="secondary" @onclick="ClearBulkSelection">Clear selection</button> }
                </div>
                <span>@_selectedFileIds.Count file(s) selected across result pages</span>
                @if (_selectedFileIds.Count > 0)
                {
                    <div class="actions">
                        <button class="secondary" @onclick="BeginBulkMove">Move</button>
                        <button class="secondary" @onclick="BeginBulkDuplicate">Duplicate</button>
                        <button class="secondary" @onclick="BeginBulkMetadataAsync">Metadata</button>
                        <button class="danger" @onclick="BeginBulkRecycle">Recycle</button>
                    </div>
                }
            </div>

            @if (_bulkAction != BulkAction.None)
            {
                <section class="panel confirmation-panel" aria-labelledby="bulk-action-title">
                    <div class="section-heading"><h2 id="bulk-action-title">@BulkActionTitle()</h2><button class="ghost" @onclick="CancelBulkAction">Cancel</button></div>
                    <p>This action applies to @_selectedFileIds.Count selected active file(s). Each file commits independently; any failure is reported without rolling back unrelated successes.</p>
                    @if (_bulkAction == BulkAction.Move)
                    {
                        <label for="bulk-destination">Destination folder
                            <select id="bulk-destination" @bind="_bulkDestinationFolderId">
                                @foreach (var folder in _activeFolders) { <option value="@folder.Id">@FolderPath(folder.Id)</option> }
                            </select>
                        </label>
                        <div class="actions"><button disabled="@_busy" @onclick="ConfirmBulkMoveAsync">Confirm move</button></div>
                    }
                    else if (_bulkAction == BulkAction.Duplicate)
                    {
                        <p>Each selected file is copied independently with its user metadata. Links are not copied. Name conflicts receive the normal numeric suffix.</p>
                        <label for="bulk-duplicate-destination">Destination folder
                            <select id="bulk-duplicate-destination" @bind="_bulkDestinationFolderId">
                                @foreach (var folder in _activeFolders) { <option value="@folder.Id">@FolderPath(folder.Id)</option> }
                            </select>
                        </label>
                        <div class="actions"><button disabled="@_busy" @onclick="ConfirmBulkDuplicateAsync">Confirm duplicate</button></div>
                    }
                    else if (_bulkAction == BulkAction.Recycle)
                    {
                        <p>Files, their user metadata, and endpoint-owned links will move to the recycle bin together. They can be restored until permanently deleted.</p>
                        <div class="actions"><button class="danger" disabled="@_busy" @onclick="ConfirmBulkRecycleAsync">Confirm recycle</button></div>
                    }
                    else
                    {
                        @if (_commonMetadata.Count > 0)
                        {
                            <h3>Metadata keys common to every selected file</h3>
                            <ul class="metadata-list">
                                @foreach (var item in _commonMetadata)
                                {
                                    <li><strong>@item.Key</strong><small>@item.TypeLabel · @item.ValueLabel</small></li>
                                }
                            </ul>
                        }
                        else { <p class="muted">The selected files have no user-metadata key in common.</p> }
                        <div class="bulk-metadata-form">
                            <label for="bulk-metadata-key">Key<input id="bulk-metadata-key" maxlength="200" @bind="_bulkMetadata.Key" /></label>
                            <label for="bulk-metadata-kind">Type
                                <select id="bulk-metadata-kind" @bind="_bulkMetadata.Kind">@foreach (var kind in Enum.GetValues<MetadataValueKind>()) { <option value="@kind">@kind</option> }</select>
                            </label>
                            <label class="bulk-metadata-value" for="bulk-metadata-value">New value<textarea id="bulk-metadata-value" @bind="_bulkMetadata.Value"></textarea></label>
                            <label class="check"><input type="checkbox" @bind="_bulkMetadata.IsSensitive" /> Sensitive</label>
                        </div>
                        <div class="actions">
                            <button disabled="@_busy" @onclick="ReviewBulkMetadataSetAsync">Review add or replace</button>
                            <button class="danger ghost" disabled="@_busy" @onclick="ReviewBulkMetadataRemovalAsync">Review removal</button>
                        </div>
                        @if (_bulkMetadataPreview is not null)
                        {
                            <div class="notice" role="status">
                                <p>@_bulkMetadataPreview.Summary</p>
                                @if (_bulkMetadataPreview.ExistingSensitiveCount > 0) { <p>@_bulkMetadataPreview.ExistingSensitiveCount existing sensitive value(s) remain concealed in this preview.</p> }
                                <button class="@(_bulkMetadataPreview.Remove ? "danger" : string.Empty)" disabled="@_busy" @onclick="ConfirmBulkMetadataAsync">@(_bulkMetadataPreview.Remove ? "Confirm removal" : "Confirm metadata change")</button>
                            </div>
                        }
                    }
                </section>
            }

            @if (_bulkResult is not null)
            {
                <section class="panel" aria-labelledby="bulk-result-title">
                    <div class="section-heading"><h2 id="bulk-result-title">Bulk action result</h2><button class="ghost" @onclick="() => _bulkResult = null">Dismiss</button></div>
                    <p>@_bulkResult.SucceededCount succeeded; @_bulkResult.FailedCount failed.</p>
                    @if (_bulkResult.FailedCount > 0)
                    {
                        <ul class="metadata-list">@foreach (var item in _bulkResult.Items.Where(item => !item.Succeeded)) { <li><strong>@item.DisplayName</strong><small>@item.Error</small></li> }</ul>
                    }
                </section>
            }
            <div class="@(_browser.ViewMode == LibraryBrowserViewMode.Grid ? "file-grid" : "file-list")">
                @foreach (var item in _browseResult.Items)
                {
                    <article class="@(_browser.ViewMode == LibraryBrowserViewMode.Grid ? "file-card" : "file-row")">
                        <label class="file-select"><input type="checkbox" checked="@_selectedFileIds.Contains(item.File.Id)" @onchange="args => SetFileSelected(item.File.Id, args)" /><span class="visually-hidden">Select @item.File.DisplayName</span></label>
                        <button class="file-main" @onclick="() => OpenFile(item.File.Id)">
                            @if (CanShowThumbnail(item.File))
                            {
                                <span class="thumbnail-frame">
                                    @if (_thumbnails.TryGetValue(item.File.Id, out var thumbnail) && thumbnail.DataUri is not null)
                                    {
                                        <img src="@thumbnail.DataUri" alt="" />
                                    }
                                    else
                                    {
                                        <span class="file-type-icon" aria-hidden="true" title="@thumbnail?.Error">@MediaIcon(item.File.MediaType)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="file-type-icon" aria-hidden="true">@MediaIcon(item.File.MediaType)</span>
                            }
                            <span class="file-identity"><strong>@item.File.DisplayName</strong><span>@item.File.MediaType · @FormatBytes(item.File.ByteSize)</span></span>
                        </button>
                        @if (item.File.ContentState != FileContentState.Healthy) { <span class="content-state-badge">@item.File.ContentState</span> }
                        @if (_browser.Scope == LibraryBrowseScope.EntireLibrary)
                        {
                            <span class="file-location">@FolderPath(item.File.FolderId)</span>
                        }
                        @if (!string.Equals(item.File.DisplayName, item.File.OriginalFileName, StringComparison.Ordinal))
                        {
                            <span class="original-name">Original: @item.File.OriginalFileName</span>
                        }
                        @if (item.MatchReasons.Count > 0)
                        {
                            <ul class="match-reasons" aria-label="Why this file matched">
                                @foreach (var reason in item.MatchReasons) { <li>@reason</li> }
                            </ul>
                        }
                        <div class="file-actions">
                            <button class="ghost" @onclick="() => BeginFileEdit(item.File)">Manage</button>
                            <button class="ghost" @onclick="() => BeginDuplicate(item.File)">Duplicate</button>
                            <button class="danger ghost" @onclick="() => RecycleFileAsync(item.File.Id)">Recycle</button>
                        </div>
                    </article>
                }
            </div>
            <nav class="pagination" aria-label="File result pages">
                <button class="secondary" @onclick="PreviousPageAsync" disabled="@(!_browseResult.HasPreviousPage || _loadingBrowse)">Previous</button>
                <span>Page @CurrentPage of @PageCount</span>
                <button class="secondary" @onclick="NextPageAsync" disabled="@(!_browseResult.HasNextPage || _loadingBrowse)">Next</button>
            </nav>
        }
    </section>
}

@code {
    private const int PageSize = 48;
    private LibraryFolderContents? _contents;
    private LibraryFileBrowseResult? _browseResult;
    private bool _busy;
    private bool _loadingBrowse;
    private bool _showFolderForm;
    private string? _message;
    private string? _editingFileId;
    private string? _editingFolderId;
    private string? _duplicatingFileId;
    private FolderForm _newFolder = new();
    private ItemForm _itemForm = new();
    private DuplicateForm _duplicateForm = new();
    private IReadOnlyList<FolderRecord> _activeFolders = [];
    private readonly Dictionary<string, PreviewThumbnail> _thumbnails = new(StringComparer.Ordinal);
    private CancellationTokenSource? _thumbnailCancellation;
    private List<PendingImport> _pendingImports = [];
    private IReadOnlyList<ImportResult> _lastImportResults = [];
    private ImportForm _importForm = new();
    private ImportProgress? _importProgress;
    private CancellationTokenSource? _importCancellation;
    private readonly HashSet<string> _activeImportPaths = new(OperatingSystem.IsWindows() ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
    private IReadOnlyList<IncomingImportFailure> _incomingFailures = [];
    private readonly HashSet<string> _selectedFileIds = new(StringComparer.Ordinal);
    private BulkAction _bulkAction;
    private string _bulkDestinationFolderId = string.Empty;
    private BulkMetadataForm _bulkMetadata = new();
    private IReadOnlyList<CommonMetadataSummary> _commonMetadata = [];
    private BulkMetadataPreview? _bulkMetadataPreview;
    private BulkFileOperationResult? _bulkResult;
    private LibraryBrowserSession _browser => LibraryState.BrowserSession;
    private bool HasBrowserCriteria => !string.IsNullOrWhiteSpace(_browser.SearchText) || _browser.Scope != LibraryBrowseScope.CurrentFolder || _browser.MediaKind != LibraryMediaKind.Any || _browser.Origin is not null || _browser.ImportedFrom is not null || _browser.ImportedThrough is not null || _browser.MetadataFilterEnabled;
    private bool MetadataFilterNeedsValue => _browser.MetadataOperator is not MetadataFilterOperator.Exists and not MetadataFilterOperator.DoesNotExist;
    private int CurrentPage => _browseResult is null ? 1 : (_browseResult.Offset / PageSize) + 1;
    private int PageCount => _browseResult is null ? 1 : Math.Max(1, (int)Math.Ceiling(_browseResult.TotalCount / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        LibraryState.Changed += OnLibraryChanged;
        IncomingImports.PendingChanged += OnIncomingImportsChanged;
        DrainIncomingImports();
        await LibraryState.InitializeAsync();
        if (LibraryState.Workspace is null) return;
        var desiredFolder = _browser.FolderId ?? LibraryState.Workspace.Descriptor.RootFolderId;
        try { await LoadFolderAsync(desiredFolder, preserveOffset: true); }
        catch (SlopFactoryException)
        {
            await LoadFolderAsync(LibraryState.Workspace.Descriptor.RootFolderId);
        }
    }

    private async Task LoadFolderAsync(string folderId, bool preserveOffset = false)
    {
        if (LibraryState.Workspace is null) return;
        _contents = await LibraryState.Workspace.GetFolderContentsAsync(folderId);
        _activeFolders = await LibraryState.Workspace.GetActiveFoldersAsync();
        if (_pendingImports.Count > 0 && string.IsNullOrWhiteSpace(_importForm.DestinationFolderId)) _importForm.DestinationFolderId = folderId;
        if (_pendingImports.Count > 0 && string.IsNullOrWhiteSpace(_importForm.TargetLibraryPath)) _importForm.TargetLibraryPath = LibraryState.ActivePath ?? LibraryState.Workspace.Descriptor.RootPath;
        if (!preserveOffset || !string.Equals(_browser.FolderId, folderId, StringComparison.Ordinal)) _browser.Offset = 0;
        _browser.FolderId = folderId;
        await LoadBrowseAsync();
    }

    private Task OpenFolderAsync(string folderId) => LoadFolderAsync(folderId);

    private async Task LoadBrowseAsync()
    {
        if (LibraryState.Workspace is null || _contents is null) return;
        _loadingBrowse = true;
        try
        {
            var from = ParseLocalDate(_browser.ImportedFrom, inclusiveThrough: false);
            var before = ParseLocalDate(_browser.ImportedThrough, inclusiveThrough: true);
            var query = new LibraryFileBrowseQuery(_contents.Folder.Id, _browser.Scope, _browser.SearchText, _browser.MediaKind, _browser.Origin, from, before, _browser.Sort, _browser.Offset, PageSize, BuildMetadataFilter());
            _browseResult = await LibraryState.Workspace.BrowseFilesAsync(query);
            if (_browseResult.TotalCount > 0 && _browser.Offset >= _browseResult.TotalCount)
            {
                _browser.Offset = ((_browseResult.TotalCount - 1) / PageSize) * PageSize;
                _browseResult = await LibraryState.Workspace.BrowseFilesAsync(query with { Offset = _browser.Offset });
            }
            QueueThumbnails();
            _message = null;
        }
        catch (Exception exception) when (exception is SlopFactoryException or FormatException or ArgumentException)
        {
            _message = exception.Message;
        }
        finally { _loadingBrowse = false; }
    }

