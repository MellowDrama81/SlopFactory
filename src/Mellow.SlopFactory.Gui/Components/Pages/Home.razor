    private static string TruncateMetadataValue(string value) => value.Length <= 80 ? value : $"{value[..80]}…";

    private void QueueThumbnails()
    {
        _thumbnailCancellation?.Cancel();
        _thumbnailCancellation?.Dispose();
        _thumbnailCancellation = new CancellationTokenSource();
        _thumbnails.Clear();
        if (_browseResult is null || LibraryState.Workspace is null) return;
        foreach (var file in _browseResult.Items.Select(item => item.File).Where(CanShowThumbnail))
        {
            _ = LoadThumbnailAsync(LibraryState.Workspace, file, _thumbnailCancellation.Token);
        }
    }

    private async Task LoadThumbnailAsync(ILibraryWorkspace workspace, FileRecord file, CancellationToken cancellationToken)
    {
        try
        {
            var thumbnail = await PreviewCache.GetThumbnailAsync(workspace, file, cancellationToken);
            if (cancellationToken.IsCancellationRequested || LibraryState.Workspace != workspace) return;
            _thumbnails[file.Id] = thumbnail;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private static DateTimeOffset? ParseLocalDate(DateTime? value, bool inclusiveThrough)
    {
        if (value is null) return null;
        var date = DateOnly.FromDateTime(value.Value);
        if (inclusiveThrough) date = date.AddDays(1);
        var local = DateTime.SpecifyKind(date.ToDateTime(TimeOnly.MinValue), DateTimeKind.Unspecified);
        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(local), TimeSpan.Zero);
    }

    private void SetViewMode(LibraryBrowserViewMode mode) => _browser.ViewMode = mode;

    private IEnumerable<FolderRecord> Breadcrumbs()
    {
        if (_contents is null) return [];
        var result = new Stack<FolderRecord>();
        FolderRecord? current = _contents.Folder;
        while (current is not null)
        {
            result.Push(current);
            current = current.ParentId is { } parentId ? _activeFolders.FirstOrDefault(folder => folder.Id == parentId) : null;
        }
        return result;
    }

    private string FolderPath(string folderId)
    {
        var names = new Stack<string>();
        var current = _activeFolders.FirstOrDefault(folder => folder.Id == folderId);
        while (current is not null)
        {
            names.Push(current.Name);
            current = current.ParentId is { } parentId ? _activeFolders.FirstOrDefault(folder => folder.Id == parentId) : null;
        }
        return names.Count == 0 ? "Unknown folder" : string.Join(" / ", names);
    }

    private async Task ChooseImportFilesAsync()
    {
        if (_contents is null || LibraryState.Workspace is null) return;
        var picked = await FilePicker.Default.PickMultipleAsync(new PickOptions { PickerTitle = "Import files into SlopFactory" });
        var files = picked?.OfType<FileResult>().Where(item => !string.IsNullOrWhiteSpace(item.FullPath)).ToArray() ?? [];
        if (files.Length == 0) return;
        var selected = files.Select(item =>
        {
            long? size = null;
            try { var info = new FileInfo(item.FullPath); if (info.Exists) size = info.Length; }
            catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException) { }
            return new PendingImport(item.FullPath, string.IsNullOrWhiteSpace(item.FileName) ? Path.GetFileName(item.FullPath) : item.FileName, size, false, null);
        }).GroupBy(item => item.Path, OperatingSystem.IsWindows() ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal).Select(group => group.First()).ToList();
        AddPendingImports(selected);
        _importForm = new ImportForm { TargetLibraryPath = LibraryState.ActivePath ?? string.Empty, DestinationFolderId = _contents.Folder.Id };
        _lastImportResults = [];
        _importProgress = null;
    }

    private async Task ConfirmImportAsync()
    {
        if (_pendingImports.Count == 0 || LibraryState.Workspace is null) return;
        var runItems = _pendingImports.ToArray();
        _activeImportPaths.Clear();
        foreach (var item in runItems) _activeImportPaths.Add(item.Path);
        _busy = true;
        _importCancellation?.Dispose();
        _importCancellation = new CancellationTokenSource();
        var progress = new Progress<ImportProgress>(value =>
        {
            _importProgress = value;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            _lastImportResults = await ImportReviewedItemsAsync(LibraryState.Workspace, runItems, progress, _importCancellation.Token);
            _message = $"Imported {_lastImportResults.Count(item => item.Outcome == ImportOutcome.Imported)}; skipped {_lastImportResults.Count(item => item.Outcome == ImportOutcome.DuplicateSkipped)} duplicate(s); {_lastImportResults.Count(item => item.Outcome == ImportOutcome.Failed)} failed; {_lastImportResults.Count(item => item.Outcome == ImportOutcome.Cancelled)} cancelled.";
            foreach (var item in runItems)
            {
                _pendingImports.RemoveAll(candidate => SameSourcePath(candidate.Path, item.Path));
                if (item.IsTemporary) await IncomingImports.DiscardAsync(new IncomingImportItem(item.Path, item.DisplayName, item.ByteSize, true, item.RelativeFolder));
            }
            _importProgress = null;
            if (_contents is not null) await LoadFolderAsync(_contents.Folder.Id, preserveOffset: true);
        }
        finally { _activeImportPaths.Clear(); _busy = false; }
    }

    private async Task RemovePendingImport(string path)
    {
        var item = _pendingImports.FirstOrDefault(candidate => SameSourcePath(candidate.Path, path));
        _pendingImports.RemoveAll(candidate => SameSourcePath(candidate.Path, path));
        if (item?.IsTemporary == true) await IncomingImports.DiscardAsync(new IncomingImportItem(item.Path, item.DisplayName, item.ByteSize, true, item.RelativeFolder));
    }
    private void CancelImport() => _importCancellation?.Cancel();
    private async Task CancelImportReview()
    {
        var discarded = _pendingImports.Where(item => item.IsTemporary).ToArray();
        _pendingImports = [];
        _importProgress = null;
        foreach (var item in discarded) await IncomingImports.DiscardAsync(new IncomingImportItem(item.Path, item.DisplayName, item.ByteSize, true, item.RelativeFolder));
    }

    private void DrainIncomingImports()
    {
        var incoming = IncomingImports.TakePending().Select(item => new PendingImport(item.Path, item.DisplayName, item.ByteSize, item.IsTemporary, item.RelativeFolder));
        AddPendingImports(incoming);
        var failures = IncomingImports.TakeFailures();
        if (failures.Count > 0) _incomingFailures = _incomingFailures.Concat(failures).ToArray();
        if (_contents is not null && string.IsNullOrWhiteSpace(_importForm.DestinationFolderId)) _importForm.DestinationFolderId = _contents.Folder.Id;
        if (string.IsNullOrWhiteSpace(_importForm.TargetLibraryPath)) _importForm.TargetLibraryPath = LibraryState.ActivePath ?? string.Empty;
    }

    private void AddPendingImports(IEnumerable<PendingImport> items)
    {
        foreach (var item in items)
        {
            if (!_pendingImports.Any(candidate => SameSourcePath(candidate.Path, item.Path))) _pendingImports.Add(item);
        }
    }

    private void OnIncomingImportsChanged(object? sender, EventArgs args) => _ = InvokeAsync(() =>
    {
        DrainIncomingImports();
        StateHasChanged();
    });

    private static bool SameSourcePath(string left, string right) => string.Equals(left, right, OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);

    private async Task<IReadOnlyList<ImportResult>> ImportReviewedItemsAsync(ILibraryWorkspace workspace, IReadOnlyList<PendingImport> items, IProgress<ImportProgress> progress, CancellationToken cancellationToken)
    {
        var results = new List<ImportResult>(items.Count);
        for (var index = 0; index < items.Count; index++)
        {
            var item = items[index];
            if (cancellationToken.IsCancellationRequested)
            {
                AddCancelledResults(results, items, index);
                break;
            }
            try
            {
                var destinationId = await ResolveImportFolderAsync(workspace, _importForm.DestinationFolderId, item.RelativeFolder, cancellationToken);
                var mappedProgress = new DelegatingProgress<ImportProgress>(value => progress.Report(value with { ItemIndex = index + 1, TotalItems = items.Count, DisplayName = item.DisplayName }));
                var result = AssertSingleImportResult(await workspace.ImportWithProgressAsync([item.Path], destinationId, _importForm.ImportDuplicates, mappedProgress, cancellationToken));
                results.Add(result);
                if (result.Outcome == ImportOutcome.Cancelled)
                {
                    AddCancelledResults(results, items, index + 1);
                    break;
                }
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                AddCancelledResults(results, items, index);
                break;
            }
            catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
            {
                results.Add(new ImportResult(new ImportCandidate(item.Path, item.DisplayName, item.ByteSize ?? 0, null), null, ImportOutcome.Failed, [], exception.Message));
            }
        }
        return results;
    }

    private static ImportResult AssertSingleImportResult(IReadOnlyList<ImportResult> results) => results.Count == 1
        ? results[0]
        : throw new InvalidOperationException("A single reviewed import did not return one result.");

    private static void AddCancelledResults(List<ImportResult> results, IReadOnlyList<PendingImport> items, int startIndex)
    {
        for (var index = startIndex; index < items.Count; index++)
        {
            var item = items[index];
            results.Add(new ImportResult(new ImportCandidate(item.Path, item.DisplayName, item.ByteSize ?? 0, null), null, ImportOutcome.Cancelled, [], null));
        }
    }

    private static async Task<string> ResolveImportFolderAsync(ILibraryWorkspace workspace, string destinationId, string? relativeFolder, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(relativeFolder)) return destinationId;
        var folders = (await workspace.GetActiveFoldersAsync(cancellationToken)).ToList();
        var currentId = destinationId;
        foreach (var rawSegment in relativeFolder.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var segment = LibraryRules.NormalizeDisplayName(rawSegment, "Imported folder name");
            var comparison = LibraryRules.ComparisonKey(segment);
            var existing = folders.FirstOrDefault(folder => folder.ParentId == currentId && LibraryRules.ComparisonKey(folder.Name) == comparison);
            if (existing is not null) currentId = existing.Id;
            else
            {
                var created = await workspace.CreateFolderAsync(currentId, segment, cancellationToken);
                folders.Add(created);
                currentId = created.Id;
            }
        }
        return currentId;
    }

    private IReadOnlyList<RecentLibrary> AvailableImportLibraries()
    {
        var recent = RecentLibraries.GetAll().Where(library => Directory.Exists(library.Path) && File.Exists(Path.Combine(library.Path, "slopfactory-library.json"))).ToList();
        if (LibraryState.Workspace is not null && recent.All(library => !SameSourcePath(library.Path, LibraryState.Workspace.Descriptor.RootPath)))
        {
            recent.Insert(0, new RecentLibrary(LibraryState.Workspace.Descriptor.LibraryId, LibraryState.Workspace.Descriptor.DisplayName, LibraryState.Workspace.Descriptor.RootPath, DateTimeOffset.UtcNow));
        }
        return recent;
    }

    private async Task ChangeImportTargetAsync(ChangeEventArgs args)
    {
        var path = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(path) || SameSourcePath(path, LibraryState.ActivePath ?? string.Empty)) return;
        try
        {
            await LibraryState.SwitchAsync(path);
            if (LibraryState.Workspace is null) return;
            _importForm.TargetLibraryPath = LibraryState.ActivePath ?? path;
            _importForm.DestinationFolderId = LibraryState.Workspace.Descriptor.RootFolderId;
            await LoadFolderAsync(LibraryState.Workspace.Descriptor.RootFolderId);
            _message = $"Import target changed to {LibraryState.Workspace.Descriptor.DisplayName}.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or SlopFactoryException)
        {
            _importForm.TargetLibraryPath = LibraryState.ActivePath ?? string.Empty;
            _message = exception.Message;
        }
    }

