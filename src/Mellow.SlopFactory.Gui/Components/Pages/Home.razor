    private UserMetadataFilter? BuildMetadataFilter() => !_browser.MetadataFilterEnabled
        ? null
        : LibraryRules.ValidateMetadataFilter(new UserMetadataFilter(_browser.MetadataKey, _browser.MetadataKind, _browser.MetadataOperator,
            MetadataFilterNeedsValue ? _browser.MetadataComparisonValue : null));

    private void ChangeMetadataFilterKind(ChangeEventArgs args)
    {
        if (!Enum.TryParse<MetadataValueKind>(args.Value?.ToString(), out var kind)) return;
        _browser.MetadataKind = kind;
        _browser.MetadataOperator = MetadataOperators(kind)[0].Operator;
        _browser.MetadataComparisonValue = string.Empty;
    }

    private static IReadOnlyList<MetadataOperatorChoice> MetadataOperators(MetadataValueKind kind) => kind switch
    {
        MetadataValueKind.Text =>
        [
            new(MetadataFilterOperator.Equals, "Equals (case-insensitive)"),
            new(MetadataFilterOperator.DoesNotEqual, "Does not equal"),
            new(MetadataFilterOperator.Contains, "Contains (case-insensitive)")
        ],
        MetadataValueKind.Boolean =>
        [
            new(MetadataFilterOperator.Equals, "Equals"),
            new(MetadataFilterOperator.DoesNotEqual, "Does not equal")
        ],
        MetadataValueKind.Json =>
        [
            new(MetadataFilterOperator.Exists, "Exists"),
            new(MetadataFilterOperator.DoesNotExist, "Does not exist"),
            new(MetadataFilterOperator.StructurallyEquals, "Structurally equals"),
            new(MetadataFilterOperator.DoesNotEqual, "Does not equal")
        ],
        _ =>
        [
            new(MetadataFilterOperator.Equals, "Equals"),
            new(MetadataFilterOperator.DoesNotEqual, "Does not equal"),
            new(MetadataFilterOperator.LessThan, "Less than"),
            new(MetadataFilterOperator.LessThanOrEqual, "Less than or equal"),
            new(MetadataFilterOperator.GreaterThan, "Greater than"),
            new(MetadataFilterOperator.GreaterThanOrEqual, "Greater than or equal")
        ]
    };

