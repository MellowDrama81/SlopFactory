@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources
@inject IStringLocalizer<UiStrings> Strings
@inject AppLibraryState LibraryState
@inject PreviewCacheService PreviewCache

<div class="source-picker-current">
    @if (SelectedFileIds.Count == 0)
    {
        <span>@Strings["NoSourceImage"]</span>
    }
    else
    {
        <ul class="metadata-list">
            @foreach (var file in SelectedFiles)
            {
                <li>
                    <span class="thumbnail-frame">
                        @if (_thumbnails.TryGetValue(file.Id, out var thumbnail) && thumbnail.DataUri is not null)
                        {
                            <img src="@thumbnail.DataUri" alt="" />
                        }
                        else
                        {
                            <span class="file-type-icon" aria-hidden="true">@ImageIconLabel</span>
                        }
                    </span>
                    <span>@file.DisplayName</span>
                    <button type="button" class="secondary" disabled="@Disabled" @onclick="() => RemoveAsync(file.Id)">@Strings["BatchRemoveFile"]</button>
                </li>
            }
        </ul>
    }
    <button type="button" class="secondary" aria-labelledby="@LabelledBy" disabled="@Disabled" @onclick="OpenAsync">@Strings["ChooseSourceImage"]</button>
</div>

@if (_open)
{
    <div class="source-picker-modal" role="dialog" aria-label="@Strings["SourceImagePickerTitle"]">
        <div class="source-picker-filters">
            <input type="search" aria-label="@Strings["SourceImagePickerSearchPlaceholder"]" placeholder="@Strings["SourceImagePickerSearchPlaceholder"]" @bind="_searchText" @bind:event="oninput" />
            @if (Folders.Count > 0)
            {
                <div class="source-picker-view-toggle" role="group" aria-label="@Strings["SourceImagePickerViewMode"]">
                    <button type="button" class="secondary @(_viewMode == PickerViewMode.Tree ? "selected" : "")" @onclick="() => _viewMode = PickerViewMode.Tree">@Strings["SourceImagePickerFolderView"]</button>
                    <button type="button" class="secondary @(_viewMode == PickerViewMode.Folder ? "selected" : "")" @onclick="() => _viewMode = PickerViewMode.Folder">@Strings["SourceImagePickerFolderNavView"]</button>
                    <button type="button" class="secondary @(_viewMode == PickerViewMode.Flat ? "selected" : "")" @onclick="() => _viewMode = PickerViewMode.Flat">@Strings["SourceImagePickerFlatView"]</button>
                </div>
            }
            <button type="button" class="secondary" @onclick="() => _open = false">@Strings["BatchPickerDone"]</button>
        </div>

        @if (AllTags.Count > 0)
        {
            <div class="source-picker-tags">
                @foreach (var tag in AllTags)
                {
                    <button type="button" class="source-picker-tag @(_selectedTagIds.Contains(tag.Id) ? "selected" : "")" @onclick="() => ToggleTag(tag.Id)">@tag.Name</button>
                }
            </div>
        }

        @{
            var filtered = FilteredCandidates();
            RenderFragment<FileRecord> fileCellTemplate = file =>
                @<button type="button" class="source-picker-cell @(SelectedFileIds.Contains(file.Id) ? "selected" : "")" @onclick="() => ToggleFileAsync(file.Id)">
                    <span class="thumbnail-frame">
                        @if (_thumbnails.TryGetValue(file.Id, out var thumbnail) && thumbnail.DataUri is not null)
                        {
                            <img src="@thumbnail.DataUri" alt="" />
                        }
                        else
                        {
                            <span class="file-type-icon" aria-hidden="true" title="@thumbnail?.Error">@ImageIconLabel</span>
                        }
                    </span>
                    <span class="source-picker-cell-name">@file.DisplayName</span>
                </button>;
        }
        @if (filtered.Count == 0)
        {
            <p class="empty">@(Candidates.Count == 0 ? Strings["SourceImagePickerNoCandidates"] : Strings["SourceImagePickerNoResults"])</p>
        }
        else if (_viewMode == PickerViewMode.Tree && Folders.Count > 0)
        {
            <div class="source-picker-tree">
                @foreach (var root in RootFolders)
                {
                    <SourcePickerFolderTree Folder="root" AllFolders="Folders" FilesByFolder="FilesByFolder" FileTemplate="fileCellTemplate" Depth="0" />
                }
                @{ var unfiled = UnfiledFiles(filtered); }
                @if (unfiled.Count > 0)
                {
                    <div class="source-picker-folder-group">
                        <h4 class="source-picker-folder-name">@Strings["SourceImagePickerUnfiled"]</h4>
                        <div class="source-picker-grid">
                            @foreach (var file in unfiled)
                            {
                                @fileCellTemplate(file)
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (_viewMode == PickerViewMode.Folder && Folders.Count > 0)
        {
            <div class="source-picker-folder-nav">
                <div class="breadcrumbs">
                    <button type="button" class="secondary" disabled="@(CurrentFolder?.ParentId is null)" @onclick="() => NavigateTo(CurrentFolder?.ParentId)">@Strings["SourceImagePickerUp"]</button>
                    @foreach (var crumb in BreadcrumbChain(CurrentFolder))
                    {
                        <span aria-hidden="true">/</span>
                        <button type="button" class="text-button" disabled="@(crumb.Id == CurrentFolder?.Id)" @onclick="() => NavigateTo(crumb.Id)">@crumb.Name</button>
                    }
                </div>
                @{
                    var childFolders = ChildFoldersOf(CurrentFolder?.Id);
                    var folderFiles = FolderFiles(CurrentFolder?.Id);
                }
                @if (childFolders.Count > 0)
                {
                    <div class="source-picker-subfolders">
                        @foreach (var folder in childFolders)
                        {
                            <button type="button" class="secondary source-picker-folder-button" @onclick="() => NavigateTo(folder.Id)">@Strings["SourceImagePickerFolderEntry", folder.Name]</button>
                        }
                    </div>
                }
                @if (folderFiles.Count == 0 && childFolders.Count == 0)
                {
                    <p class="empty">@Strings["SourceImagePickerFolderEmpty"]</p>
                }
                else if (folderFiles.Count > 0)
                {
                    <div class="source-picker-grid">
                        @foreach (var file in folderFiles)
                        {
                            @fileCellTemplate(file)
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="source-picker-grid">
                @foreach (var file in filtered)
                {
                    @fileCellTemplate(file)
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<string> SelectedFileIds { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<string>> SelectedFileIdsChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<FileRecord> Candidates { get; set; } = [];
    [Parameter] public IReadOnlyList<FolderRecord> Folders { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? LabelledBy { get; set; }

    private enum PickerViewMode { Tree, Folder, Flat }

    private bool _open;
    private PickerViewMode _viewMode = PickerViewMode.Tree;
    private string? _currentFolderId;
    private string _searchText = string.Empty;
    private readonly HashSet<string> _selectedTagIds = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<Tag>> _tagsByFile = new(StringComparer.Ordinal);
    private readonly Dictionary<string, PreviewThumbnail> _thumbnails = new(StringComparer.Ordinal);
    private CancellationTokenSource? _loadCancellation;

    private const string ImageIconLabel = "IMG";

    private IReadOnlyList<FileRecord> SelectedFiles => Candidates.Where(file => SelectedFileIds.Contains(file.Id)).ToArray();

    private IReadOnlyList<Tag> AllTags => _tagsByFile.Values.SelectMany(tags => tags).DistinctBy(tag => tag.Id).OrderBy(tag => tag.Name, StringComparer.OrdinalIgnoreCase).ToArray();

    private async Task OpenAsync()
    {
        if (Disabled) return;
        _open = true;
        _searchText = string.Empty;
        _selectedTagIds.Clear();
        await LoadTagsAndThumbnailsAsync();
    }

    private async Task LoadTagsAndThumbnailsAsync()
    {
        if (LibraryState.Workspace is null) return;
        var workspace = LibraryState.Workspace;
        _tagsByFile.Clear();
        try
        {
            var byFile = await workspace.GetTagsForFilesAsync(Candidates.Select(file => file.Id).ToArray());
            foreach (var (fileId, tags) in byFile) _tagsByFile[fileId] = tags;
        }
        catch (Exception) { }

        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        var token = _loadCancellation.Token;
        foreach (var file in Candidates)
        {
            if (_thumbnails.ContainsKey(file.Id)) continue;
            _ = LoadThumbnailAsync(workspace, file, token);
        }
    }

    private async Task LoadThumbnailAsync(ILibraryWorkspace workspace, FileRecord file, CancellationToken cancellationToken)
    {
        try
        {
            var thumbnail = await PreviewCache.GetThumbnailAsync(workspace, file, cancellationToken);
            if (cancellationToken.IsCancellationRequested || LibraryState.Workspace != workspace) return;
            _thumbnails[file.Id] = thumbnail;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception) { }
    }

    private void ToggleTag(string tagId)
    {
        if (!_selectedTagIds.Add(tagId)) _selectedTagIds.Remove(tagId);
    }

    private IReadOnlyList<FileRecord> FilteredCandidates() => Candidates
        .Where(file => string.IsNullOrWhiteSpace(_searchText) || file.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(file => _selectedTagIds.Count == 0 || (_tagsByFile.TryGetValue(file.Id, out var tags) && tags.Any(tag => _selectedTagIds.Contains(tag.Id))))
        .ToArray();

    private IReadOnlyList<FolderRecord> RootFolders => Folders.Where(folder => folder.ParentId is null).OrderBy(folder => folder.Name, StringComparer.OrdinalIgnoreCase).ToArray();

    private Dictionary<string, List<FileRecord>> FilesByFolder =>
        FilteredCandidates().GroupBy(file => file.FolderId, StringComparer.Ordinal).ToDictionary(group => group.Key, group => group.ToList(), StringComparer.Ordinal);

    /// <summary>Filtered files whose <see cref="FileRecord.FolderId"/> isn't among <see cref="Folders"/>
    /// — normally none, but keeps grouped view from silently dropping a file if its containing folder
    /// was excluded from the list this component was given.</summary>
    private IReadOnlyList<FileRecord> UnfiledFiles(IReadOnlyList<FileRecord> filtered) =>
        filtered.Where(file => !Folders.Any(folder => folder.Id == file.FolderId)).ToArray();

    /// <summary>Falls back to the first root folder whenever <see cref="_currentFolderId"/> is unset or
    /// no longer resolves (e.g. a stale id left over from a previous, differently-scoped
    /// <see cref="Folders"/> list) — so folder-navigation mode always has somewhere valid to show.</summary>
    private FolderRecord? CurrentFolder => Folders.FirstOrDefault(folder => folder.Id == _currentFolderId) ?? RootFolders.FirstOrDefault();

    private IReadOnlyList<FolderRecord> ChildFoldersOf(string? folderId) =>
        Folders.Where(folder => folder.ParentId == folderId).OrderBy(folder => folder.Name, StringComparer.OrdinalIgnoreCase).ToArray();

    private IReadOnlyList<FileRecord> FolderFiles(string? folderId) =>
        FilesByFolder.TryGetValue(folderId ?? string.Empty, out var files) ? files : [];

    private IReadOnlyList<FolderRecord> BreadcrumbChain(FolderRecord? from)
    {
        var chain = new List<FolderRecord>();
        var current = from;
        while (current is not null)
        {
            chain.Insert(0, current);
            current = current.ParentId is { } parentId ? Folders.FirstOrDefault(folder => folder.Id == parentId) : null;
        }
        return chain;
    }

    private void NavigateTo(string? folderId) => _currentFolderId = folderId;

    private async Task ToggleFileAsync(string fileId)
    {
        var next = SelectedFileIds.Contains(fileId)
            ? SelectedFileIds.Where(id => id != fileId).ToArray()
            : [.. SelectedFileIds, fileId];
        SelectedFileIds = next;
        await SelectedFileIdsChanged.InvokeAsync(next);
    }

    private async Task RemoveAsync(string fileId) => await ToggleFileAsync(fileId);
}
