@inherits LayoutComponentBase
@implements IDisposable
@inject IncomingImportService IncomingImports
@inject ManagedContentWatchService ContentWatch
@inject GenerationQueueService Queue
@inject IThemePreferenceService Theme
@inject IntegrityScanRecommendationService ScanRecommendation
@inject CredentialReconciliationService CredentialReconciliation
@inject AppLibraryState LibraryState
@inject GenerationNotificationCoordinator NotificationCoordinator
@inject INotificationService Notifications
@inject NavigationManager Navigation
@inject IStringLocalizer<UiStrings> Strings
@using Microsoft.Extensions.Localization
@using Mellow.SlopFactory.Gui.Resources
@using Mellow.SlopFactory.Domain

<div class="app-shell @Theme.CssClass">
    <aside class="sidebar" aria-label="@Strings["PrimaryNavigation"]">
        <a class="brand" href="/">@Strings["ApplicationName"]</a>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">@Strings["NavLibrary"]</NavLink>
            <NavLink href="/recycle-bin">@Strings["NavRecycleBin"]</NavLink>
            <NavLink href="/connections">@Strings["NavConnections"]</NavLink>
            <NavLink href="/models">@Strings["NavModels"]</NavLink>
            <NavLink href="/generate">@Strings["NavGenerate"]</NavLink>
            <NavLink href="/queue">@Strings["NavQueue"]</NavLink>
            <NavLink href="/generation-history">@Strings["NavGenerationHistory"]</NavLink>
            <NavLink href="/saved-settings">@Strings["NavSavedSettings"]</NavLink>
            <NavLink href="/library-settings">@Strings["NavLibrarySettings"]</NavLink>
            <NavLink href="/about">@Strings["NavAbout"]</NavLink>
        </nav>
    </aside>
    <main class="content">
        @if (IncomingImports.PendingCount > 0)
        {
            <div class="notice incoming-import-notice" role="status">
                @Strings["IncomingImportsPending", IncomingImports.PendingCount] <a href="/">@Strings["ReviewInLibrary"]</a>
            </div>
        }
        @if (ContentWatch.Notices.Count > 0)
        {
            <div class="notice content-watch-notice" role="alert">
                <strong>@Strings["ManagedContentNeedsReview"]</strong>
                @foreach (var item in ContentWatch.Notices.Take(3))
                {
                    <div>
                        <span>@item.DisplayName: @item.Message</span>
                        @if (item.FileId is not null) { <a href="@($"/file/{item.FileId}")">@Strings["Review"]</a> }
                    </div>
                }
                @if (ContentWatch.Notices.Count > 3) { <div>@Strings["MoreNotices", ContentWatch.Notices.Count - 3]</div> }
            </div>
        }
        @if (Queue.QueuedCount > 0 || Queue.RunningCount > 0)
        {
            <div class="notice generation-queue-notice" role="status">
                @Strings["GenerationQueueActivity", Queue.QueuedCount, Queue.RunningCount]
                @if (Queue.EnergySaverCapActive) { <span>@Strings["EnergySaverCapActive", Queue.EffectiveDeviceCap]</span> }
                <a href="/queue">@Strings["NavQueue"]</a>
            </div>
        }
        @if (ScanRecommendation.IsRecommended)
        {
            <div class="notice" role="status">
                <strong>@Strings["IntegrityScanRecommended"]</strong>
                <span>@Strings["IntegrityScanNotAutomatic"]</span>
                <a href="/library-settings">@Strings["StartFromLibrarySettings"]</a>
                <button class="ghost" @onclick="ScanRecommendation.Defer">@Strings["Defer"]</button>
            </div>
        }
        @if (LibraryState.DirtyDraftIds.Count > 0)
        {
            <div class="notice session-recovery-notice" role="alert">
                @Strings["DirtyDraftsDetected", LibraryState.DirtyDraftIds.Count]
                <a href="/generate">@Strings["NavGenerate"]</a>
                <button class="ghost" @onclick="LibraryState.DismissDirtyDrafts">@Strings["Dismiss"]</button>
            </div>
        }
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        IncomingImports.PendingChanged += OnPendingChanged;
        ContentWatch.Changed += OnPendingChanged;
        ContentWatch.Start();
        Queue.Changed += OnPendingChanged;
        Queue.Start();
        Theme.Changed += OnPendingChanged;
        ScanRecommendation.Changed += OnPendingChanged;
        LibraryState.Changed += OnPendingChanged;
        CredentialReconciliation.Start();
        NotificationCoordinator.Start();
        NotificationCoordinator.NotifyRequested += OnNotifyRequested;
        Notifications.Tapped += OnNotificationTapped;
    }
    private void OnPendingChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnNotifyRequested(object? sender, GenerationRecord record) => Notifications.Show(record.Id, record.ModelLabel, StatusLabel(record.Status));
    private void OnNotificationTapped(object? sender, string recordId) => _ = InvokeAsync(() => Navigation.NavigateTo($"/generation-history/{recordId}"));
    private string StatusLabel(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => Strings["GenerationCompleted"],
        GenerationStatus.Failed => Strings["GenerationFailed"],
        GenerationStatus.PartiallyCompleted => Strings["GenerationPartiallyCompleted"],
        _ => status.ToString()
    };
    public void Dispose()
    {
        IncomingImports.PendingChanged -= OnPendingChanged;
        ContentWatch.Changed -= OnPendingChanged;
        Queue.Changed -= OnPendingChanged;
        Theme.Changed -= OnPendingChanged;
        ScanRecommendation.Changed -= OnPendingChanged;
        LibraryState.Changed -= OnPendingChanged;
        NotificationCoordinator.NotifyRequested -= OnNotifyRequested;
        Notifications.Tapped -= OnNotificationTapped;
    }
}
