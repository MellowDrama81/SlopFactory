    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "unet": {
    "inputs": {
      "unet_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "lora": {
    "inputs": {
      "lora_name": "Flux_2-Turbo-LoRA_comfyui.safetensors",
      "strength_model": 1,
      "model": [
        "unet",
        0
      ]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Load LoRA"
    }
  },
  "lora_on": {
    "inputs": {
      "value": false
    },
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "Enable 8 steps lora"
    }
  },
  "steps_hi": {
    "inputs": {
      "value": 20
    },
    "class_type": "PrimitiveInt",
    "_meta": {
      "title": "Steps"
    }
  },
  "steps_lo": {
    "inputs": {
      "value": 8
    },
    "class_type": "PrimitiveInt",
    "_meta": {
      "title": "Steps"
    }
  },
  "model_sw": {
    "inputs": {
      "switch": [
        "lora_on",
        0
      ],
      "on_false": [
        "unet",
        0
      ],
      "on_true": [
        "lora",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Switch(model)"
    }
  },
  "steps_sw": {
    "inputs": {
      "switch": [
        "lora_on",
        0
      ],
      "on_false": [
        "steps_hi",
        0
      ],
      "on_true": [
        "steps_lo",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Switch(steps)"
    }
  },
  "pos": {
    "inputs": {
