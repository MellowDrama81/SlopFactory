{
  "ref0": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{UPLOADED_IMAGE_FILENAME:image}}"
    }
  },
  "sr0": {
    "class_type": "Krea2StyleReferenceNode",
    "inputs": {
      "image": [
        "ref0",
        0
      ],
      "strength": 1.0
    }
  },
  "ref1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{UPLOADED_IMAGE_FILENAME_2:image}}"
    }
  },
  "sr1": {
    "class_type": "Krea2StyleReferenceNode",
    "inputs": {
      "image": [
        "ref1",
        0
      ],
      "strength": 1.0,
      "style_reference": [
        "sr0",
        0
      ]
    }
  },
  "ref2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{UPLOADED_IMAGE_FILENAME_3:image}}"
    }
  },
  "sr2": {
    "class_type": "Krea2StyleReferenceNode",
    "inputs": {
      "image": [
        "ref2",
        0
      ],
      "strength": 1.0,
      "style_reference": [
        "sr1",
        0
      ]
    }
  },
  "gen": {
    "class_type": "Krea2ImageNode",
    "inputs": {
      "prompt": "{{PROMPT:string}}",
      "model": "Krea 2 Large",
      "seed": {{SEED:seed}},
      "model.aspect_ratio": "1:1",
      "model.resolution": "1K",
      "model.creativity": "medium",
      "model.style_reference": [
        "sr2",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "Krea2_API_StyleRef",
      "images": [
        "gen",
        0
      ]
    }
  }
}
