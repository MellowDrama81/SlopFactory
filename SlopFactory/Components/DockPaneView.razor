@using SlopFactory.Models
@using SlopFactory.Services
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Web
@inject ProjectLibrary ProjectLibrary
@inject WorkflowLibrary WorkflowLibrary
@inject WorkflowTemplateService WorkflowTemplateService
@inject ComfyGenerationService ComfyGenerationService
@inject IJSRuntime JS
@implements IDisposable
<div class="pane-view @Pane.Kind">
@if (Pane.Kind == "overview") { <div class="intro"><p class="eyebrow">Q3 DELIVERY</p><h2>Ship work, not status updates.</h2><p>Focus the team on the smallest set of decisions that moves the release forward.</p><div class="stat-row"><div><b>74%</b><span>release confidence</span></div><div><b>12</b><span>open decisions</span></div><div><b>4</b><span>days to beta</span></div></div></div><div class="mini-roadmap"><span>Discovery</span><i></i><span>Build</span><i></i><span>Launch</span></div> }
else if (Pane.Kind == "velocity") { <div class="metric"><p>Weekly throughput</p><b>42 <em>↑ 18%</em></b><svg viewBox="0 0 300 90"><path d="M0 70 L40 64 70 68 105 42 140 50 185 20 220 32 260 14 300 23" fill="none" stroke="#82b6ff" stroke-width="4"/></svg></div> }
else if (Pane.Kind == "activity") { <div class="feed"><p><b>Maia Chen</b> moved Payment flow to review <small>8m</small></p><p><b>Rohan Patel</b> added 4 customer interviews <small>28m</small></p><p><b>Ana Torres</b> closed Onboarding QA <small>1h</small></p></div> }
else if (Pane.Kind == "notes") { <div class="notes"><p class="eyebrow">TODAY'S NOTE</p><h2>Keep the release calm.</h2><p>Surface decisions early, make handoffs explicit, and preserve room for the team to think.</p><span>#product</span><span>#direction</span></div> }
else if (Pane.Kind == "checklist") { <div class="checklist"><p><b>12 / 16</b> launch tasks complete</p><div class="progress"><i></i></div><label>☑ Release notes approved</label><label>☑ Support coverage confirmed</label><label>□ Schedule customer announcement</label><label>□ Publish launch post</label></div> }
else if (Pane.Kind == "risks") { <div class="risks"><p class="eyebrow">WATCH LIST</p><h2>2 decisions need a owner</h2><p>Billing migration and regional rollout timing could affect beta readiness.</p></div> }
else if (Pane.Kind == "assets" && string.IsNullOrWhiteSpace(Pane.Context)) { <div class="assets-pane assets-project-picker"><p class="eyebrow">PROJECT ASSETS</p><h2>Select a project</h2><p>Choose the project whose assets folder this pane should show.</p>@if (ProjectLibrary.GetAll().Count == 0) { <p class="assets-empty">No projects have been added yet. Add one from Projects, then open a new Assets pane.</p> } else { <div class="assets-project-list">@foreach (var project in ProjectLibrary.GetAll()) { <button type="button" data-assets-project-select data-assets-pane="@Pane.Id" data-project-folder="@project.FolderPath" data-project-name="@project.Name">@project.DisplayName</button> }</div> }</div> }
else if (Pane.Kind == "generation" && string.IsNullOrWhiteSpace(Pane.Context))
{
  <div class="generation-pane generation-project-picker">
    <p class="eyebrow">PROJECT GENERATION</p>
    <h2>Select a project</h2>
    <p>Generations in this pane will belong to the project you choose.</p>
    @if (ProjectLibrary.GetAll().Count == 0)
    {
      <p class="assets-empty">No projects have been added yet. Add one from Projects, then select it here.</p>
    }
    else
    {
      <div class="assets-project-list">
        @foreach (var project in ProjectLibrary.GetAll())
        {
          <button type="button" data-generation-project-select data-generation-pane="@Pane.Id" data-project-folder="@project.FolderPath">@project.DisplayName</button>
        }
      </div>
    }
    <p class="generation-status" data-generation-status role="status"></p>
  </div>
}
else if (Pane.Kind == "generation")
{
  <div class="generation-pane">
    <p class="eyebrow">PROJECT GENERATION</p>
    <div class="generation-heading">
      <div><h2>@Pane.Title</h2><p class="assets-path">@Pane.Context</p></div>
      <button type="button" data-generation-change-project data-generation-pane="@Pane.Id">Change project</button>
    </div>
    <label class="generation-field">
      <span>Workflow</span>
      <select value="@Pane.WorkflowId" @onchange="ChangeGenerationWorkflow">
        <option value="">Select a workflow</option>
        @foreach (var workflow in WorkflowLibrary.GetAll().Where(item => !string.IsNullOrWhiteSpace(item.GraphFile)))
        {
          <option value="@workflow.Id">@workflow.DisplayName</option>
        }
      </select>
    </label>
    @if (SelectedGenerationWorkflow is not null)
    {
      <p class="generation-workflow-description">@SelectedGenerationWorkflow.Description</p>
      @if (generationLoading)
      {
        <p class="generation-next-step">Loading workflow inputs…</p>
      }
      else if (!string.IsNullOrWhiteSpace(generationLoadError))
      {
        <p class="generation-status" role="alert">@generationLoadError</p>
      }
      else
      {
        <div class="generation-inputs">
          @foreach (var placeholder in generationInputs)
          {
            @if (placeholder.Type == "image")
            {
              var selectedAsset = GenerationValue(placeholder.Name);
              <div class="generation-field generation-image-field" data-generation-image-drop data-generation-pane="@Pane.Id" data-generation-input="@placeholder.Name" @key="placeholder.Name">
                <span>@placeholder.Label</span>
                <div class="generation-image-controls">
                  <button type="button" class="generation-image-selection" aria-label="Choose @placeholder.Label.ToLowerInvariant()" aria-expanded="@(openGenerationImagePicker == placeholder.Name)" @onclick="() => ToggleGenerationImagePicker(placeholder.Name)">
                    @if (selectedAsset.Length > 0 && GenerationThumbnail(selectedAsset) is { } selectedThumbnail)
                    {
                      <img src="@selectedThumbnail" alt="Selected @placeholder.Label.ToLowerInvariant()" />
                    }
                    else
                    {
                      <span class="generation-image-empty" aria-hidden="true">▧</span>
                    }
                    <span class="generation-image-selection-text"><strong>@(selectedAsset.Length > 0 ? Path.GetFileName(selectedAsset) : "Choose a project image")</strong><small>@(selectedAsset.Length > 0 ? selectedAsset : "Browse image thumbnails")</small></span>
                    <span class="generation-image-chevron" aria-hidden="true">@(openGenerationImagePicker == placeholder.Name ? "▴" : "▾")</span>
                  </button>
                  <button type="button" class="generation-image-import" disabled="@(importingImageFor is not null)" @onclick="() => ImportGenerationImage(placeholder.Name)">@(importingImageFor == placeholder.Name ? "Importing…" : "Import image…")</button>
                </div>
                <small class="generation-image-import-hint">Imported images go to assets/imported.</small>
                @if (importErrorFor == placeholder.Name)
                {
                  <p class="generation-status" role="alert">@generationImportError</p>
                }
                <p class="generation-drop-status" data-generation-drop-status role="status"></p>
                @if (openGenerationImagePicker == placeholder.Name)
                {
                  <div class="generation-picker-toolbar">
                    <button type="button" class="generation-picker-up" disabled="@(!CanGenerationPickerNavigateUp)" @onclick="NavigateGenerationPickerUp">↑ Up</button>
                    <span class="generation-picker-path" title="@GenerationPickerLocation">@GenerationPickerLocation</span>
                    <div class="generation-picker-filter">
                      <span>Filter by tag</span>
                      <input type="text" class="generation-picker-tag-trigger" aria-label="Filter by tag" aria-haspopup="listbox" aria-expanded="@generationTagMenuOpen" placeholder="All tags" autocomplete="off" value="@generationTagQuery" @oninput="OnGenerationTagInput" @onfocus="OpenGenerationTagMenu" @onkeydown="HandleGenerationTagKeyDown" />
                      @if (generationTagMenuOpen)
                      {
                        <div class="generation-picker-tag-menu" role="listbox" aria-label="Filter by tag">
                          @if (string.IsNullOrWhiteSpace(generationTagQuery))
                          {
                            <button type="button" role="option" aria-selected="@(generationPickerTag.Length == 0)" @onclick="() => SetGenerationPickerTag(string.Empty)">All tags</button>
                          }
                          @foreach (var tag in MatchingGenerationTags)
                          {
                            <button type="button" role="option" aria-selected="@(string.Equals(generationPickerTag, tag, StringComparison.OrdinalIgnoreCase))" @key="tag" @onclick="() => SetGenerationPickerTag(tag)">@tag</button>
                          }
                          @if (!MatchingGenerationTags.Any() && !string.IsNullOrWhiteSpace(generationTagQuery)) { <span class="tag-no-match">No matching tags</span> }
                        </div>
                      }
                    </div>
                  </div>
                  @if (generationPickerTag.Length > 0)
                  {
                    <p class="generation-picker-hint">Showing matching images in this folder and subfolders</p>
                  }
                  @if (generationPickerEntries.Count == 0)
                  {
                    <p class="generation-image-picker-empty">@(generationPickerTag.Length > 0 ? "No images with this tag in this folder or its subfolders." : "This folder has no images or subfolders.")</p>
                  }
                  else
                  {
                    <div class="generation-image-grid" aria-label="Choose @placeholder.Label.ToLowerInvariant()">
                      @foreach (var entry in generationPickerEntries)
                      {
                        @if (entry.IsDirectory)
                        {
                          <button type="button" class="generation-image-option generation-folder-option" title="Open @entry.RelativePath" aria-label="Open folder @entry.RelativePath" @key="entry.FullPath" @onclick="() => NavigateGenerationPicker(entry.FullPath)">
                            <span class="generation-folder-icon" aria-hidden="true"><FolderThumbnail /></span><span>@Path.GetFileName(entry.FullPath)</span><small>Folder</small>
                          </button>
                        }
                        else
                        {
                          <button type="button" class="generation-image-option @(string.Equals(entry.RelativePath, selectedAsset, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")" title="@entry.RelativePath" aria-label="Select @entry.RelativePath" aria-pressed="@(string.Equals(entry.RelativePath, selectedAsset, StringComparison.OrdinalIgnoreCase))" @key="entry.FullPath" @onclick="() => SelectGenerationImage(placeholder.Name, entry.RelativePath)">
                            @if (GenerationThumbnail(entry.RelativePath) is { } thumbnail)
                            {
                              <img src="@thumbnail" alt="" loading="lazy" />
                            }
                            else
                            {
                              <span class="generation-image-unavailable" aria-hidden="true">▧</span>
                            }
                            <span>@Path.GetFileName(entry.FullPath)</span>
                            @if (generationPickerTag.Length > 0) { <small>@Path.GetDirectoryName(entry.RelativePath)?.Replace('\\', '/')</small> }
                          </button>
                        }
                      }
                    </div>
                  }
                }
              </div>
            }
            else
            {
              <label class="generation-field" @key="placeholder.Name">
                <span>@placeholder.Label</span>
                @if (placeholder.Name == "PROMPT")
                {
                  <textarea rows="5" value="@GenerationValue(placeholder.Name)" @onchange="args => ChangeGenerationInput(placeholder.Name, args)" placeholder="Describe what to create"></textarea>
                }
                else
                {
                  <input type="text" value="@GenerationValue(placeholder.Name)" @onchange="args => ChangeGenerationInput(placeholder.Name, args)" />
                }
              </label>
            }
          }
          @if (generationInputs.Count == 0)
          {
            <p>No user inputs are required by this workflow.</p>
          }
        </div>
        <section class="generation-output-settings" aria-label="Generation output settings">
          <h3>Output</h3>
          <label class="generation-field">
            <span>Folder within assets</span>
            <input type="text" value="@outputFolderDraft" placeholder="generated" aria-label="Output folder within assets" @oninput="OnOutputFolderInput" @onchange="CommitOutputFolder" />
          </label>
          <p class="generation-output-hint">Leave blank for assets/generated. Use . for the assets root, or a subfolder such as artwork/drafts.</p>
          <div class="generation-output-tags">
            <span>Tags for generated assets</span>
            @if (Pane.OutputTags is { Count: > 0 })
            {
              <div class="asset-tag-list">
                @foreach (var tag in Pane.OutputTags)
                {
                  <span class="asset-tag" @key="tag">@tag<button type="button" title="Remove @tag" aria-label="Remove @tag" @onclick="() => RemoveOutputTag(tag)">×</button></span>
                }
              </div>
            }
            <div class="asset-tag-form generation-output-tag-form">
              <div class="asset-tag-input-wrap">
                <input type="text" value="@newOutputTag" placeholder="Add a tag" aria-label="New output tag" aria-haspopup="listbox" aria-expanded="@outputTagSuggestionsOpen" autocomplete="off" maxlength="64" @oninput="OnOutputTagInput" @onfocus="OpenOutputTagSuggestions" @onkeydown="HandleOutputTagKeyDown" />
                @if (outputTagSuggestionsOpen && MatchingOutputTags.Count > 0)
                {
                  <div class="asset-tag-suggestions" role="listbox" aria-label="Suggested project tags">
                    @foreach (var tag in MatchingOutputTags)
                    {
                      <button type="button" role="option" @key="tag" @onclick="() => SelectOutputTagSuggestion(tag)">@tag</button>
                    }
                  </div>
                }
              </div>
              <button type="button" @onclick="AddOutputTag">Add tag</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(outputTagStatus)) { <p class="generation-status" role="status">@outputTagStatus</p> }
          </div>
        </section>
        <p class="generation-seed-note">Seed values are generated automatically. Run uploads selected images and submits the workflow to the current Comfy connection.</p>
        <button type="button" class="generation-run-button" disabled="@(GenerationState?.IsRunning == true)" @onclick="RunGeneration">@(GenerationState?.IsRunning == true ? "Running…" : "Run")</button>
      }
    }
    else
    {
      <p class="generation-next-step">Select a workflow to see its required inputs.</p>
    }
    @if (GenerationState is { } run)
    {
      <p class="generation-status @(run.IsRunning ? "generation-active" : "")" role="status">@run.Status</p>
      @if (!string.IsNullOrWhiteSpace(run.PromptId))
      {
        <p class="generation-job-id">Comfy job · @run.PromptId</p>
      }
      @if (run.Outputs.Count > 0)
      {
        <section class="generation-results" aria-label="Generation results">
          <h3>Results</h3>
          <div class="generation-result-grid">
            @foreach (var output in run.Outputs)
            {
              <div class="generation-result" @key="output.Path">
                @if (output.IsImage)
                {
                  <img src="@CreateImageSource(output.Path)" alt="Generated result @Path.GetFileName(output.Path)" />
                }
                <span>@Path.GetFileName(output.Path)</span>
              </div>
            }
          </div>
        </section>
      }
    }
  </div>
}
else if (Pane.Kind == "mask-editor")
{
  <MaskEditor AssetPath="@(Pane.Context ?? string.Empty)" AssetsRoot="@(Pane.Location ?? string.Empty)" />
}
else if (Pane.Kind == "panel-editor")
{
  <PanelEditor Pane="Pane" OnSelectionChanged="OnPanelSelectionChanged" />
}
else if (Pane.Kind == "asset-details")
{
  <div class="asset-details">
    <p class="eyebrow">ASSET DETAILS</p>
    <h2>@assetName</h2>
    <p class="assets-path">@Pane.Context</p>
    @if (assetImage is not null)
    {
      <div class="asset-details-actions"><button type="button" data-assets-mask data-asset-path="@Pane.Context" data-assets-root="@Pane.Location" data-source-pane="@Pane.Id">✎ Define mask</button><span data-mask-open-status role="status"></span></div>
      <p class="asset-dimensions">Dimensions: @(assetDimensions ?? "Loading…")</p>
      <div class="asset-full-image"><img @ref="assetImageElement" @onload="UpdateImageDimensions" src="@assetImage" alt="@assetName" /></div>
    }
    else
    {
      <div class="asset-image-unavailable">Preview is available for JPG, PNG, GIF, and WebP images.</div>
    }
    <section class="asset-tags-section" aria-label="Asset tags">
      <h3>Tags</h3>
      @if (assetTags.Count == 0)
      {
        <p class="asset-tags-empty">No tags yet.</p>
      }
      else
      {
        <div class="asset-tag-list">
          @foreach (var tag in assetTags)
          {
            <span class="asset-tag" @key="tag">@tag<button type="button" title="Remove @tag" aria-label="Remove @tag" @onclick="() => RemoveTag(tag)">×</button></span>
          }
        </div>
      }
      <div class="asset-tag-form">
        <div class="asset-tag-input-wrap">
          <input type="text" placeholder="Add a tag" aria-label="New tag" aria-haspopup="listbox" aria-expanded="@tagSuggestionsOpen" autocomplete="off" maxlength="64" value="@newTag" @oninput="OnNewTagInput" @onfocus="OpenTagSuggestions" @onkeydown="HandleTagKeyDown" />
          @if (tagSuggestionsOpen && MatchingProjectTags.Count > 0)
          {
            <div class="asset-tag-suggestions" role="listbox" aria-label="Suggested project tags">
              @foreach (var tag in MatchingProjectTags)
              {
                <button type="button" role="option" @key="tag" @onclick="() => SelectTagSuggestion(tag)">@tag</button>
              }
            </div>
          }
        </div>
        <button type="button" @onclick="AddTag">Add tag</button>
      </div>
      @if (!string.IsNullOrWhiteSpace(tagStatus))
      {
        <p class="asset-tag-status" role="status">@tagStatus</p>
      }
    </section>
  </div>
}
else if (Pane.Kind == "assets")
{
  <div class="assets-pane" data-assets-drop-target data-assets-pane="@Pane.Id" data-assets-folder="@currentAssetsPath" data-assets-root="@assetsRoot">
    <p class="eyebrow">PROJECT ASSETS</p>
    <div class="assets-heading">
      <div><h2>@Pane.Title</h2><p class="assets-path">@currentAssetsPath</p></div>
      <div class="assets-actions"><button type="button" class="assets-up" data-assets-navigate data-assets-pane="@Pane.Id" data-assets-folder="@ParentAssetsPath" disabled="@(!CanNavigateUp)">↑ Up</button><button type="button" class="assets-create" data-assets-create-folder data-assets-folder="@currentAssetsPath">Create folder</button><button type="button" class="assets-select-all" data-assets-select-all>Select all</button><button type="button" class="assets-export-selected" data-assets-export-selected>⇩ Selected</button><button type="button" class="assets-delete-selected" data-assets-delete-selected>× Selected</button><button type="button" class="assets-add" data-assets-add data-assets-folder="@currentAssetsPath" data-assets-root="@assetsRoot">＋ Add assets</button><button type="button" class="assets-generate" data-assets-generate data-assets-pane="@Pane.Id" title="Open Generation for this folder">✦ Generate here</button></div>
    </div>
    <div class="assets-filter-bar">
      <div class="assets-tag-filter">
        <span>Filter by tag</span>
        <input type="text" class="assets-tag-trigger" aria-label="Filter by tag" aria-haspopup="listbox" aria-expanded="@assetTagMenuOpen" placeholder="All tags" autocomplete="off" value="@assetTagQuery" @oninput="OnAssetTagInput" @onfocus="OpenAssetTagMenu" @onkeydown="HandleAssetTagKeyDown" />
        @if (assetTagMenuOpen)
        {
          <div class="assets-tag-menu" role="listbox" aria-label="Filter by tag">
            @if (string.IsNullOrWhiteSpace(assetTagQuery))
            {
              <button type="button" role="option" aria-selected="@(selectedTag.Length == 0)" @onclick="() => SetAssetTagFilter(string.Empty)">All tags</button>
            }
            @foreach (var tag in MatchingAssetTags)
            {
              <button type="button" role="option" aria-selected="@(string.Equals(selectedTag, tag, StringComparison.OrdinalIgnoreCase))" @key="tag" @onclick="() => SetAssetTagFilter(tag)">@tag</button>
            }
            @if (!MatchingAssetTags.Any() && !string.IsNullOrWhiteSpace(assetTagQuery)) { <span class="tag-no-match">No matching tags</span> }
          </div>
        }
      </div>
      @if (!string.IsNullOrEmpty(selectedTag)) { <span class="assets-filter-hint">Showing matching files in this folder and subfolders</span> }
    </div>
    <p class="assets-action-status" data-assets-status></p>
    @if (assetEntries.Count == 0) { <p class="assets-empty">@(string.IsNullOrEmpty(selectedTag) ? "This folder is empty." : "No assets with this tag in this folder or its subfolders.")</p> }
    else
    {
      <div class="assets-grid">@foreach (var entry in assetEntries) { <article class="asset-tile @(entry.IsDirectory ? "" : "asset-file")" draggable="true" data-assets-drag data-assets-source-path="@entry.Path" data-assets-source-root="@assetsRoot" data-asset-path="@entry.Path" data-assets-open-details="@(entry.IsDirectory ? "" : "file")"><input type="checkbox" class="asset-select" data-asset-select data-asset-path="@entry.Path" data-assets-root="@assetsRoot" aria-label="Select @entry.Name" />@if (entry.IsDirectory) { <button type="button" class="asset-folder" data-assets-navigate data-assets-pane="@Pane.Id" data-assets-folder="@entry.Path"><div class="asset-tile-placeholder"><FolderThumbnail /></div><strong>@entry.Name</strong><small>Folder</small></button><div class="asset-folder-actions"><button type="button" class="asset-rename-icon" data-assets-rename data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Rename folder" aria-label="Rename @entry.Name">✎</button><button type="button" class="asset-export-icon" data-assets-export data-asset-path="@entry.Path" title="Export folder as ZIP">⇩</button><button type="button" class="asset-delete-icon" data-assets-delete data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Delete folder">×</button></div> } else { @if (entry.Thumbnail is not null) { <img src="@entry.Thumbnail" alt="@entry.Name" /> } else { <div class="asset-tile-placeholder">◌</div> }<div class="asset-tile-footer"><strong>@entry.Name</strong>@if (IsGenerationImage(entry.Path)) { <button type="button" class="asset-mask-icon" data-assets-mask data-asset-path="@entry.Path" data-assets-root="@assetsRoot" data-source-pane="@Pane.Id" title="Define mask" aria-label="Define mask for @entry.Name">◐</button> }<button type="button" class="asset-rename-icon" data-assets-rename data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Rename asset" aria-label="Rename @entry.Name">✎</button><button type="button" class="asset-export-icon" data-assets-export data-asset-path="@entry.Path" title="Export asset">⇩</button><button type="button" class="asset-delete-icon" data-assets-delete data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Delete asset">×</button></div><small>@entry.Detail</small> }</article> }</div>
    }
  </div>
}
else { <div class="insights"><i>✦</i><h2>Customer signal</h2><p>13 people asked for easier handoffs between product and design this week.</p><button>Review insights →</button></div> }
</div>
@code {
  [Parameter, EditorRequired] public DockPane Pane { get; set; } = default!;
  [Parameter] public EventCallback<GenerationWorkflowSelection> OnGenerationWorkflowChanged { get; set; }
  [Parameter] public EventCallback<GenerationInputChange> OnGenerationInputChanged { get; set; }
  [Parameter] public EventCallback<GenerationOutputFolderChange> OnGenerationOutputFolderChanged { get; set; }
  [Parameter] public EventCallback<GenerationOutputTagsChange> OnGenerationOutputTagsChanged { get; set; }
  [Parameter] public EventCallback<PanelPaneSelection> OnPanelSelectionChanged { get; set; }
  private string? loadedGenerationWorkflowId;
  private List<WorkflowPlaceholder> generationInputs = [];
  private List<string> generationImages = [];
  private HashSet<string> generationImagePaths = new(StringComparer.OrdinalIgnoreCase);
  private List<GenerationPickerEntry> generationPickerEntries = [];
  private List<string> generationPickerTags = [];
  private string generationPickerTag = string.Empty;
  private string generationTagQuery = string.Empty;
  private bool generationTagMenuOpen;
  private IEnumerable<string> MatchingGenerationTags => generationPickerTags.Where(tag => tag.Contains(generationTagQuery.Trim(), StringComparison.OrdinalIgnoreCase));
  private string? generationPickerRoot;
  private string? generationPickerFolder;
  private readonly Dictionary<string, string?> generationThumbnails = new(StringComparer.OrdinalIgnoreCase);
  private string? openGenerationImagePicker;
  private string? importingImageFor;
  private string? importErrorFor;
  private string generationImportError = string.Empty;
  private static readonly FilePickerFileType GenerationImageFileTypes = new(new Dictionary<DevicePlatform, IEnumerable<string>>
  {
      [DevicePlatform.WinUI] = [".jpg", ".jpeg", ".png", ".gif", ".webp"],
      [DevicePlatform.Android] = ["image/jpeg", "image/png", "image/gif", "image/webp"]
  });
  private string? generationImageProject;
  private string outputFolderDraft = "generated";
  private string? loadedOutputFolder;
  private IReadOnlyList<string> generationProjectTags = [];
  private string newOutputTag = string.Empty;
  private bool outputTagSuggestionsOpen;
  private string outputTagStatus = string.Empty;
  private List<string> MatchingOutputTags => generationProjectTags.Where(tag => !(Pane.OutputTags ?? []).Contains(tag, StringComparer.OrdinalIgnoreCase)
      && tag.Contains(newOutputTag.Trim(), StringComparison.OrdinalIgnoreCase)).Take(10).ToList();
  private string generationLoadError = string.Empty;
  private bool generationLoading;
  private GenerationRunState? GenerationState => ComfyGenerationService.GetState(Pane.Id);
  private WorkflowDefinition? SelectedGenerationWorkflow => WorkflowLibrary.GetAll()
      .FirstOrDefault(workflow => workflow.Id == Pane.WorkflowId && !string.IsNullOrWhiteSpace(workflow.GraphFile));
  private string GenerationValue(string name) => Pane.InputValues?.GetValueOrDefault(name) ?? string.Empty;
  private Task ChangeGenerationWorkflow(ChangeEventArgs args)
  {
      openGenerationImagePicker = null;
      return OnGenerationWorkflowChanged.InvokeAsync(new GenerationWorkflowSelection(Pane.Id, args.Value?.ToString() ?? string.Empty));
  }
  private Task ChangeGenerationInput(string name, ChangeEventArgs args) =>
      OnGenerationInputChanged.InvokeAsync(new GenerationInputChange(Pane.Id, name, args.Value?.ToString() ?? string.Empty));
  private void ToggleGenerationImagePicker(string name)
  {
      if (openGenerationImagePicker == name) { openGenerationImagePicker = null; generationTagMenuOpen = false; return; }
      openGenerationImagePicker = name;
      generationPickerTag = string.Empty;
      generationTagQuery = string.Empty;
      generationTagMenuOpen = false;
      generationPickerFolder = generationPickerRoot;
      var selected = GenerationValue(name);
      if (generationImagePaths.Contains(selected) && Pane.Context is not null)
      {
          var selectedFolder = Path.GetDirectoryName(Path.Combine(Pane.Context, selected.Replace('/', Path.DirectorySeparatorChar)));
          if (selectedFolder is not null && IsInsideGenerationPicker(selectedFolder)) generationPickerFolder = selectedFolder;
      }
      RefreshGenerationPicker();
  }
