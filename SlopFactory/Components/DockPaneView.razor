  private void LoadAssets()
  {
      try
      {
          var files = Directory.EnumerateFiles(currentAssetsPath, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).ToList();
          var taggedFiles = files.Select(path => (Path: path, Tags: ReadAssetTags(path, Directory.GetParent(assetsRoot!)!.FullName))).ToList();
          availableTags = taggedFiles.SelectMany(file => file.Tags)
              .Distinct(StringComparer.OrdinalIgnoreCase)
              .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
              .ToList();
          if (selectedTag.Length > 0 && !availableTags.Contains(selectedTag, StringComparer.OrdinalIgnoreCase))
          {
              selectedTag = string.Empty;
              assetTagQuery = string.Empty;
          }
          if (selectedTag.Length > 0)
          {
              assetEntries = taggedFiles.Where(file => file.Tags.Contains(selectedTag, StringComparer.OrdinalIgnoreCase))
                  .OrderBy(file => Path.GetFileName(file.Path), StringComparer.OrdinalIgnoreCase)
                  .Select(file =>
                  {
                      var entry = CreateAssetEntry(file.Path);
                      var folder = Path.GetRelativePath(currentAssetsPath, Path.GetDirectoryName(file.Path)!);
                      return folder == "." ? entry : entry with { Detail = $"{folder.Replace('\\', '/')} · {entry.Detail}" };
                  }).ToList();
          }
          else
          {
              assetEntries = Directory.EnumerateFileSystemEntries(currentAssetsPath)
                  .OrderBy(path => !Directory.Exists(path))
                  .ThenBy(Path.GetFileName, StringComparer.OrdinalIgnoreCase)
                  .Select(CreateAssetEntry).ToList();
          }
      }
      catch { availableTags = []; assetEntries = []; }
  }
  private static IReadOnlyList<string> ReadAssetTags(string assetPath, string projectFolder)
  {
      try
      {
          var metadataPath = AssetMetadataPaths.ForAsset(projectFolder, assetPath);
          if (!File.Exists(metadataPath)) return [];
          using var metadata = System.Text.Json.JsonDocument.Parse(File.ReadAllText(metadataPath));
          if (!metadata.RootElement.TryGetProperty("tags", out var tags) || tags.ValueKind != System.Text.Json.JsonValueKind.Array) return [];
          return tags.EnumerateArray()
              .Where(tag => tag.ValueKind == System.Text.Json.JsonValueKind.String)
              .Select(tag => tag.GetString()?.Trim() ?? string.Empty)
              .Where(tag => tag.Length > 0)
              .ToList();
      }
      catch { return []; }
  }
  private AssetEntry CreateAssetEntry(string path)
  {
      var isDirectory = Directory.Exists(path);
      if (!isDirectory) EnsureAssetMetadata(path);
      return new AssetEntry(Path.GetFileName(path), isDirectory, isDirectory ? "Folder" : $"{new FileInfo(path).Length:N0} bytes", isDirectory ? null : CreateThumbnail(path), path);
  }
  private void EnsureAssetMetadata(string assetPath)
  {
      try
      {
          var projectFolder = Directory.GetParent(assetsRoot!)!.FullName;
          var relativeAssetPath = Path.GetRelativePath(projectFolder, assetPath).Replace('\\', '/');
          var metadataPath = AssetMetadataPaths.ForRelativeAsset(projectFolder, relativeAssetPath, createDirectory: true);
          if (File.Exists(metadataPath)) return;
          var metadata = new { asset = relativeAssetPath, name = Path.GetFileName(assetPath), tags = Array.Empty<string>() };
          File.WriteAllText(metadataPath, System.Text.Json.JsonSerializer.Serialize(metadata));
      }
      catch { }
  }
  private void LoadAssetDetails()
  {
      if (!string.Equals(dimensionsForPath, Pane.Context, StringComparison.OrdinalIgnoreCase))
      {
          assetDimensions = null;
          dimensionsForPath = Pane.Context;
          newTag = string.Empty;
          tagSuggestionsOpen = false;
          tagStatus = string.Empty;
      }
      assetName = Path.GetFileName(Pane.Context) ?? "Asset";
      assetImage = null;
      assetTags = [];
      assetMetadataPath = null;
      assetProjectFolder = null;
      projectTags = [];
      if (string.IsNullOrWhiteSpace(Pane.Context) || string.IsNullOrWhiteSpace(Pane.Location) || !File.Exists(Pane.Context)) return;
      try
      {
          assetsRoot = Pane.Location;
          EnsureAssetMetadata(Pane.Context);
          assetImage = CreateImageSource(Pane.Context);
          var projectFolder = Directory.GetParent(Pane.Location)!.FullName;
          assetProjectFolder = projectFolder;
          assetMetadataPath = AssetMetadataPaths.ForAsset(projectFolder, Pane.Context, createDirectory: true);
          if (File.Exists(assetMetadataPath))
          {
              using var metadata = System.Text.Json.JsonDocument.Parse(File.ReadAllText(assetMetadataPath));
              if (metadata.RootElement.TryGetProperty("tags", out var tags) && tags.ValueKind == System.Text.Json.JsonValueKind.Array)
                  assetTags = tags.EnumerateArray()
                      .Where(tag => tag.ValueKind == System.Text.Json.JsonValueKind.String)
                      .Select(tag => tag.GetString()?.Trim() ?? string.Empty)
                      .Where(tag => tag.Length > 0)
                      .Distinct(StringComparer.OrdinalIgnoreCase)
                      .ToList();
          }
          projectTags = ProjectLibrary.GetProjectTags(projectFolder);
      }
      catch { tagStatus = "Tags could not be read."; }
  }
  private async Task AddTag()
  {
      var enteredTag = newTag.Trim();
      var tag = projectTags.FirstOrDefault(existing => string.Equals(existing, enteredTag, StringComparison.OrdinalIgnoreCase)) ?? enteredTag;
      if (tag.Length == 0) { tagStatus = "Enter a tag."; return; }
      if (tag.Length > 64) { tagStatus = "Tags must be 64 characters or fewer."; return; }
      if (assetTags.Contains(tag, StringComparer.OrdinalIgnoreCase)) { tagStatus = "This tag is already assigned."; return; }
      if (await SaveTags(assetTags.Append(tag).ToList()))
      {
          newTag = string.Empty;
          tagSuggestionsOpen = false;
      }
  }
