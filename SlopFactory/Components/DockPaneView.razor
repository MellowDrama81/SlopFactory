  private Task RemoveTag(string tag) => SaveTags(assetTags.Where(existing => !string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)).ToList());
  private async Task<bool> SaveTags(List<string> tags)
  {
      if (string.IsNullOrWhiteSpace(assetMetadataPath)) { tagStatus = "Asset metadata is unavailable."; return false; }
      try
      {
          var metadata = JsonNode.Parse(await File.ReadAllTextAsync(assetMetadataPath)) as JsonObject
              ?? throw new InvalidOperationException("The asset metadata is invalid.");
          metadata["tags"] = System.Text.Json.JsonSerializer.SerializeToNode(tags);
          await File.WriteAllTextAsync(assetMetadataPath, metadata.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
          assetTags = tags;
          tagStatus = string.Empty;
          if (assetProjectFolder is not null)
          {
              try
              {
                  foreach (var tag in tags) ProjectLibrary.RegisterProjectTag(assetProjectFolder, tag);
                  projectTags = ProjectLibrary.GetProjectTags(assetProjectFolder);
              }
              catch (Exception ex) { tagStatus = $"Tags saved, but project suggestions could not be updated: {ex.Message}"; }
          }
          return true;
      }
      catch (Exception ex)
      {
          tagStatus = $"Could not save tags: {ex.Message}";
          return false;
      }
  }
  private static string? CreateThumbnail(string path)
  {
      var extension = Path.GetExtension(path).ToLowerInvariant();
      var mimeType = extension switch { ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", _ => null };
      var info = new FileInfo(path);
      if (mimeType is null || info.Length > 8 * 1024 * 1024) return null;
      try { return $"data:{mimeType};base64,{Convert.ToBase64String(File.ReadAllBytes(path))}"; }
      catch { return null; }
  }
  private static string? CreateImageSource(string path)
  {
      var extension = Path.GetExtension(path).ToLowerInvariant();
      var mimeType = extension switch { ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", _ => null };
      if (mimeType is null) return null;
      try { return $"data:{mimeType};base64,{Convert.ToBase64String(File.ReadAllBytes(path))}"; }
      catch { return null; }
  }
  private sealed record AssetEntry(string Name, bool IsDirectory, string Detail, string? Thumbnail, string Path);
