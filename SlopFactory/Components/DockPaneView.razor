  protected override void OnParametersSet()
  {
      if (Pane.Kind == "generation")
      {
          if (!string.Equals(loadedOutputFolder, Pane.OutputFolder, StringComparison.Ordinal))
          {
              outputFolderDraft = Pane.OutputFolder ?? "generated";
              loadedOutputFolder = Pane.OutputFolder;
          }
          LoadGenerationImages();
          return;
      }
      if (Pane.Kind == "asset-details") { LoadAssetDetails(); return; }
      if (Pane.Kind != "assets" || string.IsNullOrWhiteSpace(Pane.Context) || !Directory.Exists(Pane.Context)) { assetEntries = []; return; }
      if (!string.Equals(assetsRoot, Pane.Context, StringComparison.OrdinalIgnoreCase))
      {
          assetsRoot = Pane.Context;
          selectedTag = string.Empty;
          assetTagQuery = string.Empty;
          assetTagMenuOpen = false;
      }
      currentAssetsPath = Pane.Location ?? Pane.Context;
      LoadAssets();
  }
  protected override async Task OnParametersSetAsync()
  {
      if (Pane.Kind != "generation" || string.Equals(loadedGenerationWorkflowId, Pane.WorkflowId, StringComparison.Ordinal)) return;
      loadedGenerationWorkflowId = Pane.WorkflowId;
      generationInputs = [];
      generationLoadError = string.Empty;
      generationLoading = false;
      if (SelectedGenerationWorkflow is not { } workflow) return;
      generationLoading = true;
      try
      {
          var placeholders = await WorkflowTemplateService.GetPlaceholdersAsync(workflow);
          if (Pane.WorkflowId == workflow.Id)
              generationInputs = placeholders.Where(placeholder => !placeholder.IsSeed).ToList();
      }
      catch (Exception ex)
      {
          if (Pane.WorkflowId == workflow.Id) generationLoadError = $"Could not load workflow inputs: {ex.Message}";
      }
      finally { if (Pane.WorkflowId == workflow.Id) generationLoading = false; }
  }
  private void LoadGenerationImages()
  {
      generationImages = [];
      generationImagePaths.Clear();
      if (!string.Equals(generationImageProject, Pane.Context, StringComparison.OrdinalIgnoreCase))
      {
          generationThumbnails.Clear();
          openGenerationImagePicker = null;
          importErrorFor = null;
          generationImportError = string.Empty;
          outputFolderDraft = Pane.OutputFolder ?? "generated";
          loadedOutputFolder = Pane.OutputFolder;
          newOutputTag = string.Empty;
          outputTagSuggestionsOpen = false;
          outputTagStatus = string.Empty;
          try { generationProjectTags = string.IsNullOrWhiteSpace(Pane.Context) ? [] : ProjectLibrary.GetProjectTags(Pane.Context); }
          catch { generationProjectTags = []; }
          generationImageProject = Pane.Context;
          generationPickerTag = string.Empty;
          generationTagQuery = string.Empty;
          generationTagMenuOpen = false;
          generationPickerFolder = null;
      }
      if (string.IsNullOrWhiteSpace(Pane.Context)) return;
      var assetsFolder = Path.Combine(Pane.Context, "assets");
      generationPickerRoot = Path.GetFullPath(assetsFolder);
      if (generationPickerFolder is null || !IsInsideGenerationPicker(generationPickerFolder) || !Directory.Exists(generationPickerFolder))
          generationPickerFolder = generationPickerRoot;
      if (!Directory.Exists(assetsFolder)) return;
      try
      {
          generationImages = Directory.EnumerateFiles(assetsFolder, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).Where(path => Path.GetExtension(path).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp")
              .Select(path => Path.GetRelativePath(Pane.Context, path).Replace('\\', '/'))
              .OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToList();
      }
      catch { generationImages = []; }
      generationImagePaths = generationImages.ToHashSet(StringComparer.OrdinalIgnoreCase);
      if (openGenerationImagePicker is not null) RefreshGenerationPicker();
  }
  private void RefreshGenerationPicker()
  {
      generationPickerEntries = [];
      generationPickerTags = [];
      if (generationPickerFolder is null || Pane.Context is null || !Directory.Exists(generationPickerFolder) ||
          !IsInsideGenerationPicker(generationPickerFolder)) return;
      try
      {
          var imageFiles = Directory.EnumerateFiles(generationPickerFolder, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).Where(IsGenerationImage).ToList();
          var taggedImages = imageFiles.Select(path => (Path: path, Tags: ReadAssetTags(path, Pane.Context))).ToList();
          generationPickerTags = taggedImages.SelectMany(item => item.Tags)
              .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase).ToList();
          if (generationPickerTag.Length > 0 && !generationPickerTags.Contains(generationPickerTag, StringComparer.OrdinalIgnoreCase))
          {
              generationPickerTag = string.Empty;
              generationTagQuery = string.Empty;
          }
          IEnumerable<string> paths = generationPickerTag.Length > 0
              ? taggedImages.Where(item => item.Tags.Contains(generationPickerTag, StringComparer.OrdinalIgnoreCase)).Select(item => item.Path)
              : Directory.EnumerateFileSystemEntries(generationPickerFolder)
                  .Where(path => Directory.Exists(path) || IsGenerationImage(path));
          generationPickerEntries = paths.OrderBy(path => !Directory.Exists(path))
              .ThenBy(Path.GetFileName, StringComparer.OrdinalIgnoreCase)
              .Select(path => new GenerationPickerEntry(path, Path.GetRelativePath(Pane.Context, path).Replace('\\', '/'), Directory.Exists(path)))
              .ToList();
      }
      catch { generationPickerEntries = []; generationPickerTags = []; }
  }
  private static bool IsGenerationImage(string path) => Path.GetExtension(path).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
