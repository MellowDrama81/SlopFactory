  private async Task AddOutputTag()
  {
      var enteredTag = newOutputTag.Trim();
      var tag = generationProjectTags.FirstOrDefault(existing => string.Equals(existing, enteredTag, StringComparison.OrdinalIgnoreCase)) ?? enteredTag;
      if (tag.Length == 0) { outputTagStatus = "Enter a tag."; return; }
      if (tag.Length > 64) { outputTagStatus = "Tags must be 64 characters or fewer."; return; }
      if ((Pane.OutputTags ?? []).Contains(tag, StringComparer.OrdinalIgnoreCase)) { outputTagStatus = "This tag is already selected."; return; }
      await OnGenerationOutputTagsChanged.InvokeAsync(new GenerationOutputTagsChange(Pane.Id, (Pane.OutputTags ?? []).Append(tag).ToList()));
      newOutputTag = string.Empty;
      outputTagSuggestionsOpen = false;
      outputTagStatus = string.Empty;
      if (!string.IsNullOrWhiteSpace(Pane.Context))
      {
          try
          {
              ProjectLibrary.RegisterProjectTag(Pane.Context, tag);
              generationProjectTags = ProjectLibrary.GetProjectTags(Pane.Context);
          }
          catch (Exception ex) { outputTagStatus = $"Tag selected, but project suggestions could not be updated: {ex.Message}"; }
      }
  }
