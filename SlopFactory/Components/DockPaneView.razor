  private async Task ImportGenerationImage(string name)
  {
      if (importingImageFor is not null || string.IsNullOrWhiteSpace(Pane.Context)) return;
      importingImageFor = name;
      importErrorFor = null;
      string? destination = null;
      string? metadataPath = null;
      var imported = false;
      try
      {
          var file = await FilePicker.Default.PickAsync(new PickOptions
          {
              PickerTitle = "Choose an image to import",
              FileTypes = GenerationImageFileTypes
          });
          if (file is null) return;

          var fileName = Path.GetFileName(file.FileName);
          if (string.IsNullOrWhiteSpace(fileName) || !IsGenerationImage(fileName))
              throw new InvalidOperationException("Choose a JPG, PNG, GIF, or WebP image.");

          var projectFolder = Path.GetFullPath(Pane.Context);
          if (!Directory.Exists(projectFolder)) throw new DirectoryNotFoundException("The selected project folder is unavailable.");
          var importedFolder = Path.Combine(projectFolder, "assets", "imported");
          Directory.CreateDirectory(importedFolder);
          destination = UniqueGenerationImagePath(importedFolder, fileName);
          await using (var source = await file.OpenReadAsync())
          await using (var target = new FileStream(destination, FileMode.CreateNew, FileAccess.Write, FileShare.None))
              await source.CopyToAsync(target);

          var relativePath = Path.GetRelativePath(projectFolder, destination).Replace('\\', '/');
          metadataPath = AssetMetadataPaths.ForRelativeAsset(projectFolder, relativePath, createDirectory: true);
          var metadata = new { asset = relativePath, name = Path.GetFileName(destination), tags = Array.Empty<string>() };
          await File.WriteAllTextAsync(metadataPath, System.Text.Json.JsonSerializer.Serialize(metadata));
          imported = true;

          LoadGenerationImages();
          openGenerationImagePicker = null;
          await OnGenerationInputChanged.InvokeAsync(new GenerationInputChange(Pane.Id, name, relativePath));
      }
      catch (Exception ex)
      {
          if (!imported && destination is not null)
          {
              try { File.Delete(destination); } catch { /* Keep the original import error. */ }
              if (metadataPath is not null)
              {
                  try { File.Delete(metadataPath); } catch { /* Keep the original import error. */ }
              }
          }
          importErrorFor = name;
          generationImportError = imported
              ? $"Image imported, but could not select it: {ex.Message}"
              : $"Could not import image: {ex.Message}";
      }
      finally { importingImageFor = null; }
  }
  private static string UniqueGenerationImagePath(string folder, string fileName)
  {
      var stem = Path.GetFileNameWithoutExtension(fileName);
      var extension = Path.GetExtension(fileName);
      var path = Path.Combine(folder, fileName);
      for (var suffix = 2; File.Exists(path) || Directory.Exists(path); suffix++)
          path = Path.Combine(folder, $"{stem} ({suffix}){extension}");
      return path;
  }
  private string? GenerationThumbnail(string asset)
  {
      if (!generationImagePaths.Contains(asset)) return null;
      if (generationThumbnails.TryGetValue(asset, out var thumbnail)) return thumbnail;
      if (string.IsNullOrWhiteSpace(Pane.Context)) return null;
      var path = Path.Combine(Pane.Context, asset.Replace('/', Path.DirectorySeparatorChar));
      thumbnail = CreateImageSource(path);
      generationThumbnails[asset] = thumbnail;
      return thumbnail;
  }
