@using SlopFactory.Models
@using SlopFactory.Services
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Web
@inject ProjectLibrary ProjectLibrary
@inject WorkflowLibrary WorkflowLibrary
@inject WorkflowTemplateService WorkflowTemplateService
@inject ComfyGenerationService ComfyGenerationService
@inject IJSRuntime JS
@implements IDisposable
<div class="panel-view @Panel.Kind">
@if (Panel.Kind == "overview") { <div class="intro"><p class="eyebrow">Q3 DELIVERY</p><h2>Ship work, not status updates.</h2><p>Focus the team on the smallest set of decisions that moves the release forward.</p><div class="stat-row"><div><b>74%</b><span>release confidence</span></div><div><b>12</b><span>open decisions</span></div><div><b>4</b><span>days to beta</span></div></div></div><div class="mini-roadmap"><span>Discovery</span><i></i><span>Build</span><i></i><span>Launch</span></div> }
else if (Panel.Kind == "velocity") { <div class="metric"><p>Weekly throughput</p><b>42 <em>↑ 18%</em></b><svg viewBox="0 0 300 90"><path d="M0 70 L40 64 70 68 105 42 140 50 185 20 220 32 260 14 300 23" fill="none" stroke="#82b6ff" stroke-width="4"/></svg></div> }
else if (Panel.Kind == "activity") { <div class="feed"><p><b>Maia Chen</b> moved Payment flow to review <small>8m</small></p><p><b>Rohan Patel</b> added 4 customer interviews <small>28m</small></p><p><b>Ana Torres</b> closed Onboarding QA <small>1h</small></p></div> }
else if (Panel.Kind == "notes") { <div class="notes"><p class="eyebrow">TODAY'S NOTE</p><h2>Keep the release calm.</h2><p>Surface decisions early, make handoffs explicit, and preserve room for the team to think.</p><span>#product</span><span>#direction</span></div> }
else if (Panel.Kind == "checklist") { <div class="checklist"><p><b>12 / 16</b> launch tasks complete</p><div class="progress"><i></i></div><label>☑ Release notes approved</label><label>☑ Support coverage confirmed</label><label>□ Schedule customer announcement</label><label>□ Publish launch post</label></div> }
else if (Panel.Kind == "risks") { <div class="risks"><p class="eyebrow">WATCH LIST</p><h2>2 decisions need a owner</h2><p>Billing migration and regional rollout timing could affect beta readiness.</p></div> }
else if (Panel.Kind == "assets" && string.IsNullOrWhiteSpace(Panel.Context)) { <div class="assets-panel assets-project-picker"><p class="eyebrow">PROJECT ASSETS</p><h2>Select a project</h2><p>Choose the project whose assets folder this panel should show.</p>@if (ProjectLibrary.GetAll().Count == 0) { <p class="assets-empty">No projects have been added yet. Add one from Projects, then open a new Assets panel.</p> } else { <div class="assets-project-list">@foreach (var project in ProjectLibrary.GetAll()) { <button type="button" data-assets-project-select data-assets-panel="@Panel.Id" data-project-folder="@project.FolderPath" data-project-name="@project.Name">@project.DisplayName</button> }</div> }</div> }
else if (Panel.Kind == "generation" && string.IsNullOrWhiteSpace(Panel.Context))
{
  <div class="generation-panel generation-project-picker">
    <p class="eyebrow">PROJECT GENERATION</p>
    <h2>Select a project</h2>
    <p>Generations in this panel will belong to the project you choose.</p>
    @if (ProjectLibrary.GetAll().Count == 0)
    {
      <p class="assets-empty">No projects have been added yet. Add one from Projects, then select it here.</p>
    }
    else
    {
      <div class="assets-project-list">
        @foreach (var project in ProjectLibrary.GetAll())
        {
          <button type="button" data-generation-project-select data-generation-panel="@Panel.Id" data-project-folder="@project.FolderPath">@project.DisplayName</button>
        }
      </div>
    }
    <p class="generation-status" data-generation-status role="status"></p>
  </div>
}
else if (Panel.Kind == "generation")
{
  <div class="generation-panel">
    <p class="eyebrow">PROJECT GENERATION</p>
    <div class="generation-heading">
      <div><h2>@Panel.Title</h2><p class="assets-path">@Panel.Context</p></div>
      <button type="button" data-generation-change-project data-generation-panel="@Panel.Id">Change project</button>
    </div>
    <label class="generation-field">
      <span>Workflow</span>
      <select value="@Panel.WorkflowId" @onchange="ChangeGenerationWorkflow">
        <option value="">Select a workflow</option>
        @foreach (var workflow in WorkflowLibrary.GetAll().Where(item => !string.IsNullOrWhiteSpace(item.GraphFile)))
        {
          <option value="@workflow.Id">@workflow.DisplayName</option>
        }
      </select>
    </label>
    @if (SelectedGenerationWorkflow is not null)
    {
      <p class="generation-workflow-description">@SelectedGenerationWorkflow.Description</p>
      @if (generationLoading)
      {
        <p class="generation-next-step">Loading workflow inputs…</p>
      }
      else if (!string.IsNullOrWhiteSpace(generationLoadError))
      {
        <p class="generation-status" role="alert">@generationLoadError</p>
      }
      else
      {
        <div class="generation-inputs">
          @foreach (var placeholder in generationInputs)
          {
            @if (placeholder.Type == "image")
            {
              var selectedAsset = GenerationValue(placeholder.Name);
              <div class="generation-field generation-image-field" @key="placeholder.Name">
                <span>@placeholder.Label</span>
                <button type="button" class="generation-image-selection" aria-label="Choose @placeholder.Label.ToLowerInvariant()" aria-expanded="@(openGenerationImagePicker == placeholder.Name)" @onclick="() => ToggleGenerationImagePicker(placeholder.Name)">
                  @if (selectedAsset.Length > 0 && GenerationThumbnail(selectedAsset) is { } selectedThumbnail)
                  {
                    <img src="@selectedThumbnail" alt="Selected @placeholder.Label.ToLowerInvariant()" />
                  }
                  else
                  {
                    <span class="generation-image-empty" aria-hidden="true">▧</span>
                  }
                  <span class="generation-image-selection-text"><strong>@(selectedAsset.Length > 0 ? Path.GetFileName(selectedAsset) : "Choose a project image")</strong><small>@(selectedAsset.Length > 0 ? selectedAsset : "Browse image thumbnails")</small></span>
                  <span class="generation-image-chevron" aria-hidden="true">@(openGenerationImagePicker == placeholder.Name ? "▴" : "▾")</span>
                </button>
                @if (openGenerationImagePicker == placeholder.Name)
                {
                  <div class="generation-picker-toolbar">
                    <button type="button" class="generation-picker-up" disabled="@(!CanGenerationPickerNavigateUp)" @onclick="NavigateGenerationPickerUp">↑ Up</button>
                    <span class="generation-picker-path" title="@GenerationPickerLocation">@GenerationPickerLocation</span>
                    <div class="generation-picker-filter">
                      <span>Filter by tag</span>
                      <button type="button" class="generation-picker-tag-trigger" aria-label="Filter by tag" aria-haspopup="listbox" aria-expanded="@generationTagMenuOpen" @onclick="ToggleGenerationTagMenu">@(generationPickerTag.Length == 0 ? "All tags" : generationPickerTag)<span aria-hidden="true">▾</span></button>
                      @if (generationTagMenuOpen)
                      {
                        <div class="generation-picker-tag-menu" role="listbox" aria-label="Filter by tag">
                          <button type="button" role="option" aria-selected="@(generationPickerTag.Length == 0)" @onclick="() => SetGenerationPickerTag(string.Empty)">All tags</button>
                          @foreach (var tag in generationPickerTags)
                          {
                            <button type="button" role="option" aria-selected="@(string.Equals(generationPickerTag, tag, StringComparison.OrdinalIgnoreCase))" @key="tag" @onclick="() => SetGenerationPickerTag(tag)">@tag</button>
                          }
                        </div>
                      }
                    </div>
                  </div>
                  @if (generationPickerTag.Length > 0)
                  {
                    <p class="generation-picker-hint">Showing matching images in this folder and subfolders</p>
                  }
                  @if (generationPickerEntries.Count == 0)
                  {
                    <p class="generation-image-picker-empty">@(generationPickerTag.Length > 0 ? "No images with this tag in this folder or its subfolders." : "This folder has no images or subfolders.")</p>
                  }
                  else
                  {
                    <div class="generation-image-grid" aria-label="Choose @placeholder.Label.ToLowerInvariant()">
                      @foreach (var entry in generationPickerEntries)
                      {
                        @if (entry.IsDirectory)
                        {
                          <button type="button" class="generation-image-option generation-folder-option" title="Open @entry.RelativePath" aria-label="Open folder @entry.RelativePath" @key="entry.FullPath" @onclick="() => NavigateGenerationPicker(entry.FullPath)">
                            <span class="generation-folder-icon" aria-hidden="true">▰</span><span>@Path.GetFileName(entry.FullPath)</span><small>Folder</small>
                          </button>
                        }
                        else
                        {
                          <button type="button" class="generation-image-option @(string.Equals(entry.RelativePath, selectedAsset, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")" title="@entry.RelativePath" aria-label="Select @entry.RelativePath" aria-pressed="@(string.Equals(entry.RelativePath, selectedAsset, StringComparison.OrdinalIgnoreCase))" @key="entry.FullPath" @onclick="() => SelectGenerationImage(placeholder.Name, entry.RelativePath)">
                            @if (GenerationThumbnail(entry.RelativePath) is { } thumbnail)
                            {
                              <img src="@thumbnail" alt="" loading="lazy" />
                            }
                            else
                            {
                              <span class="generation-image-unavailable" aria-hidden="true">▧</span>
                            }
                            <span>@Path.GetFileName(entry.FullPath)</span>
                            @if (generationPickerTag.Length > 0) { <small>@Path.GetDirectoryName(entry.RelativePath)?.Replace('\\', '/')</small> }
                          </button>
                        }
                      }
                    </div>
                  }
                }
              </div>
            }
            else
            {
              <label class="generation-field" @key="placeholder.Name">
                <span>@placeholder.Label</span>
                @if (placeholder.Name == "PROMPT")
                {
                  <textarea rows="5" value="@GenerationValue(placeholder.Name)" @onchange="args => ChangeGenerationInput(placeholder.Name, args)" placeholder="Describe what to create"></textarea>
                }
                else
                {
                  <input type="text" value="@GenerationValue(placeholder.Name)" @onchange="args => ChangeGenerationInput(placeholder.Name, args)" />
                }
              </label>
            }
          }
          @if (generationInputs.Count == 0)
          {
            <p>No user inputs are required by this workflow.</p>
          }
        </div>
        <p class="generation-seed-note">Seed values are generated automatically. Run uploads selected images and submits the workflow to the current Comfy connection.</p>
        <button type="button" class="generation-run-button" disabled="@(GenerationState?.IsRunning == true)" @onclick="RunGeneration">@(GenerationState?.IsRunning == true ? "Running…" : "Run")</button>
      }
    }
    else
    {
      <p class="generation-next-step">Select a workflow to see its required inputs.</p>
    }
    @if (GenerationState is { } run)
    {
      <p class="generation-status @(run.IsRunning ? "generation-active" : "")" role="status">@run.Status</p>
      @if (!string.IsNullOrWhiteSpace(run.PromptId))
      {
        <p class="generation-job-id">Comfy job · @run.PromptId</p>
      }
      @if (run.Outputs.Count > 0)
      {
        <section class="generation-results" aria-label="Generation results">
          <h3>Results</h3>
          <div class="generation-result-grid">
            @foreach (var output in run.Outputs)
            {
              <div class="generation-result" @key="output.Path">
                @if (output.IsImage)
                {
                  <img src="@CreateImageSource(output.Path)" alt="Generated result @Path.GetFileName(output.Path)" />
                }
                <span>@Path.GetFileName(output.Path)</span>
              </div>
            }
          </div>
        </section>
      }
    }
  </div>
}
else if (Panel.Kind == "asset-details")
{
  <div class="asset-details">
    <p class="eyebrow">ASSET DETAILS</p>
    <h2>@assetName</h2>
    <p class="assets-path">@Panel.Context</p>
    @if (assetImage is not null)
    {
      <p class="asset-dimensions">Dimensions: @(assetDimensions ?? "Loading…")</p>
      <div class="asset-full-image"><img @ref="assetImageElement" @onload="UpdateImageDimensions" src="@assetImage" alt="@assetName" /></div>
    }
    else
    {
      <div class="asset-image-unavailable">Preview is available for JPG, PNG, GIF, and WebP images.</div>
    }
    <section class="asset-tags-section" aria-label="Asset tags">
      <h3>Tags</h3>
      @if (assetTags.Count == 0)
      {
        <p class="asset-tags-empty">No tags yet.</p>
      }
      else
      {
        <div class="asset-tag-list">
          @foreach (var tag in assetTags)
          {
            <span class="asset-tag" @key="tag">@tag<button type="button" title="Remove @tag" aria-label="Remove @tag" @onclick="() => RemoveTag(tag)">×</button></span>
          }
        </div>
      }
      <div class="asset-tag-form">
        <input type="text" list="@TagSuggestionListId" placeholder="Add a tag" aria-label="New tag" autocomplete="off" maxlength="64" @bind="newTag" @bind:event="oninput" @onkeydown="HandleTagKeyDown" />
        <datalist id="@TagSuggestionListId">
          @foreach (var tag in projectTags.Where(tag => !assetTags.Contains(tag, StringComparer.OrdinalIgnoreCase)))
          {
            <option value="@tag"></option>
          }
        </datalist>
        <button type="button" @onclick="AddTag">Add tag</button>
      </div>
      @if (!string.IsNullOrWhiteSpace(tagStatus))
      {
        <p class="asset-tag-status" role="status">@tagStatus</p>
      }
    </section>
  </div>
}
else if (Panel.Kind == "assets")
{
  <div class="assets-panel" data-assets-drop-target data-assets-panel="@Panel.Id" data-assets-folder="@currentAssetsPath" data-assets-root="@assetsRoot">
    <p class="eyebrow">PROJECT ASSETS</p>
    <div class="assets-heading">
      <div><h2>@Panel.Title</h2><p class="assets-path">@currentAssetsPath</p></div>
      <div class="assets-actions"><button type="button" class="assets-up" data-assets-navigate data-assets-panel="@Panel.Id" data-assets-folder="@ParentAssetsPath" disabled="@(!CanNavigateUp)">↑ Up</button><button type="button" class="assets-create" data-assets-create-folder data-assets-folder="@currentAssetsPath">Create folder</button><button type="button" class="assets-select-all" data-assets-select-all>Select all</button><button type="button" class="assets-export-selected" data-assets-export-selected>⇩ Selected</button><button type="button" class="assets-delete-selected" data-assets-delete-selected>× Selected</button><button type="button" class="assets-add" data-assets-add data-assets-folder="@currentAssetsPath" data-assets-root="@assetsRoot">＋ Add assets</button></div>
    </div>
    <div class="assets-filter-bar">
      <div class="assets-tag-filter">
        <span>Filter by tag</span>
        <button type="button" class="assets-tag-trigger" aria-label="Filter by tag" aria-haspopup="listbox" aria-expanded="@assetTagMenuOpen" @onclick="ToggleAssetTagMenu">@(selectedTag.Length == 0 ? "All tags" : selectedTag)<span aria-hidden="true">▾</span></button>
        @if (assetTagMenuOpen)
        {
          <div class="assets-tag-menu" role="listbox" aria-label="Filter by tag">
            <button type="button" role="option" aria-selected="@(selectedTag.Length == 0)" @onclick="() => SetAssetTagFilter(string.Empty)">All tags</button>
            @foreach (var tag in availableTags)
            {
              <button type="button" role="option" aria-selected="@(string.Equals(selectedTag, tag, StringComparison.OrdinalIgnoreCase))" @key="tag" @onclick="() => SetAssetTagFilter(tag)">@tag</button>
            }
          </div>
        }
      </div>
      @if (!string.IsNullOrEmpty(selectedTag)) { <span class="assets-filter-hint">Showing matching files in this folder and subfolders</span> }
    </div>
    <p class="assets-action-status" data-assets-status></p>
    @if (assetEntries.Count == 0) { <p class="assets-empty">@(string.IsNullOrEmpty(selectedTag) ? "This folder is empty." : "No assets with this tag in this folder or its subfolders.")</p> }
    else
    {
      <div class="assets-grid">@foreach (var entry in assetEntries) { <article class="asset-tile @(entry.IsDirectory ? "" : "asset-file")" draggable="true" data-assets-drag data-assets-source-path="@entry.Path" data-assets-source-root="@assetsRoot" data-asset-path="@entry.Path" data-assets-open-details="@(entry.IsDirectory ? "" : "file")"><input type="checkbox" class="asset-select" data-asset-select data-asset-path="@entry.Path" data-assets-root="@assetsRoot" aria-label="Select @entry.Name" />@if (entry.IsDirectory) { <button type="button" class="asset-folder" data-assets-navigate data-assets-panel="@Panel.Id" data-assets-folder="@entry.Path"><div class="asset-tile-placeholder">▰</div><strong>@entry.Name</strong><small>Folder</small></button><div class="asset-folder-actions"><button type="button" class="asset-rename-icon" data-assets-rename data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Rename folder" aria-label="Rename @entry.Name">✎</button><button type="button" class="asset-export-icon" data-assets-export data-asset-path="@entry.Path" title="Export folder as ZIP">⇩</button><button type="button" class="asset-delete-icon" data-assets-delete data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Delete folder">×</button></div> } else { @if (entry.Thumbnail is not null) { <img src="@entry.Thumbnail" alt="@entry.Name" /> } else { <div class="asset-tile-placeholder">◌</div> }<div class="asset-tile-footer"><strong>@entry.Name</strong><button type="button" class="asset-rename-icon" data-assets-rename data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Rename asset" aria-label="Rename @entry.Name">✎</button><button type="button" class="asset-export-icon" data-assets-export data-asset-path="@entry.Path" title="Export asset">⇩</button><button type="button" class="asset-delete-icon" data-assets-delete data-asset-path="@entry.Path" data-assets-root="@assetsRoot" title="Delete asset">×</button></div><small>@entry.Detail</small> }</article> }</div>
    }
  </div>
}
else { <div class="insights"><i>✦</i><h2>Customer signal</h2><p>13 people asked for easier handoffs between product and design this week.</p><button>Review insights →</button></div> }
</div>
@code {
  [Parameter, EditorRequired] public DockPanel Panel { get; set; } = default!;
  [Parameter] public EventCallback<GenerationWorkflowSelection> OnGenerationWorkflowChanged { get; set; }
  [Parameter] public EventCallback<GenerationInputChange> OnGenerationInputChanged { get; set; }
  private string? loadedGenerationWorkflowId;
  private List<WorkflowPlaceholder> generationInputs = [];
  private List<string> generationImages = [];
  private HashSet<string> generationImagePaths = new(StringComparer.OrdinalIgnoreCase);
  private List<GenerationPickerEntry> generationPickerEntries = [];
  private List<string> generationPickerTags = [];
  private string generationPickerTag = string.Empty;
  private bool generationTagMenuOpen;
  private string? generationPickerRoot;
  private string? generationPickerFolder;
  private readonly Dictionary<string, string?> generationThumbnails = new(StringComparer.OrdinalIgnoreCase);
  private string? openGenerationImagePicker;
  private string? generationImageProject;
  private string generationLoadError = string.Empty;
  private bool generationLoading;
  private GenerationRunState? GenerationState => ComfyGenerationService.GetState(Panel.Id);
  private WorkflowDefinition? SelectedGenerationWorkflow => WorkflowLibrary.GetAll()
      .FirstOrDefault(workflow => workflow.Id == Panel.WorkflowId && !string.IsNullOrWhiteSpace(workflow.GraphFile));
  private string GenerationValue(string name) => Panel.InputValues?.GetValueOrDefault(name) ?? string.Empty;
  private Task ChangeGenerationWorkflow(ChangeEventArgs args)
  {
      openGenerationImagePicker = null;
      return OnGenerationWorkflowChanged.InvokeAsync(new GenerationWorkflowSelection(Panel.Id, args.Value?.ToString() ?? string.Empty));
  }
  private Task ChangeGenerationInput(string name, ChangeEventArgs args) =>
      OnGenerationInputChanged.InvokeAsync(new GenerationInputChange(Panel.Id, name, args.Value?.ToString() ?? string.Empty));
  private void ToggleGenerationImagePicker(string name)
  {
      if (openGenerationImagePicker == name) { openGenerationImagePicker = null; generationTagMenuOpen = false; return; }
      openGenerationImagePicker = name;
      generationPickerTag = string.Empty;
      generationTagMenuOpen = false;
      generationPickerFolder = generationPickerRoot;
      var selected = GenerationValue(name);
      if (generationImagePaths.Contains(selected) && Panel.Context is not null)
      {
          var selectedFolder = Path.GetDirectoryName(Path.Combine(Panel.Context, selected.Replace('/', Path.DirectorySeparatorChar)));
          if (selectedFolder is not null && IsInsideGenerationPicker(selectedFolder)) generationPickerFolder = selectedFolder;
      }
      RefreshGenerationPicker();
  }
  private bool CanGenerationPickerNavigateUp => generationPickerRoot is not null && generationPickerFolder is not null &&
      !string.Equals(generationPickerRoot, generationPickerFolder, StringComparison.OrdinalIgnoreCase);
  private string GenerationPickerLocation => generationPickerFolder is null || Panel.Context is null ? "assets" :
      Path.GetRelativePath(Panel.Context, generationPickerFolder).Replace('\\', '/');
  private bool IsInsideGenerationPicker(string folder) => generationPickerRoot is not null &&
      (string.Equals(Path.GetFullPath(folder), generationPickerRoot, StringComparison.OrdinalIgnoreCase) ||
       Path.GetFullPath(folder).StartsWith(generationPickerRoot + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase));
  private void NavigateGenerationPicker(string folder)
  {
      if (!Directory.Exists(folder) || !IsInsideGenerationPicker(folder)) return;
      generationTagMenuOpen = false;
      generationPickerFolder = Path.GetFullPath(folder);
      RefreshGenerationPicker();
  }
  private void NavigateGenerationPickerUp()
  {
      if (!CanGenerationPickerNavigateUp) return;
      var parent = Directory.GetParent(generationPickerFolder!)?.FullName;
      if (parent is not null) NavigateGenerationPicker(parent);
  }
  private void ToggleGenerationTagMenu() => generationTagMenuOpen = !generationTagMenuOpen;
  private void SetGenerationPickerTag(string tag)
  {
      generationPickerTag = tag;
      generationTagMenuOpen = false;
      RefreshGenerationPicker();
  }
  private Task SelectGenerationImage(string name, string asset)
  {
      openGenerationImagePicker = null;
      return OnGenerationInputChanged.InvokeAsync(new GenerationInputChange(Panel.Id, name, asset));
  }
  private string? GenerationThumbnail(string asset)
  {
      if (!generationImagePaths.Contains(asset)) return null;
      if (generationThumbnails.TryGetValue(asset, out var thumbnail)) return thumbnail;
      if (string.IsNullOrWhiteSpace(Panel.Context)) return null;
      var path = Path.Combine(Panel.Context, asset.Replace('/', Path.DirectorySeparatorChar));
      thumbnail = CreateImageSource(path);
      generationThumbnails[asset] = thumbnail;
      return thumbnail;
  }
  private void RunGeneration()
  {
      var workflow = SelectedGenerationWorkflow;
      if (workflow is null || string.IsNullOrWhiteSpace(Panel.Context)) return;
      ComfyGenerationService.Start(Panel.Id, Panel.Context, workflow,
          Panel.InputValues ?? new Dictionary<string, string>());
  }
  protected override void OnInitialized() => ComfyGenerationService.Changed += OnGenerationChanged;
  private void OnGenerationChanged(string panelId)
  {
      if (Panel.Id == panelId) _ = InvokeAsync(StateHasChanged);
  }
  public void Dispose() => ComfyGenerationService.Changed -= OnGenerationChanged;
  private List<AssetEntry> assetEntries = [];
  private List<string> availableTags = [];
  private string selectedTag = string.Empty;
  private bool assetTagMenuOpen;
  private string? assetsRoot;
  private string currentAssetsPath = string.Empty;
  private string assetName = string.Empty;
  private string? assetMetadataPath;
  private string? assetProjectFolder;
  private List<string> assetTags = [];
  private IReadOnlyList<string> projectTags = [];
  private string newTag = string.Empty;
  private string tagStatus = string.Empty;
  private string? assetImage;
  private ElementReference assetImageElement;
  private string? assetDimensions;
  private string? dimensionsForPath;
  private string TagSuggestionListId => $"asset-tag-suggestions-{Panel.Id}";
  private async Task UpdateImageDimensions()
  {
      var size = await JS.InvokeAsync<int[]>("recursiveDock.imageDimensions", assetImageElement);
      assetDimensions = size.Length == 2 && size[0] > 0 && size[1] > 0
          ? $"{size[0]:N0} × {size[1]:N0} px" : "Unavailable";
      await InvokeAsync(StateHasChanged);
  }
  protected override void OnParametersSet()
  {
      if (Panel.Kind == "generation") { LoadGenerationImages(); return; }
      if (Panel.Kind == "asset-details") { LoadAssetDetails(); return; }
      if (Panel.Kind != "assets" || string.IsNullOrWhiteSpace(Panel.Context) || !Directory.Exists(Panel.Context)) { assetEntries = []; return; }
      if (!string.Equals(assetsRoot, Panel.Context, StringComparison.OrdinalIgnoreCase))
      {
          assetsRoot = Panel.Context;
          selectedTag = string.Empty;
          assetTagMenuOpen = false;
      }
      currentAssetsPath = Panel.Location ?? Panel.Context;
      LoadAssets();
  }
  protected override async Task OnParametersSetAsync()
  {
      if (Panel.Kind != "generation" || string.Equals(loadedGenerationWorkflowId, Panel.WorkflowId, StringComparison.Ordinal)) return;
      loadedGenerationWorkflowId = Panel.WorkflowId;
      generationInputs = [];
      generationLoadError = string.Empty;
      generationLoading = false;
      if (SelectedGenerationWorkflow is not { } workflow) return;
      generationLoading = true;
      try
      {
          var placeholders = await WorkflowTemplateService.GetPlaceholdersAsync(workflow);
          if (Panel.WorkflowId == workflow.Id)
              generationInputs = placeholders.Where(placeholder => !placeholder.IsSeed).ToList();
      }
      catch (Exception ex)
      {
          if (Panel.WorkflowId == workflow.Id) generationLoadError = $"Could not load workflow inputs: {ex.Message}";
      }
      finally { if (Panel.WorkflowId == workflow.Id) generationLoading = false; }
  }
  private void LoadGenerationImages()
  {
      generationImages = [];
      generationImagePaths.Clear();
      if (!string.Equals(generationImageProject, Panel.Context, StringComparison.OrdinalIgnoreCase))
      {
          generationThumbnails.Clear();
          openGenerationImagePicker = null;
          generationImageProject = Panel.Context;
          generationPickerTag = string.Empty;
          generationTagMenuOpen = false;
          generationPickerFolder = null;
      }
      if (string.IsNullOrWhiteSpace(Panel.Context)) return;
      var assetsFolder = Path.Combine(Panel.Context, "assets");
      generationPickerRoot = Path.GetFullPath(assetsFolder);
      if (generationPickerFolder is null || !IsInsideGenerationPicker(generationPickerFolder) || !Directory.Exists(generationPickerFolder))
          generationPickerFolder = generationPickerRoot;
      if (!Directory.Exists(assetsFolder)) return;
      try
      {
          generationImages = Directory.EnumerateFiles(assetsFolder, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).Where(path => Path.GetExtension(path).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp")
              .Select(path => Path.GetRelativePath(Panel.Context, path).Replace('\\', '/'))
              .OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToList();
      }
      catch { generationImages = []; }
      generationImagePaths = generationImages.ToHashSet(StringComparer.OrdinalIgnoreCase);
      if (openGenerationImagePicker is not null) RefreshGenerationPicker();
  }
  private void RefreshGenerationPicker()
  {
      generationPickerEntries = [];
      generationPickerTags = [];
      if (generationPickerFolder is null || Panel.Context is null || !Directory.Exists(generationPickerFolder) ||
          !IsInsideGenerationPicker(generationPickerFolder)) return;
      try
      {
          var imageFiles = Directory.EnumerateFiles(generationPickerFolder, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).Where(IsGenerationImage).ToList();
          var taggedImages = imageFiles.Select(path => (Path: path, Tags: ReadAssetTags(path, Panel.Context))).ToList();
          generationPickerTags = taggedImages.SelectMany(item => item.Tags)
              .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase).ToList();
          if (generationPickerTag.Length > 0 && !generationPickerTags.Contains(generationPickerTag, StringComparer.OrdinalIgnoreCase))
              generationPickerTag = string.Empty;
          IEnumerable<string> paths = generationPickerTag.Length > 0
              ? taggedImages.Where(item => item.Tags.Contains(generationPickerTag, StringComparer.OrdinalIgnoreCase)).Select(item => item.Path)
              : Directory.EnumerateFileSystemEntries(generationPickerFolder)
                  .Where(path => Directory.Exists(path) || IsGenerationImage(path));
          generationPickerEntries = paths.OrderBy(path => !Directory.Exists(path))
              .ThenBy(Path.GetFileName, StringComparer.OrdinalIgnoreCase)
              .Select(path => new GenerationPickerEntry(path, Path.GetRelativePath(Panel.Context, path).Replace('\\', '/'), Directory.Exists(path)))
              .ToList();
      }
      catch { generationPickerEntries = []; generationPickerTags = []; }
  }
  private static bool IsGenerationImage(string path) => Path.GetExtension(path).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
  private sealed record GenerationPickerEntry(string FullPath, string RelativePath, bool IsDirectory);
  private bool CanNavigateUp => !string.Equals(currentAssetsPath, assetsRoot, StringComparison.OrdinalIgnoreCase);
  private string ParentAssetsPath => CanNavigateUp ? Directory.GetParent(currentAssetsPath)?.FullName ?? assetsRoot! : currentAssetsPath;
  private void ToggleAssetTagMenu() => assetTagMenuOpen = !assetTagMenuOpen;
  private void SetAssetTagFilter(string tag)
  {
      selectedTag = tag;
      assetTagMenuOpen = false;
      LoadAssets();
  }
  private void LoadAssets()
  {
      try
      {
          var files = Directory.EnumerateFiles(currentAssetsPath, "*", new EnumerationOptions
          {
              RecurseSubdirectories = true,
              IgnoreInaccessible = true
          }).ToList();
          var taggedFiles = files.Select(path => (Path: path, Tags: ReadAssetTags(path, Directory.GetParent(assetsRoot!)!.FullName))).ToList();
          availableTags = taggedFiles.SelectMany(file => file.Tags)
              .Distinct(StringComparer.OrdinalIgnoreCase)
              .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
              .ToList();
          if (selectedTag.Length > 0 && !availableTags.Contains(selectedTag, StringComparer.OrdinalIgnoreCase))
              selectedTag = string.Empty;
          if (selectedTag.Length > 0)
          {
              assetEntries = taggedFiles.Where(file => file.Tags.Contains(selectedTag, StringComparer.OrdinalIgnoreCase))
                  .OrderBy(file => Path.GetFileName(file.Path), StringComparer.OrdinalIgnoreCase)
                  .Select(file =>
                  {
                      var entry = CreateAssetEntry(file.Path);
                      var folder = Path.GetRelativePath(currentAssetsPath, Path.GetDirectoryName(file.Path)!);
                      return folder == "." ? entry : entry with { Detail = $"{folder.Replace('\\', '/')} · {entry.Detail}" };
                  }).ToList();
          }
          else
          {
              assetEntries = Directory.EnumerateFileSystemEntries(currentAssetsPath)
                  .OrderBy(path => !Directory.Exists(path))
                  .ThenBy(Path.GetFileName, StringComparer.OrdinalIgnoreCase)
                  .Select(CreateAssetEntry).ToList();
          }
      }
      catch { availableTags = []; assetEntries = []; }
  }
  private static IReadOnlyList<string> ReadAssetTags(string assetPath, string projectFolder)
  {
      try
      {
          var relativePath = Path.GetRelativePath(projectFolder, assetPath).Replace('\\', '/');
          var metadataName = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativePath))).ToLowerInvariant() + ".json";
          var metadataPath = Path.Combine(projectFolder, metadataName);
          if (!File.Exists(metadataPath)) return [];
          using var metadata = System.Text.Json.JsonDocument.Parse(File.ReadAllText(metadataPath));
          if (!metadata.RootElement.TryGetProperty("tags", out var tags) || tags.ValueKind != System.Text.Json.JsonValueKind.Array) return [];
          return tags.EnumerateArray()
              .Where(tag => tag.ValueKind == System.Text.Json.JsonValueKind.String)
              .Select(tag => tag.GetString()?.Trim() ?? string.Empty)
              .Where(tag => tag.Length > 0)
              .ToList();
      }
      catch { return []; }
  }
  private AssetEntry CreateAssetEntry(string path)
  {
      var isDirectory = Directory.Exists(path);
      if (!isDirectory) EnsureAssetMetadata(path);
      return new AssetEntry(Path.GetFileName(path), isDirectory, isDirectory ? "Folder" : $"{new FileInfo(path).Length:N0} bytes", isDirectory ? null : CreateThumbnail(path), path);
  }
  private void EnsureAssetMetadata(string assetPath)
  {
      try
      {
          var projectFolder = Directory.GetParent(assetsRoot!)!.FullName;
          var relativeAssetPath = Path.GetRelativePath(projectFolder, assetPath).Replace('\\', '/');
          var metadataFileName = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativeAssetPath))).ToLowerInvariant() + ".json";
          var metadataPath = Path.Combine(projectFolder, metadataFileName);
          if (File.Exists(metadataPath)) return;
          var metadata = new { asset = relativeAssetPath, name = Path.GetFileName(assetPath), tags = Array.Empty<string>() };
          File.WriteAllText(metadataPath, System.Text.Json.JsonSerializer.Serialize(metadata));
      }
      catch { }
  }
  private void LoadAssetDetails()
  {
      if (!string.Equals(dimensionsForPath, Panel.Context, StringComparison.OrdinalIgnoreCase))
      {
          assetDimensions = null;
          dimensionsForPath = Panel.Context;
          newTag = string.Empty;
          tagStatus = string.Empty;
      }
      assetName = Path.GetFileName(Panel.Context) ?? "Asset";
      assetImage = null;
      assetTags = [];
      assetMetadataPath = null;
      assetProjectFolder = null;
      projectTags = [];
      if (string.IsNullOrWhiteSpace(Panel.Context) || string.IsNullOrWhiteSpace(Panel.Location) || !File.Exists(Panel.Context)) return;
      try
      {
          assetsRoot = Panel.Location;
          EnsureAssetMetadata(Panel.Context);
          assetImage = CreateImageSource(Panel.Context);
          var projectFolder = Directory.GetParent(Panel.Location)!.FullName;
          assetProjectFolder = projectFolder;
          var relativePath = Path.GetRelativePath(projectFolder, Panel.Context).Replace('\\', '/');
          var metadataName = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativePath))).ToLowerInvariant() + ".json";
          assetMetadataPath = Path.Combine(projectFolder, metadataName);
          if (File.Exists(assetMetadataPath))
          {
              using var metadata = System.Text.Json.JsonDocument.Parse(File.ReadAllText(assetMetadataPath));
              if (metadata.RootElement.TryGetProperty("tags", out var tags) && tags.ValueKind == System.Text.Json.JsonValueKind.Array)
                  assetTags = tags.EnumerateArray()
                      .Where(tag => tag.ValueKind == System.Text.Json.JsonValueKind.String)
                      .Select(tag => tag.GetString()?.Trim() ?? string.Empty)
                      .Where(tag => tag.Length > 0)
                      .Distinct(StringComparer.OrdinalIgnoreCase)
                      .ToList();
          }
          projectTags = ProjectLibrary.GetProjectTags(projectFolder);
      }
      catch { tagStatus = "Tags could not be read."; }
  }
  private async Task AddTag()
  {
      var enteredTag = newTag.Trim();
      var tag = projectTags.FirstOrDefault(existing => string.Equals(existing, enteredTag, StringComparison.OrdinalIgnoreCase)) ?? enteredTag;
      if (tag.Length == 0) { tagStatus = "Enter a tag."; return; }
      if (tag.Length > 64) { tagStatus = "Tags must be 64 characters or fewer."; return; }
      if (assetTags.Contains(tag, StringComparer.OrdinalIgnoreCase)) { tagStatus = "This tag is already assigned."; return; }
      if (await SaveTags(assetTags.Append(tag).ToList())) newTag = string.Empty;
  }
  private Task HandleTagKeyDown(KeyboardEventArgs args) => args.Key == "Enter" ? AddTag() : Task.CompletedTask;
  private Task RemoveTag(string tag) => SaveTags(assetTags.Where(existing => !string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)).ToList());
  private async Task<bool> SaveTags(List<string> tags)
  {
      if (string.IsNullOrWhiteSpace(assetMetadataPath)) { tagStatus = "Asset metadata is unavailable."; return false; }
      try
      {
          var metadata = JsonNode.Parse(await File.ReadAllTextAsync(assetMetadataPath)) as JsonObject
              ?? throw new InvalidOperationException("The asset metadata is invalid.");
          metadata["tags"] = System.Text.Json.JsonSerializer.SerializeToNode(tags);
          await File.WriteAllTextAsync(assetMetadataPath, metadata.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
          assetTags = tags;
          tagStatus = string.Empty;
          if (assetProjectFolder is not null)
          {
              try
              {
                  foreach (var tag in tags) ProjectLibrary.RegisterProjectTag(assetProjectFolder, tag);
                  projectTags = ProjectLibrary.GetProjectTags(assetProjectFolder);
              }
              catch (Exception ex) { tagStatus = $"Tags saved, but project suggestions could not be updated: {ex.Message}"; }
          }
          return true;
      }
      catch (Exception ex)
      {
          tagStatus = $"Could not save tags: {ex.Message}";
          return false;
      }
  }
  private static string? CreateThumbnail(string path)
  {
      var extension = Path.GetExtension(path).ToLowerInvariant();
      var mimeType = extension switch { ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", _ => null };
      var info = new FileInfo(path);
      if (mimeType is null || info.Length > 8 * 1024 * 1024) return null;
      try { return $"data:{mimeType};base64,{Convert.ToBase64String(File.ReadAllBytes(path))}"; }
      catch { return null; }
  }
  private static string? CreateImageSource(string path)
  {
      var extension = Path.GetExtension(path).ToLowerInvariant();
      var mimeType = extension switch { ".jpg" or ".jpeg" => "image/jpeg", ".png" => "image/png", ".gif" => "image/gif", ".webp" => "image/webp", _ => null };
      if (mimeType is null) return null;
      try { return $"data:{mimeType};base64,{Convert.ToBase64String(File.ReadAllBytes(path))}"; }
      catch { return null; }
  }
  private sealed record AssetEntry(string Name, bool IsDirectory, string Detail, string? Thumbnail, string Path);
}
