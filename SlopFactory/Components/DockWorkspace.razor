      _ => null
  };
  private static bool IsGenerationImage(string path) => Path.GetExtension(path).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
  [JSInvokable]
  public async Task<string> CopyAsset(string sourcePath, string sourceRoot, string destinationFolder, string destinationRoot)
  {
      try
      {
          var source = Path.GetFullPath(sourcePath);
          var normalizedSourceRoot = NormalizeFolder(sourceRoot);
          var destination = NormalizeFolder(destinationFolder);
          var normalizedDestinationRoot = NormalizeFolder(destinationRoot);
          if (!IsInFolder(source, normalizedSourceRoot) || !IsInFolder(destination, normalizedDestinationRoot) || (!File.Exists(source) && !Directory.Exists(source)))
              return JsonSerializer.Serialize(new { success = false, message = "The source or destination assets folder is not available." }, WorkflowJsonOptions);

          var sourceParent = NormalizeFolder(Path.GetDirectoryName(source)!);
          if (string.Equals(sourceParent, destination, StringComparison.OrdinalIgnoreCase))
              return JsonSerializer.Serialize(new { success = true, message = "That asset is already in this folder." }, WorkflowJsonOptions);
          if (Directory.Exists(source) && IsInFolder(destination, source))
              return JsonSerializer.Serialize(new { success = false, message = "A folder cannot be copied into itself." }, WorkflowJsonOptions);

          var target = UniqueAssetPath(destination, Path.GetFileName(source), Directory.Exists(source));
          if (Directory.Exists(source)) CopyDirectory(source, target);
          else File.Copy(source, target);
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true, message = $"Copied {Path.GetFileName(source)}." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> OpenAssetDetails(string assetPath, string assetsRoot, string sourcePaneId)
  {
      try
      {
          var asset = Path.GetFullPath(assetPath);
          var root = NormalizeFolder(assetsRoot);
          if (!File.Exists(asset) || !IsInFolder(asset, root))
              return JsonSerializer.Serialize(new { success = false, message = "The asset is not available." }, WorkflowJsonOptions);
          var existingDetails = FindAssetDetails(Root, sourcePaneId);
          if (existingDetails is not null)
          {
              Root = UpdateAssetDetails(Root, existingDetails.Id, asset, root);
          }
          else
          {
              added++;
              var detailsPane = new DockPane($"asset-details{added}", $"Asset · {Path.GetFileName(asset)}", "◉", "mint", "asset-details", asset, root, sourcePaneId);
              var relatedMask = FindRelatedMaskPane(Root, sourcePaneId, root);
              if (relatedMask is not null && relatedMask.Owner is null)
                  Root = SetPaneOwner(Root, relatedMask.Id, sourcePaneId);
              Root = relatedMask is not null
                  ? AddPaneAfter(Root, relatedMask.Id, detailsPane)
                  : ContainsPane(Root, sourcePaneId) ? DockDetailsRightOfPane(Root, sourcePaneId, detailsPane) : AddToFirstGroup(Root, detailsPane);
          }
          Root = CollapseEmptyGroups(Root) ?? BuildTree();
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> OpenMaskEditor(string assetPath, string assetsRoot, string sourcePaneId)
  {
      try
      {
          var asset = Path.GetFullPath(assetPath);
          var root = NormalizeFolder(assetsRoot);
          var project = FindRegisteredProject(Directory.GetParent(root)?.FullName);
          if (project is null || !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase) ||
              !File.Exists(asset) || !IsInFolder(asset, root) || !IsGenerationImage(asset))
              throw new InvalidOperationException("Choose an image in a registered project's assets folder.");
          var existing = FindMaskPane(Root, asset);
          if (existing is not null)
          {
              var source = FindPane(Root, sourcePaneId);
              var owner = source?.Kind == "asset-details" ? source.Owner : source?.Kind == "assets" ? sourcePaneId : null;
              if (owner is not null && existing.Owner is null)
                  Root = SetPaneOwner(Root, existing.Id, owner);
              Root = ActivatePane(Root, existing.Id);
          }
          else
          {
              added++;
              var source = FindPane(Root, sourcePaneId);
              var owner = source?.Kind == "asset-details" ? source.Owner : sourcePaneId;
              var maskPane = new DockPane($"mask{added}", $"Mask · {Path.GetFileName(asset)}", "◐", "violet", "mask-editor", asset, root, owner);
              if (source?.Kind == "asset-details")
              {
                  Root = AddPaneAfter(Root, sourcePaneId, maskPane);
              }
              else if (source?.Kind == "assets")
              {
                  var relatedPane = FindAssetDetails(Root, sourcePaneId) ?? FindRelatedMaskPane(Root, sourcePaneId, root);
                  if (relatedPane?.Kind == "mask-editor" && relatedPane.Owner is null)
                      Root = SetPaneOwner(Root, relatedPane.Id, sourcePaneId);
                  Root = relatedPane is not null
                      ? AddPaneAfter(Root, relatedPane.Id, maskPane)
                      : DockDetailsRightOfPane(Root, sourcePaneId, maskPane);
              }
              else
              {
                  Root = AddToFirstGroup(Root, maskPane);
              }
          }
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
