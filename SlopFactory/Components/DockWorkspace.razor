  [JSInvokable]
  public async Task TestComfyConnection(string serverUrl, string apiKey)
  {
      isTesting = true;
      connectionStatus = "";
      connectionStatusClass = "";
      await InvokeAsync(StateHasChanged);
      try
      {
          var testConnection = new ComfyConnectionSettings { ServerUrl = serverUrl, ApiKey = apiKey };
          var result = await ComfyConnectionTester.TestAsync(testConnection);
          connectionStatus = result.Message;
          connectionStatusClass = result.Succeeded ? "connection-success" : "connection-error";
      }
      finally
      {
          isTesting = false;
          await InvokeAsync(StateHasChanged);
      }
  }
  [JSInvokable]
  public async Task SaveComfyConnection(string serverUrl, string apiKey, string connectionKey)
  {
      if (!Uri.TryCreate(serverUrl, UriKind.Absolute, out var parsedServerUrl)
          || (!string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
              && !string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)))
      {
          connectionStatus = "Enter a valid ComfyUI API URL.";
          connectionStatusClass = "connection-error";
          await InvokeAsync(StateHasChanged);
          return;
      }

      connectionStatus = "Connection saved.";
      connectionStatusClass = "connection-success";
      await InvokeAsync(StateHasChanged);
  }
  [JSInvokable]
  public async Task SetCurrentComfyConnection(string serverUrl, string apiKey, string connectionId)
  {
      ComfyConnection.ServerUrl = serverUrl;
      ComfyConnection.ApiKey = apiKey;
      if (!Uri.TryCreate(ComfyConnection.ServerUrl, UriKind.Absolute, out var parsedServerUrl)
          || (!string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
              && !string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)))
      {
          connectionStatus = "Enter a valid ComfyUI API URL.";
          connectionStatusClass = "connection-error";
          await InvokeAsync(StateHasChanged);
          return;
      }

      ComfyConnection.ConnectionId = string.IsNullOrWhiteSpace(connectionId) ? serverUrl.Trim() : connectionId.Trim();
      await ComfyConnection.SaveAsync();
      connectionStatus = "Current connection saved.";
      connectionStatusClass = "connection-success";
      await InvokeAsync(StateHasChanged);
  }
  private Task ActivateTab(TabActivation activation)
  {
      Root = SetActiveTab(Root, activation.GroupId, activation.PanelId);
      return InvokeAsync(StateHasChanged);
  }
  private Task SelectGenerationWorkflow(GenerationWorkflowSelection selection)
  {
      if (!string.IsNullOrEmpty(selection.WorkflowId) && !WorkflowLibrary.GetAll().Any(workflow =>
          workflow.Id == selection.WorkflowId && !string.IsNullOrWhiteSpace(workflow.GraphFile)))
          return Task.CompletedTask;
      Root = UpdateGenerationPanel(Root, selection.PanelId, panel =>
          panel with { WorkflowId = selection.WorkflowId, InputValues = new Dictionary<string, string>() });
      return InvokeAsync(StateHasChanged);
  }
  private Task ChangeGenerationInput(GenerationInputChange change)
  {
      if (string.IsNullOrWhiteSpace(change.Name)) return Task.CompletedTask;
      Root = UpdateGenerationPanel(Root, change.PanelId, panel =>
      {
          var values = new Dictionary<string, string>(panel.InputValues ?? [], StringComparer.Ordinal);
          values[change.Name] = change.Value;
          return panel with { InputValues = values };
      });
      return InvokeAsync(StateHasChanged);
  }
  private static DockNode UpdateGenerationPanel(DockNode node, string panelId, Func<DockPanel, DockPanel> update) => node switch
  {
      TabGroupNode group when group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "generation")
          => group with
          {
              Panels = group.Panels.Select(panel => panel.Id == panelId ? update(panel) : panel).ToList(),
              ActiveId = panelId
          },
      SplitNode split => split with
      {
          First = UpdateGenerationPanel(split.First, panelId, update),
          Second = UpdateGenerationPanel(split.Second, panelId, update)
      },
      _ => node
  };
  [JSInvokable]
  public async Task ClosePanel(string panelId)
  {
      var remaining = RemovePanel(Root, panelId, out var removed);
      if (removed is null) return;
      Root = remaining is null ? BuildTree() : CollapseEmptyGroups(remaining) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode AddToFirstGroup(DockNode node, DockPanel panel) => node switch
  {
      TabGroupNode group => group with { Panels = group.Panels.Append(panel).ToList(), ActiveId = panel.Id },
      SplitNode split => split with { First = AddToFirstGroup(split.First, panel) },
      _ => node
  };
  private static DockNode SetActiveTab(DockNode node, string groupId, string panelId) => node switch
  {
      TabGroupNode group when group.Id == groupId && group.Panels.Any(panel => panel.Id == panelId)
          => group with { ActiveId = panelId },
      SplitNode split => split with
      {
          First = SetActiveTab(split.First, groupId, panelId),
          Second = SetActiveTab(split.Second, groupId, panelId)
      },
      _ => node
  };
  [JSInvokable("ApplyDockDrop")]
  public async Task DockPanel(string panelId, string targetGroupId, string zone)
  {
      var withoutSource = RemovePanel(Root, panelId, out var panel);
      if (panel is null || withoutSource is null) return;
      Root = CollapseEmptyGroups(InsertPanel(withoutSource, targetGroupId, panel, zone)) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  [JSInvokable("ApplyRootDockDrop")]
  public async Task DockAtRoot(string panelId, string edge)
  {
      var remaining = RemovePanel(Root, panelId, out var panel);
      if (remaining is null || panel is null) return;
      var incoming = new TabGroupNode($"group-{panel.Id}", [panel], panel.Id);
      Root = CollapseEmptyGroups(edge switch
      {
          "top" => new SplitNode($"root-top-{panel.Id}", DockAxis.Vertical, .25, incoming, remaining),
          "bottom" => new SplitNode($"root-bottom-{panel.Id}", DockAxis.Vertical, .75, remaining, incoming),
          "left" => new SplitNode($"root-left-{panel.Id}", DockAxis.Horizontal, .25, incoming, remaining),
          _ => new SplitNode($"root-right-{panel.Id}", DockAxis.Horizontal, .75, remaining, incoming)
      }) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode? RemovePanel(DockNode node, string panelId, out DockPanel? removed)
  {
      removed = null;
      if (node is TabGroupNode group)
      {
          var removedIndex = group.Panels.ToList().FindIndex(panel => panel.Id == panelId);
          if (removedIndex < 0) return group;
          removed = group.Panels[removedIndex];
          var remaining = group.Panels.Where(panel => panel.Id != panelId).ToList();
          if (remaining.Count == 0) return null;
          var activeId = remaining.Any(panel => panel.Id == group.ActiveId)
              ? group.ActiveId
              : remaining[Math.Min(removedIndex, remaining.Count - 1)].Id;
          return group with { Panels = remaining, ActiveId = activeId };
      }
      var split = (SplitNode)node;
      var first = RemovePanel(split.First, panelId, out removed);
      if (removed is not null) return first is null ? split.Second : split with { First = first };
      var second = RemovePanel(split.Second, panelId, out removed);
      return second is null ? split.First : split with { Second = second };
  }
  private static DockNode? CollapseEmptyGroups(DockNode node) => node switch
  {
      TabGroupNode group => group.Panels.Count == 0 ? null : group,
      SplitNode split => CollapseSplit(split),
      _ => node
  };
  private static DockNode? CollapseSplit(SplitNode split)
  {
      var first = CollapseEmptyGroups(split.First);
      var second = CollapseEmptyGroups(split.Second);
      return first is null ? second : second is null ? first : split with { First = first, Second = second };
  }
  private static DockNode InsertPanel(DockNode node, string groupId, DockPanel panel, string zone)
  {
      if (node is TabGroupNode group)
      {
          if (group.Id != groupId) return group;
          if (zone == "stack") return group with { Panels = group.Panels.Append(panel).ToList(), ActiveId = panel.Id };
          var incoming = new TabGroupNode($"group-{panel.Id}", [panel], panel.Id);
          var axis = zone is "left" or "right" ? DockAxis.Horizontal : DockAxis.Vertical;
          return zone is "left" or "top"
              ? new SplitNode($"split-{panel.Id}", axis, .5, incoming, group)
              : new SplitNode($"split-{panel.Id}", axis, .5, group, incoming);
      }
      var split = (SplitNode)node;
      return split with { First = InsertPanel(split.First, groupId, panel, zone), Second = InsertPanel(split.Second, groupId, panel, zone) };
  }
  [JSInvokable]
  public Task SetSplitRatio(string splitId, double ratio)
  {
      if (string.IsNullOrWhiteSpace(splitId) || !double.IsFinite(ratio)) return Task.CompletedTask;
      Root = UpdateSplitRatio(Root, splitId, Math.Clamp(ratio, .22, .78));
      return InvokeAsync(StateHasChanged);
  }
  private static DockNode UpdateSplitRatio(DockNode node, string splitId, double ratio) => node switch
  {
      SplitNode split when split.Id == splitId => split with { Ratio = ratio },
      SplitNode split => split with
      {
          First = UpdateSplitRatio(split.First, splitId, ratio),
          Second = UpdateSplitRatio(split.Second, splitId, ratio)
      },
      _ => node
  };
  private DockNode? RestoreWorkspace(DockNode? node)
  {
      if (node is TabGroupNode group)
      {
          var panels = (group.Panels ?? []).Select(RestorePanel).OfType<DockPanel>()
              .DistinctBy(panel => panel.Id).ToList();
          if (panels.Count == 0) return null;
          var activeId = panels.Any(panel => panel.Id == group.ActiveId) ? group.ActiveId : panels[0].Id;
          return group with { Id = string.IsNullOrWhiteSpace(group.Id) ? $"group-{Guid.NewGuid():N}" : group.Id,
              Panels = panels, ActiveId = activeId };
      }
      if (node is SplitNode split)
      {
          var first = RestoreWorkspace(split.First);
          var second = RestoreWorkspace(split.Second);
          if (first is null) return second;
          if (second is null) return first;
          return split with { First = first, Second = second,
              Ratio = double.IsFinite(split.Ratio) ? Math.Clamp(split.Ratio, .22, .78) : .5 };
      }
      return null;
  }
  private DockPanel? RestorePanel(DockPanel panel)
  {
      if (string.IsNullOrWhiteSpace(panel.Id)) return null;
      try
      {
          if (panel.Kind == "assets")
          {
              if (string.IsNullOrWhiteSpace(panel.Context))
                  return panel with { Title = "Assets", Context = null, Location = null };
              var root = NormalizeFolder(panel.Context);
              var projectFolder = Directory.GetParent(root)?.FullName;
              var project = FindRegisteredProject(projectFolder);
              if (project is null || !Directory.Exists(root) ||
                  !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase))
                  return panel with { Title = "Assets", Context = null, Location = null };
              var location = string.IsNullOrWhiteSpace(panel.Location) ? root : NormalizeFolder(panel.Location);
              if (!IsInFolder(location, root) || !Directory.Exists(location)) location = root;
              return panel with { Title = $"Assets · {project.DisplayName}", Context = root, Location = location };
          }
          if (panel.Kind == "generation")
          {
              var project = FindRegisteredProject(panel.Context);
              return project is null
                  ? panel with { Title = "Generation", Context = null, Location = null }
                  : panel with { Title = $"Generation · {project.DisplayName}", Context = project.FolderPath };
          }
          if (panel.Kind == "asset-details")
          {
              if (string.IsNullOrWhiteSpace(panel.Context) || string.IsNullOrWhiteSpace(panel.Location)) return null;
              var root = NormalizeFolder(panel.Location);
              var project = FindRegisteredProject(Directory.GetParent(root)?.FullName);
              var asset = Path.GetFullPath(panel.Context);
              if (project is null || !File.Exists(asset) || !IsInFolder(asset, root) ||
                  !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase)) return null;
              return panel with { Title = $"Asset · {Path.GetFileName(asset)}", Context = asset, Location = root };
          }
      }
      catch (Exception ex) when (ex is ArgumentException or IOException or UnauthorizedAccessException or NotSupportedException)
      {
          return panel.Kind is "assets" or "generation" ? panel with { Title = panel.Kind == "assets" ? "Assets" : "Generation", Context = null, Location = null } : null;
      }
      return null;
  }
  private ProjectDefinition? FindRegisteredProject(string? folderPath) =>
      string.IsNullOrWhiteSpace(folderPath) ? null : ProjectLibrary.GetAll().FirstOrDefault(project =>
          string.Equals(project.FolderPath, folderPath, StringComparison.OrdinalIgnoreCase) && Directory.Exists(project.FolderPath));
  private static int MaximumPanelNumber(DockNode node) => node switch
  {
      TabGroupNode group => group.Panels.Select(panel =>
      {
          var digits = new string(panel.Id.Reverse().TakeWhile(char.IsDigit).Reverse().ToArray());
          return int.TryParse(digits, out var number) ? number : 0;
      }).DefaultIfEmpty().Max(),
      SplitNode split => Math.Max(MaximumPanelNumber(split.First), MaximumPanelNumber(split.Second)),
      _ => 0
  };
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
      if (firstRender)
      {
          dockReference = DotNetObjectReference.Create(this);
          await JS.InvokeVoidAsync("recursiveDock.setReference", dockReference);
      }
      if (!workspaceLoaded) return;
      if (ReferenceEquals(savedRoot, Root)) return;
      try
      {
          WorkspaceLayoutStore.Save(Root);
          savedRoot = Root;
      }
      catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
      {
          System.Diagnostics.Debug.WriteLine($"Could not save workspace layout: {ex}");
      }
  }
  public void Dispose() => dockReference?.Dispose();
