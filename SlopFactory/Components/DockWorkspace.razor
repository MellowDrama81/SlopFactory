      TabGroupNode group => group.Panes.FirstOrDefault(pane => pane.Kind == "mask-editor" && string.Equals(pane.Context, assetPath, StringComparison.OrdinalIgnoreCase)),
      SplitNode split => FindMaskPane(split.First, assetPath) ?? FindMaskPane(split.Second, assetPath),
      _ => null
  };
  private static DockPane? FindOwnedMaskPane(DockNode node, string assetsPaneId) => node switch
  {
      TabGroupNode group => group.Panes.FirstOrDefault(pane => pane.Kind == "mask-editor" && pane.Owner == assetsPaneId),
      SplitNode split => FindOwnedMaskPane(split.First, assetsPaneId) ?? FindOwnedMaskPane(split.Second, assetsPaneId),
      _ => null
  };
  private static DockPane? FindRelatedMaskPane(DockNode node, string assetsPaneId, string assetsRoot)
      => FindOwnedMaskPane(node, assetsPaneId) ??
          (CountAssetsPanesForRoot(node, assetsRoot) == 1 ? FindUnownedMaskPane(node, assetsRoot) : null);
  private static DockPane? FindUnownedMaskPane(DockNode node, string assetsRoot) => node switch
  {
      TabGroupNode group => group.Panes.FirstOrDefault(pane => pane.Kind == "mask-editor" && pane.Owner is null &&
          string.Equals(pane.Location, assetsRoot, StringComparison.OrdinalIgnoreCase)),
      SplitNode split => FindUnownedMaskPane(split.First, assetsRoot) ?? FindUnownedMaskPane(split.Second, assetsRoot),
      _ => null
  };
  private static int CountAssetsPanesForRoot(DockNode node, string assetsRoot) => node switch
  {
      TabGroupNode group => group.Panes.Count(pane => pane.Kind == "assets" &&
          string.Equals(pane.Context, assetsRoot, StringComparison.OrdinalIgnoreCase)),
      SplitNode split => CountAssetsPanesForRoot(split.First, assetsRoot) + CountAssetsPanesForRoot(split.Second, assetsRoot),
      _ => 0
  };
  private static DockNode SetPaneOwner(DockNode node, string paneId, string owner) => node switch
