  [JSInvokable]
  public async Task SaveComfyConnection(string serverUrl, string apiKey, string connectionKey)
  {
      if (!Uri.TryCreate(serverUrl, UriKind.Absolute, out var parsedServerUrl)
          || (!string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
              && !string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)))
      {
          connectionStatus = "Enter a valid ComfyUI API URL.";
          connectionStatusClass = "connection-error";
          await InvokeAsync(StateHasChanged);
          return;
      }

      connectionStatus = "Connection saved.";
      connectionStatusClass = "connection-success";
      await InvokeAsync(StateHasChanged);
  }
  [JSInvokable]
  public async Task SetCurrentComfyConnection(string serverUrl, string apiKey, string connectionId)
  {
      ComfyConnection.ServerUrl = serverUrl;
      ComfyConnection.ApiKey = apiKey;
      if (!Uri.TryCreate(ComfyConnection.ServerUrl, UriKind.Absolute, out var parsedServerUrl)
          || (!string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
              && !string.Equals(parsedServerUrl.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)))
      {
          connectionStatus = "Enter a valid ComfyUI API URL.";
          connectionStatusClass = "connection-error";
          await InvokeAsync(StateHasChanged);
          return;
      }

      ComfyConnection.ConnectionId = string.IsNullOrWhiteSpace(connectionId) ? serverUrl.Trim() : connectionId.Trim();
      await ComfyConnection.SaveAsync();
      connectionStatus = "Current connection saved.";
      connectionStatusClass = "connection-success";
      await InvokeAsync(StateHasChanged);
  }
  private Task ActivateTab(TabActivation activation)
  {
      Root = SetActiveTab(Root, activation.GroupId, activation.PaneId);
      return InvokeAsync(StateHasChanged);
  }
  private Task SelectGenerationWorkflow(GenerationWorkflowSelection selection)
  {
      if (!string.IsNullOrEmpty(selection.WorkflowId) && !WorkflowLibrary.GetAll().Any(workflow =>
          workflow.Id == selection.WorkflowId && !string.IsNullOrWhiteSpace(workflow.GraphFile)))
          return Task.CompletedTask;
      Root = UpdateGenerationPane(Root, selection.PaneId, pane =>
          pane with { WorkflowId = selection.WorkflowId, InputValues = new Dictionary<string, string>() });
      return InvokeAsync(StateHasChanged);
  }
  private Task ChangeGenerationInput(GenerationInputChange change)
  {
      if (string.IsNullOrWhiteSpace(change.Name)) return Task.CompletedTask;
      Root = UpdateGenerationPane(Root, change.PaneId, pane =>
      {
          var values = new Dictionary<string, string>(pane.InputValues ?? [], StringComparer.Ordinal);
          values[change.Name] = change.Value;
          return pane with { InputValues = values };
      });
      return InvokeAsync(StateHasChanged);
  }
  private Task ChangeGenerationOutputFolder(GenerationOutputFolderChange change)
  {
      Root = UpdateGenerationPane(Root, change.PaneId, pane => pane with
      {
          OutputFolder = string.IsNullOrWhiteSpace(change.Folder) ? null : change.Folder.Trim()
      });
      return InvokeAsync(StateHasChanged);
  }
  private Task ChangeGenerationOutputTags(GenerationOutputTagsChange change)
  {
      Root = UpdateGenerationPane(Root, change.PaneId, pane => pane with { OutputTags = change.Tags.ToList() });
      return InvokeAsync(StateHasChanged);
  }
  private static DockNode UpdateGenerationPane(DockNode node, string paneId, Func<DockPane, DockPane> update) => node switch
  {
      TabGroupNode group when group.Panes.Any(pane => pane.Id == paneId && pane.Kind == "generation")
          => group with
          {
              Panes = group.Panes.Select(pane => pane.Id == paneId ? update(pane) : pane).ToList(),
              ActiveId = paneId
          },
      SplitNode split => split with
      {
          First = UpdateGenerationPane(split.First, paneId, update),
          Second = UpdateGenerationPane(split.Second, paneId, update)
      },
      _ => node
  };
  [JSInvokable]
  public async Task ClosePane(string paneId)
  {
      var remaining = RemovePane(Root, paneId, out var removed);
      if (removed is null) return;
      Root = remaining is null ? BuildTree() : CollapseEmptyGroups(remaining) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode AddToFirstGroup(DockNode node, DockPane pane) => node switch
  {
      TabGroupNode group => group with { Panes = group.Panes.Append(pane).ToList(), ActiveId = pane.Id },
      SplitNode split => split with { First = AddToFirstGroup(split.First, pane) },
      _ => node
  };
  private static DockNode AddPaneAfter(DockNode node, string sourcePaneId, DockPane pane) => node switch
  {
      TabGroupNode group when group.Panes.Any(item => item.Id == sourcePaneId) => InsertAfter(group, sourcePaneId, pane),
      SplitNode split => split with { First = AddPaneAfter(split.First, sourcePaneId, pane), Second = AddPaneAfter(split.Second, sourcePaneId, pane) },
      _ => node
  };
  private static TabGroupNode InsertAfter(TabGroupNode group, string sourcePaneId, DockPane pane)
  {
      var panes = group.Panes.ToList();
      panes.Insert(panes.FindIndex(item => item.Id == sourcePaneId) + 1, pane);
      return group with { Panes = panes, ActiveId = pane.Id };
  }
  private static DockNode SetActiveTab(DockNode node, string groupId, string paneId) => node switch
  {
      TabGroupNode group when group.Id == groupId && group.Panes.Any(pane => pane.Id == paneId)
          => group with { ActiveId = paneId },
      SplitNode split => split with
      {
          First = SetActiveTab(split.First, groupId, paneId),
          Second = SetActiveTab(split.Second, groupId, paneId)
      },
      _ => node
  };
  [JSInvokable("ApplyDockDrop")]
  public async Task DockPane(string paneId, string targetGroupId, string zone)
  {
      var withoutSource = RemovePane(Root, paneId, out var pane);
      if (pane is null || withoutSource is null) return;
      Root = CollapseEmptyGroups(InsertPane(withoutSource, targetGroupId, pane, zone)) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  [JSInvokable("ApplyRootDockDrop")]
  public async Task DockAtRoot(string paneId, string edge)
  {
      var remaining = RemovePane(Root, paneId, out var pane);
      if (remaining is null || pane is null) return;
      var incoming = new TabGroupNode($"group-{pane.Id}", [pane], pane.Id);
      Root = CollapseEmptyGroups(edge switch
      {
          "top" => new SplitNode($"root-top-{pane.Id}", DockAxis.Vertical, .25, incoming, remaining),
          "bottom" => new SplitNode($"root-bottom-{pane.Id}", DockAxis.Vertical, .75, remaining, incoming),
          "left" => new SplitNode($"root-left-{pane.Id}", DockAxis.Horizontal, .25, incoming, remaining),
          _ => new SplitNode($"root-right-{pane.Id}", DockAxis.Horizontal, .75, remaining, incoming)
      }) ?? BuildTree();
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode? RemovePane(DockNode node, string paneId, out DockPane? removed)
  {
      removed = null;
      if (node is TabGroupNode group)
      {
          var removedIndex = group.Panes.ToList().FindIndex(pane => pane.Id == paneId);
          if (removedIndex < 0) return group;
          removed = group.Panes[removedIndex];
          var remaining = group.Panes.Where(pane => pane.Id != paneId).ToList();
          if (remaining.Count == 0) return null;
          var activeId = remaining.Any(pane => pane.Id == group.ActiveId)
              ? group.ActiveId
              : remaining[Math.Min(removedIndex, remaining.Count - 1)].Id;
          return group with { Panes = remaining, ActiveId = activeId };
      }
      var split = (SplitNode)node;
      var first = RemovePane(split.First, paneId, out removed);
      if (removed is not null) return first is null ? split.Second : split with { First = first };
      var second = RemovePane(split.Second, paneId, out removed);
      return second is null ? split.First : split with { Second = second };
  }
  private static DockNode? CollapseEmptyGroups(DockNode node) => node switch
  {
      TabGroupNode group => group.Panes.Count == 0 ? null : group,
      SplitNode split => CollapseSplit(split),
      _ => node
  };
  private static DockNode? CollapseSplit(SplitNode split)
  {
      var first = CollapseEmptyGroups(split.First);
      var second = CollapseEmptyGroups(split.Second);
      return first is null ? second : second is null ? first : split with { First = first, Second = second };
  }
  private static DockNode InsertPane(DockNode node, string groupId, DockPane pane, string zone)
  {
      if (node is TabGroupNode group)
      {
          if (group.Id != groupId) return group;
          if (zone == "stack") return group with { Panes = group.Panes.Append(pane).ToList(), ActiveId = pane.Id };
          var incoming = new TabGroupNode($"group-{pane.Id}", [pane], pane.Id);
          var axis = zone is "left" or "right" ? DockAxis.Horizontal : DockAxis.Vertical;
          return zone is "left" or "top"
              ? new SplitNode($"split-{pane.Id}", axis, .5, incoming, group)
              : new SplitNode($"split-{pane.Id}", axis, .5, group, incoming);
      }
      var split = (SplitNode)node;
      return split with { First = InsertPane(split.First, groupId, pane, zone), Second = InsertPane(split.Second, groupId, pane, zone) };
  }
  [JSInvokable]
  public Task SetSplitRatio(string splitId, double ratio)
  {
      if (string.IsNullOrWhiteSpace(splitId) || !double.IsFinite(ratio)) return Task.CompletedTask;
      Root = UpdateSplitRatio(Root, splitId, Math.Clamp(ratio, .22, .78));
      return InvokeAsync(StateHasChanged);
  }
  private static DockNode UpdateSplitRatio(DockNode node, string splitId, double ratio) => node switch
  {
      SplitNode split when split.Id == splitId => split with { Ratio = ratio },
      SplitNode split => split with
      {
          First = UpdateSplitRatio(split.First, splitId, ratio),
          Second = UpdateSplitRatio(split.Second, splitId, ratio)
      },
      _ => node
  };
  private DockNode? RestoreWorkspace(DockNode? node)
  {
      if (node is TabGroupNode group)
      {
          var panes = (group.Panes ?? []).Select(RestorePane).OfType<DockPane>()
              .DistinctBy(pane => pane.Id).ToList();
          if (panes.Count == 0) return null;
          var activeId = panes.Any(pane => pane.Id == group.ActiveId) ? group.ActiveId : panes[0].Id;
          return group with { Id = string.IsNullOrWhiteSpace(group.Id) ? $"group-{Guid.NewGuid():N}" : group.Id,
              Panes = panes, ActiveId = activeId };
      }
      if (node is SplitNode split)
      {
          var first = RestoreWorkspace(split.First);
          var second = RestoreWorkspace(split.Second);
          if (first is null) return second;
          if (second is null) return first;
          return split with { First = first, Second = second,
              Ratio = double.IsFinite(split.Ratio) ? Math.Clamp(split.Ratio, .22, .78) : .5 };
      }
      return null;
  }
  private DockPane? RestorePane(DockPane pane)
  {
      if (string.IsNullOrWhiteSpace(pane.Id)) return null;
      try
      {
          if (pane.Kind == "assets")
          {
              if (string.IsNullOrWhiteSpace(pane.Context))
                  return pane with { Title = "Assets", Context = null, Location = null };
              var root = NormalizeFolder(pane.Context);
              var projectFolder = Directory.GetParent(root)?.FullName;
              var project = FindRegisteredProject(projectFolder);
              if (project is null || !Directory.Exists(root) ||
                  !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase))
                  return pane with { Title = "Assets", Context = null, Location = null };
              var location = string.IsNullOrWhiteSpace(pane.Location) ? root : NormalizeFolder(pane.Location);
              if (!IsInFolder(location, root) || !Directory.Exists(location)) location = root;
              return pane with { Title = $"Assets · {project.DisplayName}", Context = root, Location = location };
          }
          if (pane.Kind == "generation")
          {
              var project = FindRegisteredProject(pane.Context);
              return project is null
                  ? pane with { Title = "Generation", Context = null, Location = null, OutputFolder = null, OutputTags = null }
                  : pane with { Title = $"Generation · {project.DisplayName}", Context = project.FolderPath };
          }
          if (pane.Kind == "panel-editor")
          {
              var project = FindRegisteredProject(pane.Context);
              if (project is null) return pane with { Title = "Panel", Context = null, Location = null };
              if (string.IsNullOrWhiteSpace(pane.Location))
                  return pane with { Title = $"Panel · {project.DisplayName}", Context = project.FolderPath, Location = null };
              try
              {
                  var panel = PanelStore.Load(project.FolderPath, pane.Location);
                  return pane with { Title = $"Panel · {panel.Name}", Context = project.FolderPath, Location = panel.Id };
              }
              catch
              {
                  // Keep the editor open so it can report the file problem and offer a new Panel.
                  return pane with { Title = $"Panel · {project.DisplayName}", Context = project.FolderPath };
              }
          }
          if (pane.Kind == "asset-details")
          {
              if (string.IsNullOrWhiteSpace(pane.Context) || string.IsNullOrWhiteSpace(pane.Location)) return null;
              var root = NormalizeFolder(pane.Location);
              var project = FindRegisteredProject(Directory.GetParent(root)?.FullName);
              var asset = Path.GetFullPath(pane.Context);
              if (project is null || !File.Exists(asset) || !IsInFolder(asset, root) ||
                  !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase)) return null;
              return pane with { Title = $"Asset · {Path.GetFileName(asset)}", Context = asset, Location = root };
          }
          if (pane.Kind == "mask-editor")
          {
              if (string.IsNullOrWhiteSpace(pane.Context) || string.IsNullOrWhiteSpace(pane.Location)) return null;
              var root = NormalizeFolder(pane.Location);
              var project = FindRegisteredProject(Directory.GetParent(root)?.FullName);
              var asset = Path.GetFullPath(pane.Context);
              if (project is null || !File.Exists(asset) || !IsInFolder(asset, root) || !IsGenerationImage(asset) ||
                  !string.Equals(root, NormalizeFolder(Path.Combine(project.FolderPath, "assets")), StringComparison.OrdinalIgnoreCase)) return null;
              return pane with { Title = $"Mask · {Path.GetFileName(asset)}", Context = asset, Location = root };
          }
      }
      catch (Exception ex) when (ex is ArgumentException or IOException or UnauthorizedAccessException or NotSupportedException)
      {
          return pane.Kind is "assets" or "generation" or "panel-editor"
              ? pane with { Title = pane.Kind switch { "assets" => "Assets", "generation" => "Generation", _ => "Panel" }, Context = null, Location = null }
              : null;
      }
      return null;
  }
  private ProjectDefinition? FindRegisteredProject(string? folderPath) =>
      string.IsNullOrWhiteSpace(folderPath) ? null : ProjectLibrary.GetAll().FirstOrDefault(project =>
          string.Equals(project.FolderPath, folderPath, StringComparison.OrdinalIgnoreCase) && Directory.Exists(project.FolderPath));
  private static int MaximumPaneNumber(DockNode node) => node switch
  {
      TabGroupNode group => group.Panes.Select(pane =>
      {
          var digits = new string(pane.Id.Reverse().TakeWhile(char.IsDigit).Reverse().ToArray());
          return int.TryParse(digits, out var number) ? number : 0;
      }).DefaultIfEmpty().Max(),
      SplitNode split => Math.Max(MaximumPaneNumber(split.First), MaximumPaneNumber(split.Second)),
      _ => 0
  };
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
      if (firstRender)
      {
          dockReference = DotNetObjectReference.Create(this);
          await JS.InvokeVoidAsync("recursiveDock.setReference", dockReference);
      }
      if (!workspaceLoaded) return;
      if (ReferenceEquals(savedRoot, Root)) return;
      try
      {
          WorkspaceLayoutStore.Save(Root);
          savedRoot = Root;
      }
      catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
      {
          System.Diagnostics.Debug.WriteLine($"Could not save workspace layout: {ex}");
      }
  }
  public void Dispose() => dockReference?.Dispose();
}
