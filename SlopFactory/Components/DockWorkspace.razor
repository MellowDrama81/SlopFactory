  [JSInvokable]
  public async Task<string> DeleteAsset(string assetPath, string assetsRoot)
  {
      try
      {
          var root = Path.GetFullPath(assetsRoot).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
          var target = Path.GetFullPath(assetPath);
          if (!target.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
              return JsonSerializer.Serialize(new { success = false, message = "The asset is outside the project assets folder." }, WorkflowJsonOptions);

          var files = File.Exists(target) ? [target] : Directory.Exists(target) ? Directory.EnumerateFiles(target, "*", SearchOption.AllDirectories).ToList() : [];
          if (File.Exists(target)) DeleteFile(target);
          else if (Directory.Exists(target)) DeleteDirectory(target);
          else return JsonSerializer.Serialize(new { success = false, message = "The asset no longer exists." }, WorkflowJsonOptions);

          var projectFolder = Directory.GetParent(root)!.FullName;
          foreach (var file in files)
          {
              var relativePath = Path.GetRelativePath(projectFolder, file).Replace('\\', '/');
              var metadataName = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativePath))).ToLowerInvariant() + ".json";
              var metadataPath = Path.Combine(projectFolder, metadataName);
              if (File.Exists(metadataPath)) DeleteFile(metadataPath);
          }
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true, message = "Asset deleted." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  private static void DeleteDirectory(string directoryPath)
  {
      foreach (var file in Directory.EnumerateFiles(directoryPath, "*", SearchOption.AllDirectories)) DeleteFile(file);
      foreach (var directory in Directory.EnumerateDirectories(directoryPath, "*", SearchOption.AllDirectories).OrderByDescending(path => path.Length))
      {
          File.SetAttributes(directory, FileAttributes.Normal);
          Directory.Delete(directory, recursive: false);
      }
      File.SetAttributes(directoryPath, FileAttributes.Normal);
      Directory.Delete(directoryPath, recursive: false);
  }
  private static void DeleteFile(string filePath)
  {
      File.SetAttributes(filePath, FileAttributes.Normal);
      File.Delete(filePath);
  }
  private static string UniqueAssetPath(string assetsFolder, string fileName, bool isDirectory = false)
  {
      var safeName = Path.GetFileName(fileName);
      var target = Path.Combine(assetsFolder, safeName);
      if (!File.Exists(target) && !Directory.Exists(target)) return target;
      var baseName = Path.GetFileNameWithoutExtension(safeName);
      var extension = isDirectory ? string.Empty : Path.GetExtension(safeName);
      for (var suffix = 2; ; suffix++)
      {
          target = Path.Combine(assetsFolder, $"{baseName} ({suffix}){extension}");
          if (!File.Exists(target) && !Directory.Exists(target)) return target;
      }
  }
  [JSInvokable]
  public async Task<string> SaveWorkflow(string id, string displayName, string description, bool requiresMask, int minImages, int maxImages)
  {
