@using SlopFactory.Models
@using SlopFactory.Services
@using System.Text.Json
@using System.Text.Json.Nodes
@implements IDisposable
@inject IJSRuntime JS
@inject ComfyConnectionSettings ComfyConnection
@inject ComfyConnectionTester ComfyConnectionTester
@inject WorkflowLibrary WorkflowLibrary
@inject ProjectLibrary ProjectLibrary
@inject ProjectFolderPicker ProjectFolderPicker
@inject ProjectExporter ProjectExporter
@inject AssetExporter AssetExporter
@inject WorkspaceLayoutStore WorkspaceLayoutStore

<main class="dock-app">
  <header class="ribbon">
    <div class="ribbon-brand"><span>◈</span> SlopFactory</div>
    <div class="ribbon-tabs"><button type="button" class="ribbon-tab active" data-ribbon-action="workspace">Workspace</button><button type="button" class="ribbon-tab" data-ribbon-action="projects">Projects</button></div>
    <div class="ribbon-actions"><button type="button" class="ribbon-button" data-ribbon-action="clear-workspace">↶ Clear workspace</button><button type="button" class="ribbon-button" data-ribbon-action="generation">✦ Generation</button><button type="button" class="ribbon-button" data-ribbon-action="assets">▤ Assets</button><button type="button" class="ribbon-button" data-ribbon-action="settings">⚙ Comfy Settings</button><button type="button" class="ribbon-button" data-ribbon-action="workflows">⛭ Workflows</button></div>
  </header>
  <section class="settings-screen">
      <div class="settings-heading"><div><p>INTEGRATIONS</p><h1>ComfyUI connection</h1><span>Choose where SlopFactory sends ComfyUI workflow requests.</span></div></div>
      <div class="settings-grid">
        <section class="settings-card comfy-settings-card" data-comfy-connection>
          <h2>Connection</h2>
          <p>Enter any ComfyUI-compatible API endpoint. Add an API key only when your endpoint requires one.</p>
          <div class="comfy-connection-layout">
            <div class="comfy-connection-list-pane">
              <span class="comfy-connection-list-label">Saved connections</span>
              <ul class="comfy-connection-list" data-comfy-connection-list>
                <li class="comfy-connection-empty">No saved connections yet.</li>
              </ul>
              <button type="button" class="new-connection" data-comfy-action="new">＋ New connection</button>
            </div>
            <div class="comfy-connection-form">
              <label class="comfy-field">
                <span>Identifier <em>Optional — URL is used when blank</em></span>
                <input type="text" data-comfy-connection-key placeholder="e.g. studio-cloud" />
              </label>
              <label class="comfy-field">
                <span>ComfyUI API URL</span>
                <input type="url" data-comfy-server-url @bind="ComfyConnection.ServerUrl" placeholder="http://127.0.0.1:8188" />
              </label>
              <label class="comfy-field">
                <span>API key <em>Optional</em></span>
                <input type="password" data-comfy-api-key @bind="ComfyConnection.ApiKey" autocomplete="off" placeholder="Paste an API key when required" />
              </label>
              <p class="connection-note">The key is sent as the <code>X-API-Key</code> request header only when supplied. Settings are retained in this app’s local profile. For Comfy Cloud, use <code>https://cloud.comfy.org</code> and create a key in your <a href="https://platform.comfy.org/profile/api-keys" target="_blank">Comfy API key settings</a>.</p>

              <div class="connection-actions"><button type="button" class="test-connection" data-comfy-action="test" disabled="@isTesting">@(isTesting ? "Testing…" : "Test connection")</button><button type="button" class="save-connection" data-comfy-action="save">Save connection</button><button type="button" class="use-current-connection" data-comfy-action="use-current">Use as current</button><span data-comfy-status class="@connectionStatusClass">@connectionStatus</span></div>
            </div>
          </div>
        </section>
      </div>
    </section>
  <section class="workflows-screen">
      <div class="settings-heading"><div><p>AUTOMATION</p><h1>Workflows</h1><span>Manage the ComfyUI workflows SlopFactory can run.</span></div></div>
      <div class="settings-grid">
        <section class="settings-card comfy-settings-card" data-workflow-library>
          <h2>Workflow library</h2>
          <p>Built-in workflows are read-only. Add your own custom workflows alongside them.</p>
          <div class="comfy-connection-layout">
            <div class="comfy-connection-list-pane">
              <span class="comfy-connection-list-label">Workflows</span>
              <ul class="comfy-connection-list" data-workflow-list>
                <li class="comfy-connection-empty">Loading workflows…</li>
              </ul>
              <button type="button" class="new-connection" data-workflow-action="new">＋ New workflow</button>
            </div>
            <div class="comfy-connection-form">
              <label class="comfy-field">
                <span>Identifier</span>
                <input type="text" data-workflow-id placeholder="e.g. my-custom-upscale" />
              </label>
              <label class="comfy-field">
                <span>Display name</span>
                <input type="text" data-workflow-display-name placeholder="e.g. My custom upscale" />
              </label>
              <label class="comfy-field">
                <span>Description</span>
                <textarea data-workflow-description rows="3" placeholder="What this workflow does"></textarea>
              </label>
              <div class="setting-row">
                <div><b>Requires mask</b><span>The workflow needs a painted mask region.</span></div>
                <label class="switch"><input type="checkbox" data-workflow-requires-mask /><i></i></label>
              </div>
              <label class="comfy-field">
                <span>Minimum images</span>
                <input type="number" min="0" step="1" data-workflow-min-images />
              </label>
              <label class="comfy-field">
                <span>Maximum images</span>
                <input type="number" min="0" step="1" data-workflow-max-images />
              </label>
              <p class="connection-note" data-workflow-readonly-note hidden>This is a built-in workflow. Its metadata is read-only — create a new workflow to customize it.</p>

              <div class="connection-actions"><button type="button" class="save-connection" data-workflow-action="save">Save workflow</button><button type="button" class="use-current-connection" data-workflow-action="duplicate">⧉ Duplicate as new</button><button type="button" class="test-connection" data-workflow-action="delete">Remove workflow</button><span data-workflow-status></span></div>
            </div>
          </div>
        </section>
      </div>
    </section>
  <section class="projects-screen">
    <div class="settings-heading"><div><p>WORKSPACE LIBRARY</p><h1>Projects</h1><span>Choose a project to open in the docking workspace.</span></div></div>
    <section class="settings-card comfy-settings-card" data-project-library>
      <h2>Project library</h2>
      <p>Each project is backed by a folder. Choose an existing folder or create one.</p>
      <div class="comfy-connection-layout">
        <div class="comfy-connection-list-pane">
          <span class="comfy-connection-list-label">Projects</span>
          <ul class="comfy-connection-list" data-project-list><li class="comfy-connection-empty">Loading projects…</li></ul>
        </div>
        <div class="comfy-connection-form">
          <label class="comfy-field"><span>Project name <em>Optional — folder path is used when blank</em></span><input type="text" data-project-name placeholder="e.g. Brand launch" /></label>
          <label class="comfy-field"><span>Project folder</span><input type="text" data-project-folder placeholder="C:\\Projects\\My project" readonly /></label>
          <div class="connection-actions"><button type="button" class="test-connection" data-project-action="pick">Add project</button><button type="button" class="save-connection" data-project-action="save">Save project</button><button type="button" class="export-project" data-project-action="export">Export</button><button type="button" class="remove-project" data-project-action="remove">Remove project</button><span data-project-status></span></div>
        </div>
      </div>
    </section>
  </section>
  <section class="dock-host" data-root-dock><DockSurface @key="Root" Node="Root" OnActivateTab="ActivateTab" OnGenerationWorkflowChanged="SelectGenerationWorkflow" OnGenerationInputChanged="ChangeGenerationInput" /></section>
</main>

@code {
  private DockNode Root = BuildTree();
  private DockNode? savedRoot;
  private bool workspaceLoaded;
  private DotNetObjectReference<DockWorkspace>? dockReference;
  private int added;
  private string connectionStatus = "";
  private string connectionStatusClass = "";
  private bool isTesting;
  private static DockNode BuildTree() => new TabGroupNode("workspace", [], string.Empty);
  private static readonly JsonSerializerOptions WorkflowJsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
  [JSInvokable]
  public Task ClearWorkspace()
  {
      Root = BuildTree();
      return InvokeAsync(StateHasChanged);
  }
  protected override async Task OnInitializedAsync()
  {
      await ComfyConnection.LoadAsync();
      await WorkflowLibrary.LoadAsync();
      await ProjectLibrary.LoadAsync();
      Root = RestoreWorkspace(await WorkspaceLayoutStore.LoadAsync()) ?? BuildTree();
      added = MaximumPanelNumber(Root);
      workspaceLoaded = true;
  }
  [JSInvokable]
  public string GetWorkflows() => JsonSerializer.Serialize(WorkflowLibrary.GetAll(), WorkflowJsonOptions);
  [JSInvokable]
  public string GetProjects() => JsonSerializer.Serialize(ProjectLibrary.GetAll(), WorkflowJsonOptions);
  [JSInvokable]
  public async Task<string?> PickProjectFolder() => await ProjectFolderPicker.PickAsync();
  [JSInvokable]
  public async Task<string> SaveProject(string folderPath, string name, bool createFolder)
  {
      if (string.IsNullOrWhiteSpace(folderPath)) return JsonSerializer.Serialize(new { success = false, message = "Choose or enter a project folder." }, WorkflowJsonOptions);
      try
      {
          var project = await ProjectLibrary.SaveAsync(folderPath, name, createFolder);
          return JsonSerializer.Serialize(new { success = true, project }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> RemoveProject(string folderPath)
  {
      if (string.IsNullOrWhiteSpace(folderPath)) return JsonSerializer.Serialize(new { success = false, message = "Select a project to remove." }, WorkflowJsonOptions);
      try
      {
          await ProjectLibrary.RemoveAsync(folderPath);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> ExportProject(string folderPath)
  {
      if (string.IsNullOrWhiteSpace(folderPath)) return JsonSerializer.Serialize(new { success = false, message = "Select a project to export." }, WorkflowJsonOptions);
      try
      {
          var path = await ProjectExporter.ExportAsync(folderPath);
          return JsonSerializer.Serialize(new { success = path is not null, message = path is null ? "Export cancelled." : "Project exported as a ZIP archive." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> OpenAssetsPanel(string folderPath, string name)
  {
      if (string.IsNullOrWhiteSpace(folderPath))
      {
          added++;
          Root = AddToFirstGroup(Root, new DockPanel($"assets{added}", "Assets", "▤", "gold", "assets"));
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      var assetsPath = Path.Combine(folderPath, "assets");
      Directory.CreateDirectory(assetsPath);
      added++;
      var title = string.IsNullOrWhiteSpace(name) ? folderPath : name;
      Root = AddToFirstGroup(Root, new DockPanel($"assets{added}", $"Assets · {title}", "▤", "gold", "assets", assetsPath, assetsPath));
      await InvokeAsync(StateHasChanged);
      return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
  }
  [JSInvokable]
  public async Task<string> OpenGenerationPanel()
  {
      added++;
      Root = AddToFirstGroup(Root, new DockPanel($"generation{added}", "Generation", "✦", "violet", "generation"));
      await InvokeAsync(StateHasChanged);
      return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
  }
  [JSInvokable]
  public async Task<string> SetGenerationPanelProject(string panelId, string folderPath)
  {
      try
      {
          var project = ProjectLibrary.GetAll().FirstOrDefault(item =>
              string.Equals(item.FolderPath, Path.GetFullPath(folderPath), StringComparison.OrdinalIgnoreCase));
          if (project is null || !Directory.Exists(project.FolderPath))
              return JsonSerializer.Serialize(new { success = false, message = "The selected project is not available." }, WorkflowJsonOptions);
          Root = SetGenerationProject(Root, panelId, project);
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task ClearGenerationPanelProject(string panelId)
  {
      Root = ClearGenerationProject(Root, panelId);
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode ClearGenerationProject(DockNode node, string panelId) => node switch
  {
      TabGroupNode group => group with
      {
          Panels = group.Panels.Select(panel => panel.Id == panelId && panel.Kind == "generation"
              ? panel with { Title = "Generation", Context = null, WorkflowId = null, InputValues = null }
              : panel).ToList(),
          ActiveId = group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "generation") ? panelId : group.ActiveId
      },
      SplitNode split => split with
      {
          First = ClearGenerationProject(split.First, panelId),
          Second = ClearGenerationProject(split.Second, panelId)
      },
      _ => node
  };
  private static DockNode SetGenerationProject(DockNode node, string panelId, ProjectDefinition project) => node switch
  {
      TabGroupNode group => group with
      {
          Panels = group.Panels.Select(panel => panel.Id == panelId && panel.Kind == "generation"
              ? panel with { Title = $"Generation · {project.DisplayName}", Context = project.FolderPath, WorkflowId = null, InputValues = null }
              : panel).ToList(),
          ActiveId = group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "generation") ? panelId : group.ActiveId
      },
      SplitNode split => split with
      {
          First = SetGenerationProject(split.First, panelId, project),
          Second = SetGenerationProject(split.Second, panelId, project)
      },
      _ => node
  };
  [JSInvokable]
  public async Task SetAssetsPanelProject(string panelId, string folderPath, string name)
  {
      if (string.IsNullOrWhiteSpace(folderPath) || !Directory.Exists(folderPath)) return;
      var assetsPath = Path.Combine(folderPath, "assets");
      Directory.CreateDirectory(assetsPath);
      var title = string.IsNullOrWhiteSpace(name) ? folderPath : name;
      Root = SetAssetsPanelProject(Root, panelId, assetsPath, $"Assets · {title}");
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode SetAssetsPanelProject(DockNode node, string panelId, string assetsPath, string title) => node switch
  {
      TabGroupNode group when group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "assets")
          => group with
          {
              Panels = group.Panels.Select(panel => panel.Id == panelId ? panel with { Title = title, Context = assetsPath, Location = assetsPath } : panel).ToList(),
              ActiveId = panelId
          },
      SplitNode split => split with { First = SetAssetsPanelProject(split.First, panelId, assetsPath, title), Second = SetAssetsPanelProject(split.Second, panelId, assetsPath, title) },
      _ => node
  };
  [JSInvokable]
  public async Task<string> AddAssets(string assetsFolder, string assetsRoot)
  {
      if (string.IsNullOrWhiteSpace(assetsFolder) || string.IsNullOrWhiteSpace(assetsRoot) || !Directory.Exists(assetsFolder) || !Directory.Exists(assetsRoot))
          return JsonSerializer.Serialize(new { success = false, message = "The assets folder is not available." }, WorkflowJsonOptions);

      var files = await FilePicker.Default.PickMultipleAsync();
      if (files is null || !files.Any()) return JsonSerializer.Serialize(new { success = false, message = "No files selected." }, WorkflowJsonOptions);

      var copied = 0;
      foreach (var file in files)
      {
          if (file is null) continue;
          var target = UniqueAssetPath(assetsFolder, file.FileName ?? "asset");
          await using var source = await file.OpenReadAsync();
          await using var destination = File.Create(target);
          await source.CopyToAsync(destination);
          var projectFolder = Directory.GetParent(assetsRoot)!.FullName;
          var relativeAssetPath = Path.GetRelativePath(projectFolder, target).Replace('\\', '/');
          var metadataFileName = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativeAssetPath))).ToLowerInvariant() + ".json";
          var metadataPath = Path.Combine(projectFolder, metadataFileName);
          var metadata = new { asset = relativeAssetPath, name = Path.GetFileName(target), tags = Array.Empty<string>() };
          await File.WriteAllTextAsync(metadataPath, JsonSerializer.Serialize(metadata, WorkflowJsonOptions));
          copied++;
      }
      await InvokeAsync(StateHasChanged);
      return JsonSerializer.Serialize(new { success = true, message = $"Added {copied} asset{(copied == 1 ? string.Empty : "s")}." }, WorkflowJsonOptions);
  }
  [JSInvokable]
  public async Task<string> AddDroppedAsset(string assetsFolder, string assetsRoot, string fileName, IJSStreamReference file)
  {
      const long maxFileSize = 1024L * 1024 * 1024;
      string? target = null;
      var created = false;
      try
      {
          var folder = NormalizeFolder(assetsFolder);
          var root = NormalizeFolder(assetsRoot);
          if (!Directory.Exists(folder) || !Directory.Exists(root) || !IsInFolder(folder, root))
              return JsonSerializer.Serialize(new { success = false, message = "The destination assets folder is not available." }, WorkflowJsonOptions);
          if (string.IsNullOrWhiteSpace(fileName) || fileName is "." or ".." ||
              fileName != Path.GetFileName(fileName) || fileName.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
              return JsonSerializer.Serialize(new { success = false, message = "The dropped file has an invalid name." }, WorkflowJsonOptions);
          if (file.Length > maxFileSize)
              return JsonSerializer.Serialize(new { success = false, message = $"{fileName} exceeds the 1 GB file limit." }, WorkflowJsonOptions);

          target = UniqueAssetPath(folder, fileName);
          await using (var source = await file.OpenReadStreamAsync(maxAllowedSize: maxFileSize))
          await using (var destination = new FileStream(target, FileMode.CreateNew, FileAccess.Write, FileShare.None))
          {
              created = true;
              await source.CopyToAsync(destination);
          }

          var projectFolder = Directory.GetParent(root)!.FullName;
          var relativeAssetPath = Path.GetRelativePath(projectFolder, target).Replace('\\', '/');
          var metadataPath = AssetMetadataPath(projectFolder, relativeAssetPath);
          var metadata = new { asset = relativeAssetPath, name = Path.GetFileName(target), tags = Array.Empty<string>() };
          await File.WriteAllTextAsync(metadataPath, JsonSerializer.Serialize(metadata, WorkflowJsonOptions));
          return JsonSerializer.Serialize(new { success = true, message = $"Added {Path.GetFileName(target)}." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          if (created && target is not null)
          {
              try { File.Delete(target); } catch { /* Preserve the original error. */ }
          }
          return JsonSerializer.Serialize(new { success = false, message = $"Could not add {fileName}: {ex.Message}" }, WorkflowJsonOptions);
      }
      finally { await file.DisposeAsync(); }
  }
  [JSInvokable]
  public Task RefreshAssetsPanels() => InvokeAsync(StateHasChanged);
  [JSInvokable]
  public async Task<string> CopyAsset(string sourcePath, string sourceRoot, string destinationFolder, string destinationRoot)
  {
      try
      {
          var source = Path.GetFullPath(sourcePath);
          var normalizedSourceRoot = NormalizeFolder(sourceRoot);
          var destination = NormalizeFolder(destinationFolder);
          var normalizedDestinationRoot = NormalizeFolder(destinationRoot);
          if (!IsInFolder(source, normalizedSourceRoot) || !IsInFolder(destination, normalizedDestinationRoot) || (!File.Exists(source) && !Directory.Exists(source)))
              return JsonSerializer.Serialize(new { success = false, message = "The source or destination assets folder is not available." }, WorkflowJsonOptions);

          var sourceParent = NormalizeFolder(Path.GetDirectoryName(source)!);
          if (string.Equals(sourceParent, destination, StringComparison.OrdinalIgnoreCase))
              return JsonSerializer.Serialize(new { success = true, message = "That asset is already in this folder." }, WorkflowJsonOptions);
          if (Directory.Exists(source) && IsInFolder(destination, source))
              return JsonSerializer.Serialize(new { success = false, message = "A folder cannot be copied into itself." }, WorkflowJsonOptions);

          var target = UniqueAssetPath(destination, Path.GetFileName(source), Directory.Exists(source));
          if (Directory.Exists(source)) CopyDirectory(source, target);
          else File.Copy(source, target);
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true, message = $"Copied {Path.GetFileName(source)}." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  [JSInvokable]
  public async Task<string> OpenAssetDetails(string assetPath, string assetsRoot, string sourcePanelId)
  {
      try
      {
          var asset = Path.GetFullPath(assetPath);
          var root = NormalizeFolder(assetsRoot);
          if (!File.Exists(asset) || !IsInFolder(asset, root))
              return JsonSerializer.Serialize(new { success = false, message = "The asset is not available." }, WorkflowJsonOptions);
          var existingDetails = FindAssetDetails(Root, sourcePanelId);
          if (existingDetails is not null)
          {
              Root = UpdateAssetDetails(Root, existingDetails.Id, asset, root);
          }
          else
          {
              added++;
              var detailsPanel = new DockPanel($"asset-details{added}", $"Asset · {Path.GetFileName(asset)}", "◉", "mint", "asset-details", asset, root, sourcePanelId);
              Root = ContainsPanel(Root, sourcePanelId) ? DockDetailsRightOfPanel(Root, sourcePanelId, detailsPanel) : AddToFirstGroup(Root, detailsPanel);
          }
          Root = CollapseEmptyGroups(Root) ?? BuildTree();
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  private static bool ContainsPanel(DockNode node, string panelId) => node switch
  {
      TabGroupNode group => group.Panels.Any(panel => panel.Id == panelId),
      SplitNode split => ContainsPanel(split.First, panelId) || ContainsPanel(split.Second, panelId),
      _ => false
  };
  private static DockPanel? FindAssetDetails(DockNode node, string sourcePanelId) => node switch
  {
      TabGroupNode group => group.Panels.FirstOrDefault(panel => panel.Kind == "asset-details" && panel.Owner == sourcePanelId),
      SplitNode split => FindAssetDetails(split.First, sourcePanelId) ?? FindAssetDetails(split.Second, sourcePanelId),
      _ => null
  };
  private static DockNode UpdateAssetDetails(DockNode node, string detailsPanelId, string assetPath, string assetsRoot) => node switch
  {
      TabGroupNode group when group.Panels.Any(panel => panel.Id == detailsPanelId)
          => group with
          {
              Panels = group.Panels.Select(panel => panel.Id == detailsPanelId
                  ? panel with { Title = $"Asset · {Path.GetFileName(assetPath)}", Context = assetPath, Location = assetsRoot }
                  : panel).ToList(),
              ActiveId = detailsPanelId
          },
      SplitNode split => split with
      {
          First = UpdateAssetDetails(split.First, detailsPanelId, assetPath, assetsRoot),
          Second = UpdateAssetDetails(split.Second, detailsPanelId, assetPath, assetsRoot)
      },
      _ => node
  };
  private static DockNode DockDetailsRightOfPanel(DockNode node, string sourcePanelId, DockPanel detailsPanel) => node switch
  {
      TabGroupNode group when group.Panels.Any(panel => panel.Id == sourcePanelId)
          => new SplitNode($"asset-details-split-{detailsPanel.Id}", DockAxis.Horizontal, .6, group, new TabGroupNode($"asset-details-group-{detailsPanel.Id}", [detailsPanel], detailsPanel.Id)),
      SplitNode split when ContainsPanel(split.First, sourcePanelId)
          => split with { First = DockDetailsRightOfPanel(split.First, sourcePanelId, detailsPanel) },
      SplitNode split => split with { Second = DockDetailsRightOfPanel(split.Second, sourcePanelId, detailsPanel) },
      _ => node
  };
  private static string NormalizeFolder(string path) => Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
  private static bool IsInFolder(string path, string folder) => string.Equals(path, folder, StringComparison.OrdinalIgnoreCase) || path.StartsWith(folder + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase);
  private static void CopyDirectory(string source, string destination)
  {
      Directory.CreateDirectory(destination);
      foreach (var file in Directory.EnumerateFiles(source)) File.Copy(file, Path.Combine(destination, Path.GetFileName(file)));
      foreach (var folder in Directory.EnumerateDirectories(source)) CopyDirectory(folder, Path.Combine(destination, Path.GetFileName(folder)));
  }
  [JSInvokable]
  public async Task NavigateAssetsPanel(string panelId, string folderPath)
  {
      if (!Directory.Exists(folderPath)) return;
      Root = SetPanelLocation(Root, panelId, folderPath);
      await InvokeAsync(StateHasChanged);
  }
  private static DockNode SetPanelLocation(DockNode node, string panelId, string folderPath) => node switch
  {
      TabGroupNode group when group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "assets")
          => group with
          {
              Panels = group.Panels.Select(panel => panel.Id == panelId ? panel with { Location = folderPath } : panel).ToList(),
              ActiveId = panelId
          },
      SplitNode split => split with { First = SetPanelLocation(split.First, panelId, folderPath), Second = SetPanelLocation(split.Second, panelId, folderPath) },
      _ => node
  };
  [JSInvokable]
  public async Task<string> RenameAsset(string assetPath, string assetsRoot, string newName, string panelId)
  {
      try
      {
          var root = NormalizeFolder(assetsRoot);
          var source = Path.GetFullPath(assetPath);
          newName = newName.Trim();
          if (!Directory.Exists(root) || !IsInFolder(source, root) || string.Equals(source, root, StringComparison.OrdinalIgnoreCase))
              return JsonSerializer.Serialize(new { success = false, message = "The asset is outside the project assets folder." }, WorkflowJsonOptions);
          if (string.IsNullOrWhiteSpace(newName) || newName is "." or ".." || newName.EndsWith('.') || newName.EndsWith(' ')
              || newName.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0 || newName.Contains('/') || newName.Contains('\\'))
              return JsonSerializer.Serialize(new { success = false, message = "Enter a valid file or folder name." }, WorkflowJsonOptions);

          var isFolder = Directory.Exists(source);
          if (!isFolder && !File.Exists(source))
              return JsonSerializer.Serialize(new { success = false, message = "The asset no longer exists." }, WorkflowJsonOptions);
          var destination = Path.Combine(Path.GetDirectoryName(source)!, newName);
          if (string.Equals(source, destination, StringComparison.Ordinal))
              return JsonSerializer.Serialize(new { success = true, message = "Name unchanged." }, WorkflowJsonOptions);
          if (!string.Equals(source, destination, StringComparison.OrdinalIgnoreCase) && (File.Exists(destination) || Directory.Exists(destination)))
              return JsonSerializer.Serialize(new { success = false, message = "An item with that name already exists." }, WorkflowJsonOptions);

          var projectFolder = Directory.GetParent(root)!.FullName;
          var files = isFolder ? Directory.EnumerateFiles(source, "*", SearchOption.AllDirectories).ToList() : [source];
          var metadata = new List<(string OldPath, string NewPath, string Content)>();
          foreach (var file in files)
          {
              var renamedFile = destination + file[source.Length..];
              var oldRelative = Path.GetRelativePath(projectFolder, file).Replace('\\', '/');
              var newRelative = Path.GetRelativePath(projectFolder, renamedFile).Replace('\\', '/');
              var oldMetadata = AssetMetadataPath(projectFolder, oldRelative);
              var newMetadata = AssetMetadataPath(projectFolder, newRelative);
              if (!string.Equals(oldMetadata, newMetadata, StringComparison.OrdinalIgnoreCase) && File.Exists(newMetadata))
                  return JsonSerializer.Serialize(new { success = false, message = "Metadata already exists for the new name." }, WorkflowJsonOptions);
              var content = File.Exists(oldMetadata) ? JsonNode.Parse(File.ReadAllText(oldMetadata)) as JsonObject
                  ?? throw new InvalidOperationException($"Invalid metadata for {Path.GetFileName(file)}.") : new JsonObject();
              content["asset"] = newRelative;
              content["name"] = Path.GetFileName(renamedFile);
              metadata.Add((oldMetadata, newMetadata, content.ToJsonString(new JsonSerializerOptions { WriteIndented = true })));
          }

          if (isFolder) Directory.Move(source, destination);
          else File.Move(source, destination);
          foreach (var item in metadata)
          {
              File.WriteAllText(item.NewPath, item.Content);
              if (!string.Equals(item.OldPath, item.NewPath, StringComparison.OrdinalIgnoreCase)) File.Delete(item.OldPath);
          }
          Root = RewriteRenamedPaths(Root, source, destination, panelId);
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true, message = $"Renamed to {newName}." }, WorkflowJsonOptions);
      }
      catch (Exception ex)
      {
          return JsonSerializer.Serialize(new { success = false, message = ex.Message }, WorkflowJsonOptions);
      }
  }
  private static string AssetMetadataPath(string projectFolder, string relativePath)
      => Path.Combine(projectFolder, Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(relativePath))).ToLowerInvariant() + ".json");
  private static string? RewriteRenamedPath(string? path, string source, string destination)
      => path is not null && IsInFolder(path, source) ? destination + path[source.Length..] : path;
  private static DockNode RewriteRenamedPaths(DockNode node, string source, string destination, string panelId) => node switch
  {
      TabGroupNode group => group with { Panels = group.Panels.Select(panel => panel with
      {
          Context = RewriteRenamedPath(panel.Context, source, destination),
          Location = RewriteRenamedPath(panel.Location, source, destination),
          Title = panel.Kind == "asset-details" && IsInFolder(panel.Context ?? string.Empty, source)
              ? $"Asset · {Path.GetFileName(RewriteRenamedPath(panel.Context, source, destination))}" : panel.Title
      }).ToList(), ActiveId = group.Panels.Any(panel => panel.Id == panelId && panel.Kind == "assets") ? panelId : group.ActiveId },
      SplitNode split => split with { First = RewriteRenamedPaths(split.First, source, destination, panelId), Second = RewriteRenamedPaths(split.Second, source, destination, panelId) },
      _ => node
  };
  [JSInvokable]
  public async Task<string> CreateAssetsFolder(string parentFolder, string name)
  {
      if (string.IsNullOrWhiteSpace(name) || name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
          return JsonSerializer.Serialize(new { success = false, message = "Enter a valid folder name." }, WorkflowJsonOptions);
      try
      {
          Directory.CreateDirectory(Path.Combine(parentFolder, name.Trim()));
          await InvokeAsync(StateHasChanged);
          return JsonSerializer.Serialize(new { success = true, message = "Folder created." }, WorkflowJsonOptions);
      }
      catch
      {
          return JsonSerializer.Serialize(new { success = false, message = "Could not create the folder." }, WorkflowJsonOptions);
      }
  }
