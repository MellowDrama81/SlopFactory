                  ? pane with { Title = $"Asset · {Path.GetFileName(assetPath)}", Context = assetPath, Location = assetsRoot }
                  : pane).ToList(),
              ActiveId = detailsPaneId
          },
      SplitNode split => split with
      {
          First = UpdateAssetDetails(split.First, detailsPaneId, assetPath, assetsRoot),
          Second = UpdateAssetDetails(split.Second, detailsPaneId, assetPath, assetsRoot)
      },
